---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCard from '../../components/ToolCard.astro';
import AmazonDealBox from '../../components/AmazonDealBox.astro';
import DealPoll from '../../components/DealPoll.astro';
import NicheCard from '../../components/NicheCard.astro';
import DisclaimerBar from '../../components/DisclaimerBar.astro';
import Icon from '../../components/Icon.astro';
import HypeMeter from '../../components/HypeMeter.astro';
import FreshnessStamp from '../../components/FreshnessStamp.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import BoxOfficeTable from '../../components/BoxOfficeTable.astro';
import DealPriceStack from '../../components/DealPriceStack.astro';
import TldrBox from '../../components/TldrBox.astro';
import { getPost, getPostsByNiche, getProductsByNiche, getNicheBySlug, getTrendingPosts, getAllProducts } from '../../lib/db';
import { marked } from 'marked';

const { niche: nicheSlug, post: postSlug } = Astro.params;
if (!nicheSlug || !postSlug) {
  return Astro.redirect('/404');
}

const runtime = (Astro.locals as any)?.runtime;
const niche = await getNicheBySlug(nicheSlug, runtime?.env);
const post = await getPost(nicheSlug, postSlug, runtime?.env);

if (!post || !niche) {
  return Astro.redirect('/404');
}

const [relatedPosts, rawProducts, trendingPosts] = await Promise.all([
  getPostsByNiche(niche.id, 6, runtime?.env),
  getProductsByNiche(niche.id, runtime?.env),
  getTrendingPosts(6, runtime?.env)
]);

let products = rawProducts;
if (products.length === 0) {
  const allProds = await getAllProducts(runtime?.env);
  products = allProds.slice(0, 4);
}

const cleanRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 3);
const sidebarRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 4);
const sidebarTrending = trendingPosts.filter(p => p.slug !== post.slug).slice(0, 5);

function sanitizeMarkdownHtml(html: string): string {
  return html
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/\son\w+="[^"]*"/gi, '')
    .replace(/\son\w+='[^']*'/gi, '')
    .replace(/href=["']javascript:[^"']*["']/gi, 'href="#"');
}

function slugifyHeading(text: string): string {
  return text
    .toLowerCase()
    .replace(/<[^>]*>/g, '')
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

// Normalize literal escaped newlines and markdown characters from database / API
const normalizedMarkdown = (post.body_md || '')
  .replace(/\\r\\n/g, '\n')
  .replace(/\\n/g, '\n')
  .replace(/\\t/g, '  ');

// Extract H2 Table of Contents from markdown
const tokens = marked.lexer(normalizedMarkdown);
const tableOfContents = tokens
  .filter((t: any) => t.type === 'heading' && t.depth === 2)
  .map((t: any) => ({
    text: t.text.replace(/[*_`]/g, '').trim(),
    id: slugifyHeading(t.text)
  }));

// Setup marked renderer to inject anchor IDs into headings
const headingRenderer = new marked.Renderer();
headingRenderer.heading = ({ text, depth }: { text: string; depth: number }) => {
  const cleanId = slugifyHeading(text);
  return `<h${depth} id="${cleanId}" class="scroll-mt-28 group relative font-black text-slate-900 tracking-tight">${text}<a href="#${cleanId}" class="ml-2 text-slate-300 opacity-0 group-hover:opacity-100 transition no-underline text-base" aria-hidden="true">#</a></h${depth}>\n`;
};

const rawBodyHtml = normalizedMarkdown ? (marked.parse(normalizedMarkdown, { renderer: headingRenderer }) as string) : '';
const bodyHtml = typeof rawBodyHtml === 'string' ? sanitizeMarkdownHtml(rawBodyHtml) : '';
const isCard = post.kind === 'card' || !post.indexable;

// Estimated reading time & stats
const wordCount = (post.body_md || post.summary || '').split(/\s+/).length;
const readTime = Math.max(2, Math.ceil(wordCount / 180));

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=10, must-revalidate');

// High-Resolution Curated Assets to Prevent Low-Res Blur (100% Real Wikipedia Commons & Local Assets)
const CURATED_NICHE_HERO_IMAGES: Record<string, string> = {
  'cricket-sports': 'https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/Board_of_Control_for_Cricket_in_India_Logo_%282024%29.svg/960px-Board_of_Control_for_Cricket_in_India_Logo_%282024%29.svg.png',
  'pc-builds': '/images/rtx5090.jpg',
  'gta-6': '/images/gta6_cover.jpg',
  'ai-tools': '/images/ai_tools.jpg',
  'gold-rate': '/images/gold_24k.jpg',
  'deals': '/images/products/iphone_16_pro.jpg',
  'cashback': 'https://upload.wikimedia.org/wikipedia/commons/2/2a/Credit_Card_Chip_%2834684294971%29.jpg',
  'food': 'https://upload.wikimedia.org/wikipedia/commons/e/ef/Tradtional_Thali.jpg',
  'health': 'https://upload.wikimedia.org/wikipedia/commons/b/b0/Beach_asana_class%2C_Plage_Pereire%2C_Arcachon%2C_2015.jpg',
  'side-hustles': '/images/ai_tools.jpg',
  'fashion': 'https://upload.wikimedia.org/wikipedia/commons/a/a6/Carolina_Herrera_AW14_12.jpg',
  'movies': 'https://upload.wikimedia.org/wikipedia/en/d/d9/Drishyam-_The_Conclusion_poster.jpg',
  'automotive-trends': 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/25/Tata_Nexon_Blue_Dual_Tone.jpg/960px-Tata_Nexon_Blue_Dual_Tone.jpg',
  'exams-results': 'https://upload.wikimedia.org/wikipedia/commons/thumb/8/84/Government_of_India_logo.svg/960px-Government_of_India_logo.svg.png',
  'viral': '/images/ai_tools.jpg'
};

interface GalleryItem {
  url: string;
  label: string;
  caption: string;
}

import { proxyImageUrl } from '../../lib/images';

// Curated Entity Multi-Image Galleries (Zero Generic Stock Photos)
const ENTITY_SPECIFIC_GALLERIES: Record<string, GalleryItem[]> = {
  'drishyam-3-the-conclusion-box-office-collection-nears-400-crore-worldwide': [
    {
      url: 'https://upload.wikimedia.org/wikipedia/en/d/d9/Drishyam-_The_Conclusion_poster.jpg',
      label: '1. Official Poster',
      caption: 'Drishyam 3: The Conclusion official theatrical release poster.'
    },
    {
      url: 'https://upload.wikimedia.org/wikipedia/commons/9/9d/Ajay_Devgn_at_the_trailer_launch_of_Raid_2.jpg',
      label: '2. Ajay Devgn (Vijay)',
      caption: 'Ajay Devgn as Vijay Salgaonkar leading the gripping conclusion.'
    },
    {
      url: 'https://upload.wikimedia.org/wikipedia/commons/5/5d/Mohanlal_Viswanathan_BNC.jpg',
      label: '3. Mohanlal (Creator)',
      caption: 'Mohanlal, legendary lead of the original Malayalam cult classic universe.'
    }
  ],
  'gta-6-pc-specs-realistic-india-pricing-what-system-do-you-need': [
    {
      url: '/images/gta6_cover.jpg',
      label: '1. Official Key Art',
      caption: 'Rockstar Games official Grand Theft Auto VI Vice City artwork.'
    },
    {
      url: '/images/rtx5090.jpg',
      label: '2. RTX 5090 Target',
      caption: 'Next-gen ray tracing and high-FPS target hardware.'
    }
  ]
};

const displayHeroImage = proxyImageUrl(post.image_url, niche.slug, post.slug);
const absoluteImageUrl = displayHeroImage.startsWith('http') 
  ? displayHeroImage 
  : `${Astro.url.origin}${displayHeroImage}`;

// Build Authentic Gallery: Only show real entity slides, never inject fake stock photos
const rawGallerySlides: GalleryItem[] = ENTITY_SPECIFIC_GALLERIES[post.slug] || [
  {
    url: displayHeroImage,
    label: '1. Curated Visual',
    caption: post.image_credit ? `Source: ${post.image_credit}` : `${post.title} — Curated editorial coverage.`
  }
];

const gallerySlides: GalleryItem[] = rawGallerySlides.map(slide => ({
  ...slide,
  url: proxyImageUrl(slide.url)
}));

// 1. Article / NewsArticle Schema (Google Discover & SEO Compliant)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isCard ? 'NewsArticle' : 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href
  },
  headline: post.title,
  description: post.summary,
  image: gallerySlides.map(s => s.url.startsWith('http') ? s.url : `${Astro.url.origin}${s.url}`),
  datePublished: post.published_at,
  dateModified: post.updated_at || post.published_at,
  inLanguage: 'en-IN',
  author: [
    {
      '@type': 'Person',
      name: 'Deepanshu',
      jobTitle: 'Lead Hardware & Intelligence Editor',
      url: `${Astro.url.origin}/about`
    },
    {
      '@type': 'Organization',
      name: 'UniqueDigit Editorial Desk',
      url: Astro.url.origin
    }
  ],
  publisher: {
    '@type': 'Organization',
    name: 'UniqueDigit',
    logo: {
      '@type': 'ImageObject',
      url: `${Astro.url.origin}/favicon.svg`
    }
  }
};

// 2. Breadcrumbs Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.url.origin
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: niche.name,
      item: `${Astro.url.origin}/${niche.slug}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.title,
      item: Astro.url.href
    }
  ]
};

// 3. FAQPage Schema for Google Rich Accordions
const faqSchema = post.faq && post.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map(item => ({
    '@type': 'Question',
    name: item.q || item.question || item.title || 'Frequently Asked Question',
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a || item.answer || item.content || ''
    }
  }))
} : null;

// Calibrated Hype Score (avoids displaying "10 · Low" on live editorial articles)
const calculatedHype = (() => {
  const rawHype = post.hype ?? post.trend_score ?? 0;
  if (rawHype >= 55) return rawHype;
  const seed = (typeof post.id === 'number' ? post.id : (post.title?.length || 15));
  return 76 + (seed % 19);
})();

// Context-tailored dynamic verdict copy (eliminates cricket hallucinations on non-cricket articles)
function getDynamicVerdictCopy(slug: string, title: string, summaryText?: string): string {
  const prefix = summaryText ? `${summaryText} ` : '';
  if (['pc-builds', 'ai-tools', 'gta-6'].includes(slug)) {
    return `${prefix}When assessing hardware configurations, AI workflows, and performance benchmarks, choosing verified components and tracking market price volatility delivers the highest price-to-performance return. Bookmark this page for continuous telemetry.`;
  }
  if (['deals', 'cashback'].includes(slug)) {
    return `${prefix}Flash discounts and bank cashback offers fluctuate rapidly based on retailer inventory. We advise verifying seller ratings and applying available instant coupon codes at checkout. Bookmark this page for continuous telemetry.`;
  }
  if (['health'].includes(slug)) {
    return `${prefix}Holistic wellness and health routines yield the greatest benefit when paired with consistent, science-backed habits. Always cross-reference lifestyle changes with medical guidelines. Bookmark this page for continuous telemetry.`;
  }
  if (['gold-rate'].includes(slug)) {
    return `${prefix}Precious metal valuations reflect live global bullion indices and currency movements. Track multi-city spot rates and hallmarking standards before making physical or digital allocations. Bookmark this page for continuous telemetry.`;
  }
  if (['movies'].includes(slug)) {
    return `${prefix}From critical acclaim to box office trajectories, streaming releases and theatrical runs continue to evolve. Keep this tracker bookmarked for updated platform availability.`;
  }
  if (['cricket'].includes(slug)) {
    return `${prefix}Match dynamics, player form, and pitch conditions play a pivotal role. Stay tuned to our verified editorial feed for live updates, scores, and fixture telemetry.`;
  }
  return `${prefix}Tracking real-time developments across primary curated sources ensures you have the most accurate, unfiltered perspective. Keep this briefing bookmarked for continuous verification.`;
}

// Multi-gradient palettes for deduplicated rank badges
const rankGradients = [
  'from-rose-500 to-amber-500',
  'from-purple-600 to-indigo-600',
  'from-blue-600 to-cyan-500',
  'from-emerald-500 to-teal-500',
  'from-fuchsia-600 to-pink-500',
  'from-amber-500 to-orange-600'
];

const renderedImages = new Set<string>();
if (post.image_url) renderedImages.add(post.image_url);
if (displayHeroImage) renderedImages.add(displayHeroImage);
---

<Layout
  title={`${post.title} | UniqueDigit`}
  description={post.summary}
  image={absoluteImageUrl}
  canonical={Astro.url.href}
  niche={niche}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-brand via-purple-500 to-emerald-500 z-50 transition-all duration-75 w-0"></div>

  <!-- Mobile Sidebar Overlay (Fixed Position - Outside Grid) -->
  <div
    id="sidebar-panel"
    class="fixed inset-0 z-40 hidden"
    aria-hidden="true"
  >
    <!-- Backdrop Overlay -->
    <div class="sidebar-backdrop absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 invisible transition-all duration-300"></div>
    <!-- Sidebar Panel -->
    <div class="sidebar-panel absolute inset-y-0 right-0 w-full max-w-[360px] bg-white rounded-tl-3xl shadow-2xl flex flex-col overflow-y-auto transform translate-x-full transition-transform duration-300 ease-out lg:translate-x-0 lg:static lg:shadow-none lg:rounded-none lg:bg-transparent">
      <!-- Sidebar Close Button (Mobile Only) -->
      <button
        id="sidebar-close-btn"
        type="button"
        class="lg:hidden absolute top-4 right-4 z-50 w-10 h-10 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center shadow-lg active:scale-95 transition"
        aria-label="Close sidebar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <!-- Mobile Sidebar Content -->
      <div class="flex-1 p-4 sm:p-6 overflow-y-auto">

        <!-- 1. Trending Stories in India (Top 5 Ranking with Thumbnails) -->
        <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6 mb-6">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">
                Trending in India
              </h3>
            </div>
            <a href="/trending" class="text-xs font-bold text-brand hover:underline">
              Radar &rarr;
            </a>
          </div>

          <div class="flex flex-col gap-3.5">
            {sidebarTrending.map((tr, idx) => {
              const trThumb = proxyImageUrl(tr.image_url, (tr as any).niches?.slug, tr.slug);

              return (
                <a
                  href={(tr as any).niches ? `/${(tr as any).niches.slug}/${tr.slug}` : `/${tr.slug}`}
                  class="group flex items-center gap-3.5 p-2 rounded-2xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100"
                >
                  <div class="relative w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-slate-900 border border-slate-200">
                    <img
                      src={trThumb}
                      alt={tr.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    />
                    <div class="absolute bottom-0 left-0 right-0 bg-black/70 backdrop-blur-xs text-[10px] font-black text-white text-center py-0.5 font-mono">
                      #{idx + 1}
                    </div>
                  </div>

                  <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-bold text-slate-900 line-clamp-2 leading-snug group-hover:text-brand transition">
                      {tr.title}
                    </h4>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-xs font-mono text-emerald-600 font-bold">
                        🔥 {tr.hype || 80} velocity
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <!-- 2. More In This Category (with Thumbnails) -->
        {sidebarRelated.length > 0 && (
          <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6 mb-6">
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">
                More in {niche.name}
              </h3>
              <a href={`/${niche.slug}`} class="text-xs font-bold text-brand hover:underline">
                View All &rarr;
              </a>
            </div>

            <div class="flex flex-col gap-3">
              {sidebarRelated.map((item) => {
                const itemThumb = proxyImageUrl(item.image_url, niche.slug, item.slug);

                return (
                  <a
                    href={`/${niche.slug}/${item.slug}`}
                    class="group flex items-center gap-3.5 p-2 rounded-2xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100"
                  >
                    <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0 bg-slate-900 border border-slate-200">
                      <img
                        src={itemThumb}
                        alt={item.title}
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                      />
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-bold text-slate-900 line-clamp-2 leading-snug group-hover:text-brand transition mb-1">
                        {item.title}
                      </h4>
                      <span class="text-xs text-slate-400 font-mono">
                        {new Date(item.published_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' })}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- 3. Handpicked Deals & Gear Widget -->
        {products.length > 0 && (
          <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6 mb-6">
            <div class="flex items-center gap-2 pb-3 mb-4 border-b border-slate-100">
              <span class="text-sm">🏷️</span>
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">
                Top Deals in {niche.name}
              </h3>
            </div>

            <div class="flex flex-col gap-3">
              {products.slice(0, 3).map(prod => (
                <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
                  <div class="flex items-center justify-between gap-2 mb-1.5">
                    <span class="text-xs font-bold text-slate-900 line-clamp-1">{prod.name}</span>
                    {typeof prod.price === 'number' && prod.price > 0 ? (
                      <span class="text-xs font-black text-emerald-600 font-mono">₹{prod.price.toLocaleString('en-IN')}</span>
                    ) : null}
                  </div>
                  <a
                    href={prod.aff_url || `https://www.amazon.in/s?k=${encodeURIComponent(prod.name)}&tag=uniquedigi0c6-21`}
                    target="_blank"
                    rel="nofollow noopener"
                    class="mt-2 text-center text-xs font-black uppercase py-2 px-3 rounded-xl bg-amber-400 text-slate-950 hover:bg-amber-500 transition shadow-xs block"
                  >
                    Check Deal On Amazon &rarr;
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- 4. Telegram / WhatsApp VIP Alert CTA -->
        <div class="rounded-3xl bg-gradient-to-br from-brand-dark via-brand to-purple-800 text-white p-6 shadow-sm mb-6">
          <span class="px-2.5 py-1 rounded-full text-xs font-black uppercase bg-amber-400 text-slate-950 inline-block mb-3">
            Real-Time Radar
          </span>
          <h4 class="font-black text-base mb-2">Never Miss a Trend or Loot Deal</h4>
          <p class="text-xs text-purple-100 leading-relaxed mb-4">
            Instant updates on breaking sports, tech benchmarks, gold rates, and price-drop alerts.
          </p>
          <a
            href="https://t.me/uniquedigit"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center py-2 px-4 rounded-xl bg-white text-brand font-black text-xs hover:bg-slate-100 transition shadow-xs"
          >
            Join Telegram Alert Channel
          </a>
        </div>

        <AdSlot position="sidebar" />

      </div>
    </div>
  </div>

  <Fragment slot="head">
    {isCard && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- Main Editorial Container (2-Column Grid) -->
  <div class="w-full">
    
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-muted mb-4 sm:mb-6 px-1 overflow-x-auto no-scrollbar whitespace-nowrap">
      <a href="/" class="hover:text-brand transition font-medium">Home</a>
      <span>/</span>
      <a href={`/${niche.slug}`} class="hover:text-brand transition font-medium">{niche.name}</a>
      <span>/</span>
      <span class="text-ink truncate max-w-sm font-semibold">{post.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN (8 cols): Main Newsroom Article Card -->
      <article class="lg:col-span-8 bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-sm p-4 sm:p-8 lg:p-10 min-w-0">
        
        <!-- Header Area -->
        <header class="mb-8 sm:mb-12">
          <div class="flex items-center gap-2.5 mb-5 flex-wrap">
            <a
              href={`/${niche.slug}`}
              class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-black uppercase tracking-wider bg-brand text-white shadow-xs hover:bg-brand-dark transition"
            >
              {niche.name}
            </a>
            <span class="px-3 py-1 rounded-full text-xs sm:text-sm font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200">
              ⏱️ {readTime} min read
            </span>
            <HypeMeter score={calculatedHype} size="sm" />
            <FreshnessStamp updatedAt={post.updated_at || post.published_at} />
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black text-slate-900 leading-[1.1] tracking-tight mb-5 sm:mb-6">
            {post.title}
          </h1>

          <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8 font-medium max-w-3xl">
            {post.summary}
          </p>

          <!-- Byline & Social Actions -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between py-5 border-y border-slate-100 text-sm text-slate-500 flex-wrap gap-4">
