---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCard from '../../components/ToolCard.astro';
import AmazonDealBox from '../../components/AmazonDealBox.astro';
import DealPoll from '../../components/DealPoll.astro';
import NicheCard from '../../components/NicheCard.astro';
import DisclaimerBar from '../../components/DisclaimerBar.astro';
import Icon from '../../components/Icon.astro';
import HypeMeter from '../../components/HypeMeter.astro';
import FreshnessStamp from '../../components/FreshnessStamp.astro';
import DealRadarCard from '../../components/DealRadarCard.astro';
import { getPost, getPostsByNiche, getProductsByNiche, getNicheBySlug } from '../../lib/db';
import { marked } from 'marked';

const { niche: nicheSlug, post: postSlug } = Astro.params;
if (!nicheSlug || !postSlug) {
  return Astro.redirect('/404');
}

const runtime = (Astro.locals as any)?.runtime;
const niche = await getNicheBySlug(nicheSlug, runtime?.env);
const post = await getPost(nicheSlug, postSlug, runtime?.env);

if (!post || !niche) {
  return Astro.redirect('/404');
}

const [relatedPosts, products] = await Promise.all([
  getPostsByNiche(niche.id, 4, runtime?.env),
  getProductsByNiche(niche.id, runtime?.env)
]);

const cleanRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 3);

function sanitizeMarkdownHtml(html: string): string {
  return html
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/\son\w+="[^"]*"/gi, '')
    .replace(/\son\w+='[^']*'/gi, '')
    .replace(/href=["']javascript:[^"']*["']/gi, 'href="#"');
}

// Normalize literal escaped newlines and markdown characters from database / API
const normalizedMarkdown = (post.body_md || '')
  .replace(/\\r\\n/g, '\n')
  .replace(/\\n/g, '\n')
  .replace(/\\t/g, '  ');

const rawBodyHtml = normalizedMarkdown ? (marked.parse(normalizedMarkdown) as string) : '';
const bodyHtml = typeof rawBodyHtml === 'string' ? sanitizeMarkdownHtml(rawBodyHtml) : '';
const isCard = post.kind === 'card' || !post.indexable;

// Estimated reading time
const wordCount = (post.body_md || post.summary || '').split(/\s+/).length;
const readTime = Math.max(2, Math.ceil(wordCount / 180));

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=10, must-revalidate');

const absoluteImageUrl = post.image_url?.startsWith('http') 
  ? post.image_url 
  : `${Astro.url.origin}${post.image_url || '/images/gta6_cover.jpg'}`;

// 1. Article / NewsArticle Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isCard ? 'NewsArticle' : 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href
  },
  headline: post.title,
  description: post.summary,
  image: [absoluteImageUrl],
  datePublished: post.published_at,
  dateModified: post.updated_at || post.published_at,
  author: {
    '@type': 'Organization',
    name: 'UniqueDigit Editorial Desk',
    url: `${Astro.url.origin}/about`
  },
  publisher: {
    '@type': 'Organization',
    name: 'UniqueDigit',
    url: Astro.url.origin,
    logo: {
      '@type': 'ImageObject',
      url: `${Astro.url.origin}/favicon.svg`
    }
  }
};

// 2. BreadcrumbList Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.url.origin
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: niche.name,
      item: `${Astro.url.origin}/${niche.slug}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.title,
      item: Astro.url.href
    }
  ]
};

// 3. FAQPage Schema for Google Rich Accordions
const faqSchema = post.faq && post.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
} : null;
---

<Layout
  title={`${post.title} | UniqueDigit`}
  description={post.summary}
  image={absoluteImageUrl}
  canonical={Astro.url.href}
  niche={niche}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-[3.5px] bg-gradient-to-r from-brand via-purple-500 to-cta z-50 transition-all duration-75 w-0"></div>

  <Fragment slot="head">
    {isCard && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="max-w-4xl mx-auto flex items-center gap-2 text-xs text-muted mb-6 pt-4 px-2 overflow-x-auto no-scrollbar whitespace-nowrap">
    <a href="/" class="hover:text-brand transition font-medium">Home</a>
    <span>/</span>
    <a href={`/${niche.slug}`} class="hover:text-brand transition font-medium">{niche.name}</a>
    <span>/</span>
    <span class="text-ink truncate max-w-xs">{post.title}</span>
  </nav>

  <article class="max-w-4xl mx-auto bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-10 lg:p-12 mb-12">
    <!-- Header Area -->
    <header class="mb-8">
      <div class="flex items-center gap-2.5 mb-4 flex-wrap">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand text-white shadow-xs">
          {niche.name}
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200">
          ⏱️ {readTime} min read
        </span>
        <HypeMeter score={post.hype || post.trend_score || 75} size="sm" />
        <FreshnessStamp updatedAt={post.updated_at || post.published_at} />
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 leading-tight tracking-tight mb-4">
        {post.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6 font-medium">
        {post.summary}
      </p>

      <div class="flex items-center justify-between py-4 border-y border-slate-100 text-xs text-slate-500 flex-wrap gap-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-brand text-white font-bold flex items-center justify-center text-xs shadow-xs">
            UD
          </div>
          <div>
            <span class="font-bold text-slate-900 block">UniqueDigit Editorial Desk</span>
            <span class="text-[11px] text-slate-500">
              Verified {new Date(post.published_at).toLocaleDateString('en-IN', { month: 'long', day: 'numeric', year: 'numeric' })}
            </span>
          </div>
        </div>

        <!-- Social Share Pills -->
        <div class="flex items-center gap-2">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title}\nRead more: ${Astro.url.href}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold hover:bg-emerald-100 transition active:scale-95"
            title="Share on WhatsApp"
          >
            <span>💬 WhatsApp</span>
          </a>
          <button
            id="copy-article-link-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition active:scale-95 cursor-pointer"
            title="Copy article link"
          >
            <span id="copy-btn-text">🔗 Copy Link</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Hero Image & Attribution (Standard 16:9 Aspect Ratio) -->
    <div class="rounded-2xl overflow-hidden mb-8 border border-slate-200/80 bg-slate-100 shadow-sm relative">
      <div class="aspect-video sm:aspect-[16/9] w-full overflow-hidden">
        <img
          src={post.image_url || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80'}
          alt={post.title}
          loading="eager"
          class="w-full h-full object-cover"
        />
      </div>
      {post.image_credit && (
        <div class="px-4 py-2 bg-slate-900/85 text-[11px] text-slate-300 flex items-center justify-between">
          <span>Source: {post.image_credit}</span>
          {post.source_url && (
            <a href={post.source_url} target="_blank" rel="nofollow noopener" class="text-cta hover:underline">
              Verify Original Source →
            </a>
          )}
        </div>
      )}
    </div>

    <!-- Health / Sensitive Disclaimer -->
    {niche.config?.disclaimer && (
      <div class="mb-8">
        <DisclaimerBar text={niche.config.disclaimer} type={niche.slug === 'health' ? 'health' : 'general'} />
      </div>
    )}

    <!-- Article Markdown Content -->
    <div class="prose max-w-none text-slate-800 leading-relaxed mb-10" set:html={bodyHtml} />

    <!-- Verified Independent Sources -->
    {post.sources && post.sources.length > 0 && (
      <div class="my-8 p-5 rounded-2xl bg-slate-50 border border-slate-200 text-xs shadow-2xs">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-sm">📰</span>
          <span class="font-bold text-slate-900 uppercase tracking-wider text-[11px]">Verified Source References</span>
        </div>
        <ul class="flex flex-col gap-2">
          {post.sources.map(s => (
            <li class="flex items-center gap-2 text-slate-600">
              <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
              <a href={s.url} target="_blank" rel="nofollow noopener noreferrer" class="hover:text-brand transition underline truncate font-medium">
                {s.title}
              </a>
              {s.publisher && <span class="text-[10px] text-muted font-mono">({s.publisher})</span>}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- High-Converting Amazon Affiliate Recommendation & Live Deal Widget -->
    <AmazonDealBox keyword={post.title} nicheSlug={niche.slug} nicheName={niche.name} />

    <!-- Product Recommendations if in Tools/PC/Deals Niche -->
    {products.length > 0 && (
      <div class="my-12 p-6 sm:p-8 rounded-3xl bg-slate-50 border border-line">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-cta"></span>
          <h3 class="text-lg font-black text-ink tracking-tight">Verified Gear & Tools in {niche.name}</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {products.slice(0, 2).map(pr => (
            <ToolCard product={pr} />
          ))}
        </div>
      </div>
    )}

    <!-- FAQ Accordion -->
    {post.faq && post.faq.length > 0 && (
      <div class="my-12 pt-8 border-t border-line">
        <h3 class="text-xl font-black text-ink mb-6">Frequently Asked Questions</h3>
        <div class="flex flex-col gap-4">
          {post.faq.map(item => (
            <div class="p-5 rounded-2xl bg-white border border-line shadow-card">
              <h4 class="font-bold text-sm sm:text-base text-ink mb-2 flex items-start gap-2">
                <span class="text-brand font-black">Q:</span>
                <span>{item.q}</span>
              </h4>
              <p class="text-xs sm:text-sm text-muted leading-relaxed pl-5">
                {item.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Interactive Community Feedback & Dwell Time Poll -->
    <DealPoll topicTitle={post.title} nicheSlug={niche.slug} />

    <AdSlot position="mid" />

    <!-- Related Articles -->
    {cleanRelated.length > 0 && (
      <div class="my-12 pt-8 border-t border-line">
        <h3 class="text-xl font-black text-ink mb-6">Related {niche.name} Guides</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {cleanRelated.map(p => (
            <NicheCard post={p} niche={niche} />
          ))}
        </div>
      </div>
    )}

    <!-- Mandatory Affiliate Disclosure Strip -->
    <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 text-amber-900 text-xs mt-8">
      <strong>Transparency Note:</strong> UniqueDigit publishes independent research and benchmark analysis. When you purchase via outbound links on this page, we may earn an affiliate commission at zero additional cost to you.
    </div>
  </article>

  <script>
    (function() {
      // 1. Reading Progress Bar
      const progressBar = document.getElementById('reading-progress-bar');
      function updateProgress() {
        if (!progressBar) return;
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight <= 0) {
          progressBar.style.width = '0%';
          return;
        }
        const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
        progressBar.style.width = `${progress}%`;
      }
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      // 2. Copy Link Button Feedback
      const copyBtn = document.getElementById('copy-article-link-btn');
      const copyText = document.getElementById('copy-btn-text');
      if (copyBtn && copyText) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyText.textContent = '✅ Copied!';
            setTimeout(() => {
              copyText.textContent = '🔗 Copy Link';
            }, 2000);
          } catch {
            copyText.textContent = 'Link Copied';
          }
        });
      }
    })();
  </script>
</Layout>
