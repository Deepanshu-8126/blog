---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCard from '../../components/ToolCard.astro';
import AmazonDealBox from '../../components/AmazonDealBox.astro';
import NicheCard from '../../components/NicheCard.astro';
import DisclaimerBar from '../../components/DisclaimerBar.astro';
import Icon from '../../components/Icon.astro';
import { getPost, getPostsByNiche, getProductsByNiche, getNicheBySlug } from '../../lib/db';
import { marked } from 'marked';

const { niche: nicheSlug, post: postSlug } = Astro.params;
if (!nicheSlug || !postSlug) {
  return Astro.redirect('/404');
}

const niche = await getNicheBySlug(nicheSlug);
const post = await getPost(nicheSlug, postSlug);

if (!post || !niche) {
  return Astro.redirect('/404');
}

const [relatedPosts, products] = await Promise.all([
  getPostsByNiche(niche.id, 4),
  getProductsByNiche(niche.id)
]);

const cleanRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 3);
const bodyHtml = post.body_md ? marked.parse(post.body_md) : '';

// JSON-LD structured data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.summary,
  image: post.image_url ? [post.image_url] : [],
  datePublished: post.published_at,
  dateModified: post.published_at,
  author: {
    '@type': 'Organization',
    name: 'UniqueDigit Editorial Desk',
    url: 'https://uniquedigit.in'
  },
  publisher: {
    '@type': 'Organization',
    name: 'UniqueDigit',
    logo: {
      '@type': 'ImageObject',
      url: 'https://uniquedigit.in/favicon.svg'
    }
  }
};
---

<Layout
  title={`${post.title} | UniqueDigit`}
  description={post.summary}
  image={post.image_url}
  niche={niche}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-muted mb-6">
    <a href="/" class="hover:text-brand transition">Home</a>
    <span>/</span>
    <a href={`/${niche.slug}`} class="hover:text-brand transition font-medium">{niche.name}</a>
    <span>/</span>
    <span class="text-ink truncate max-w-xs">{post.title}</span>
  </nav>

  <article class="max-w-4xl mx-auto">
    <!-- Header Area -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand text-white shadow-xs">
          {niche.name}
        </span>
        {post.trend_score > 0 && (
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-cta text-cta-ink font-mono shadow-xs">
            🔥 +{post.trend_score}k Trend
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl font-black text-ink leading-tight tracking-tight mb-4">
        {post.title}
      </h1>

      <p class="text-base sm:text-lg text-muted leading-relaxed mb-6 font-medium">
        {post.summary}
      </p>

      <div class="flex items-center justify-between py-4 border-y border-line text-xs text-muted">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-brand text-white font-bold flex items-center justify-center text-xs">
            UD
          </div>
          <div>
            <span class="font-bold text-ink block">UniqueDigit Editorial Team</span>
            <span class="text-[11px]">{new Date(post.published_at).toLocaleDateString('en-IN', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <span class="bg-slate-100 px-2.5 py-1 rounded-lg text-slate-700 font-bold">4 Min Read</span>
          {post.views ? <span>{post.views.toLocaleString()} reads</span> : null}
        </div>
      </div>
    </header>

    <!-- Hero Image & Attribution -->
    <div class="rounded-3xl overflow-hidden mb-8 border border-line bg-slate-900 shadow-soft">
      <img
        src={post.image_url || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80'}
        alt={post.title}
        loading="eager"
        class="w-full max-h-[480px] object-cover"
      />
      {post.image_credit && (
        <div class="px-4 py-2 bg-slate-950/80 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Image Source: {post.image_credit}</span>
          {post.source_url && (
            <a href={post.source_url} target="_blank" rel="nofollow noopener" class="text-cta hover:underline">
              Verify Original Source →
            </a>
          )}
        </div>
      )}
    </div>

    <!-- Health / Sensitive Disclaimer -->
    {niche.config?.disclaimer && (
      <DisclaimerBar text={niche.config.disclaimer} type={niche.slug === 'health' ? 'health' : 'general'} />
    )}

    <!-- Quick Value Proposition / Why You Are Here -->
    <div class="my-6 p-5 sm:p-6 rounded-2xl bg-brand/5 border border-brand/20 flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center shrink-0 font-bold text-lg">
        💡
      </div>
      <div>
        <h3 class="text-sm font-black text-ink uppercase tracking-wider mb-1">Editor's Quick Verdict & Reader Guide</h3>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">
          Our editorial team evaluated current market specifications, user feedback, and price-to-performance metrics. Below you will find the complete breakdown along with direct verified retail options and today's live discount offers.
        </p>
      </div>
    </div>

    <AdSlot position="top" />

    <!-- Article Markdown Content -->
    <div class="prose max-w-none text-ink text-base sm:text-lg leading-relaxed mb-12" set:html={bodyHtml} />

    <!-- High-Converting Amazon Affiliate Recommendation & Live Deal Widget -->
    <AmazonDealBox keyword={post.title} nicheSlug={niche.slug} nicheName={niche.name} />

    <!-- Product Recommendations if in Tools/PC/Deals Niche -->
    {products.length > 0 && (
      <div class="my-12 p-6 sm:p-8 rounded-3xl bg-slate-50 border border-line">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-cta"></span>
          <h3 class="text-lg font-black text-ink tracking-tight">Verified Gear & Tools in {niche.name}</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {products.slice(0, 2).map(pr => (
            <ToolCard product={pr} />
          ))}
        </div>
      </div>
    )}

    <!-- FAQ Accordion -->
    {post.faq && post.faq.length > 0 && (
      <div class="my-12 pt-8 border-t border-line">
        <h3 class="text-xl font-black text-ink mb-6">Frequently Asked Questions</h3>
        <div class="flex flex-col gap-4">
          {post.faq.map(item => (
            <div class="p-5 rounded-2xl bg-white border border-line shadow-card">
              <h4 class="font-bold text-sm sm:text-base text-ink mb-2 flex items-start gap-2">
                <span class="text-brand font-black">Q:</span>
                <span>{item.q}</span>
              </h4>
              <p class="text-xs sm:text-sm text-muted leading-relaxed pl-5">
                {item.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <AdSlot position="mid" />

    <!-- Related Articles -->
    {cleanRelated.length > 0 && (
      <div class="my-12 pt-8 border-t border-line">
        <h3 class="text-xl font-black text-ink mb-6">Related {niche.name} Guides</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {cleanRelated.map(p => (
            <NicheCard post={p} niche={niche} />
          ))}
        </div>
      </div>
    )}

    <!-- Mandatory Affiliate Disclosure Strip -->
    <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 text-amber-900 text-xs mt-8">
      <strong>Transparency Note:</strong> UniqueDigit publishes independent research and benchmark analysis. When you purchase via outbound links on this page, we may earn an affiliate commission at zero additional cost to you.
    </div>
  </article>
</Layout>
