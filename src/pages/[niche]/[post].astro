      <aside
        id="sidebar-panel-desktop"
        class="lg:col-span-4 flex flex-col gap-6 lg:sticky lg:top-24 hidden lg:block"
      >
        
        <!-- 1. Trending Stories in India (Top 5 Ranking with Thumbnails) -->
        <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">
                Trending in India
              </h3>
            </div>
            <a href="/trending" class="text-xs font-bold text-brand hover:underline">
              Radar &rarr;
            </a>
          </div>

          <div class="flex flex-col gap-3.5">
            {sidebarTrending.map((tr, idx) => {
              const trThumb = proxyImageUrl(tr.image_url, (tr as any).niches?.slug, tr.slug);

              return (
                <a
                  href={(tr as any).niches ? `/${(tr as any).niches.slug}/${tr.slug}` : `/${tr.slug}`}
                  class="group flex items-center gap-3.5 p-2 rounded-2xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100"
                >
                  <div class="relative w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-slate-900 border border-slate-200">
                    <img
                      src={trThumb}
                      alt={tr.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    />
                    <div class="absolute bottom-0 left-0 right-0 bg-black/70 backdrop-blur-xs text-[10px] font-black text-white text-center py-0.5 font-mono">
                      #{idx + 1}
                    </div>
                  </div>

                  <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-bold text-slate-900 line-clamp-2 leading-snug group-hover:text-brand transition">
                      {tr.title}
                    </h4>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-xs font-mono text-emerald-600 font-bold">
                        🔥 {tr.hype || 80} velocity
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <!-- 2. More In This Category (with Thumbnails) -->
        {sidebarRelated.length > 0 && (
          <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6">
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">
                More in {niche.name}
              </h3>
              <a href={`/${niche.slug}`} class="text-xs font-bold text-brand hover:underline">
                View All &rarr;
              </a>
            </div>

            <div class="flex flex-col gap-3">
              {sidebarRelated.map((item) => {
                const itemThumb = proxyImageUrl(item.image_url, niche.slug, item.slug);

                return (
                  <a
                    href={`/${niche.slug}/${item.slug}`}
                    class="group flex items-center gap-3.5 p-2 rounded-2xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100"
                  >
                    <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0 bg-slate-900 border border-slate-200">
                      <img
                        src={itemThumb}
                        alt={item.title}
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                      />
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-bold text-slate-900 line-clamp-2 leading-snug group-hover:text-brand transition mb-1">
                        {item.title}
                      </h4>
                      <span class="text-xs text-slate-400 font-mono">
                        {new Date(item.published_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' })}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- 3. Handpicked Deals & Gear Widget -->
        {products.length > 0 && (
          <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6">
            <div class="flex items-center gap-2 pb-3 mb-4 border-b border-slate-100">
              <span class="text-sm">🏷️</span>
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">
                Top Deals in {niche.name}
              </h3>
            </div>

            <div class="flex flex-col gap-3">
              {products.slice(0, 3).map(prod => (
                <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
                  <div class="flex items-center justify-between gap-2 mb-1.5">
                    <span class="text-xs font-bold text-slate-900 line-clamp-1">{prod.name}</span>
                    {typeof prod.price === 'number' && prod.price > 0 ? (
                      <span class="text-xs font-black text-emerald-600 font-mono">₹{prod.price.toLocaleString('en-IN')}</span>
                    ) : null}
                  </div>
                  <a
                    href={prod.aff_url || `https://www.amazon.in/s?k=${encodeURIComponent(prod.name)}&tag=uniquedigi0c6-21`}
                    target="_blank"
                    rel="nofollow noopener"
                    class="mt-2 text-center text-xs font-black uppercase py-2 px-3 rounded-xl bg-amber-400 text-slate-950 hover:bg-amber-500 transition shadow-xs block"
                  >
                    Check Deal On Amazon &rarr;
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- 4. Telegram / WhatsApp VIP Alert CTA -->
        <div class="rounded-3xl bg-gradient-to-br from-brand-dark via-brand to-purple-800 text-white p-6 shadow-sm">
          <span class="px-2.5 py-1 rounded-full text-xs font-black uppercase bg-amber-400 text-slate-950 inline-block mb-3">
            Real-Time Radar
          </span>
          <h4 class="font-black text-base mb-2">Never Miss a Trend or Loot Deal</h4>
          <p class="text-xs text-purple-100 leading-relaxed mb-4">
            Instant updates on breaking sports, tech benchmarks, gold rates, and price-drop alerts.
          </p>
          <a
            href="https://t.me/uniquedigit"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center py-2 px-4 rounded-xl bg-white text-brand font-black text-xs hover:bg-slate-100 transition shadow-xs"
          >
            Join Telegram Alert Channel
          </a>
        </div>

        <AdSlot position="sidebar" />
      </aside>

    </div>
  </div>

  <!-- Floating Back to Top Button (Floats cleanly above sidebar toggle) -->
  <button
    id="back-to-top-btn"
    type="button"
    aria-label="Back to top"
    class="fixed bottom-36 right-5 lg:bottom-24 lg:right-6 z-30 w-11 h-11 rounded-full bg-slate-900/80 hover:bg-brand text-white flex items-center justify-center shadow-lg backdrop-blur-md border border-white/20 opacity-0 pointer-events-none transition-all duration-300 cursor-pointer active:scale-90"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7-7"/></svg>
  </button>

  <script define:vars={{ slidesData: gallerySlides }}>
    (function() {
      // 1. Reading Progress Bar
      try {
        const progressBar = document.getElementById('reading-progress-bar');
        function updateProgress() {
          if (!progressBar) return;
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (totalHeight <= 0) {
            progressBar.style.width = '0%';
            return;
          }
          const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
          progressBar.style.width = `${progress}%`;
        }
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      } catch (err) {
        console.warn('[Progress Bar Init Error]:', err);
      }

      // 2. Multi-Image Carousel Engine
      try {
        const track = document.getElementById('gallery-track');
        const prevBtn = document.getElementById('gallery-prev-btn');
        const nextBtn = document.getElementById('gallery-next-btn');
        const counterBadge = document.getElementById('gallery-counter-badge');
        const captionText = document.getElementById('gallery-caption-text');
        const tabBtns = document.querySelectorAll('.gallery-tab-btn');
        const totalSlides = slidesData ? slidesData.length : 3;
        let currentIndex = 0;

        function goToSlide(index) {
          if (!track) return;
          if (index < 0) index = totalSlides - 1;
          if (index >= totalSlides) index = 0;
          currentIndex = index;

          track.style.transform = `translateX(-${currentIndex * 100}%)`;

          if (counterBadge) {
            counterBadge.textContent = `Photo ${currentIndex + 1} of ${totalSlides}`;
          }

          if (captionText && slidesData && slidesData[currentIndex]) {
            captionText.textContent = slidesData[currentIndex].caption;
          }

          tabBtns.forEach((btn, idx) => {
            if (idx === currentIndex) {
              btn.className = 'gallery-tab-btn flex items-center gap-2 p-2.5 rounded-2xl border transition text-left cursor-pointer bg-purple-50/90 border-brand text-brand ring-2 ring-brand/20 font-bold';
            } else {
              btn.className = 'gallery-tab-btn flex items-center gap-2 p-2.5 rounded-2xl border transition text-left cursor-pointer bg-white border-slate-200 text-slate-700 hover:bg-slate-50 hover:border-slate-300';
            }
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));
        }

        tabBtns.forEach((btn, idx) => {
          btn.addEventListener('click', () => goToSlide(idx));
        });

        let touchStartX = 0;
        let touchEndX = 0;
        if (track) {
          track.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });
          track.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            if (touchStartX - touchEndX > 45) {
              goToSlide(currentIndex + 1);
            } else if (touchEndX - touchStartX > 45) {
              goToSlide(currentIndex - 1);
            }
          }, { passive: true });
        }
      } catch (err) {
        console.warn('[Gallery Init Error]:', err);
      }

      // 3. Smooth Jump for Table of Contents
      try {
        const tocPills = document.querySelectorAll('.toc-jump-pill');
        tocPills.forEach(pill => {
          pill.addEventListener('click', (e) => {
            const targetId = pill.getAttribute('href');
            if (targetId && targetId.startsWith('#')) {
              const targetEl = document.querySelector(targetId);
              if (targetEl) {
                e.preventDefault();
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          });
        });
      } catch (err) {
        console.warn('[TOC Init Error]:', err);
      }

      // 4. Copy Link Button Feedback
      try {
        const copyBtn = document.getElementById('copy-article-link-btn');
        const copyText = document.getElementById('copy-btn-text');
        if (copyBtn && copyText) {
          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(window.location.href);
              copyText.textContent = '✅ Copied!';
              setTimeout(() => {
                copyText.textContent = '🔗 Copy Link';
              }, 2000);
            } catch {
              copyText.textContent = 'Link Copied';
            }
          });
        }
      } catch (err) {
        console.warn('[Copy Link Init Error]:', err);
      }

      // 5. Mobile Sidebar Toggle
      try {
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebarPanel = document.getElementById('sidebar-panel');
        const sidebarBackdrop = sidebarPanel?.querySelector('.sidebar-backdrop');
        const sidebarInner = sidebarPanel?.querySelector('.sidebar-panel');
        const sidebarCloseBtn = document.getElementById('sidebar-close-btn');
        if (sidebarToggle && sidebarPanel && sidebarBackdrop && sidebarInner) {
          function openSidebar() {
            sidebarPanel.classList.remove('hidden');
            sidebarBackdrop.offsetHeight;
            sidebarBackdrop.classList.remove('opacity-0', 'invisible');
            sidebarBackdrop.classList.add('opacity-100', 'visible');
            sidebarInner.classList.remove('translate-x-full');
            sidebarToggle.setAttribute('aria-expanded', 'true');
            sidebarToggle.innerHTML = '<svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
          }
          function closeSidebar() {
            sidebarBackdrop.classList.add('opacity-0', 'invisible');
            sidebarBackdrop.classList.remove('opacity-100', 'visible');
            sidebarInner.classList.add('translate-x-full');
            sidebarToggle.setAttribute('aria-expanded', 'false');
            sidebarToggle.innerHTML = '<svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>';
            setTimeout(() => {
              if (sidebarInner.classList.contains('translate-x-full')) {
                sidebarPanel.classList.add('hidden');
              }
            }, 300);
          }
          sidebarToggle.addEventListener('click', () => {
            if (sidebarInner.classList.contains('translate-x-full')) {
              openSidebar();
            } else {
              closeSidebar();
            }
          });
          if (sidebarCloseBtn) {
            sidebarCloseBtn.addEventListener('click', closeSidebar);
          }
          sidebarBackdrop.addEventListener('click', closeSidebar);
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !sidebarInner.classList.contains('translate-x-full')) {
              closeSidebar();
            }
          });
        }
      } catch (err) {
        console.warn('[Sidebar Toggle Init Error]:', err);
      }

      // 6. Floating Back to Top Button
      try {
        const backToTopBtn = document.getElementById('back-to-top-btn');
        if (backToTopBtn) {
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400) {
              backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
              backToTopBtn.classList.add('opacity-100', 'pointer-events-auto');
            } else {
              backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
              backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto');
            }
          }, { passive: true });
          backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      } catch (err) {
        console.warn('[Back to Top Init Error]:', err);
      }
    })();
  </script>
</Layout>
