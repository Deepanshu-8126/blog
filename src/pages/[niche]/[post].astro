---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCard from '../../components/ToolCard.astro';
import AmazonDealBox from '../../components/AmazonDealBox.astro';
import DealPoll from '../../components/DealPoll.astro';
import NicheCard from '../../components/NicheCard.astro';
import DisclaimerBar from '../../components/DisclaimerBar.astro';
import Icon from '../../components/Icon.astro';
import HypeMeter from '../../components/HypeMeter.astro';
import FreshnessStamp from '../../components/FreshnessStamp.astro';
import HealthDisclaimer from '../../components/HealthDisclaimer.astro';
import BoxOfficeTable from '../../components/BoxOfficeTable.astro';
import DealPriceStack from '../../components/DealPriceStack.astro';
import TldrBox from '../../components/TldrBox.astro';
import SarkariDirectBox from '../../components/SarkariDirectBox.astro';
import CurrentAffairsQuizHook from '../../components/CurrentAffairsQuizHook.astro';
import ComicLoreBox from '../../components/ComicLoreBox.astro';
import ComicStripViewer, { type ComicPanel } from '../../components/ComicStripViewer.astro';
import { getPost, getPostsByNiche, getProductsByNiche, getNicheBySlug, getTrendingPosts, getAllProducts } from '../../lib/db';
import { marked } from 'marked';

const { niche: nicheSlug, post: postSlug } = Astro.params;
if (!nicheSlug || !postSlug) {
  return Astro.redirect('/404');
}

const runtime = (Astro.locals as any)?.runtime;
const niche = await getNicheBySlug(nicheSlug, runtime?.env);
const post = await getPost(nicheSlug, postSlug, runtime?.env);

if (!post || !niche) {
  return Astro.redirect('/404');
}

const [relatedPosts, rawProducts, trendingPosts] = await Promise.all([
  getPostsByNiche(niche.id, 6, runtime?.env),
  getProductsByNiche(niche.id, runtime?.env),
  getTrendingPosts(6, runtime?.env)
]);

let products = rawProducts;
if (products.length === 0) {
  const allProds = await getAllProducts(runtime?.env);
  products = allProds.slice(0, 4);
}

const cleanRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 3);
const sidebarRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 4);
const sidebarTrending = trendingPosts.filter(p => p.slug !== post.slug).slice(0, 5);

function sanitizeMarkdownHtml(html: string): string {
  return html
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/\son\w+="[^"]*"/gi, '')
    .replace(/\son\w+='[^']*'/gi, '')
    .replace(/href=["']javascript:[^"']*["']/gi, 'href="#"');
}

function slugifyHeading(text: string): string {
  return text
    .toLowerCase()
    .replace(/<[^>]*>/g, '')
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

// Normalize literal escaped newlines and markdown characters from database / API
const normalizedMarkdown = (post.body_md || '')
  .replace(/\\r\\n/g, '\n')
  .replace(/\\n/g, '\n')
  .replace(/\\t/g, '  ');

// Extract H2 Table of Contents from markdown
const tokens = marked.lexer(normalizedMarkdown);
const tableOfContents = tokens
  .filter((t: any) => t.type === 'heading' && t.depth === 2)
  .map((t: any) => ({
    text: t.text.replace(/[*_`]/g, '').trim(),
    id: slugifyHeading(t.text)
  }));

// Setup marked renderer to inject anchor IDs into headings and custom interactive prompt cards
const headingRenderer = new marked.Renderer();
headingRenderer.heading = ({ text, depth }: { text: string; depth: number }) => {
  const cleanId = slugifyHeading(text);
  return `<h${depth} id="${cleanId}" class="scroll-mt-28 group relative font-black text-slate-900 tracking-tight">${text}<a href="#${cleanId}" class="ml-2 text-slate-300 opacity-0 group-hover:opacity-100 transition no-underline text-base" aria-hidden="true">#</a></h${depth}>\n`;
};

headingRenderer.code = ({ text, lang }: { text: string; lang?: string }) => {
  const rawLang = (lang || '').toLowerCase();
  const isPrompt = rawLang === 'prompt' || text.toLowerCase().includes('you are a') || text.toLowerCase().includes('act as') || text.toLowerCase().includes('write a') || text.toLowerCase().includes('[insert');
  const badgeTitle = isPrompt ? '🤖 Ready-to-Use AI Prompt Template' : (rawLang ? rawLang.toUpperCase() : 'CODE SNIPPET');
  const badgeEmoji = isPrompt ? '✨' : '💻';
  const encodedCode = encodeURIComponent(text);

  return `
<div class="prompt-code-card my-7 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl overflow-hidden group">
  <div class="flex items-center justify-between px-4 py-3 bg-slate-800/90 border-b border-slate-700/70 text-xs backdrop-blur-sm">
    <div class="flex items-center gap-2">
      <span class="text-sm">${badgeEmoji}</span>
      <span class="font-bold font-mono text-emerald-400 tracking-wide text-xs">${badgeTitle}</span>
    </div>
    <button type="button" class="copy-prompt-btn px-3 py-1.5 rounded-xl bg-slate-700/80 hover:bg-brand text-white font-mono font-bold text-xs transition-all flex items-center gap-1.5 shadow-xs active:scale-95 cursor-pointer" data-clipboard="${encodedCode}">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
      <span class="copy-label">Copy Prompt</span>
    </button>
  </div>
  <pre class="p-4 sm:p-5 text-slate-100 font-mono text-xs sm:text-sm leading-relaxed whitespace-pre-wrap select-all overflow-x-auto bg-slate-950/80"><code>${text}</code></pre>
</div>\n`;
};

const rawBodyHtml = normalizedMarkdown ? (marked.parse(normalizedMarkdown, { renderer: headingRenderer }) as string) : '';
const bodyHtml = typeof rawBodyHtml === 'string' ? sanitizeMarkdownHtml(rawBodyHtml) : '';
const isCard = post.kind === 'card' || !post.indexable;

// Extract structured comic strip panels if present
const comicPanels: ComicPanel[] = (() => {
  if (niche.slug !== 'comics') return [];
  const match = (post.body_md || '').match(/```comic-strip\s*([\s\S]*?)\s*```/);
  if (match) {
    try {
      const parsed = JSON.parse(match[1]);
      if (Array.isArray(parsed) && parsed.length > 0) return parsed;
    } catch (e) {
      console.warn('[Comic Panels Parse Note]:', e);
    }
  }
  return [];
})();

// Estimated reading time & stats
const wordCount = (post.body_md || post.summary || '').split(/\s+/).length;
const readTime = Math.max(2, Math.ceil(wordCount / 180));

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=10, must-revalidate');

interface GalleryItem {
  url: string;
  label: string;
  caption: string;
}

import { proxyImageUrl } from '../../lib/images';

// Curated Entity Multi-Image Galleries (Zero Generic Stock Photos)
const ENTITY_SPECIFIC_GALLERIES: Record<string, GalleryItem[]> = {
  'drishyam-3-the-conclusion-box-office-collection-nears-400-crore-worldwide': [
    {
      url: 'https://upload.wikimedia.org/wikipedia/en/d/d9/Drishyam-_The_Conclusion_poster.jpg',
      label: '1. Official Poster',
      caption: 'Drishyam 3: The Conclusion official theatrical release poster.'
    },
    {
      url: 'https://upload.wikimedia.org/wikipedia/commons/9/9d/Ajay_Devgn_at_the_trailer_launch_of_Raid_2.jpg',
      label: '2. Ajay Devgn (Vijay)',
      caption: 'Ajay Devgn as Vijay Salgaonkar leading the gripping conclusion.'
    },
    {
      url: 'https://upload.wikimedia.org/wikipedia/commons/5/5d/Mohanlal_Viswanathan_BNC.jpg',
      label: '3. Mohanlal (Creator)',
      caption: 'Mohanlal, legendary lead of the original Malayalam cult classic universe.'
    }
  ]
};

const displayHeroImage = proxyImageUrl(post.image_url, niche.slug, post.slug);
const absoluteImageUrl = displayHeroImage 
  ? (displayHeroImage.startsWith('http') ? displayHeroImage : `${Astro.url.origin}${displayHeroImage}`)
  : `${Astro.url.origin}/favicon.svg`;

// Clean up any internal scraper or crawler credit strings
const cleanCredit = (credit?: string | null): string => {
  if (!credit) return 'Curated Editorial Photography';
  const c = credit.trim();
  const lower = c.toLowerCase();
  if (lower.includes('radar') || lower.includes('fetcher') || lower.includes('google') || lower.includes('reddit') || lower.includes('search')) {
    return 'Curated Editorial Photography';
  }
  return c;
};

// Build Authentic Gallery: Only show real entity slides, never inject fake stock photos
const rawGallerySlides: GalleryItem[] = ENTITY_SPECIFIC_GALLERIES[post.slug] || (displayHeroImage ? [
  {
    url: displayHeroImage,
    label: '1. Curated Visual',
    caption: post.image_credit ? `Source: ${cleanCredit(post.image_credit)}` : `${post.title} — Curated editorial coverage.`
  }
] : []);

const gallerySlides: GalleryItem[] = rawGallerySlides
  .map(slide => ({
    ...slide,
    url: proxyImageUrl(slide.url) || ''
  }))
  .filter(slide => Boolean(slide.url));

interface NicheAuthorMeta {
  deskName: string;
  authorName: string;
  authorInitials: string;
  role: string;
  bio: string;
  badge: string;
  accentGradient: string;
}

function getNicheAuthorMeta(slug: string): NicheAuthorMeta {
  switch (slug) {
    case 'exams-results':
      return {
        deskName: 'UniqueDigit Sarkari & Career Desk',
        authorName: 'Deepanshu & Sarkari Editorial Team',
        authorInitials: 'SE',
        role: 'Senior Career & Exam Analyst',
        bio: 'Tracks official recruitment notifications, answer keys, scorecards, and board advisories across UPSC, SSC, RPSC, NTA, BTEUP, CBSE, and State Commissions.',
        badge: 'Official Board Verified',
        accentGradient: 'from-emerald-600 via-teal-600 to-indigo-700'
      };
    case 'deals':
    case 'cashback':
      return {
        deskName: 'UniqueDigit Loot & Deals Desk',
        authorName: 'Deepanshu',
        authorInitials: 'LD',
        role: 'Senior Deals & Price Analyst',
        bio: 'Real-time retail price tracking, coupon verification, price drops, and cashback offers across Amazon India, Flipkart, Myntra, and direct brands.',
        badge: 'Price-Drop Verified',
        accentGradient: 'from-amber-500 via-rose-600 to-purple-600'
      };
    case 'gold-rate':
    case 'finance':
      return {
        deskName: 'UniqueDigit Commodities & Markets Desk',
        authorName: 'Deepanshu',
        authorInitials: 'FM',
        role: 'Commodities & Financial Analyst',
        bio: 'Monitors real-time 24K and 22K spot bullion prices, MCX trends, hallmarking updates, and personal finance strategies across top Indian hubs.',
        badge: 'MCX & Bullion Verified',
        accentGradient: 'from-amber-600 via-yellow-500 to-amber-700'
      };
    case 'movies':
    case 'entertainment-celebrity':
      return {
        deskName: 'UniqueDigit Entertainment Desk',
        authorName: 'Deepanshu & Cinema Desk',
        authorInitials: 'ED',
        role: 'Film & OTT Tracking Specialist',
        bio: 'Theatrical box office collections, streaming release dates, certifications, and industry intelligence across Bollywood, South Indian cinema, and Hollywood.',
        badge: 'Box Office Verified',
        accentGradient: 'from-fuchsia-600 via-purple-600 to-indigo-700'
      };
    case 'health':
      return {
        deskName: 'UniqueDigit Health & Wellness Desk',
        authorName: 'UniqueDigit Clinical Editorial Team',
        authorInitials: 'HW',
        role: 'Wellness & Nutrition Researcher',
        bio: 'Evidence-based health insights, nutrition plans, fitness protocols, and scientific studies reviewed against established medical research guidelines.',
        badge: 'Fact-Checked Evidence',
        accentGradient: 'from-teal-600 via-emerald-600 to-cyan-700'
      };
    case 'automotive-trends':
      return {
        deskName: 'UniqueDigit Automotive & Mobility Desk',
        authorName: 'Deepanshu',
        authorInitials: 'AM',
        role: 'Automotive & EV Analyst',
        bio: 'Electric vehicles, new car launches, real-world battery range tests, highway efficiency, and safety ratings in the Indian automotive ecosystem.',
        badge: 'Fact-Checked & Verified',
        accentGradient: 'from-blue-600 via-indigo-600 to-slate-800'
      };
    case 'ai-tools':
      return {
        deskName: 'UniqueDigit AI Intelligence Labs',
        authorName: 'Deepanshu',
        authorInitials: 'AI',
        role: 'Applied AI & LLM Specialist',
        bio: 'Evaluates production LLMs, developer APIs, prompt workflows, and generative tooling for engineers, creators, and modern teams.',
        badge: 'Lab Benchmark Verified',
        accentGradient: 'from-indigo-600 via-purple-600 to-pink-600'
      };
    case 'cricket-sports':
    case 'football-sports':
      return {
        deskName: 'UniqueDigit Sports Desk',
        authorName: 'Sports Editorial Team',
        authorInitials: 'ST',
        role: 'Senior Sports Analyst & Statistician',
        bio: 'Live match statistics, tournament analytics, pitch conditions, squad changes, and player performance metrics across ICC tournaments and leagues.',
        badge: 'Match Stats Verified',
        accentGradient: 'from-sky-600 via-blue-600 to-indigo-700'
      };
    default:
      return {
        deskName: 'UniqueDigit Editorial Desk',
        authorName: 'Deepanshu',
        authorInitials: 'UD',
        role: 'Lead Tech & Market Analyst',
        bio: 'Covers smartphones, personal technology, and verified consumer buying guides across UniqueDigit.',
        badge: 'Curated & Fact-Checked',
        accentGradient: 'from-brand via-purple-600 to-indigo-600'
      };
  }
}

const authorMeta = getNicheAuthorMeta(niche.slug);
const isExamRelated = niche.slug === 'exams-results' ||
  /result|admit card|scorecard|cut off|cutoff|merit list|answer key|counselling|rpsc|upsc|ssc|cbse|bteup|nta|neet|jee/i.test(post.title);

// 1. Article / NewsArticle Schema (Google Discover & SEO Compliant)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isCard ? 'NewsArticle' : 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href
  },
  headline: post.title,
  description: post.summary,
  image: gallerySlides.map(s => s.url.startsWith('http') ? s.url : `${Astro.url.origin}${s.url}`),
  datePublished: post.published_at,
  dateModified: post.updated_at || post.published_at,
  inLanguage: 'en-IN',
  author: [
    {
      '@type': 'Person',
      name: authorMeta.authorName,
      jobTitle: authorMeta.role,
      url: `${Astro.url.origin}/about`
    },
    {
      '@type': 'Organization',
      name: authorMeta.deskName,
      url: Astro.url.origin
    }
  ],
  publisher: {
    '@type': 'Organization',
    name: 'UniqueDigit',
    logo: {
      '@type': 'ImageObject',
      url: `${Astro.url.origin}/favicon.svg`
    }
  }
};

// 2. Breadcrumbs Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.url.origin
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: niche.name,
      item: `${Astro.url.origin}/${niche.slug}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.title,
      item: Astro.url.href
    }
  ]
};

// 3. FAQPage Schema for Google Rich Accordions
const faqSchema = post.faq && post.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map(item => ({
    '@type': 'Question',
    name: item.q || item.question || item.title || 'Frequently Asked Question',
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a || item.answer || item.content || ''
    }
  }))
} : null;

// Calibrated Hype Score (avoids displaying "10 · Low" on live editorial articles)
const calculatedHype = (() => {
  const rawHype = post.hype ?? post.trend_score ?? 0;
  if (rawHype >= 55) return rawHype;
  const seed = (typeof post.id === 'number' ? post.id : (post.title?.length || 15));
  return 76 + (seed % 19);
})();

// Context-tailored dynamic verdict copy (eliminates cricket hallucinations on non-cricket articles)
function getDynamicVerdictCopy(slug: string, title: string, summaryText?: string): string {
  const prefix = summaryText ? `${summaryText} ` : '';
  if (['pc-builds', 'ai-tools', 'gta-6'].includes(slug)) {
    return `${prefix}When assessing hardware configurations, AI workflows, and performance benchmarks, choosing verified components and tracking market pricing delivers the highest return. Bookmark this guide for the latest updates and alerts.`;
  }
  if (['deals', 'cashback'].includes(slug)) {
    return `${prefix}Flash discounts and bank cashback offers fluctuate rapidly based on retailer inventory. We advise verifying seller ratings and applying available instant coupon codes at checkout. Bookmark this guide for the latest updates and alerts.`;
  }
  if (['health'].includes(slug)) {
    return `${prefix}Holistic wellness and health routines yield the greatest benefit when paired with consistent, science-backed habits. Always cross-reference lifestyle changes with medical guidelines. Bookmark this guide for the latest updates and alerts.`;
  }
  if (['gold-rate'].includes(slug)) {
    return `${prefix}Precious metal valuations reflect live global bullion indices and currency movements. Track multi-city spot rates and hallmarking standards before making physical or digital allocations. Bookmark this guide for the latest updates and alerts.`;
  }
  if (['movies', 'entertainment-celebrity'].includes(slug)) {
    return `${prefix}From critical acclaim to box office trajectories, streaming releases and theatrical runs continue to evolve. Keep this tracker bookmarked for updated platform availability.`;
  }
  if (['cricket', 'cricket-sports', 'football-sports'].includes(slug)) {
    return `${prefix}Match dynamics, player form, and pitch conditions play a pivotal role. Stay tuned to our verified editorial feed for live match updates, scores, and coverage.`;
  }
  if (['exams-results'].includes(slug)) {
    return `${prefix}उम्मीदवारों को सलाह दी जाती है कि वे अपने आधिकारिक रोल नंबर और जन्म तिथि के साथ पोर्टल पर लॉग इन करें। स्कोरकार्ड, कटऑफ और मेरिट लिस्ट पीडीएफ का प्रिंटआउट भविष्य के संदर्भ के लिए सुरक्षित रख लें।`;
  }
  if (['finance'].includes(slug)) {
    return `${prefix}Market movements, RBI interest rates, and SIP compound returns demand disciplined capital management. Verify mutual fund TER and regulatory disclosures before allocating capital.`;
  }
  if (['automotive-trends'].includes(slug)) {
    return `${prefix}Real-world ARAI range metrics, battery safety tests, and highway efficiency figures provide the truest measure of vehicle performance. Check on-road state subsidies before booking.`;
  }
  return `${prefix}Tracking real-time developments across primary curated sources ensures you have the most accurate, unfiltered perspective. Keep this briefing bookmarked for continuous verification.`;
}

// Multi-gradient palettes for deduplicated rank badges
const rankGradients = [
  'from-rose-500 to-amber-500',
  'from-purple-600 to-indigo-600',
  'from-blue-600 to-cyan-500',
  'from-emerald-500 to-teal-500',
  'from-fuchsia-600 to-pink-500',
  'from-amber-500 to-orange-600'
];

const renderedImages = new Set<string>();
if (post.image_url) renderedImages.add(post.image_url);
if (displayHeroImage) renderedImages.add(displayHeroImage);
---

<Layout
  title={`${post.title} | UniqueDigit`}
  description={post.summary}
  image={absoluteImageUrl}
  canonical={`https://uniquedigit-viral-hub.pages.dev/${niche.slug}/${post.slug}`}
  niche={niche}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-brand via-purple-500 to-emerald-500 z-50 transition-all duration-75 w-0"></div>

  <!-- Mobile Sidebar Overlay (Fixed Position - Outside Grid) -->
  <div
    id="sidebar-panel"
    class="fixed inset-0 z-40 hidden"
    aria-hidden="true"
  >
    <!-- Backdrop Overlay -->
    <div class="sidebar-backdrop absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 invisible transition-all duration-300"></div>
    <!-- Sidebar Panel -->
    <div class="sidebar-panel absolute inset-y-0 right-0 w-full max-w-[360px] bg-white rounded-tl-3xl shadow-2xl flex flex-col overflow-y-auto transform translate-x-full transition-transform duration-300 ease-out lg:translate-x-0 lg:static lg:shadow-none lg:rounded-none lg:bg-transparent">
      <!-- Sidebar Close Button (Mobile Only) -->
      <button
        id="sidebar-close-btn"
        type="button"
        class="lg:hidden absolute top-4 right-4 z-50 w-10 h-10 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center shadow-lg active:scale-95 transition"
        aria-label="Close sidebar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <!-- Mobile Sidebar Content -->
      <div class="flex-1 p-4 sm:p-6 overflow-y-auto">

        <!-- 1. Trending Stories in India (Top 5 Ranking with Thumbnails) -->
        <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6 mb-6">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
              <h3 class="font-black text-slate-900 text-sm uppercase tracking-wider">
                Trending in India
              </h3>
            </div>
            <a href="/trending" class="text-xs font-bold text-brand hover:underline">
              View All &rarr;
            </a>
          </div>

          <div class="flex flex-col gap-3.5">
            {sidebarTrending.map((tr, idx) => {
              const trThumb = proxyImageUrl(tr.image_url, (tr as any).niches?.slug, tr.slug);

              return (
                <a
                  href={(tr as any).niches ? `/${(tr as any).niches.slug}/${tr.slug}` : `/${tr.slug}`}
                  class="group flex items-center gap-3.5 p-2 rounded-2xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100"
                >
                  <div class="relative w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-slate-900 border border-slate-200">
                    <img
                      src={trThumb}
                      alt={tr.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    />
                    <div class="absolute bottom-0 left-0 right-0 bg-black/70 backdrop-blur-xs text-[10px] font-black text-white text-center py-0.5 font-mono">
                      #{idx + 1}
                    </div>
                  </div>

                  <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-bold text-slate-900 line-clamp-2 leading-snug group-hover:text-brand transition">
                      {tr.title}
                    </h4>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-xs font-mono text-emerald-600 font-bold">
                        🔥 Trending #{idx + 1}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <!-- 2. More In This Category (with Thumbnails) -->
        {sidebarRelated.length > 0 && (
