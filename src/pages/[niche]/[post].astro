---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolCard from '../../components/ToolCard.astro';
import AmazonDealBox from '../../components/AmazonDealBox.astro';
import DealPoll from '../../components/DealPoll.astro';
import NicheCard from '../../components/NicheCard.astro';
import DisclaimerBar from '../../components/DisclaimerBar.astro';
import Icon from '../../components/Icon.astro';
import HypeMeter from '../../components/HypeMeter.astro';
import FreshnessStamp from '../../components/FreshnessStamp.astro';
import { getPost, getPostsByNiche, getProductsByNiche, getNicheBySlug, getTrendingPosts } from '../../lib/db';
import { marked } from 'marked';

const { niche: nicheSlug, post: postSlug } = Astro.params;
if (!nicheSlug || !postSlug) {
  return Astro.redirect('/404');
}

const runtime = (Astro.locals as any)?.runtime;
const niche = await getNicheBySlug(nicheSlug, runtime?.env);
const post = await getPost(nicheSlug, postSlug, runtime?.env);

if (!post || !niche) {
  return Astro.redirect('/404');
}

const [relatedPosts, products, trendingPosts] = await Promise.all([
  getPostsByNiche(niche.id, 6, runtime?.env),
  getProductsByNiche(niche.id, runtime?.env),
  getTrendingPosts(6, runtime?.env)
]);

const cleanRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 3);
const sidebarRelated = relatedPosts.filter(p => p.slug !== post.slug).slice(0, 4);
const sidebarTrending = trendingPosts.filter(p => p.slug !== post.slug).slice(0, 5);

function sanitizeMarkdownHtml(html: string): string {
  return html
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/\son\w+="[^"]*"/gi, '')
    .replace(/\son\w+='[^']*'/gi, '')
    .replace(/href=["']javascript:[^"']*["']/gi, 'href="#"');
}

function slugifyHeading(text: string): string {
  return text
    .toLowerCase()
    .replace(/<[^>]*>/g, '')
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

// Normalize literal escaped newlines and markdown characters from database / API
const normalizedMarkdown = (post.body_md || '')
  .replace(/\\r\\n/g, '\n')
  .replace(/\\n/g, '\n')
  .replace(/\\t/g, '  ');

// Extract H2 Table of Contents from markdown
const tokens = marked.lexer(normalizedMarkdown);
const tableOfContents = tokens
  .filter((t: any) => t.type === 'heading' && t.depth === 2)
  .map((t: any) => ({
    text: t.text.replace(/[*_`]/g, '').trim(),
    id: slugifyHeading(t.text)
  }));

// Setup marked renderer to inject anchor IDs into headings
const headingRenderer = new marked.Renderer();
headingRenderer.heading = ({ text, depth }: { text: string; depth: number }) => {
  const cleanId = slugifyHeading(text);
  return `<h${depth} id="${cleanId}" class="scroll-mt-28 group relative font-black text-slate-900 tracking-tight">${text}<a href="#${cleanId}" class="ml-2 text-slate-300 opacity-0 group-hover:opacity-100 transition no-underline text-base" aria-hidden="true">#</a></h${depth}>\n`;
};

const rawBodyHtml = normalizedMarkdown ? (marked.parse(normalizedMarkdown, { renderer: headingRenderer }) as string) : '';
const bodyHtml = typeof rawBodyHtml === 'string' ? sanitizeMarkdownHtml(rawBodyHtml) : '';
const isCard = post.kind === 'card' || !post.indexable;

// Estimated reading time & stats
const wordCount = (post.body_md || post.summary || '').split(/\s+/).length;
const readTime = Math.max(2, Math.ceil(wordCount / 180));

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=10, must-revalidate');

// High-Resolution Curated Assets to Prevent Low-Res Blur (100% Real Wikipedia Commons & Local Assets)
const CURATED_NICHE_HERO_IMAGES: Record<string, string> = {
  'cricket-sports': 'https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/Board_of_Control_for_Cricket_in_India_Logo_%282024%29.svg/960px-Board_of_Control_for_Cricket_in_India_Logo_%282024%29.svg.png',
  'pc-builds': '/images/rtx5090.jpg',
  'gta-6': '/images/gta6_cover.jpg',
  'ai-tools': '/images/ai_tools.jpg',
  'gold-rate': '/images/gold_24k.jpg',
  'deals': '/images/products/iphone_16_pro.jpg',
  'cashback': 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Visa_2021.svg/960px-Visa_2021.svg.png',
  'food': 'https://upload.wikimedia.org/wikipedia/commons/e/ef/Tradtional_Thali.jpg',
  'health': 'https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/Yoga_mat_and_dumbbells.jpg/960px-Yoga_mat_and_dumbbells.jpg',
  'side-hustles': '/images/ai_tools.jpg',
  'fashion': 'https://upload.wikimedia.org/wikipedia/commons/a/a6/Carolina_Herrera_AW14_12.jpg',
  'movies': 'https://upload.wikimedia.org/wikipedia/en/d/d9/Drishyam-_The_Conclusion_poster.jpg',
  'automotive-trends': 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/25/Tata_Nexon_Blue_Dual_Tone.jpg/960px-Tata_Nexon_Blue_Dual_Tone.jpg',
  'exams-results': 'https://upload.wikimedia.org/wikipedia/commons/thumb/8/84/Government_of_India_logo.svg/960px-Government_of_India_logo.svg.png',
  'viral': '/images/ai_tools.jpg'
};

interface GalleryItem {
  url: string;
  label: string;
  caption: string;
}

// Verified Entity Multi-Image Galleries (Zero Generic Stock Photos)
const ENTITY_SPECIFIC_GALLERIES: Record<string, GalleryItem[]> = {
  'drishyam-3-the-conclusion-box-office-collection-nears-400-crore-worldwide': [
    {
      url: 'https://upload.wikimedia.org/wikipedia/en/d/d9/Drishyam-_The_Conclusion_poster.jpg',
      label: '1. Official Poster',
      caption: 'Drishyam 3: The Conclusion official theatrical release poster.'
    },
    {
      url: 'https://upload.wikimedia.org/wikipedia/commons/9/9d/Ajay_Devgn_at_the_trailer_launch_of_Raid_2.jpg',
      label: '2. Ajay Devgn (Vijay)',
      caption: 'Ajay Devgn as Vijay Salgaonkar leading the gripping conclusion.'
    },
    {
      url: 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/d8/Mohanlal_at_Vanitha_Film_Awards_2019.jpg/640px-Mohanlal_at_Vanitha_Film_Awards_2019.jpg',
      label: '3. Mohanlal (Creator)',
      caption: 'Mohanlal, legendary lead of the original Malayalam cult classic universe.'
    }
  ],
  'gta-6-pc-specs-realistic-india-pricing-what-system-do-you-need': [
    {
      url: '/images/gta6_cover.jpg',
      label: '1. Official Key Art',
      caption: 'Rockstar Games official Grand Theft Auto VI Vice City artwork.'
    },
    {
      url: '/images/rtx5090.jpg',
      label: '2. RTX 5090 Target',
      caption: 'Next-gen ray tracing and high-FPS target hardware.'
    }
  ]
};

function getSharpImage(imageUrl?: string, nSlug = 'viral'): string {
  if (!imageUrl || imageUrl.length < 10) {
    return CURATED_NICHE_HERO_IMAGES[nSlug] || '/images/ai_tools.jpg';
  }
  if (imageUrl.includes('wikipedia/commons/thumb/') || imageUrl.includes('wikipedia/en/thumb/')) {
    return imageUrl.replace(/\/thumb(\/.*)\/[^\/]+$/, '$1');
  }
  return imageUrl;
}

const displayHeroImage = getSharpImage(post.image_url, niche.slug);
const absoluteImageUrl = displayHeroImage.startsWith('http') 
  ? displayHeroImage 
  : `${Astro.url.origin}${displayHeroImage}`;

// Build Authentic Gallery: Only show real entity slides, never inject fake stock photos
const gallerySlides: GalleryItem[] = ENTITY_SPECIFIC_GALLERIES[post.slug] || [
  {
    url: displayHeroImage,
    label: '1. Verified Visual',
    caption: post.image_credit ? `Source: ${post.image_credit}` : `${post.title} — Verified editorial coverage.`
  }
];

// 1. Article / NewsArticle Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isCard ? 'NewsArticle' : 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href
  },
  headline: post.title,
  description: post.summary,
  image: gallerySlides.map(s => s.url.startsWith('http') ? s.url : `${Astro.url.origin}${s.url}`),
  datePublished: post.published_at,
  dateModified: post.updated_at || post.published_at,
  author: {
    '@type': 'Organization',
    name: 'UniqueDigit Editorial Desk',
    url: Astro.url.origin
  },
  publisher: {
    '@type': 'Organization',
    name: 'UniqueDigit',
    logo: {
      '@type': 'ImageObject',
      url: `${Astro.url.origin}/favicon.svg`
    }
  }
};

// 2. Breadcrumbs Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.url.origin
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: niche.name,
      item: `${Astro.url.origin}/${niche.slug}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.title,
      item: Astro.url.href
    }
  ]
};

// 3. FAQPage Schema for Google Rich Accordions
const faqSchema = post.faq && post.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
} : null;
---

<Layout
  title={`${post.title} | UniqueDigit`}
  description={post.summary}
  image={absoluteImageUrl}
  canonical={Astro.url.href}
  niche={niche}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-[3.5px] bg-gradient-to-r from-brand via-purple-500 to-emerald-500 z-50 transition-all duration-75 w-0"></div>

  <Fragment slot="head">
    {isCard && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- Main Editorial Container (2-Column Grid) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-muted mb-6 px-1 overflow-x-auto no-scrollbar whitespace-nowrap">
      <a href="/" class="hover:text-brand transition font-medium">Home</a>
      <span>/</span>
      <a href={`/${niche.slug}`} class="hover:text-brand transition font-medium">{niche.name}</a>
      <span>/</span>
      <span class="text-ink truncate max-w-sm font-semibold">{post.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN (8 cols): Main Newsroom Article Card -->
      <main class="lg:col-span-8 bg-white rounded-3xl border border-slate-200/90 shadow-sm p-6 sm:p-10">
        
        <!-- Header Area -->
        <header class="mb-6">
          <div class="flex items-center gap-2.5 mb-4 flex-wrap">
            <a
              href={`/${niche.slug}`}
              class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-brand text-white shadow-xs hover:bg-brand-dark transition"
            >
              {niche.name}
            </a>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200">
              ⏱️ {readTime} min read
            </span>
            <HypeMeter score={post.hype || post.trend_score || 75} size="sm" />
            <FreshnessStamp updatedAt={post.updated_at || post.published_at} />
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 leading-tight tracking-tight mb-4">
            {post.title}
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6 font-medium">
            {post.summary}
          </p>

          <!-- Byline & Social Actions -->
          <div class="flex items-center justify-between py-4 border-y border-slate-100 text-xs text-slate-500 flex-wrap gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-brand to-purple-500 text-white font-extrabold flex items-center justify-center text-sm shadow-xs">
                UD
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-slate-900">UniqueDigit Editorial Desk</span>
                  <span class="text-emerald-600 font-bold text-[11px] bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-200">✓ Verified</span>
                </div>
                <span class="text-[11px] text-slate-500">
                  Published {new Date(post.published_at).toLocaleDateString('en-IN', { month: 'long', day: 'numeric', year: 'numeric' })}
                </span>
              </div>
            </div>

            <!-- Share Buttons -->
            <div class="flex items-center gap-2">
              <a
                href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title}\nRead more: ${Astro.url.href}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold hover:bg-emerald-100 transition active:scale-95"
                title="Share on WhatsApp"
              >
                <span>💬 WhatsApp</span>
              </a>
              <button
                id="copy-article-link-btn"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition active:scale-95 cursor-pointer"
                title="Copy article link"
              >
                <span id="copy-btn-text">🔗 Copy Link</span>
              </button>
            </div>
          </div>
        </header>

        <!-- 4-Card Quick Telemetry Bar (High Impact Scannability) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Trending Hype</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-lg font-black text-rose-600 font-mono">{post.hype || post.trend_score || 88}</span>
              <span class="text-[11px] font-bold text-rose-500">/ 100</span>
            </div>
            <span class="text-[10px] text-slate-500 font-medium">🔥 Spike Surge</span>
          </div>

          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Category Radar</span>
            <span class="text-xs font-black text-slate-900 mt-1 truncate">{niche.name}</span>
            <span class="text-[10px] text-brand font-medium">📍 {niche.grp}</span>
          </div>

          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Read Time</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-lg font-black text-slate-900 font-mono">{readTime}</span>
              <span class="text-[11px] font-bold text-slate-600">min</span>
            </div>
            <span class="text-[10px] text-emerald-600 font-medium font-mono">⚡ Fast Digest</span>
          </div>

          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Editorial Trust</span>
            <span class="text-xs font-black text-emerald-700 mt-1 flex items-center gap-1">
              <span>🛡️ 100%</span>
              <span class="text-[10px]">Verified</span>
            </span>
            <span class="text-[10px] text-slate-500 font-medium">Real-Time Data</span>
          </div>
        </div>

        <!-- Interactive 3-Image Carousel / Slider Component -->
        <div class="mb-8">
          <div class="rounded-3xl overflow-hidden border border-slate-200/90 bg-slate-950 shadow-md relative group select-none">
            
            <!-- Slide Viewport -->
            <div class="relative aspect-video sm:aspect-[16/9] w-full max-h-[520px] overflow-hidden bg-slate-950">
              <div id="gallery-track" class="flex w-full h-full transition-transform duration-500 ease-out">
                {gallerySlides.map((slide, idx) => (
                  <div class="w-full h-full shrink-0 relative bg-slate-950 flex items-center justify-center">
                    <img
                      src={slide.url}
                      alt={`${post.title} - ${slide.label}`}
                      loading={idx === 0 ? "eager" : "lazy"}
                      decoding="async"
                      class="w-full h-full object-cover object-center filter brightness-[0.98]"
                    />
                  </div>
                ))}
              </div>

              <!-- Top Floating Badges -->
              <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
                <span id="gallery-counter-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-900/85 backdrop-blur-md text-amber-300 border border-slate-700/80 shadow-md">
                  {gallerySlides.length > 1 ? `Photo 1 of ${gallerySlides.length}` : 'Verified Visual'}
                </span>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-black/60 backdrop-blur-md text-white border border-white/20">
                  HD 1400w
                </span>
              </div>

              <!-- Navigation Arrows (Shown only if multi-image) -->
              {gallerySlides.length > 1 && (
                <>
                  <button
                    id="gallery-prev-btn"
                    type="button"
                    aria-label="Previous Image"
                    class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-slate-900/70 hover:bg-brand text-white flex items-center justify-center backdrop-blur-md border border-white/20 shadow-lg active:scale-95 transition opacity-90 sm:opacity-0 group-hover:opacity-100 cursor-pointer"
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                  </button>

                  <button
                    id="gallery-next-btn"
                    type="button"
                    aria-label="Next Image"
                    class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-slate-900/70 hover:bg-brand text-white flex items-center justify-center backdrop-blur-md border border-white/20 shadow-lg active:scale-95 transition opacity-90 sm:opacity-0 group-hover:opacity-100 cursor-pointer"
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </>
              )}
            </div>

            <!-- Dynamic Slide Caption & Source Bar -->
            <div class="px-5 py-3 bg-slate-900/95 text-xs text-slate-300 flex items-center justify-between border-t border-slate-800 gap-3 flex-wrap">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
                <p id="gallery-caption-text" class="truncate max-w-sm sm:max-w-xl text-slate-200 font-medium">
                  {gallerySlides[0].caption}
                </p>
              </div>
              {post.source_url && (
                <a href={post.source_url} target="_blank" rel="nofollow noopener" class="text-amber-400 hover:underline shrink-0 text-[11px] font-bold">
                  Verify Source &rarr;
                </a>
              )}
            </div>
          </div>

          <!-- Interactive Thumbnail Switcher Bar (Shown only if multiple authentic slides) -->
          {gallerySlides.length > 1 && (
            <div class={`grid ${gallerySlides.length === 2 ? 'grid-cols-2' : 'grid-cols-3'} gap-2.5 mt-3`}>
              {gallerySlides.map((slide, idx) => (
                <button
                  type="button"
                  data-slide-index={idx}
                  class={`gallery-tab-btn flex items-center gap-2 p-2.5 rounded-2xl border transition text-left cursor-pointer ${
                    idx === 0
                      ? 'bg-purple-50/90 border-brand text-brand ring-2 ring-brand/20 font-bold'
                      : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50 hover:border-slate-300'
                  }`}
                >
                  <div class="w-10 h-7 rounded-lg overflow-hidden shrink-0 bg-slate-900 border border-slate-200">
                    <img src={slide.url} alt="" class="w-full h-full object-cover" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <span class="text-[11px] block truncate font-bold">{slide.label}</span>
                  </div>
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Interactive Table of Contents (TOC) Quick Jump Bar -->
        {tableOfContents.length > 0 && (
          <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-slate-50 via-purple-50/40 to-slate-50 border border-slate-200/90 shadow-2xs">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-base">🧭</span>
              <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider">
                Quick Jump to Section (Table of Contents)
              </h3>
            </div>
            <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
              {tableOfContents.map((heading) => (
                <a
                  href={`#${heading.id}`}
                  class="toc-jump-pill px-3 py-1.5 rounded-xl bg-white hover:bg-brand hover:text-white border border-slate-200 hover:border-brand text-xs font-bold text-slate-700 transition shadow-2xs shrink-0"
                >
                  {heading.text}
                </a>
              ))}
              {post.faq && post.faq.length > 0 && (
                <a
                  href="#faq-section"
                  class="toc-jump-pill px-3 py-1.5 rounded-xl bg-white hover:bg-brand hover:text-white border border-slate-200 hover:border-brand text-xs font-bold text-slate-700 transition shadow-2xs shrink-0"
                >
                  Frequently Asked Questions
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Key Intel & Executive Summary Card (At-a-Glance Scannability) -->
        <div class="my-6 p-6 rounded-3xl bg-gradient-to-br from-purple-50/70 via-slate-50 to-emerald-50/50 border border-purple-200/80 shadow-2xs">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-lg">⚡</span>
            <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider">
              Executive Briefing & Key Takeaways
            </h3>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
            <div class="p-3.5 rounded-2xl bg-white border border-slate-200/80">
              <span class="text-[10px] font-black uppercase text-brand tracking-wider block mb-1">01. What Happened</span>
              <p class="text-xs text-slate-700 font-medium leading-relaxed">
