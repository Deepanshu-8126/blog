---
import { getNicheBySlug, getPostsByNiche, getPostsCountByNiche, getTrendingPosts, getProductsByNiche } from '../../lib/db';
import Feed from '../../templates/Feed.astro';
import Tools from '../../templates/Tools.astro';
import Dataset from '../../templates/Dataset.astro';
import Movies from '../../templates/Movies.astro';
import DealsHub from '../../templates/DealsHub.astro';
import HealthHub from '../../templates/HealthHub.astro';
import NewsHub from '../../templates/NewsHub.astro';
import NicheLayout from '../../layouts/NicheLayout.astro';

const { niche: nicheSlug } = Astro.params;
if (!nicheSlug) {
  return Astro.redirect('/404');
}

const runtime = (Astro.locals as any)?.runtime;
const niche = await getNicheBySlug(nicheSlug, runtime?.env);
if (!niche) {
  return Astro.redirect('/404');
}

console.log('[index.astro] niche from DB:', { slug: niche.slug, name: niche.name, page_type: niche.page_type, grp: niche.grp });

const isDealsPageType = niche.page_type === 'deals';
const isHealthPageType = niche.page_type === 'health';
const isNewsNiche = niche.slug === 'news' || niche.slug === 'viral' || niche.slug === 'breaking';

const pageQuery = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(pageQuery) || pageQuery < 1 ? 1 : pageQuery;
const tabQuery = Astro.url.searchParams.get('tab') || (isDealsPageType ? 'live' : 'latest');
const pageSize = 12;
const offset = (currentPage - 1) * pageSize;

const [posts, totalCount, trendingPosts, products] = await Promise.all([
  getPostsByNiche(niche.id, pageSize, runtime?.env, offset),
  getPostsCountByNiche(niche.id, runtime?.env),
  getTrendingPosts(5, runtime?.env),
  getProductsByNiche(niche.id, runtime?.env)
]);

const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
---

<NicheLayout niche={niche} activeTab={tabQuery}>
  {isDealsPageType ? (
    <DealsHub niche={niche} products={products} posts={posts} activeTab={tabQuery} />
  ) : isHealthPageType ? (
    <HealthHub niche={niche} posts={posts} trendingPosts={trendingPosts} products={products} activeTab={tabQuery} />
  ) : isNewsNiche ? (
    <NewsHub niche={niche} posts={posts} trendingPosts={trendingPosts} currentPage={currentPage} totalPages={totalPages} activeTab={tabQuery} />
  ) : (
    <>
      {niche.page_type === 'feed' && (
        <Feed niche={niche} posts={posts} trendingPosts={trendingPosts} currentPage={currentPage} totalPages={totalPages} activeTab={tabQuery} />
      )}
      {niche.page_type === 'tools' && (
        <Tools niche={niche} products={products} posts={posts} activeTab={tabQuery} />
      )}
      {niche.page_type === 'dataset' && (
        <Dataset niche={niche} posts={posts} activeTab={tabQuery} />
      )}
      {niche.page_type === 'movies' && (
        <Movies niche={niche} posts={posts} activeTab={tabQuery} />
      )}
    </>
  )}
</NicheLayout>