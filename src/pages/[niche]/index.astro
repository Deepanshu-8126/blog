---
import { getNicheBySlug, getPostsByNiche, getPostsCountByNiche, getTrendingPosts, getProductsByNiche } from '../../lib/db';
import Feed from '../../templates/Feed.astro';
import Tools from '../../templates/Tools.astro';
import Dataset from '../../templates/Dataset.astro';
import Movies from '../../templates/Movies.astro';

const { niche: nicheSlug } = Astro.params;
if (!nicheSlug) {
  return Astro.redirect('/404');
}

const runtime = (Astro.locals as any)?.runtime;
const niche = await getNicheBySlug(nicheSlug, runtime?.env);
if (!niche) {
  return Astro.redirect('/404');
}

const pageQuery = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(pageQuery) || pageQuery < 1 ? 1 : pageQuery;
const pageSize = 12;
const offset = (currentPage - 1) * pageSize;

const [posts, totalCount, trendingPosts, products] = await Promise.all([
  getPostsByNiche(niche.id, pageSize, runtime?.env, offset),
  getPostsCountByNiche(niche.id, runtime?.env),
  getTrendingPosts(5, runtime?.env),
  getProductsByNiche(niche.id, runtime?.env)
]);

const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
---

{niche.page_type === 'feed' && (
  <Feed niche={niche} posts={posts} trendingPosts={trendingPosts} currentPage={currentPage} totalPages={totalPages} />
)}

{niche.page_type === 'tools' && (
  <Tools niche={niche} products={products} posts={posts} />
)}

{niche.page_type === 'dataset' && (
  <Dataset niche={niche} posts={posts} />
)}

{niche.page_type === 'movies' && (
  <Movies niche={niche} posts={posts} />
)}
