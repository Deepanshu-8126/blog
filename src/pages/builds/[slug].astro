const build = BUILDS_DATABASE[slug || 'budget-gaming-50000'] || BUILDS_DATABASE['budget-gaming-50000'];
const AMAZON_TAG = 'uniquedigi0c6-21';

// Generate 1-Click Multi-ASIN Amazon Cart Link
const cartParams = build.asins.map((asin: string, idx: number) => `ASIN.${idx+1}=${asin}&Quantity.${idx+1}=1`).join('&');
const multiCartUrl = `https://www.amazon.in/gp/aws/cart/add.html?AssociateTag=${AMAZON_TAG}&${cartParams}`;
---

<Layout
  title={`${build.title} — UniqueDigit 3D PC Builder`}
  description={`Complete parts breakdown, live FPS benchmarks, wattage calculation, and 1-click Amazon India cart for ${build.title}.`}
>
  <div class="my-6">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <div class="flex items-center gap-2 text-xs text-muted">
        <a href="/" class="hover:text-ink font-bold">Home</a>
        <span>/</span>
        <a href="/builds" class="hover:text-ink font-bold">PC Builds</a>
        <span>/</span>
        <span class="text-brand font-mono font-bold truncate">{slug}</span>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/builds"
          class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-black transition flex items-center gap-1.5"
        >
          <span>🖥️ Browse All PC Builds</span>
          <span>➔</span>
        </a>
      </div>
    </div>

    <!-- Hero Title Banner -->
    <div class="p-6 sm:p-10 rounded-3xl bg-slate-950 border border-slate-800 text-white shadow-2xl relative overflow-hidden mb-10">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class={`px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider ${build.badgeColor}`}>
              {build.badge}
            </span>
            <span class="text-xs font-mono font-bold text-emerald-400">
              ● 100% Compatible & Tested
            </span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight mb-2">
            {build.title}
          </h1>
          <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
            {build.tagline}
          </p>
        </div>

        <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 flex flex-col items-start sm:items-end justify-between gap-3 shrink-0">
          <div>
            <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Total Build Cost</span>
            <span class="text-3xl font-black text-amber-400 font-mono">{build.budget}</span>
          </div>
          <a
            href={multiCartUrl}
            target="_blank"
            rel="sponsored nofollow noopener"
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-400 hover:brightness-110 text-slate-950 font-black text-xs text-center shadow-lg transition flex items-center justify-center gap-2"
          >
            <span>🛒 1-Click Amazon India Cart</span>
            <span>➔</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 2-Column Grid: Hardware Breakdown vs Live Gaming Benchmarks -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-8 items-start">
      
      <!-- Left Column: Component Specification Table (8 Cols) -->
      <div class="lg:col-span-8 flex flex-col gap-6">
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-line shadow-card">
          <div class="flex items-center justify-between pb-4 border-b border-line mb-4">
            <div>
              <h3 class="text-lg font-black text-ink">Component Specification & Amazon Buy Links</h3>
              <span class="text-xs text-muted">All parts verified with real-time Indian pricing</span>
            </div>
            <span class="text-xs font-mono font-bold text-slate-800 bg-slate-100 px-3 py-1 rounded-full">
              6 Verified Parts
            </span>
          </div>

          <div class="flex flex-col divide-y divide-slate-100">
            <!-- CPU -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-blue-50 text-blue-700">Processor</span>
                <h4 class="text-sm font-bold text-ink mt-1">{build.cpu}</h4>
              </div>
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(build.cpu)}&tag=${AMAZON_TAG}`} target="_blank" rel="sponsored nofollow noopener" class="px-3.5 py-1.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition self-start sm:self-center shrink-0">
                🛒 Buy on Amazon
              </a>
            </div>

            <!-- GPU -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-purple-50 text-purple-700">Graphics Card</span>
                <h4 class="text-sm font-bold text-ink mt-1">{build.gpu}</h4>
              </div>
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(build.gpu)}&tag=${AMAZON_TAG}`} target="_blank" rel="sponsored nofollow noopener" class="px-3.5 py-1.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition self-start sm:self-center shrink-0">
                🛒 Buy on Amazon
              </a>
            </div>

            <!-- Motherboard -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-cyan-50 text-cyan-700">Motherboard</span>
                <h4 class="text-sm font-bold text-ink mt-1">{build.mobo}</h4>
              </div>
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(build.mobo)}&tag=${AMAZON_TAG}`} target="_blank" rel="sponsored nofollow noopener" class="px-3.5 py-1.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition self-start sm:self-center shrink-0">
                🛒 Buy on Amazon
              </a>
            </div>

            <!-- RAM -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-pink-50 text-pink-700">RAM Memory</span>
                <h4 class="text-sm font-bold text-ink mt-1">{build.ram}</h4>
              </div>
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(build.ram)}&tag=${AMAZON_TAG}`} target="_blank" rel="sponsored nofollow noopener" class="px-3.5 py-1.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition self-start sm:self-center shrink-0">
                🛒 Buy on Amazon
              </a>
            </div>

            <!-- SSD -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-emerald-50 text-emerald-700">Storage SSD</span>
                <h4 class="text-sm font-bold text-ink mt-1">{build.ssd}</h4>
              </div>
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(build.ssd)}&tag=${AMAZON_TAG}`} target="_blank" rel="sponsored nofollow noopener" class="px-3.5 py-1.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition self-start sm:self-center shrink-0">
                🛒 Buy on Amazon
              </a>
            </div>

            <!-- Cabinet + PSU -->
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-slate-100 text-slate-700">Case & Power Supply</span>
                <h4 class="text-sm font-bold text-ink mt-1">{build.psuCase}</h4>
              </div>
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(build.psuCase)}&tag=${AMAZON_TAG}`} target="_blank" rel="sponsored nofollow noopener" class="px-3.5 py-1.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition self-start sm:self-center shrink-0">
                🛒 Buy on Amazon
              </a>
            </div>
          </div>
        </div>

        <!-- 1-Click Amazon Multi-Cart Callout -->
        <div class="p-6 rounded-3xl bg-amber-500/10 border border-amber-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h4 class="text-base font-black text-ink">Want all 6 parts added directly to your Amazon Cart?</h4>
            <p class="text-xs text-muted mt-0.5">Saves time by bundling all verified ASINs in 1 click.</p>
          </div>
          <a
            href={multiCartUrl}
            target="_blank"
            rel="sponsored nofollow noopener"
            class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition shrink-0"
          >
            [ 🛒 Add All to Amazon Cart ]
          </a>
        </div>
      </div>

      <!-- Right Column: FPS Benchmarks & Power Telemetry (4 Cols) -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        
        <!-- Live FPS Benchmarks -->
        <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 text-white shadow-card">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
            <h4 class="text-xs font-mono font-black uppercase text-amber-400">🎮 1080p Ultra Benchmarks</h4>
            <span class="text-[10px] font-mono text-emerald-400">Tested 60+ FPS</span>
          </div>

          <div class="flex flex-col gap-3">
            <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">GTA 5 / GTA 6</span>
              <span class="text-sm font-black text-cyan-400 font-mono">{build.gtaFps}</span>
            </div>
            <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">Valorant (Competitive)</span>
              <span class="text-sm font-black text-emerald-400 font-mono">{build.valFps}</span>
            </div>
            <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">Cyberpunk 2077 (DLSS)</span>
              <span class="text-sm font-black text-purple-400 font-mono">{build.cpFps}</span>
            </div>
            <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">BGMI / PUBG PC</span>
              <span class="text-sm font-black text-amber-400 font-mono">{build.bgmiFps}</span>
            </div>
          </div>
        </div>

        <!-- Power & UPS Recommendation -->
        <div class="p-6 rounded-3xl bg-white border border-line shadow-card">
          <h4 class="text-xs font-mono font-bold uppercase text-muted mb-3">⚡ Power Draw & UPS Backup</h4>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between py-1.5 border-b border-slate-100">
              <span class="text-muted">Peak Power Draw</span>
              <span class="font-mono font-bold text-ink">{build.wattage}</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-slate-100">
              <span class="text-muted">Recommended UPS</span>
              <span class="font-mono font-bold text-brand">{build.ups}</span>
            </div>
            <div class="flex justify-between py-1.5">
              <span class="text-muted">Estimated Electricity</span>
              <span class="font-mono font-bold text-emerald-600">~₹320 - ₹450/mo</span>
            </div>
          </div>
        </div>

        <!-- Explore Other 4 Variations -->
        <div class="p-6 rounded-3xl bg-slate-50 border border-line">
          <h4 class="text-xs font-mono font-bold uppercase text-muted mb-3">Explore Other Builds</h4>
          <div class="flex flex-col gap-2">
            <a href="/builds/student-35000" class="p-2.5 rounded-xl bg-white hover:bg-slate-100 border border-line text-xs font-bold text-ink flex items-center justify-between">
              <span>Student Budget (₹35,000)</span>
              <span>➔</span>
            </a>
            <a href="/builds/budget-gaming-50000" class="p-2.5 rounded-xl bg-white hover:bg-slate-100 border border-line text-xs font-bold text-ink flex items-center justify-between">
              <span>RTX 4060 Gaming (₹50,000)</span>
              <span>➔</span>
            </a>
            <a href="/builds/editing-workstation-85000" class="p-2.5 rounded-xl bg-white hover:bg-slate-100 border border-line text-xs font-bold text-ink flex items-center justify-between">
              <span>Editing Workstation (₹85,000)</span>
              <span>➔</span>
            </a>
            <a href="/builds/4k-gaming-120000" class="p-2.5 rounded-xl bg-white hover:bg-slate-100 border border-line text-xs font-bold text-ink flex items-center justify-between">
              <span>High-End 4K Gaming (₹1.2L)</span>
              <span>➔</span>
            </a>
            <a href="/builds/rgb-dream-150000" class="p-2.5 rounded-xl bg-white hover:bg-slate-100 border border-line text-xs font-bold text-ink flex items-center justify-between">
              <span>Ultimate ARGB Dream (₹1.5L)</span>
              <span>➔</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>

  <AdSlot position="footer" />
</Layout>
