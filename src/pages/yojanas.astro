    documents: ['बिजली बिल (Latest Electricity Bill)', 'आधार कार्ड', 'बैंक पासबुक (DBT Active)', 'छत के स्वामित्व का प्रमाण'],
    steps: [
      'pmsuryaghar.gov.in पोर्टल पर जाएं और "Apply for Rooftop Solar" पर क्लिक करें',
      'अपना राज्य, डिस्कॉम (DISCOM) कंपनी व उपभोक्ता संख्या दर्ज करें',
      'पोर्टल से अधिकृत वेंडर चुनकर सोलर पैनल लगवाएं और बैंक खाते में डायरेक्ट DBT सब्सिडी प्राप्त करें'
    ],
    officialUrl: 'https://pmsuryaghar.gov.in',
    statusBadge: '🟢 ₹78,000 Direct Subsidy Live'
  },
  {
    id: 'pm-kisan',
    name: 'PM Kisan Samman Nidhi Yojana',
    nameHindi: 'पीएम किसान सम्मान निधि (19वीं किस्त स्टेटस)',
    category: 'kisan',
    benefit: '₹6,000 प्रति वर्ष (₹2,000 हर 4 महीने में DBT)',
    benefitBadgeColor: 'bg-emerald-600 text-white',
    authority: 'Ministry of Agriculture & Farmers Welfare',
    stateBadge: '🇮🇳 All-India / केंद्र सरकार',
    stateTag: 'all',
