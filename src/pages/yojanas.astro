---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

interface Yojana {
  id: string;
  name: string;
  nameHindi: string;
  category: 'kisan' | 'women' | 'health' | 'youth' | 'housing';
  benefit: string;
  benefitBadgeColor: string;
  authority: string;
  stateBadge: string;
  stateTag: string;
  summary: string;
  eligibility: string[];
  documents: string[];
  steps: string[];
  officialUrl: string;
  statusBadge: string;
}

const YOJANAS: Yojana[] = [
  {
