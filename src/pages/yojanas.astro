---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

import { getYojanas, type YojanaItem } from '../lib/db';

const runtime = (Astro.locals as any)?.runtime;
const YOJANAS: YojanaItem[] = await getYojanas(runtime?.env);
const siteOrigin = Astro.url.origin;


// Schema for Google Featured Snippets
const yojanasSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'name': 'Sarkari Yojana Direct Portal 2026 — PM Kisan, Ayushman Card, Ladli Behna & Awas Yojana',
  'mainEntity': YOJANAS.map(y => ({
    '@type': 'Question',
    'name': `${y.name} (${y.nameHindi}) का लाभ कैसे लें और स्टेटस कैसे चेक करें?`,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': `${y.summary} मुख्य लाभ: ${y.benefit}. आवश्यक दस्तावेज: ${y.documents.join(', ')}. आधिकारिक पोर्टल: ${y.officialUrl}`
    }
  }))
};
---

<Layout
  title="Sarkari Yojana 2026 Portal — PM Kisan, Ayushman Bharat, Ladli Behna & Free Tablet List"
  description="केंद्रीय व राज्य सरकारी योजनाओं की संपूर्ण गाइड। पीएम किसान 19वीं किस्त, आयुष्मान कार्ड ₹5 लाख मुफ्त इलाज, लाडली बहना स्टेटस व पीएम आवास योजना लिस्ट चेक करें।"
>
  <script type="application/ld+json" set:html={JSON.stringify(yojanasSchema)} />

  <!-- Hero Header -->
  <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-slate-950 via-emerald-950 to-slate-900 border border-slate-800 text-white p-6 sm:p-10 mb-10 shadow-2xl">
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-semibold mb-4 backdrop-blur-md">
        <span>🏛️ Sarkari Yojana &amp; DBT Guide 2026</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight mb-4">
        सरकारी योजना व डायरेक्ट लाभ पोर्टल <br />
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300 bg-clip-text text-transparent">
          आधिकारिक लिस्ट, स्टेटस व ऑनलाइन आवेदन
        </span>
      </h1>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
        केंद्र व राज्य सरकारों की जनकल्याणकारी योजनाओं का पूरा विवरण। बिना किसी बिचौलिए या फर्जी एजेंट के <strong>सीधे आधिकारिक पोर्टल से अपना नाम, किस्त स्टेटस और पात्रता चेक करें</strong>।
      </p>

      <!-- Trust Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-emerald-400 font-bold block">✓ 0% FAKE LINKS</span>
          <span class="text-slate-400">Direct .gov.in URLs</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-amber-400 font-bold block">⚡ LIVE DBT</span>
          <span class="text-slate-400">Direct Bank Transfer</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-cyan-400 font-bold block">📋 STEP-BY-STEP</span>
          <span class="text-slate-400">Easy Hindi Guide</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-purple-400 font-bold block">🛡️ FREE ADVICE</span>
          <span class="text-slate-400">Zero Charges Ever</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Exam Prep & Current Affairs Cross-Link Banner -->
  <div class="bg-gradient-to-r from-amber-500/10 via-purple-500/10 to-blue-500/10 border border-amber-300/40 rounded-2xl p-4 sm:p-5 mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-amber-400 text-slate-950 font-black text-xl flex items-center justify-center shrink-0 shadow-xs">
        ⚡
      </div>
      <div>
        <h3 class="text-sm font-black text-ink">सरकारी नौकरी या प्रतियोगी परीक्षा की तैयारी कर रहे हैं?</h3>
        <p class="text-xs text-muted mt-0.5">आज के राष्ट्रीय घटनाक्रम, बजट आंकड़े और Daily GK Quiz अभी हल करें।</p>
      </div>
    </div>
    <a href="/current-affairs" class="px-4 py-2 rounded-xl bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs shrink-0 transition flex items-center gap-1.5 shadow-sm">
      <span>Daily Current Affairs पढ़ें</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>

  <!-- Category Filter & Live Search Bar -->
  <div class="sticky top-20 z-40 bg-white/95 backdrop-blur-md border border-slate-200/90 rounded-2xl p-3 sm:p-4 shadow-sm mb-8">
    <!-- Live Keystroke Search Box -->
    <div class="mb-3.5 flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="relative w-full md:max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">🔍</span>
        <input 
          type="text" 
          id="yojana-search-input" 
          placeholder="योजना, सब्सिडी या राज्य खोजें (e.g. Solar, Kisan, Ladli, Awas, UP)..."
          class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white focus:border-emerald-600 focus:outline-none text-xs sm:text-sm text-slate-900 transition font-medium"
        />
      </div>
      <div class="flex items-center gap-1.5 text-xs text-slate-500 font-mono w-full md:w-auto justify-between md:justify-end">
        <span>योजनाएं प्रदर्शित:</span>
        <span id="active-count" class="font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-lg">7 Schemes Active</span>
      </div>
    </div>

    <!-- Category Pills -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth">
      <button class="yojana-filter active px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition whitespace-nowrap bg-emerald-700 text-white shadow-xs" data-cat="all">
        🏛️ All Schemes (7)
      </button>
      <button class="yojana-filter px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="housing">
        ⚡ सोलर व आवास (Solar & PMAY)
      </button>
      <button class="yojana-filter px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="kisan">
        🌾 किसान योजनाएं (PM Kisan)
      </button>
      <button class="yojana-filter px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="health">
        🏥 स्वास्थ्य (Ayushman Bharat)
      </button>
      <button class="yojana-filter px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="women">
        👩 महिला कल्याण (Ladli Behna)
      </button>
      <button class="yojana-filter px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="youth">
        🎓 युवा व रोजगार (Loans & Tablets)
      </button>
    </div>
  </div>

  <!-- Yojanas Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16" id="yojanas-container">
    {YOJANAS.map((yojana, idx) => (
      <article
        id={yojana.id}
        class="yojana-card flex flex-col justify-between rounded-3xl bg-white border border-slate-200/90 shadow-card hover:shadow-soft transition-all duration-300 p-6 sm:p-7 relative overflow-hidden"
        data-category={yojana.category}
        data-search={`${yojana.name} ${yojana.nameHindi} ${yojana.authority} ${yojana.stateBadge} ${yojana.summary} ${yojana.benefit}`.toLowerCase()}
      >
        <!-- Top Status Bar -->
        <div class="flex items-center justify-between gap-2 mb-4 flex-wrap">
          <span class={`px-3 py-1 rounded-full text-xs font-black tracking-wide ${yojana.benefitBadgeColor} shadow-xs`}>
            {yojana.benefit}
          </span>
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[11px] font-bold text-slate-700 bg-slate-100 border border-slate-200 px-2.5 py-0.5 rounded-full">
              {yojana.stateBadge}
            </span>
            <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
              {yojana.statusBadge}
            </span>
          </div>
        </div>

        <!-- Title & Authority -->
        <div class="mb-4 pb-4 border-b border-slate-100">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 leading-tight mb-1">
            {yojana.name}
          </h2>
          <p class="text-sm font-bold text-emerald-700 mb-1">
            {yojana.nameHindi}
          </p>
          <span class="text-xs text-slate-400 block font-mono">
            नोडल विभाग: {yojana.authority}
          </span>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-5">
          {yojana.summary}
        </p>

        {yojana.id === 'pm-surya-ghar' && (
          <div class="mb-5 p-4 rounded-2xl bg-gradient-to-r from-amber-500/15 via-emerald-500/10 to-amber-500/15 border border-amber-300/80 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-amber-500 text-slate-950 font-black text-lg flex items-center justify-center shrink-0 shadow-xs">
                ☀️
              </div>
              <div>
                <span class="text-xs font-black text-slate-900 block">अपना बिजली बिल डालकर सब्सिडी चेक करें</span>
                <span class="text-[11px] text-slate-600">देखें आपको ₹30,000, ₹60,000 या ₹78,000 में से कितनी सब्सिडी मिलेगी।</span>
              </div>
            </div>
            <a
              href="/calculators"
              class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 active:scale-95 text-slate-950 font-black text-xs shrink-0 transition flex items-center gap-1.5 shadow-sm"
            >
              <span>⚡ सब्सिडी कैलकुलेटर खोलें</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        )}

        <!-- Eligibility Criteria -->
        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 mb-4 text-xs">
          <span class="font-bold text-slate-900 block mb-1.5">👥 कौन आवेदन कर सकता है (पात्रता):</span>
          <ul class="space-y-1 text-slate-600 list-disc list-inside">
            {yojana.eligibility.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <!-- Required Documents -->
        <div class="p-3 rounded-xl bg-amber-50/70 border border-amber-200/80 mb-5 text-xs">
          <span class="font-bold text-amber-900 block mb-1">📄 जरूरी दस्तावेज (Documents Checklist):</span>
          <p class="text-amber-800 font-medium">
            {yojana.documents.join(' • ')}
          </p>
        </div>

        <!-- Step-by-Step Status Check -->
        <div class="p-3.5 rounded-2xl bg-indigo-50/60 border border-indigo-100 mb-6 text-xs">
          <span class="font-bold text-indigo-900 block mb-2">📋 स्टेटस चेक व आवेदन करने का तरीका:</span>
          <ol class="space-y-1.5 text-indigo-950 list-decimal list-inside">
            {yojana.steps.map(step => (
              <li>{step}</li>
            ))}
          </ol>
        </div>

        <!-- Actions: Official Link CTA & WhatsApp Share Button -->
        <div class="mt-auto pt-2">
          <div class="flex items-center gap-2">
            <a
              href={yojana.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:brightness-105 active:scale-98 text-white font-black text-xs sm:text-sm transition shadow-md"
            >
              <span>🔗 आधिकारिक पोर्टल पर आवेदन / स्टेटस देखें</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`🏛️ *${yojana.name} (${yojana.nameHindi})*\n\n💰 *लाभ:* ${yojana.benefit}\n📋 *पात्रता व आवेदन प्रक्रिया:* पूरी जानकारी और डायरेक्ट लिंक यहां देखें:\n${siteOrigin}/yojanas#${yojana.id}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-600 active:scale-98 text-white font-bold text-xs flex items-center gap-1.5 transition shrink-0 shadow-md"
              title="व्हाट्सएप पर शेयर करें"
            >
              <span class="text-base">📲</span>
              <span class="hidden sm:inline">शेयर करें</span>
            </a>
          </div>
          <span class="block text-center text-[10px] text-slate-400 mt-2 font-mono">
            Direct Official Link ({yojana.officialUrl}) • 100% नि:शुल्क सरकारी सेवा
          </span>
        </div>
      </article>
    ))}
  </div>

  <!-- Safety Advisory Box -->
  <div class="max-w-4xl mx-auto rounded-3xl bg-rose-50 border border-rose-200 p-6 sm:p-8 text-rose-950 mb-16">
    <div class="flex items-center gap-2.5 mb-2 font-black text-base sm:text-lg text-rose-900">
      <span class="text-xl">⚠️</span>
      <h3>महत्वपूर्ण धोखाधड़ी चेतावनी (Anti-Fraud Advisory)</h3>
    </div>
    <p class="text-xs sm:text-sm leading-relaxed text-rose-900/90 mb-3">
      सरकारी योजनाओं के लिए किसी भी व्यक्ति, व्हाट्सएप ग्रुप या अनधिकृत एजेंट को कभी भी पैसे न दें। सभी सरकारी योजनाओं के फॉर्म केवल <strong>.gov.in</strong> या <strong>.nic.in</strong> से समाप्त होने वाले आधिकारिक डोमेन पर ही मुफ्त में भरे जाते हैं।
    </p>
    <div class="text-[11px] font-mono text-rose-800">
      संदेह होने पर तुरंत नेशनल साइबर क्राइम पोर्टल (cybercrime.gov.in या टोल-फ्री 1930) पर रिपोर्ट करें।
    </div>
  </div>

  <!-- Interactive Search & Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.yojana-filter');
      const cards = document.querySelectorAll('.yojana-card');
      const searchInput = document.getElementById('yojana-search-input');
      const counter = document.getElementById('active-count');

      let currentCategory = 'all';
      let currentQuery = '';

      function filterCards() {
        let visibleCount = 0;
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const searchData = card.getAttribute('data-search') || '';

          const matchCat = currentCategory === 'all' || category === currentCategory;
          const matchQuery = !currentQuery || searchData.includes(currentQuery);

          if (matchCat && matchQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (counter) {
          counter.textContent = `${visibleCount} Schemes Active`;
        }
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('bg-emerald-700', 'text-white', 'shadow-xs');
            b.classList.add('text-slate-700', 'hover:bg-slate-100');
          });
          btn.classList.add('bg-emerald-700', 'text-white', 'shadow-xs');
          btn.classList.remove('text-slate-700', 'hover:bg-slate-100');

          currentCategory = btn.getAttribute('data-cat') || 'all';
          filterCards();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target.value || '').trim().toLowerCase();
          filterCards();
        });
      }
    });
  </script>
</Layout>
