    eligibility: [
      'भारत का कोई भी किसान जिसके नाम खेती योग्य जमीन है',
      'बैंक खाता आधार कार्ड और NPCI से DBT-लिंक्ड होना अनिवार्य है',
      'ई-केवाईसी (e-KYC) और लैंड सीडिंग (Land Seeding) पूरी होनी चाहिए'
    ],
    documents: ['आधार कार्ड', 'खतौनी / जमीन के दस्तावेज (Bhulekh)', 'आधार लिंक्ड बैंक पासबुक', 'मोबाइल नंबर'],
