        </div>

        <!-- Step-by-Step Status Check -->
        <div class="p-3.5 rounded-2xl bg-indigo-50/60 border border-indigo-100 mb-6 text-xs">
          <span class="font-bold text-indigo-900 block mb-2">📋 स्टेटस चेक व आवेदन करने का तरीका:</span>
