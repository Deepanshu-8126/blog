  <!-- Safety Advisory Box -->
  <div class="max-w-4xl mx-auto rounded-3xl bg-rose-50 border border-rose-200 p-6 sm:p-8 text-rose-950 mb-16">
    <div class="flex items-center gap-2.5 mb-2 font-black text-base sm:text-lg text-rose-900">
      <span class="text-xl">⚠️</span>
      <h3>महत्वपूर्ण धोखाधड़ी चेतावनी (Anti-Fraud Advisory)</h3>
    </div>
    <p class="text-xs sm:text-sm leading-relaxed text-rose-900/90 mb-3">
      सरकारी योजनाओं के लिए किसी भी व्यक्ति, व्हाट्सएप ग्रुप या अनधिकृत एजेंट को कभी भी पैसे न दें। सभी सरकारी योजनाओं के फॉर्म केवल <strong>.gov.in</strong> या <strong>.nic.in</strong> से समाप्त होने वाले आधिकारिक डोमेन पर ही मुफ्त में भरे जाते हैं।
    </p>
    <div class="text-[11px] font-mono text-rose-800">
      संदेह होने पर तुरंत नेशनल साइबर क्राइम पोर्टल (cybercrime.gov.in या टोल-फ्री 1930) पर रिपोर्ट करें।
    </div>
  </div>

  <!-- Interactive Search & Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.yojana-filter');
      const cards = document.querySelectorAll('.yojana-card');
      const searchInput = document.getElementById('yojana-search-input');
      const counter = document.getElementById('active-count');

      let currentCategory = 'all';
      let currentQuery = '';

      function filterCards() {
        let visibleCount = 0;
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const searchData = card.getAttribute('data-search') || '';

          const matchCat = currentCategory === 'all' || category === currentCategory;
          const matchQuery = !currentQuery || searchData.includes(currentQuery);

          if (matchCat && matchQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (counter) {
          counter.textContent = `${visibleCount} Schemes Active`;
        }
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('bg-emerald-700', 'text-white', 'shadow-xs');
            b.classList.add('text-slate-700', 'hover:bg-slate-100');
          });
          btn.classList.add('bg-emerald-700', 'text-white', 'shadow-xs');
          btn.classList.remove('text-slate-700', 'hover:bg-slate-100');

          currentCategory = btn.getAttribute('data-cat') || 'all';
          filterCards();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target.value || '').trim().toLowerCase();
          filterCards();
        });
      }
    });
  </script>
</Layout>
