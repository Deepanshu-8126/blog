      'Aadhaar OTP से e-KYC करें और 5 मिनट में डिजिटल आयुष्मान कार्ड डाउनलोड करें'
    ],
    officialUrl: 'https://beneficiary.nha.gov.in',
    statusBadge: '🟢 70+ Age Open for All'
  },
  {
    id: 'ladli-behna',
    name: 'Mukhyamantri Ladli Behna Yojana',
    nameHindi: 'मुख्यमंत्री लाडली बहना योजना (₹1,250 मासिक सहायता)',
    category: 'women',
    benefit: '₹1,250 हर महीने सीधे बैंक खाते में (₹15,000 सालाना)',
    benefitBadgeColor: 'bg-pink-600 text-white',
    authority: 'महिला एवं बाल विकास विभाग (WCD)',
    stateBadge: '🌟 मध्य प्रदेश विशेष (MP State)',
    stateTag: 'mp',
    summary: 'महिलाओं को आर्थिक रूप से आत्मनिर्भर और सशक्त बनाने के लिए राज्य सरकार की डायरेक्ट मंथली ट्रांसफर स्कीम।',
    eligibility: [
      'महिला की उम्र 21 से 60 वर्ष के बीच होनी चाहिए',
      'परिवार की वार्षिक आय ₹2.5 लाख से कम होनी चाहिए',
      'परिवार में कोई आयकरदाता (Income Tax Payer) या सरकारी कर्मचारी न हो'
    ],
    documents: ['समग्र आईडी (Samagra ID)', 'आधार कार्ड', 'बैंक खाता (Aadhaar DBT Enabled)', 'मोबाइल नंबर'],
    steps: [
      'cmladlibahna.mp.gov.in पोर्टल पर जाएं',
      '"आवेदन की स्थिति" (Application Status) पर क्लिक करें',
      'अपनी समग्र आईडी दर्ज करें और मासिक भुगतान का स्टेटस चेक करें'
    ],
    officialUrl: 'https://cmladlibahna.mp.gov.in',
    statusBadge: '🟢 Monthly DBT Live'
  },
  {
    id: 'pm-mudra-loan',
    name: 'Pradhan Mantri MUDRA Yojana (PMMY)',
    nameHindi: 'प्रधानमंत्री मुद्रा लोन योजना (₹20 लाख तक बिना गारंटी लोन)',
    category: 'youth',
    benefit: '₹50,000 से ₹20 लाख तक का बिजनेस लोन (बिना किसी गारंटी/कोलेटरल)',
    benefitBadgeColor: 'bg-blue-600 text-white',
    authority: 'Ministry of Finance & SIDBI',
    stateBadge: '🇮🇳 All-India / युवा व व्यापारी',
    stateTag: 'all',
    summary: 'छोटे व्यापारियों, स्टार्टअप्स, दुकानदारों और युवाओं को अपना व्यवसाय शुरू करने या बढ़ाने के लिए सस्ता सरकारी लोन।',
    eligibility: [
      '18 वर्ष से अधिक आयु का कोई भी भारतीय नागरिक',
      'गैर-कॉर्पोरेट, गैर-कृषि लघु/सूक्ष्म व्यवसाय (दुकान, मैन्युफैक्चरिंग, सर्विस)',
      'पिछला कोई बैंक लोन डिफॉल्ट न हो (Clean CIBIL History)'
    ],
    documents: ['आधार कार्ड और पैन कार्ड', 'बिजनेस का पता और कोटेशन/प्रोजेक्ट रिपोर्ट', 'पिछले 6 महीने का बैंक स्टेटमेंट'],
    steps: [
      'udyamimitra.in या नजदीकी किसी भी सरकारी बैंक शाखा में संपर्क करें',
      'शिशु (₹50k तक), किशोर (₹5L तक) या तरुण (₹20L तक) कैटेगरी चुनें',
      'आवेदन फॉर्म भरकर आवश्यक दस्तावेज संलग्न करें'
    ],
    officialUrl: 'https://www.mudra.org.in',
    statusBadge: '🟢 Limit Raised to ₹20L'
  },
  {
    id: 'pm-awas-yojana',
    name: 'Pradhan Mantri Awas Yojana (PMAY-G & U)',
    nameHindi: 'प्रधानमंत्री आवास योजना (पक्का मकान के लिए ₹1.20 लाख से ₹2.5 लाख सब्सिडी)',
    category: 'housing',
    benefit: 'ग्रामीण क्षेत्रों में ₹1,20,000 और शहरी क्षेत्रों में ₹2.5 लाख तक की सीधी सरकारी मदद',
    benefitBadgeColor: 'bg-amber-600 text-white',
    authority: 'Ministry of Housing & Urban Affairs / Rural Development',
    stateBadge: '🇮🇳 All-India / ग्रामीण व शहरी',
    stateTag: 'all',
    summary: 'कच्चे घरों में रहने वाले गरीब और मध्यमवर्गीय परिवारों को पक्का पक्का मकान बनाने के लिए सरकारी आर्थिक सहायता।',
    eligibility: [
      'परिवार के पास देश में कहीं भी कोई पक्का मकान नहीं होना चाहिए',
      'SECC सूची या आवास+ सर्वे में नाम दर्ज होना चाहिए',
      'BPL / EWS / LIG श्रेणी के अंतर्गत आते हों'
    ],
    documents: ['आधार कार्ड', 'जॉब कार्ड (मनरेगा)', 'बैंक पासबुक', 'जमीन का पट्टा / खसरा'],
    steps: [
      'pmayg.nic.in पोर्टल पर जाएं और "AwaasSoft" मेन्यू खोलें',
      '"Beneficiary Details" पर क्लिक करके अपना रजिस्ट्रेशन नंबर या नाम से लिस्ट में नाम चेक करें',
      'ग्राम पंचायत या नगर निगम कार्यालय से सत्यापन पूरा कराएं'
    ],
    officialUrl: 'https://pmayg.nic.in',
    statusBadge: '🟢 PMAY 2.0 Scheme Active'
  },
  {
    id: 'pm-free-tablet',
    name: 'Swami Vivekananda Yuva Sashaktikaran (Free Smartphone / Tablet)',
    nameHindi: 'स्वामी विवेकानंद युवा सशक्तिकरण योजना (मुफ्त टैबलेट व स्मार्टफोन)',
    category: 'youth',
    benefit: 'उच्च शिक्षा और तकनीकी कोर्स कर रहे छात्रों को बिल्कुल मुफ्त स्मार्टफोन या टैबलेट',
    benefitBadgeColor: 'bg-purple-600 text-white',
    authority: 'Department of IT & Electronics',
    stateBadge: '🌟 उत्तर प्रदेश विशेष (UP State)',
    stateTag: 'up',
    summary: 'कॉलेज, यूनिवर्सिटी और आईटीआई (ITI) के छात्रों को डिजिटल पढ़ाई और रोजगार की तैयारी के लिए फ्री गैजेट वितरण।',
    eligibility: [
      'संबंधित राज्य का मूल निवासी छात्र होना चाहिए',
      'ग्रेजुएशन, पोस्ट-ग्रेजुएशन, डिप्लोमा, आईटीआई या मेडिकल कोर्स में अध्ययनरत',
      'कॉलेज द्वारा डिजी शक्ति पोर्टल पर डेटा वेरीफाइड होना चाहिए'
    ],
    documents: ['कॉलेज आईडी कार्ड व फीस रसीद', 'आधार कार्ड', 'निवास प्रमाण पत्र', '10वीं व 12वीं की मार्कशीट'],
    steps: [
      'digishakti.up.gov.in पोर्टल पर जाएं',
      '"छात्र कॉर्नर" (Student Corner) में जाकर अपना नामांकन नंबर (Enrollment No) दर्ज करें',
      'चेक करें कि आपके कॉलेज ने आपका नाम टैबलेट वितरण सूची में फॉरवर्ड किया है या नहीं'
    ],
    officialUrl: 'https://digishakti.up.gov.in',
    statusBadge: '🟢 Distribution Phase Live'
  }
];

// Schema for Google Featured Snippets
const yojanasSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'name': 'Sarkari Yojana Direct Portal 2026 — PM Kisan, Ayushman Card, Ladli Behna & Awas Yojana',
  'mainEntity': YOJANAS.map(y => ({
    '@type': 'Question',
    'name': `${y.name} (${y.nameHindi}) का लाभ कैसे लें और स्टेटस कैसे चेक करें?`,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': `${y.summary} मुख्य लाभ: ${y.benefit}. आवश्यक दस्तावेज: ${y.documents.join(', ')}. आधिकारिक पोर्टल: ${y.officialUrl}`
    }
  }))
};
---

<Layout
  title="Sarkari Yojana 2026 Portal — PM Kisan, Ayushman Bharat, Ladli Behna & Free Tablet List"
  description="केंद्रीय व राज्य सरकारी योजनाओं की संपूर्ण गाइड। पीएम किसान 19वीं किस्त, आयुष्मान कार्ड ₹5 लाख मुफ्त इलाज, लाडली बहना स्टेटस व पीएम आवास योजना लिस्ट चेक करें।"
>
  <script type="application/ld+json" set:html={JSON.stringify(yojanasSchema)} />

  <!-- Hero Header -->
  <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-slate-950 via-emerald-950 to-slate-900 border border-slate-800 text-white p-6 sm:p-10 mb-10 shadow-2xl">
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-semibold mb-4 backdrop-blur-md">
        <span>🏛️ Sarkari Yojana &amp; DBT Guide 2026</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight mb-4">
        सरकारी योजना व डायरेक्ट लाभ पोर्टल <br />
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300 bg-clip-text text-transparent">
          आधिकारिक लिस्ट, स्टेटस व ऑनलाइन आवेदन
        </span>
      </h1>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
        केंद्र व राज्य सरकारों की जनकल्याणकारी योजनाओं का पूरा विवरण। बिना किसी बिचौलिए या फर्जी एजेंट के <strong>सीधे आधिकारिक पोर्टल से अपना नाम, किस्त स्टेटस और पात्रता चेक करें</strong>।
      </p>

      <!-- Trust Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-emerald-400 font-bold block">✓ 0% FAKE LINKS</span>
          <span class="text-slate-400">Direct .gov.in URLs</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-amber-400 font-bold block">⚡ LIVE DBT</span>
          <span class="text-slate-400">Direct Bank Transfer</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-cyan-400 font-bold block">📋 STEP-BY-STEP</span>
          <span class="text-slate-400">Easy Hindi Guide</span>
        </div>
        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-purple-400 font-bold block">🛡️ FREE ADVICE</span>
          <span class="text-slate-400">Zero Charges Ever</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Exam Prep & Current Affairs Cross-Link Banner -->
  <div class="bg-gradient-to-r from-amber-500/10 via-purple-500/10 to-blue-500/10 border border-amber-300/40 rounded-2xl p-4 sm:p-5 mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-amber-400 text-slate-950 font-black text-xl flex items-center justify-center shrink-0 shadow-xs">
        ⚡
      </div>
      <div>
        <h3 class="text-sm font-black text-ink">सरकारी नौकरी या प्रतियोगी परीक्षा की तैयारी कर रहे हैं?</h3>
