        </div>

        <!-- Required Documents -->
        <div class="p-3 rounded-xl bg-amber-50/70 border border-amber-200/80 mb-5 text-xs">
          <span class="font-bold text-amber-900 block mb-1">📄 जरूरी दस्तावेज (Documents Checklist):</span>
          <p class="text-amber-800 font-medium">
            {yojana.documents.join(' • ')}
