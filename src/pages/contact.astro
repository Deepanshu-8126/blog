---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — UniqueDigit" description="Get in touch with the UniqueDigit editorial and partnership team.">
  <div class="max-w-2xl mx-auto py-12">
    <h1 class="text-3xl sm:text-4xl font-black text-ink mb-4">Contact UniqueDigit</h1>
    <p class="text-sm text-muted mb-8">
      Have a question, feedback, or business inquiry? Fill out the form below or write directly to our desk.
    </p>

    <div class="p-8 rounded-3xl bg-white border border-line shadow-card mb-8">
      <form class="flex flex-col gap-4" onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent to our team.');">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Your Name</label>
          <input type="text" required placeholder="Aman Sharma" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Email Address</label>
          <input type="email" required placeholder="aman@example.com" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Subject</label>
          <input type="text" required placeholder="Editorial Feedback / Partnership" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Message</label>
          <textarea rows="4" required placeholder="Write your message here..." class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-brand hover:bg-brand-dark text-white font-black text-sm transition shadow-md cursor-pointer mt-2">
          Send Message
        </button>
      </form>
    </div>

    <div class="text-xs text-muted text-center">
      <span>Official Contact: </span>
      <a href="mailto:contact@uniquedigit.in" class="text-brand font-bold">contact@uniquedigit.in</a>
    </div>
  </div>
</Layout>
