---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — UniqueDigit" description="Get in touch with the UniqueDigit editorial and partnership team.">
  <div class="max-w-2xl mx-auto py-12">
    <h1 class="text-3xl sm:text-4xl font-black text-ink mb-4">Contact UniqueDigit</h1>
    <p class="text-sm text-muted mb-8">
      Have a question, feedback, or business inquiry? Fill out the form below or write directly to our desk.
    </p>

    <div class="p-8 rounded-3xl bg-white border border-line shadow-card mb-8">
      <div id="contact-status" class="hidden mb-4 p-4 rounded-xl text-sm font-medium"></div>

      <form id="contact-form" class="flex flex-col gap-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Your Name</label>
          <input type="text" id="contact-name" name="name" required placeholder="Aman Sharma" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Email Address</label>
          <input type="email" id="contact-email" name="email" required placeholder="aman@example.com" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Subject</label>
          <input type="text" id="contact-subject" name="subject" required placeholder="Editorial Feedback / Partnership" class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Message</label>
          <textarea rows="4" id="contact-message" name="message" required placeholder="Write your message here..." class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
        </div>
        <button type="submit" id="contact-btn" class="w-full py-3 rounded-xl bg-brand hover:bg-brand-dark text-white font-black text-sm transition shadow-md cursor-pointer mt-2 disabled:opacity-50">
          Send Message
        </button>
      </form>
    </div>

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement;
      const statusBox = document.getElementById('contact-status');
      const submitBtn = document.getElementById('contact-btn') as HTMLButtonElement;

      if (form && statusBox && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';
          statusBox.className = 'hidden mb-4 p-4 rounded-xl text-sm font-medium';

          const name = (document.getElementById('contact-name') as HTMLInputElement).value;
          const email = (document.getElementById('contact-email') as HTMLInputElement).value;
          const subject = (document.getElementById('contact-subject') as HTMLInputElement).value;
          const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value;

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name, email, subject, message })
            });
            const data = await res.json() as any;

            if (res.ok && data.success) {
              statusBox.textContent = data.message || 'Thank you! Your message has been sent.';
              statusBox.className = 'mb-4 p-4 rounded-xl text-sm font-medium bg-emerald-50 text-emerald-800 border border-emerald-200';
              form.reset();
            } else {
              statusBox.textContent = data.error || 'Failed to submit. Please check your inputs.';
              statusBox.className = 'mb-4 p-4 rounded-xl text-sm font-medium bg-rose-50 text-rose-800 border border-rose-200';
            }
          } catch {
            statusBox.textContent = 'Network error. Please try again later.';
            statusBox.className = 'mb-4 p-4 rounded-xl text-sm font-medium bg-rose-50 text-rose-800 border border-rose-200';
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message';
          }
        });
      }
    </script>

    <div class="text-xs text-muted text-center">
      <span>Official Contact: </span>
      <a href="mailto:contact@uniquedigit.in" class="text-brand font-bold">contact@uniquedigit.in</a>
    </div>
  </div>
</Layout>
