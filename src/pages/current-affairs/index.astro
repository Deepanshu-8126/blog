---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getNicheBySlug } from '../../lib/db';
import rawCapsuleData from '../../data/daily_current_affairs.json';

// Load Daily Current Affairs Data (From Local JSON Cache generated by Current Affairs Radar Agent)
let currentCapsule: any = rawCapsuleData?.current || null;
let historyArchives: any[] = rawCapsuleData?.history || [];

// Fallback Seed Capsule if data file is not yet generated
if (!currentCapsule || !currentCapsule.items || currentCapsule.items.length === 0) {
  currentCapsule = {
    date: '2026-10-13',
    display_date: '13 October 2026 / 13 अक्टूबर 2026',
    headline: 'Daily Current Affairs & Live GK Mock Test Capsule',
    total_questions: 10,
    items: [
      {
        id: 'ca-1',
        category: 'National',
        title_en: 'PM-Surya Ghar Muft Bijli Yojana Crosses 1.5 Crore Registrations Across India',
        title_hi: 'पीएम-सूर्य घर मुफ्त बिजली योजना ने पूरे भारत में 1.5 करोड़ पंजीकरण का आंकड़ा पार किया',
        summary: 'Ministry of New and Renewable Energy reported unprecedented rooftop solar adoption under the central subsidy framework.',
        key_bullets: [
          'Direct financial assistance up to ₹78,000 provided for residential solar rooftop units.',
          'Scheme aims to provide 300 units of free monthly electricity to 1 crore households.',
          'Target completion timeline locked for 2027 with ₹75,021 crore budget outlay.'
        ],
        static_gk: {
          fact: 'Ministry of New and Renewable Energy (MNRE)',
          details: 'Headquarters: New Delhi | First established in 1992 as Ministry of Non-Conventional Energy Sources.'
        },
        source: { name: 'PIB New Delhi', url: 'https://pib.gov.in' },
        recommended_video: {
          channel: 'Next Exam & Utkarsh Classes',
          query: 'PM Surya Ghar Yojana current affairs 2026',
          title: 'PM Surya Ghar Rooftop Solar Full Analysis'
        },
        mcq: {
          question: 'What is the maximum central subsidy provided under PM-Surya Ghar Muft Bijli Yojana? / पीएम-सूर्य घर मुफ्त बिजली योजना के तहत अधिकतम कितनी सब्सिडी दी जाती है?',
          options: ['₹50,000', '₹65,000', '₹78,000', '₹1,00,000'],
          correct_index: 2,
          explanation: 'Under the PM-Surya Ghar guidelines, residential households installing up to 3kW systems receive up to ₹78,000 direct benefit transfer.'
        }
      },
      {
        id: 'ca-2',
        category: 'Science & Defense',
        title_en: 'ISRO Successfully Validates Semi-Cryogenic Pre-Burner Ignition for Next-Gen Launch Vehicle (NGLV)',
        title_hi: 'इसरो ने नेक्स्ट-जेन लॉन्च व्हीकल (NGLV) के लिए सेमी-क्रायोजेनिक प्री-बर्नर इग्निशन का सफल परीक्षण किया',
        summary: 'The milestone test at IPRC Mahendragiri powers India’s heavy-lift orbital rocket program capable of lifting 30-tonne payloads to LEO.',
        key_bullets: [
          'Engine utilizes Isrosene (refined kerosene) and Liquid Oxygen (LOX) as propellants.',
          'NGLV will succeed LVM3 for future Indian Space Station (Bharatiya Antariksh Station) modules.',
          'Test verified high-pressure chamber stability and thrust controller margins.'
        ],
        static_gk: {
          fact: 'ISRO (Indian Space Research Organisation)',
          details: 'Founded: 15 August 1969 | Headquarters: Bengaluru | Founder: Dr. Vikram Sarabhai.'
        },
        source: { name: 'ISRO Department of Space', url: 'https://isro.gov.in' },
        recommended_video: {
          channel: 'Drishti IAS & Adda247',
          query: 'ISRO NGLV semi cryogenic engine test analysis',
          title: 'ISRO Heavy-Lift NGLV Rocket Technical Breakdown'
        },
        mcq: {
          question: 'Which propellant combination powers ISRO’s new semi-cryogenic engine? / इसरो का नया सेमी-क्रायोजेनिक इंजन किन ईंधनों पर कार्य करता है?',
          options: ['Liquid Hydrogen + Liquid Oxygen', 'Isrosene (Kerosene) + Liquid Oxygen', 'Hydrazine + UDMH', 'Solid Polymer Propellant'],
          correct_index: 1,
          explanation: 'Semi-cryogenic propulsion utilizes refined kerosene (Isrosene) and liquid oxygen, providing higher density impulse than hypergolic stages.'
        }
      },
      {
        id: 'ca-3',
        category: 'Economy & Banking',
        title_en: 'RBI Monetary Policy Committee Keeps Repo Rate Steady at 6.50% with Neutral Stance',
        title_hi: 'आरबीआई मौद्रिक नीति समिति (MPC) ने रेपो दर को 6.50% पर स्थिर रखा, नीतिगत रुख "तटस्थ" किया',
        summary: 'Governor highlighted robust GDP growth trajectory of 7.2% for FY26 while monitoring headline inflation prints.',
        key_bullets: [
          'Repo rate remains unchanged at 6.50% for the tenth consecutive policy meeting.',
          'Standing Deposit Facility (SDF) rate stands at 6.25% and MSF rate at 6.75%.',
          'Monetary policy stance shifted from "Withdrawal of Accommodation" to "Neutral".'
        ],
        static_gk: {
          fact: 'Monetary Policy Committee (MPC)',
          details: 'Formed under Section 45ZB of RBI Act 1934 | Consists of 6 members (3 RBI + 3 Government appointed).'
        },
        source: { name: 'Reserve Bank of India', url: 'https://rbi.org.in' },
        recommended_video: {
          channel: 'Study IQ & Adda247 Banking',
          query: 'RBI MPC meeting repo rate neutral stance meaning',
          title: 'RBI MPC Meeting Decoded for Banking & SSC Exams'
        },
        mcq: {
          question: 'Under which section of the RBI Act 1934 was the Monetary Policy Committee constituted? / मौद्रिक नीति समिति का गठन आरबीआई अधिनियम 1934 की किस धारा के तहत किया गया था?',
          options: ['Section 22', 'Section 45ZB', 'Section 17', 'Section 35A'],
          correct_index: 1,
          explanation: 'The MPC was instituted in 2016 through Section 45ZB of the Reserve Bank of India Act, 1934.'
        }
      },
      {
        id: 'ca-4',
        category: 'Sports',
        title_en: 'India Sweeps Historic Gold Medals in Open and Women’s Sections at 45th FIDE Chess Olympiad',
        title_hi: '45वें फिडे शतरंज ओलंपियाड में भारत ने ओपन और महिला दोनों वर्गों में ऐतिहासिक स्वर्ण पदक जीते',
        summary: 'D Gukesh and Divya Deshmukh clinched individual gold board medals as Team India dominated the tournament in Budapest.',
        key_bullets: [
          'India became only the third nation in history after USSR and China to achieve a double Olympiad gold sweep.',
          'D Gukesh registered an astonishing performance rating exceeding 3050 on Board 1.',
          'Next 46th Chess Olympiad scheduled for 2026 in Tashkent, Uzbekistan.'
        ],
        static_gk: {
          fact: 'FIDE (International Chess Federation)',
          details: 'Founded: 20 July 1924 in Paris | Headquarters: Lausanne, Switzerland.'
        },
        source: { name: 'FIDE Press Office', url: 'https://fide.com' },
        recommended_video: {
          channel: 'Next Exam & WiFistudy',
          query: 'Chess Olympiad 2024 2026 India gold medal winners list',
          title: 'Chess Olympiad Champions Complete GK Capsule'
        },
        mcq: {
          question: 'Where was the 45th FIDE Chess Olympiad hosted? / 45वां फिडे शतरंज ओलंपियाड किस शहर में आयोजित हुआ था?',
          options: ['Tashkent, Uzbekistan', 'Budapest, Hungary', 'Chennai, India', 'Baku, Azerbaijan'],
          correct_index: 1,
          explanation: 'The 45th FIDE Chess Olympiad was held in Budapest, Hungary, where India made history with double gold.'
        }
      },
      {
        id: 'ca-5',
        category: 'Appointments & Honors',
        title_en: 'Senior Diplomat Vikram Misri Takes Charge as Foreign Secretary of India',
        title_hi: 'वरिष्ठ राजनयिक विक्रम मिस्री ने भारत के नए विदेश सचिव के रूप में कार्यभार संभाला',
        summary: 'A 1989-batch IFS officer, Misri previously served as Deputy National Security Advisor and Ambassador to China.',
        key_bullets: [
          'Succeeded Vinay Mohan Kwatra as the administrative head of the Ministry of External Affairs.',
          'Brings deep strategic expertise on Indo-Pacific diplomacy and Sino-Indian border negotiations.',
          'Tenure oversees upcoming Quad Leader Summit and Global South diplomatic summits.'
        ],
        static_gk: {
          fact: 'Foreign Secretary of India',
          details: 'Administrative head of Indian Foreign Service | Appointed by Appointments Committee of the Cabinet (ACC).'
        },
        source: { name: 'Ministry of External Affairs', url: 'https://mea.gov.in' },
        recommended_video: {
          channel: 'Drishti IAS & Study IQ',
          query: 'Foreign Secretary Vikram Misri foreign policy UPSC',
          title: 'Key Appointments 2026 for UPSC & State PCS'
        },
        mcq: {
          question: 'Who serves as the administrative head of the Ministry of External Affairs in India? / भारत के विदेश मंत्रालय का प्रशासनिक प्रमुख कौन होता है?',
          options: ['Cabinet Secretary', 'Foreign Secretary', 'National Security Advisor', 'Principal Secretary to PM'],
          correct_index: 1,
          explanation: 'The Foreign Secretary is the permanent administrative head of the Ministry of External Affairs and leads the IFS.'
        }
      }
    ]
  };
}

const items = currentCapsule.items || [];
const mcqItems = items.filter((i: any) => i.mcq);
const totalQuestions = mcqItems.length;

// Precompute categories
const categories = ['All', 'National', 'International', 'Economy & Banking', 'Science & Defense', 'Sports', 'Appointments & Honors'];
const chr = (code: number) => String.fromCharCode(code);
---

<Layout
  title={`Daily Current Affairs ${currentCapsule.display_date} & 10-Question Live Mock Test | UniqueDigit`}
  description={`Practice today's high-yield current affairs bullet points and live 10 MCQs GK mock test for UPSC, SSC CGL, Railway & State PCS exams. Verified official bulletins & bilingual explanations.`}
>
  <!-- SEO Structured Data for Education / Quiz -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Quiz',
      name: `Daily Current Affairs & Live GK Mock Test - ${currentCapsule.display_date}`,
      description: `Bilingual GK & Current Affairs practice quiz with ${totalQuestions} questions for government exams.`,
      educationalAlignment: {
        '@type': 'AlignmentObject',
        alignmentType: 'educationalSubject',
        targetName: 'Government Recruitment Examinations & General Knowledge'
      },
      hasPart: mcqItems.map((item: any, idx: number) => ({
        '@type': 'Question',
        name: `Q${idx + 1}: ${item.mcq.question}`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.mcq.options[item.mcq.correct_index]
        }
      }))
    })} />
  </Fragment>

  <!-- Sticky Top Breadcrumb & Live Banner -->
  <div class="w-full">
    
    <!-- Top Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-muted mb-4 px-1 overflow-x-auto no-scrollbar whitespace-nowrap">
      <a href="/" class="hover:text-brand transition font-medium">Home</a>
      <span>/</span>
      <a href="/exams-results" class="hover:text-brand transition font-medium">Exams & Results</a>
      <span>/</span>
      <span class="text-ink font-semibold">Daily Current Affairs & Live Mock Test</span>
    </nav>

    <!-- Hero Header Banner (Jagran Josh + Drishti IAS Architecture) -->
    <div class="mb-8 rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white p-6 sm:p-10 border border-indigo-700/50 shadow-2xl relative overflow-hidden">
      <!-- Glow Accents -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-400/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2.5 mb-3 flex-wrap">
            <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-400 text-slate-950 shadow-xs">
              ⚡ Live Daily Capsule
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-white/10 text-emerald-300 border border-emerald-400/30">
              🟢 Updated: {currentCapsule.display_date}
            </span>
            <span class="text-xs text-slate-300 font-mono hidden sm:inline">
              · PIB, DD News, AIR & Government Portals
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-3">
            Daily Current Affairs & 10 GK Mock Test MCQs
          </h1>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
            UPSC, SSC CGL, Railway RRB, Banking (IBPS/SBI) एवं राज्य सेवा परीक्षाओं (UPPSC, BPSC, RPSC) के लिए परीक्षा-उपयोगी करंट अफेयर्स बुलेट्स एवं लाइव टेस्ट।
          </p>

          <!-- Exam Target Badges -->
          <div class="flex items-center gap-2 mt-5 flex-wrap">
            <span class="text-xs text-slate-400 font-mono font-bold">Target Exams:</span>
            {['UPSC CSE', 'SSC CGL', 'Railway RRB', 'State PCS', 'Banking & IBPS', 'Defense NDA/CDS'].map((exam) => (
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/5 border border-white/10 text-slate-200">
                {exam}
              </span>
            ))}
          </div>
        </div>

        <!-- Right Quick Action Card -->
        <div class="flex flex-col gap-3 shrink-0 w-full lg:w-72 bg-white/5 p-5 rounded-2xl border border-white/10 backdrop-blur-md">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-amber-300 font-bold">Study Streak</span>
            <span id="streak-badge" class="px-2 py-0.5 rounded-full text-xs font-black bg-amber-400 text-slate-950">
              🔥 1 Day Active
            </span>
          </div>
          <div class="text-xs text-slate-300">
            रोज़ 10 सवाल हल करें और अपनी एक्यूरेसी ट्रैक करें।
          </div>

          <a
            href="#mock-test-section"
            class="w-full text-center py-3 px-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider transition shadow-lg active:scale-95 cursor-pointer"
          >
            Start Live 10 MCQs Test ➔
          </a>

          <button
            id="print-capsule-btn"
            type="button"
            class="w-full text-center py-2 px-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span>🖨️ Print / Save Capsule PDF</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Navigation Tab Switcher (Bullet Points vs Live Mock Test) -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-8 flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <button
          id="tab-btn-bullets"
          type="button"
          class="active-tab-btn px-5 py-2.5 rounded-2xl font-black text-xs sm:text-sm tracking-wide bg-brand text-white shadow-xs cursor-pointer transition flex items-center gap-2"
        >
          <span>📚 Daily Exam Bullets</span>
          <span class="px-2 py-0.5 rounded-full text-[11px] bg-white/20 text-white font-mono">{items.length} Facts</span>
        </button>
        <button
          id="tab-btn-quiz"
          type="button"
          class="inactive-tab-btn px-5 py-2.5 rounded-2xl font-bold text-xs sm:text-sm tracking-wide bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 cursor-pointer transition flex items-center gap-2"
        >
          <span>📝 Live Mock Test</span>
          <span class="px-2 py-0.5 rounded-full text-[11px] bg-amber-100 text-amber-800 font-mono font-bold">10 MCQs</span>
        </button>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/exams-results"
          class="text-xs font-bold text-brand hover:underline flex items-center gap-1"
        >
          <span>🏛️ Check Sarkari Results & Cutoffs &rarr;</span>
        </a>
      </div>
    </div>

    <!-- SECTION 1: Daily Bullet Points Container -->
    <div id="section-bullets" class="space-y-6">
      
      <!-- Category Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`category-filter-btn px-4 py-1.5 rounded-full text-xs font-bold transition shrink-0 cursor-pointer ${
              idx === 0
                ? 'bg-slate-900 text-white shadow-xs'
                : 'bg-white hover:bg-slate-100 text-slate-700 border border-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- High-Yield Bullet Cards Grid -->
      <div class="grid grid-cols-1 gap-6">
        {items.map((item: any, idx: number) => (
          <article
            data-card-category={item.category}
            class="bullet-card bg-white rounded-3xl border border-slate-200/90 shadow-sm p-6 sm:p-8 transition hover:shadow-md relative overflow-hidden"
          >
            <!-- Top Category & Source Tag -->
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100 flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-purple-50 text-brand border border-purple-200">
                  {item.category}
                </span>
                <span class="text-xs font-mono font-bold text-slate-400">
                  Item #{idx + 1}
                </span>
              </div>

              {item.source && (
                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono font-bold bg-slate-50 text-slate-600 border border-slate-200">
                  Source: {item.source.name}
                </span>
              )}
            </div>

            <!-- Bilingual Titles -->
            <h2 class="text-lg sm:text-xl font-black text-slate-900 leading-snug mb-1">
              {item.title_en}
            </h2>
            <h3 class="text-base sm:text-lg font-bold text-slate-700 leading-snug mb-3 text-slate-700 font-hindi">
              {item.title_hi}
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-5">
              {item.summary}
            </p>

            <!-- Key Examination Bullets -->
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80 mb-5">
              <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 mb-3 flex items-center gap-1.5">
                <span>🎯</span>
                <span>परीक्षा-उपयोगी महत्वपूर्ण बिंदु (Key Exam Bullets):</span>
              </h4>
              <ul class="flex flex-col gap-2.5">
                {item.key_bullets?.map((bullet: string) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0 mt-2"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Static GK Hook Box (Drishti IAS Architecture) -->
            {item.static_gk && item.static_gk.fact && (
              <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200/80 text-xs sm:text-sm mb-4">
                <div class="flex items-center gap-2 mb-1 text-amber-900 font-bold">
                  <span>💡</span>
                  <span class="uppercase tracking-wider font-black text-xs">Static GK Connection:</span>
                  <span>{item.static_gk.fact}</span>
                </div>
                <p class="text-slate-700 leading-relaxed pl-6">
                  {item.static_gk.details}
                </p>
              </div>
            )}

            <!-- YouTube Video Recommendation Banner (Brave/Google Search Intelligence) -->
            {item.recommended_video && (
              <div class="p-3 sm:p-4 rounded-xl bg-slate-900 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="w-8 h-8 rounded-lg bg-red-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
                    ▶
                  </div>
                  <div class="min-w-0">
                    <span class="text-[10px] text-slate-400 uppercase font-mono block">Recommended Video Explainer</span>
                    <span class="font-bold text-slate-200 truncate block">{item.recommended_video.title}</span>
                  </div>
                </div>

                <a
                  href={`https://www.youtube.com/results?search_query=${encodeURIComponent(item.recommended_video.query)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3.5 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-xs whitespace-nowrap transition active:scale-95 shrink-0"
                >
                  Watch on YouTube ➔
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>

    <!-- SECTION 2: Interactive 10-Question Live Mock Test -->
    <div id="section-quiz" class="hidden space-y-6">
      
      <!-- Quiz Header & Score Dashboard -->
      <div id="mock-test-section" class="p-6 sm:p-8 rounded-3xl bg-slate-900 text-white shadow-xl border border-indigo-700/50 scroll-mt-24">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-400 text-slate-950">
                Live Test Mode
              </span>
              <span class="text-xs text-slate-300 font-mono">10 High-Probability MCQs</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-white">
              Daily Current Affairs Live Practice Test
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 mt-1">
              प्रत्येक प्रश्न का उत्तर देने पर तुरंत सही उत्तर और व्याख्या दिखेगी।
            </p>
          </div>

          <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10 shrink-0">
            <div class="text-center">
              <span class="text-[10px] font-mono text-slate-400 uppercase block">Attempted</span>
              <span id="quiz-attempted-count" class="text-lg font-black text-white">0 / {mcqItems.length}</span>
            </div>
            <div class="h-8 w-px bg-white/20"></div>
            <div class="text-center">
              <span class="text-[10px] font-mono text-slate-400 uppercase block">Score</span>
              <span id="quiz-score-count" class="text-lg font-black text-amber-400">0</span>
            </div>
          </div>
        </div>
      </div>

      <!-- MCQ Questions List -->
      <div class="space-y-6">
        {mcqItems.map((item: any, qIdx: number) => (
          <div
            id={`question-box-${qIdx}`}
            class="mcq-card bg-white rounded-3xl border border-slate-200/90 shadow-sm p-6 sm:p-8 transition"
            data-correct-index={item.mcq.correct_index}
            data-question-index={qIdx}
          >
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
              <span class="text-xs font-mono font-bold text-slate-400 uppercase">
                Question {qIdx + 1} of {mcqItems.length}
              </span>
              <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-slate-100 text-slate-700">
                {item.category}
              </span>
            </div>

            <!-- Question Text -->
            <h3 class="text-base sm:text-lg font-black text-slate-900 leading-snug mb-5">
              {item.mcq.question}
            </h3>

            <!-- 4 Options Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
              {item.mcq.options?.map((opt: string, optIdx: number) => (
                <button
                  type="button"
                  data-option-index={optIdx}
                  class={`option-btn text-left p-4 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 transition font-medium text-xs sm:text-sm text-slate-800 flex items-center justify-between cursor-pointer active:scale-98`}
                >
                  <div class="flex items-center gap-3">
                    <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 font-bold font-mono text-xs flex items-center justify-center shrink-0">
                      {chr(65 + optIdx)}
                    </span>
                    <span>{opt}</span>
                  </div>
                  <span class="status-icon text-sm opacity-0"></span>
                </button>
              ))}
            </div>

            <!-- Explanation Box (Initially Hidden) -->
            <div class="explanation-box hidden mt-4 p-4 sm:p-5 rounded-2xl bg-indigo-50/80 border border-indigo-200/80 text-xs sm:text-sm animate-fade-in">
              <div class="flex items-center gap-2 mb-1.5 text-indigo-950 font-bold">
                <span>📘</span>
                <span class="uppercase tracking-wider font-black text-xs">Explanation & Solution:</span>
              </div>
              <p class="text-slate-700 leading-relaxed pl-6">
                {item.mcq.explanation}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Final Score Modal / Banner -->
      <div id="quiz-completed-banner" class="hidden p-8 rounded-3xl bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 text-white text-center shadow-2xl border border-emerald-500/40">
        <span class="text-4xl mb-3 block">🎉</span>
        <h3 class="text-2xl font-black mb-2">Test Completed! शानदार प्रदर्शन!</h3>
        <p id="final-score-text" class="text-slate-300 text-sm max-w-md mx-auto mb-6">
          आपने आज का दैनिक करंट अफेयर्स टेस्ट सफलतापूर्वक पूरा कर लिया है।
        </p>
        <button
          id="retake-quiz-btn"
          type="button"
          class="px-6 py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs uppercase tracking-wider transition cursor-pointer active:scale-95 shadow-lg"
        >
          Retake Quiz (पुनः प्रयास करें) ↺
        </button>
      </div>

    </div>

  </div>

  <!-- Client-Side Interactive Engine (Tab Switching, Filter, Quiz Validation, Streak) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // 1. Tab Switching (Bullets vs Quiz)
      const tabBullets = document.getElementById('tab-btn-bullets');
      const tabQuiz = document.getElementById('tab-btn-quiz');
      const secBullets = document.getElementById('section-bullets');
      const secQuiz = document.getElementById('section-quiz');

      function switchTab(target) {
        if (target === 'quiz') {
          secBullets.classList.add('hidden');
          secQuiz.classList.remove('hidden');
          tabBullets.className = 'inactive-tab-btn px-5 py-2.5 rounded-2xl font-bold text-xs sm:text-sm tracking-wide bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 cursor-pointer transition flex items-center gap-2';
          tabQuiz.className = 'active-tab-btn px-5 py-2.5 rounded-2xl font-black text-xs sm:text-sm tracking-wide bg-brand text-white shadow-xs cursor-pointer transition flex items-center gap-2';
        } else {
          secQuiz.classList.add('hidden');
          secBullets.classList.remove('hidden');
          tabQuiz.className = 'inactive-tab-btn px-5 py-2.5 rounded-2xl font-bold text-xs sm:text-sm tracking-wide bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 cursor-pointer transition flex items-center gap-2';
          tabBullets.className = 'active-tab-btn px-5 py-2.5 rounded-2xl font-black text-xs sm:text-sm tracking-wide bg-brand text-white shadow-xs cursor-pointer transition flex items-center gap-2';
        }
      }

      if (tabBullets && tabQuiz) {
        tabBullets.addEventListener('click', () => switchTab('bullets'));
        tabQuiz.addEventListener('click', () => switchTab('quiz'));
      }

      // Check URL hash
      if (window.location.hash === '#mock-test-section') {
        switchTab('quiz');
      }

      // 2. Category Filter for Bullets
      const filterBtns = document.querySelectorAll('.category-filter-btn');
      const bulletCards = document.querySelectorAll('.bullet-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category');
          filterBtns.forEach(b => {
            b.className = 'category-filter-btn px-4 py-1.5 rounded-full text-xs font-bold transition shrink-0 cursor-pointer bg-white hover:bg-slate-100 text-slate-700 border border-slate-200';
          });
          btn.className = 'category-filter-btn px-4 py-1.5 rounded-full text-xs font-bold transition shrink-0 cursor-pointer bg-slate-900 text-white shadow-xs';

          bulletCards.forEach(card => {
            const cardCat = card.getAttribute('data-card-category');
            if (cat === 'All' || cardCat === cat) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // 3. Interactive Quiz Engine
      let attempted = 0;
      let score = 0;
      const totalQuestions = document.querySelectorAll('.mcq-card').length;
      const attemptedEl = document.getElementById('quiz-attempted-count');
      const scoreEl = document.getElementById('quiz-score-count');
      const completedBanner = document.getElementById('quiz-completed-banner');
      const finalScoreText = document.getElementById('final-score-text');

      document.querySelectorAll('.mcq-card').forEach(card => {
        const correctIdx = parseInt(card.getAttribute('data-correct-index'), 10);
        const options = card.querySelectorAll('.option-btn');
        const explBox = card.querySelector('.explanation-box');
        let answered = false;

        options.forEach(opt => {
          opt.addEventListener('click', () => {
            if (answered) return;
            answered = true;
            attempted++;

            const selectedIdx = parseInt(opt.getAttribute('data-option-index'), 10);
            const isCorrect = (selectedIdx === correctIdx);

            if (isCorrect) {
              score++;
              opt.classList.remove('bg-white', 'border-slate-200');
              opt.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-950', 'ring-2', 'ring-emerald-400');
              const icon = opt.querySelector('.status-icon');
              if (icon) { icon.textContent = '✅'; icon.classList.remove('opacity-0'); }
            } else {
              opt.classList.remove('bg-white', 'border-slate-200');
              opt.classList.add('bg-rose-50', 'border-rose-500', 'text-rose-950', 'ring-2', 'ring-rose-400');
              const icon = opt.querySelector('.status-icon');
              if (icon) { icon.textContent = '❌'; icon.classList.remove('opacity-0'); }

              // Highlight correct option
              const correctBtn = options[correctIdx];
              if (correctBtn) {
                correctBtn.classList.remove('bg-white', 'border-slate-200');
                correctBtn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-950');
                const cIcon = correctBtn.querySelector('.status-icon');
                if (cIcon) { cIcon.textContent = '✓ Correct'; cIcon.classList.remove('opacity-0'); }
              }
            }

            // Reveal explanation
            if (explBox) {
              explBox.classList.remove('hidden');
            }

            // Update stats
            if (attemptedEl) attemptedEl.textContent = `${attempted} / ${totalQuestions}`;
            if (scoreEl) scoreEl.textContent = `${score}`;

            // Check completion
            if (attempted === totalQuestions && completedBanner) {
              completedBanner.classList.remove('hidden');
              if (finalScoreText) {
                finalScoreText.textContent = `आपका कुल स्कोर ${score} / ${totalQuestions} (${Math.round((score/totalQuestions)*100)}% एक्यूरेसी) रहा।`;
              }
              // Save to localStorage
              try {
                localStorage.setItem('ud_ca_last_score', score);
                localStorage.setItem('ud_ca_last_date', new Date().toISOString().slice(0, 10));
              } catch (e) {}
            }
          });
        });
      });

      // Retake quiz
      const retakeBtn = document.getElementById('retake-quiz-btn');
      if (retakeBtn) {
        retakeBtn.addEventListener('click', () => {
          window.location.reload();
        });
      }

      // Print capsule
      const printBtn = document.getElementById('print-capsule-btn');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          switchTab('bullets');
          window.print();
        });
      }
    });

    function chr(code) {
      return String.fromCharCode(code);
    }
  </script>
</Layout>
