---
import Layout from '../layouts/Layout.astro';
import BreakingTicker from '../components/BreakingTicker.astro';
import HeroFeature from '../components/HeroFeature.astro';
import CategoryGridCard from '../components/CategoryGridCard.astro';
import NicheCard from '../components/NicheCard.astro';
import TrendingList from '../components/TrendingList.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import Icon from '../components/Icon.astro';
import { getNiches, getTrendingPosts, getPostsByNiche, type Niche, type Post } from '../lib/db';
import { getBoard } from '../lib/kv';
import TrendRow from '../components/TrendRow.astro';
import LiveDot from '../components/LiveDot.astro';
import FreshnessStamp from '../components/FreshnessStamp.astro';

const runtime = (Astro.locals as any)?.runtime;
const niches = await getNiches(runtime?.env);
const trendingPosts = await getTrendingPosts(8, runtime?.env);
const heroPost = trendingPosts[0];
const subTrending = trendingPosts.slice(1);
const board = await getBoard(runtime?.env);
const top5Hype = board.slice(0, 5);
const boardUpdate = board[0]?.updated_at;

// Group samples (one top post per group)
const groups = ['Tech', 'Money', 'Lifestyle', 'Entertainment'];
const groupColors: Record<string, { chip: string; bg: string }> = {
  Tech: { chip: 'bg-tech text-white', bg: 'bg-tech-bg/30' },
  Money: { chip: 'bg-money text-white', bg: 'bg-money-bg/30' },
  Lifestyle: { chip: 'bg-life text-white', bg: 'bg-life-bg/30' },
  Entertainment: { chip: 'bg-ent text-white', bg: 'bg-ent-bg/30' }
};
---

<Layout
  title="UniqueDigit — India's Viral Tech, Deals & Real-Time Intelligence Hub"
  description="Explore daily grounded tech guides, gold rates, generative AI tools directory, PC build benchmarks, and trending viral stories."
>
  <!-- Breaking News Ticker -->
  <BreakingTicker posts={trendingPosts} />

  <!-- Hero Feature: #1 Trending Story -->
  {heroPost && <HeroFeature post={heroPost} />}

  <!-- 12-Hub Category Grid (Reference Mockup Card) -->
  <CategoryGridCard />

  <!-- Hype Today Strip (File 9 Spec: Top 5 Real-Time Pulse) -->
  <div class="my-10 p-5 sm:p-6 rounded-3xl border border-line bg-card shadow-soft">
    <div class="flex items-center justify-between mb-5 flex-wrap gap-2 pb-4 border-b border-line">
      <div class="flex items-center gap-3">
        <LiveDot updatedAt={boardUpdate} />
        <h2 class="text-lg sm:text-xl font-black text-ink tracking-tight flex items-center gap-2">
          <span>🔥 Hype Today</span>
          <span class="text-xs text-brand font-mono font-bold px-2.5 py-0.5 rounded-full bg-brand-soft">Top 5 Live</span>
        </h2>
      </div>
      <div class="flex items-center gap-3">
        <FreshnessStamp updatedAt={boardUpdate} />
        <a
          href="/trending"
          class="text-xs font-bold text-brand hover:text-brand-dark flex items-center gap-1 transition"
        >
          <span>See All 30 Trends</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-2.5">
      {top5Hype.map((item, idx) => (
        <TrendRow item={item} rank={idx + 1} />
      ))}
    </div>
  </div>



  <!-- Top 4 Niches Spotlight -->
  <div class="my-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand font-mono">Real-Time Pulse</span>
        <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">Trending Across Categories</h2>
      </div>
      <a href="#explore-all" class="text-xs font-bold text-brand hover:underline flex items-center gap-1">
        All 12 Hubs <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {subTrending.slice(0, 4).map(p => (
        <NicheCard post={p} />
      ))}
    </div>
  </div>

  <AdSlot position="top" />

  <!-- Main 2-Column Section: Latest Feeds vs Numbered Trending List -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-12">
    
    <!-- Left Column: Featured Feeds -->
    <div class="lg:col-span-8">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-black text-ink tracking-tight flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
          <span>Latest Verified Drops</span>
        </h3>
        <span class="text-xs text-muted font-mono">Updated Every 6 Hours</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {trendingPosts.slice(0, 6).map(p => (
          <NicheCard post={p} />
        ))}
      </div>

      <AdSlot position="mid" />
    </div>

    <!-- Right Column: Numbered Top 05 & Quick Tools -->
    <div class="lg:col-span-4 flex flex-col gap-6">
      <TrendingList posts={trendingPosts} title="Trending Today (Top 05)" />

      <!-- Quick Action Card -->
      <div class="rounded-3xl bg-gradient-to-br from-brand-dark to-brand text-white p-6 shadow-soft">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-cta text-cta-ink inline-block mb-3">
          Tool Directory
        </span>
        <h4 class="font-bold text-base mb-2">Looking for Generative AI or PC Hardware?</h4>
        <p class="text-xs text-purple-100 leading-relaxed mb-4">
          Browse verified tools with authentic benchmarks and Indian pricing.
        </p>
        <div class="flex flex-col gap-2">
          <a href="/ai-tools" class="px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-bold transition flex items-center justify-between">
            <span>Explore AI Tools</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
          <a href="/builds" class="px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-bold transition flex items-center justify-between">
            <span>PC Build Estimator</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
          <a href="/gold-rate" class="px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-bold transition flex items-center justify-between">
            <span>Today's Gold Rate</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <AdSlot position="sidebar" />
    </div>

  </div>

  <!-- Explore All 12 Hubs Grid -->
  <div id="explore-all" class="my-16 pt-12 border-t border-line">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-bold uppercase tracking-wider text-brand font-mono">Dynamic Network</span>
      <h2 class="text-3xl font-black text-ink tracking-tight mt-1">Explore All 12 Specialized Hubs</h2>
      <p class="text-xs text-muted mt-2">
        Every hub runs on live datasets and AI trend clustering, updating automatically with zero stale content.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {niches.map(n => (
        <a
          href={`/${n.slug}`}
          class="group p-5 rounded-2xl bg-white border border-line shadow-card hover:shadow-soft hover:border-brand/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand group-hover:bg-brand group-hover:text-white transition flex items-center justify-center mb-3">
              <Icon name={n.icon} class="w-5 h-5" />
            </div>
            <div class="flex items-center gap-1.5 mb-1">
              <h3 class="font-bold text-sm text-ink group-hover:text-brand transition">{n.name}</h3>
              {n.is_new && (
                <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-breaking text-white">NEW</span>
              )}
            </div>
            <p class="text-xs text-muted line-clamp-2 leading-relaxed">{n.tagline}</p>
          </div>
          <span class="text-[11px] font-bold text-brand mt-4 flex items-center gap-1 group-hover:underline">
            Open Hub <Icon name="arrow-right" class="w-3 h-3 group-hover:translate-x-0.5 transition" />
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- Lead Gen / Newsletter -->
  <NewsletterStrip />
</Layout>
