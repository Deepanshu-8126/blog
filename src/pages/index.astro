---
import Layout from '../layouts/Layout.astro';
import BreakingTicker from '../components/BreakingTicker.astro';
import HeroFeature from '../components/HeroFeature.astro';
import CategoryGridCard from '../components/CategoryGridCard.astro';
import NicheCard from '../components/NicheCard.astro';
import TrendingList from '../components/TrendingList.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import Icon from '../components/Icon.astro';
import { getNiches, getTrendingPosts, getPostsByNiche, type Niche, type Post } from '../lib/db';
import { getBoard } from '../lib/kv';
import TrendRow from '../components/TrendRow.astro';
import LiveDot from '../components/LiveDot.astro';
import FreshnessStamp from '../components/FreshnessStamp.astro';

const runtime = (Astro.locals as any)?.runtime;
const niches = await getNiches(runtime?.env);
const trendingPosts = await getTrendingPosts(8, runtime?.env);
const heroPost = trendingPosts[0];
const subTrending = trendingPosts.slice(1);
const board = await getBoard(runtime?.env);
const top6Hype = board.slice(0, 6);
const boardUpdate = board[0]?.updated_at;

// Group samples (one top post per group)
const groups = ['Tech', 'Money', 'Lifestyle', 'Entertainment'];
const groupColors: Record<string, { chip: string; bg: string }> = {
  Tech: { chip: 'bg-tech text-white', bg: 'bg-tech-bg/30' },
  Money: { chip: 'bg-money text-white', bg: 'bg-money-bg/30' },
  Lifestyle: { chip: 'bg-life text-white', bg: 'bg-life-bg/30' },
  Entertainment: { chip: 'bg-ent text-white', bg: 'bg-ent-bg/30' }
};
---

<Layout
  title="UniqueDigit — India's Real-Time Trends, Tech & Deal Intelligence Hub"
  description="Live tracking Google Trends, gold rates, generative AI tools directory, PC build benchmarks, and verified loot deals across India."
>
  <!-- Breaking News Ticker -->
  <BreakingTicker posts={trendingPosts} />

  <!-- HERO SECTION: Live Google Trends Radar + Multi-Pillar Intel Stack -->
  <div class="my-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    
    <!-- Left Column (8 cols): Real-Time Google Trends Board -->
    <div class="lg:col-span-8 bg-white rounded-3xl border border-slate-200/80 shadow-sm p-5 sm:p-7 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2 pb-4 border-b border-slate-100">
          <div class="flex items-center gap-2.5">
            <LiveDot updatedAt={boardUpdate} />
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                  Google Trends Telemetry (India)
                </span>
                <span class="text-xs text-slate-500 font-mono hidden sm:inline">· 15-min auto-refresh</span>
              </div>
              <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mt-1">
                Trending Across India Right Now
              </h1>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <FreshnessStamp updatedAt={boardUpdate} />
            <a
              href="/trending"
              class="px-3.5 py-1.5 rounded-xl bg-brand text-white text-xs font-bold hover:bg-brand-dark transition flex items-center gap-1 shadow-xs"
            >
              <span>View All 30 Trends</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <p class="text-xs text-slate-500 leading-relaxed mb-4">
          Multi-signal AI radar corroborating Google Trends RSS, Google News, Wikipedia, and YouTube telemetry across India.
        </p>

        <!-- Top 6 Trend Rows -->
        <div class="flex flex-col gap-2.5">
          {top6Hype.map((item, idx) => (
            <TrendRow item={item} rank={idx + 1} />
          ))}
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Verified search spikes with active deal and reading links</span>
        </span>
        <a href="/trending" class="font-bold text-brand hover:underline">
          Explore Trend Radar &rarr;
        </a>
      </div>
    </div>

    <!-- Right Column (4 cols): Live 4-Pillar Intelligence Deck (Gold, AI, Builds, Deals) -->
    <div class="lg:col-span-4 flex flex-col gap-3.5">
      
      <!-- 1. Live Gold Rate Module -->
      <a href="/gold-rate" class="group block rounded-2xl bg-white border border-slate-200/90 p-4 shadow-xs hover:border-amber-400 hover:shadow-sm transition">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1">
            <span>🪙</span> Bullion Market
          </span>
          <span class="text-[10px] font-bold text-emerald-600 font-mono">+₹250 Today</span>
        </div>
        <div class="flex items-baseline justify-between">
          <div>
            <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-amber-600 transition">24K Gold Rate (10g)</h3>
            <p class="text-[11px] text-slate-500">Live Mumbai, Delhi & 8 City Rates</p>
          </div>
          <span class="text-base font-black text-slate-900 font-mono">₹76,850</span>
        </div>
      </a>

      <!-- 2. AI Tools Directory Module -->
      <a href="/ai-tools" class="group block rounded-2xl bg-white border border-slate-200/90 p-4 shadow-xs hover:border-blue-400 hover:shadow-sm transition">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1">
            <span>🤖</span> AI Directory
          </span>
          <span class="text-[10px] font-bold text-blue-600 font-mono">50+ Vetted</span>
        </div>
        <div class="flex items-baseline justify-between">
          <div>
            <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-blue-600 transition">Generative AI Tools</h3>
            <p class="text-[11px] text-slate-500">Cursor AI, Claude 3.5 & Midjourney</p>
          </div>
          <span class="text-xs font-bold text-brand group-hover:underline">Explore &rarr;</span>
        </div>
      </a>

      <!-- 3. PC Builds & Hardware Module -->
      <a href="/builds" class="group block rounded-2xl bg-white border border-slate-200/90 p-4 shadow-xs hover:border-purple-400 hover:shadow-sm transition">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 border border-purple-200 flex items-center gap-1">
            <span>🖥️</span> Hardware Hub
          </span>
          <span class="text-[10px] font-bold text-purple-600 font-mono">Tested FPS</span>
        </div>
        <div class="flex items-baseline justify-between">
          <div>
            <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-purple-600 transition">5 Tested PC Builds</h3>
            <p class="text-[11px] text-slate-500">₹35k Student Rig to ₹1.5L 4K Beast</p>
          </div>
          <span class="text-xs font-bold text-brand group-hover:underline">Compare &rarr;</span>
        </div>
      </a>

      <!-- 4. Verified Loot Deals & Cashback -->
      <a href="/deals" class="group block rounded-2xl bg-white border border-slate-200/90 p-4 shadow-xs hover:border-emerald-400 hover:shadow-sm transition">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1">
            <span>🏷️</span> Loot Radar
          </span>
          <span class="text-[10px] font-bold text-emerald-600 font-mono">Up to 40% Off</span>
        </div>
        <div class="flex items-baseline justify-between">
          <div>
            <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-emerald-600 transition">Loot Deals & Cashback</h3>
            <p class="text-[11px] text-slate-500">Sony XM5, iPads & 5% SBI Card</p>
          </div>
          <span class="text-xs font-bold text-brand group-hover:underline">View Deals &rarr;</span>
        </div>
      </a>

      <!-- Quick Category Directory Banner -->
      <div class="rounded-2xl bg-gradient-to-r from-brand to-brand-dark text-white p-3.5 shadow-xs flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-lg">🌐</span>
          <div>
            <div class="text-xs font-black text-white">All 12 Specialized Hubs</div>
            <div class="text-[10px] text-purple-200">Tech • Money • Lifestyle • Entertainment</div>
          </div>
        </div>
        <a href="#explore-all" class="px-2.5 py-1 rounded-lg bg-cta text-cta-ink text-[10px] font-black hover:brightness-105 transition">
          Browse All &darr;
        </a>
      </div>

    </div>

  </div>

  <!-- 12-Hub Category Grid (Reference Mockup Card) -->
  <CategoryGridCard />



  <!-- Top 4 Niches Spotlight -->
  <div class="my-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand font-mono">Real-Time Pulse</span>
        <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">Trending Across Categories</h2>
      </div>
      <a href="#explore-all" class="text-xs font-bold text-brand hover:underline flex items-center gap-1">
        All 12 Hubs <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {subTrending.slice(0, 4).map(p => (
        <NicheCard post={p} />
      ))}
    </div>
  </div>

  <AdSlot position="top" />

  <!-- Main 2-Column Section: Latest Feeds vs Numbered Trending List -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-12">
    
    <!-- Left Column: Featured Feeds -->
    <div class="lg:col-span-8">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-black text-ink tracking-tight flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
          <span>Latest Verified Drops</span>
        </h3>
        <span class="text-xs text-muted font-mono">Updated Every 6 Hours</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {trendingPosts.slice(0, 6).map(p => (
          <NicheCard post={p} />
        ))}
      </div>

      <AdSlot position="mid" />
    </div>

    <!-- Right Column: Numbered Top 05 & Quick Tools -->
    <div class="lg:col-span-4 flex flex-col gap-6">
      <TrendingList posts={trendingPosts} title="Trending Today (Top 05)" />

      <!-- Quick Action Card -->
      <div class="rounded-3xl bg-gradient-to-br from-brand-dark to-brand text-white p-6 shadow-soft">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-cta text-cta-ink inline-block mb-3">
          Tool Directory
        </span>
        <h4 class="font-bold text-base mb-2">Looking for Generative AI or PC Hardware?</h4>
        <p class="text-xs text-purple-100 leading-relaxed mb-4">
          Browse verified tools with authentic benchmarks and Indian pricing.
        </p>
        <div class="flex flex-col gap-2">
          <a href="/ai-tools" class="px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-bold transition flex items-center justify-between">
            <span>Explore AI Tools</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
          <a href="/builds" class="px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-bold transition flex items-center justify-between">
            <span>PC Build Estimator</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
          <a href="/gold-rate" class="px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-bold transition flex items-center justify-between">
            <span>Today's Gold Rate</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <AdSlot position="sidebar" />
    </div>

  </div>

  <!-- Explore All 12 Hubs Grid -->
  <div id="explore-all" class="my-16 pt-12 border-t border-line">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-bold uppercase tracking-wider text-brand font-mono">Dynamic Network</span>
      <h2 class="text-3xl font-black text-ink tracking-tight mt-1">Explore All 12 Specialized Hubs</h2>
      <p class="text-xs text-muted mt-2">
        Every hub runs on live datasets and AI trend clustering, updating automatically with zero stale content.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {niches.map(n => (
        <a
          href={`/${n.slug}`}
          class="group p-5 rounded-2xl bg-white border border-line shadow-card hover:shadow-soft hover:border-brand/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand group-hover:bg-brand group-hover:text-white transition flex items-center justify-center mb-3">
              <Icon name={n.icon} class="w-5 h-5" />
            </div>
            <div class="flex items-center gap-1.5 mb-1">
              <h3 class="font-bold text-sm text-ink group-hover:text-brand transition">{n.name}</h3>
              {n.is_new && (
                <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-breaking text-white">NEW</span>
              )}
            </div>
            <p class="text-xs text-muted line-clamp-2 leading-relaxed">{n.tagline}</p>
          </div>
          <span class="text-[11px] font-bold text-brand mt-4 flex items-center gap-1 group-hover:underline">
            Open Hub <Icon name="arrow-right" class="w-3 h-3 group-hover:translate-x-0.5 transition" />
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- Lead Gen / Newsletter -->
  <NewsletterStrip />
</Layout>
