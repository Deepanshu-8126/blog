---
import Layout from '../layouts/Layout.astro';
import BreakingTicker from '../components/BreakingTicker.astro';
import HeroFeature from '../components/HeroFeature.astro';
import NicheCard from '../components/NicheCard.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import Icon from '../components/Icon.astro';
import { getNiches, getTrendingPosts, getPostsByGroup, type Niche, type Post } from '../lib/db';

const runtime = (Astro.locals as any)?.runtime;
const niches = await getNiches(runtime?.env);

// 1. Fetch Top Trending Stories for Ticker and Lead Hero Feature
const trendingPosts = await getTrendingPosts(10, runtime?.env);

// Track all rendered slugs to guarantee ZERO duplicate headlines on the homepage!
const renderedSlugs = new Set<string>();

// Lead Hero Story (The #1 biggest, high-impact story right now)
const leadStory = trendingPosts[0];
if (leadStory) renderedSlugs.add(leadStory.slug);

// Fast Real-Time Pulse / Live Wire list (4 unique breaking updates for the hero sidebar)
const liveWirePosts = trendingPosts.filter(p => !renderedSlugs.has(p.slug)).slice(0, 4);
liveWirePosts.forEach(p => renderedSlugs.add(p.slug));

// Helper to fetch exactly 4 posts for each pavilion, ensuring balanced 4-card desktop grids
async function getBalancedPavilion(grp: string, count = 4): Promise<Post[]> {
  const direct = await getPostsByGroup(grp, count, Array.from(renderedSlugs), runtime?.env);
  direct.forEach(p => renderedSlugs.add(p.slug));

  if (direct.length < count) {
    const filler = trendingPosts.filter(p => !renderedSlugs.has(p.slug)).slice(0, count - direct.length);
    filler.forEach(p => renderedSlugs.add(p.slug));
    return [...direct, ...filler];
  }
  return direct;
}

// 2. Fetch Category-Specific Post Pavilions (Strictly excluding already rendered slugs)
const entertainmentPosts = await getBalancedPavilion('Entertainment', 4);
const techPosts = await getBalancedPavilion('Tech', 4);
const moneyPosts = await getBalancedPavilion('Money', 4);
const lifestylePosts = await getBalancedPavilion('Lifestyle', 4);

// Breaking ticker posts
const breakingTickerPosts = trendingPosts.slice(0, 6);
---

<Layout
  title="UniqueDigit — India's Real-Time News, Tech & Deal Intelligence Portal"
  description="Curated independent reporting across Indian technology, personal finance, live bullion rates, AI directories, and verified deals."
>
  <!-- Breaking News Ticker -->
  {breakingTickerPosts.length > 0 && (
    <BreakingTicker posts={breakingTickerPosts} />
  )}

  <!-- HERO SECTION: Lead Editorial Feature (8 cols) + Live Wire Radar (4 cols) -->
  <section class="my-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    
    <!-- Left Column (8 cols): Lead Magazine Cover Story -->
    <div class="lg:col-span-8 flex flex-col">
      {leadStory ? (
        <HeroFeature post={leadStory} class="h-full flex flex-col justify-between" />
      ) : (
        <div class="p-8 bg-white rounded-3xl border border-slate-200">
          <p class="text-slate-500">Loading top lead editorial story...</p>
        </div>
      )}
    </div>

    <!-- Right Column (4 cols): Live Wire (Real-Time Pulse & Fast Utility Links) -->
    <div class="lg:col-span-4 flex flex-col justify-between bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6">
      <div>
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <h2 class="font-black text-base sm:text-lg text-slate-900 tracking-tight">
              Live Indian Wire
            </h2>
          </div>
          <span class="text-[11px] font-mono font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
            Real-Time
          </span>
        </div>

        <p class="text-xs text-slate-500 leading-relaxed mb-4">
          Fast-breaking updates and developing stories verified across primary national sources.
        </p>

        <!-- Live Wire Items (01, 02, 03, 04) -->
        <div class="flex flex-col divide-y divide-slate-100">
          {liveWirePosts.map((post, idx) => {
            const rank = String(idx + 1).padStart(2, '0');
            const slug = post.niches?.slug || 'viral';
            return (
              <a
                href={`/${slug}/${post.slug}`}
                class="group py-3.5 flex items-start gap-3 hover:bg-slate-50/80 rounded-xl px-2 transition-colors"
              >
                <span class="font-mono font-black text-sm text-slate-400 group-hover:text-brand transition shrink-0 mt-0.5">
                  {rank}
                </span>
                <div class="flex-1 min-w-0">
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-extrabold uppercase bg-slate-100 text-slate-700 font-mono mb-1">
                    {post.niches?.name || 'Trending'}
                  </span>
                  <h3 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-brand transition leading-snug line-clamp-2">
                    {post.title}
                  </h3>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Quick Access Utility Modules -->
      <div class="pt-4 mt-4 border-t border-slate-100 flex flex-col gap-2">
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">
          Direct Desks & Tools
        </span>
        <div class="grid grid-cols-3 gap-2">
          <a
            href="/gold-rate"
            class="p-2 rounded-xl bg-amber-50/60 hover:bg-amber-100 border border-amber-200/60 text-center transition group"
          >
            <span class="text-xs block">🪙</span>
            <span class="text-[11px] font-bold text-amber-900 block truncate group-hover:underline">Gold Rates</span>
          </a>
          <a
            href="/ai-tools"
            class="p-2 rounded-xl bg-blue-50/60 hover:bg-blue-100 border border-blue-200/60 text-center transition group"
          >
            <span class="text-xs block">🤖</span>
            <span class="text-[11px] font-bold text-blue-900 block truncate group-hover:underline">AI Directory</span>
          </a>
          <a
            href="/builds"
            class="p-2 rounded-xl bg-purple-50/60 hover:bg-purple-100 border border-purple-200/60 text-center transition group"
          >
            <span class="text-xs block">🖥️</span>
            <span class="text-[11px] font-bold text-purple-900 block truncate group-hover:underline">PC Builds</span>
          </a>
        </div>
      </div>
    </div>

  </section>

  <!-- PAVILION 1: 🎬 Cinema, Box Office & Pop Culture (Unique Stories) -->
  {entertainmentPosts.length > 0 && (
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200/80">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-pink-100 text-pink-700 flex items-center justify-center font-bold text-base">
            🎬
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Cinema, Box Office &amp; Pop Culture
            </h2>
            <p class="text-xs text-slate-500 hidden sm:block">
              Daily collections, upcoming OTT releases, and verified entertainment reviews.
            </p>
          </div>
        </div>
        <a href="/movies" class="text-xs font-bold text-brand hover:underline flex items-center gap-1">
          <span>View All in Movies</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {entertainmentPosts.map(p => (
          <NicheCard post={p} />
        ))}
      </div>
    </section>
  )}

  <!-- Ad Slot: Top Position -->
  <AdSlot position="top" />

  <!-- PAVILION 2: 💻 Technology, AI & Hardware Intelligence (Unique Stories) -->
  {techPosts.length > 0 && (
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200/80">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-base">
            ⚡
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Technology, AI &amp; Hardware Radar
            </h2>
            <p class="text-xs text-slate-500 hidden sm:block">
              Tested PC configurations, GPU benchmarks, and generative AI productivity tools.
            </p>
          </div>
        </div>
        <a href="/pc-builds" class="text-xs font-bold text-brand hover:underline flex items-center gap-1">
          <span>Explore All Tech</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {techPosts.map(p => (
          <NicheCard post={p} />
        ))}
      </div>
    </section>
  )}

  <!-- PAVILION 3: 🏷️ Markets, Loot Deals & Personal Finance (Unique Stories) -->
  {moneyPosts.length > 0 && (
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200/80">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-base">
            🏷️
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Markets, Loot Deals &amp; Personal Finance
            </h2>
            <p class="text-xs text-slate-500 hidden sm:block">
              Verified e-commerce price drops, credit card rewards, and live bullion rate movements.
            </p>
          </div>
        </div>
        <a href="/deals" class="text-xs font-bold text-brand hover:underline flex items-center gap-1">
          <span>Browse All Deals</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {moneyPosts.map(p => (
          <NicheCard post={p} />
        ))}
      </div>
    </section>
  )}

  <!-- Ad Slot: Mid Position -->
  <AdSlot position="mid" />

  <!-- PAVILION 4: 🏃 Sports, Mobility & Daily Living (Unique Stories) -->
  {lifestylePosts.length > 0 && (
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200/80">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-base">
            🏆
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Sports, Mobility &amp; Daily Living
            </h2>
            <p class="text-xs text-slate-500 hidden sm:block">
              Match analyses, squad updates, automotive insights, and health advice.
            </p>
          </div>
        </div>
        <a href="/cricket-sports" class="text-xs font-bold text-brand hover:underline flex items-center gap-1">
          <span>View All Sports</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {lifestylePosts.map(p => (
          <NicheCard post={p} />
        ))}
      </div>
    </section>
  )}

  <!-- Master Editorial Directory: Single, High-Design Category Grid -->
  <section id="explore-all" class="my-16 pt-12 border-t border-slate-200/80">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-bold uppercase tracking-wider text-brand font-mono">
        Editorial Network
      </span>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-1">
        Explore All Specialized Desks
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Data-grounded reporting, live price tracking, and community discussions across 12 distinct verticals.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {niches.map(n => (
        <a
          href={`/${n.slug}`}
          class="group p-5 rounded-2xl bg-white border border-slate-200/90 shadow-xs hover:shadow-md hover:border-brand/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-brand group-hover:bg-brand group-hover:text-white transition flex items-center justify-center mb-3">
              <Icon name={n.icon} class="w-5 h-5" />
            </div>
            <div class="flex items-center gap-1.5 mb-1">
              <h3 class="font-bold text-sm text-slate-900 group-hover:text-brand transition">{n.name}</h3>
              {n.is_new && (
                <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-red-600 text-white">NEW</span>
              )}
            </div>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">{n.tagline}</p>
          </div>
          <span class="text-xs font-bold text-brand mt-4 flex items-center gap-1 group-hover:underline">
            <span>Explore Desk</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Lead Gen / Newsletter -->
  <NewsletterStrip />
</Layout>
