];

// Product Schema for Google SERP Rich Snippets & Stars
const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Best Smartphones in India 2026 — Buyer Guide & Price Drops',
  'description': 'Editorial comparison of best 5G phones in India by budget tiers with AnTuTu benchmarks, camera tests, and real user pros and cons.',
  'itemListElement': SMARTPHONES.map((p, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'item': {
      '@type': 'Product',
      'name': p.name,
      'image': p.image,
      'description': p.tagline,
      'brand': {
        '@type': 'Brand',
        'name': p.name.split(' ')[0]
      },
      'offers': {
        '@type': 'Offer',
        'priceCurrency': 'INR',
        'price': p.price.replace(/[^\d]/g, ''),
        'availability': 'https://schema.org/InStock',
        'url': `https://uniquedigit-viral-hub.pages.dev/smartphones#${p.id}`
      }
    }
  }))
};
---

<Layout
  title="Best Smartphones to Buy in India (2026) — Verified Price Drops & 5G Guide"
  description="Discover India's best 5G smartphones ranked by budget (Under ₹10k, ₹15k, ₹25k, ₹40k). AnTuTu benchmarks, 100W charging speeds, camera samples, and live Amazon price discounts."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />

  <!-- Hero Header Section -->
  <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 border border-slate-800 text-white p-6 sm:p-10 mb-10 shadow-2xl">
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 text-xs font-semibold mb-4 backdrop-blur-md">
        <span>📱 Smartphone Buyer's Guide</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight mb-4">
        Best Smartphones in India <br />
        <span class="bg-gradient-to-r from-amber-300 via-orange-400 to-rose-400 bg-clip-text text-transparent">
          Ranked by Real Value & Budget
        </span>
      </h1>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Curated specs, processor benchmarks, display quality, and verified Amazon deals across every budget segment.
      </p>
    </div>
  </div>

  <!-- Interactive Budget Filter Bar -->
  <div class="sticky top-20 z-40 bg-white/95 backdrop-blur-md border border-slate-200/90 rounded-2xl p-2.5 shadow-sm mb-8">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth">
      <button class="filter-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition whitespace-nowrap bg-slate-900 text-white shadow-xs" data-cat="all">
        📱 All Phones (6)
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="under10k">
        💰 Under ₹10,000
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="under15k">
        ⚡ Under ₹15,000 (Sweet Spot)
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="under25k">
        🔥 Under ₹25,000 (All-Rounders)
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="under40k">
        🎮 Flagship Killers (Under ₹40k)
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 transition whitespace-nowrap" data-cat="flagship">
        👑 Premium Flagship
      </button>
    </div>
  </div>

  <!-- Phones Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16" id="phones-container">
    {SMARTPHONES.map((phone, idx) => (
      <article
        id={phone.id}
        class="phone-card flex flex-col justify-between rounded-3xl bg-white border border-slate-200/90 shadow-card hover:shadow-soft transition-all duration-300 p-6 sm:p-7 relative overflow-hidden"
        data-category={phone.category}
      >
        <!-- Top Verdict Pill -->
        <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
          <span class={`px-3 py-1 rounded-full text-xs font-black tracking-wide ${phone.badgeColor} shadow-xs`}>
            {phone.verdictBadge}
          </span>
          <span class="text-xs font-mono font-bold text-slate-500">
            Rank #{idx + 1}
          </span>
        </div>

        <!-- Phone Header: Image + Title + Price -->
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 mb-5 pb-5 border-b border-slate-100">
          <div class="w-32 h-36 shrink-0 relative flex items-center justify-center p-2 rounded-2xl bg-slate-50 border border-slate-100">
            <img
              src={`/img?url=${encodeURIComponent(phone.image)}&title=${encodeURIComponent(phone.name)}&niche=smartphones`}
              alt={phone.name}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="w-full h-full object-contain hover:scale-105 transition-transform duration-300"
            />
          </div>

          <div class="flex-1 min-w-0 text-center sm:text-left">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 leading-tight mb-1">
              {phone.name}
            </h2>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              {phone.tagline}
            </p>

            <div class="flex items-baseline justify-center sm:justify-start gap-2.5">
              <span class="text-2xl sm:text-3xl font-black text-slate-900">
                {phone.price}
              </span>
              <span class="text-xs text-slate-400 line-through">
                {phone.mrp}
              </span>
              <span class="px-2 py-0.5 rounded-md text-xs font-black bg-rose-50 text-rose-600 border border-rose-200">
                {phone.discount}
              </span>
            </div>
          </div>
        </div>

        <!-- Specs Grid -->
        <div class="grid grid-cols-2 gap-2.5 text-xs mb-5 p-3.5 rounded-2xl bg-slate-50 border border-slate-100/80 font-mono">
          <div>
            <span class="text-slate-400 block text-[10px] uppercase">Processor</span>
            <span class="font-bold text-slate-800">{phone.processor}</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] uppercase">Display</span>
            <span class="font-bold text-slate-800">{phone.display}</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] uppercase">Camera</span>
            <span class="font-bold text-slate-800">{phone.camera}</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] uppercase">Battery & Speed</span>
            <span class="font-bold text-slate-800">{phone.battery}</span>
          </div>
        </div>

        <!-- Pros & Cons (Google Ranking Factor) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 text-xs leading-relaxed">
          <div class="p-3 rounded-xl bg-emerald-50/60 border border-emerald-100">
            <span class="font-bold text-emerald-800 block mb-1.5">✅ Pros (Why Buy)</span>
            <ul class="space-y-1 text-emerald-900/90 list-disc list-inside">
              {phone.pros.map(pro => (
                <li>{pro}</li>
              ))}
            </ul>
          </div>
          <div class="p-3 rounded-xl bg-rose-50/60 border border-rose-100">
            <span class="font-bold text-rose-800 block mb-1.5">❌ Cons (Things to Know)</span>
            <ul class="space-y-1 text-rose-900/90 list-disc list-inside">
              {phone.cons.map(con => (
                <li>{con}</li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Editorial Takeaway Highlight -->
        <div class="p-3 rounded-xl bg-purple-50/70 border border-purple-100 text-xs text-purple-900 mb-6 flex items-start gap-2">
          <span class="text-sm shrink-0">💡</span>
          <p><strong>Verdict:</strong> {phone.highlight}</p>
        </div>

        <!-- Direct Affiliate Action CTA -->
        <div class="mt-auto pt-2">
          <a
            href={phone.amazonUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 hover:brightness-105 active:scale-98 text-slate-950 font-black text-sm transition shadow-md"
          >
            <span>⚡ Check Lowest Price & Bank Offers on Amazon</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <span class="block text-center text-[10px] text-slate-400 mt-1.5">
            Prices verified daily • Eligible for No Cost EMI & Exchange Bonus
          </span>
        </div>
      </article>
    ))}
  </div>

  <!-- FAQ Section for Google Featured Snippets -->
  <section class="max-w-4xl mx-auto rounded-3xl bg-white border border-slate-200/90 p-6 sm:p-10 shadow-sm mb-16">
    <div class="flex items-center gap-2 mb-2">
      <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900">
        Frequently Asked Questions by Indian Smartphone Buyers
      </h2>
    </div>
    <p class="text-xs text-slate-500 mb-6">Common questions verified with real testing benchmarks.</p>

    <div class="space-y-4">
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
        <h3 class="font-bold text-slate-900 text-sm mb-1">Which is the best 5G phone under ₹15,000 right now?</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          The <strong>CMF Phone 1 by Nothing</strong> is currently the best overall under ₹15,000 due to its clean Nothing OS (no ads/bloatware), 120Hz Super AMOLED screen, and MediaTek Dimensity 7300 processor. If battery is your top priority, the <strong>iQOO Z9x 5G</strong> with a 6000mAh battery is the top alternative.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
        <h3 class="font-bold text-slate-900 text-sm mb-1">Is 128GB storage enough in 2026?</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          For everyday use (WhatsApp, YouTube, casual photos), 128GB is sufficient. However, if you record 4K reels or play heavy games like BGMI and Genshin Impact, we strongly recommend opting for the <strong>256GB variant</strong> or ensuring the phone has an expandable microSD slot.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
        <h3 class="font-bold text-slate-900 text-sm mb-1">How can I get the maximum discount on Amazon India?</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Always check the <strong>"Apply Coupon"</strong> checkbox directly on the Amazon product page before adding to cart, and combine it with instant credit card discounts (typically HDFC, ICICI, SBI or OneCard) for an extra ₹1,000 to ₹3,000 off.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.phone-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white', 'shadow-xs');
            b.classList.add('text-slate-700', 'hover:bg-slate-100');
          });
          btn.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
          btn.classList.remove('text-slate-700', 'hover:bg-slate-100');

          const category = btn.getAttribute('data-cat');
          cards.forEach(card => {
            if (category === 'all' || card.getAttribute('data-category') === category) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</Layout>
