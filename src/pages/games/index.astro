---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<Layout
  title="Interactive Gaming Hub & Simulators (Free to Play) | UniqueDigit"
  description="Play free browser simulators, custom build gaming rigs with live Indian pricing, test real-time FPS, and discover top Amazon deals."
>
  <!-- Hub Header -->
  <div class="mb-10 pb-6 border-b border-line flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-brand text-white shadow-xs">
          🎮 Web Gaming & Simulators
        </span>
        <span class="text-xs text-muted font-mono font-bold">100% Free & No Install Required</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-ink tracking-tight">
        Interactive Gaming & PC Simulators
      </h1>
      <p class="text-sm text-muted mt-1">
        Build dream rigs, test performance bottlenecks, and discover the best gaming hardware deals in India.
      </p>
    </div>
  </div>

  <!-- Featured Master Game Card: Indian PC Builder -->
  <div class="mb-12 p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 border border-amber-500/30 text-white shadow-2xl relative overflow-hidden group">
    <!-- Glowing background accent -->
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow-md">
            🔥 Featured Simulator
          </span>
          <span class="text-xs text-amber-300 font-mono font-bold">3D Visual Rig Assembly</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-black text-white leading-tight mb-3">
          Indian PC Builder & 3D Rig Simulator (2026)
        </h2>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
          Assemble custom gaming rigs, check component compatibility (AM4/AM5/LGA1700), test real-time FPS in GTA 6 / Valorant, and get 1-click Amazon India discounted cart checkouts.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/games/pc-builder-india"
            class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-sm transition transform hover:-translate-y-0.5 active:translate-y-0 shadow-lg shadow-amber-500/25 cursor-pointer flex items-center gap-2"
          >
            <span>Launch 3D Simulator Now</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>

          <span class="text-xs text-slate-400 font-medium">
            ⚡ Over 12,000+ rigs customized this week
          </span>
        </div>
      </div>

      <div class="lg:col-span-5 aspect-video sm:aspect-square rounded-2xl bg-slate-900 border border-slate-800 p-6 flex flex-col justify-center items-center text-center relative overflow-hidden">
        <div class="w-24 h-24 rounded-full border-4 border-dashed border-cyan-400 animate-spin flex items-center justify-center mb-4">
          <Icon name="cpu" class="w-10 h-10 text-cyan-300" />
        </div>
        <span class="font-mono text-sm font-bold text-cyan-300">RGB 3D Hardware Engine</span>
        <span class="text-xs text-slate-400 mt-1">Live Wattage & Compatibility Engine</span>
      </div>
    </div>
  </div>

  <AdSlot position="top" />

  <!-- All Upcoming Games Grid -->
  <div class="my-12">
    <div class="flex items-center justify-between mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand font-mono">Catalog</span>
        <h3 class="text-2xl font-black text-ink tracking-tight">Mini-Games & Interactive Tools</h3>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Card 1: PC Builder -->
      <div class="p-6 rounded-3xl bg-white border border-line hover:border-brand/40 transition shadow-card flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-emerald-100 text-emerald-800">Live Now</span>
            <span class="text-xs font-mono font-bold text-amber-500">★ 4.9/5</span>
          </div>
          <h4 class="text-base font-black text-ink mb-1">Indian PC Builder Simulator</h4>
          <p class="text-xs text-muted leading-relaxed mb-4">
            Build custom PC configurations with live ₹ INR Amazon India prices and FPS benchmarks.
          </p>
        </div>
        <a href="/games/pc-builder-india" class="px-4 py-2.5 rounded-xl bg-brand hover:bg-brand-dark text-white font-bold text-xs text-center transition">
          Play Simulator ➔
        </a>
      </div>

      <!-- Card 2: Blinkit Delivery Rider (Coming Soon) -->
      <div class="p-6 rounded-3xl bg-slate-50 border border-dashed border-slate-300 flex flex-col justify-between opacity-85">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-amber-100 text-amber-800">Coming Soon</span>
            <span class="text-xs font-mono text-slate-400">2D Canvas</span>
          </div>
          <h4 class="text-base font-black text-ink mb-1">Blinkit 10-Min Delivery Rider</h4>
          <p class="text-xs text-muted leading-relaxed mb-4">
            Retro arcade delivery runner across Indian streets. Dodge traffic, beat the 10-minute clock, and unlock loot coupons.
          </p>
        </div>
        <button disabled class="px-4 py-2.5 rounded-xl bg-slate-200 text-slate-500 font-bold text-xs text-center cursor-not-allowed">
          In Development
        </button>
      </div>

      <!-- Card 3: Gold Loot Catcher (Coming Soon) -->
      <div class="p-6 rounded-3xl bg-slate-50 border border-dashed border-slate-300 flex flex-col justify-between opacity-85">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-amber-100 text-amber-800">Coming Soon</span>
            <span class="text-xs font-mono text-slate-400">Arcade</span>
          </div>
          <h4 class="text-base font-black text-ink mb-1">Gold Coin Loot Catcher</h4>
          <p class="text-xs text-muted leading-relaxed mb-4">
            Catch falling 24K certified gold bullion coins with live MCX ticker rates and claim Amazon gold coin deals.
          </p>
        </div>
        <button disabled class="px-4 py-2.5 rounded-xl bg-slate-200 text-slate-500 font-bold text-xs text-center cursor-not-allowed">
          In Development
        </button>
      </div>
    </div>
  </div>

  <AdSlot position="mid" />
</Layout>
