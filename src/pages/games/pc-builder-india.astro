---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<style>
  /* 🌌 Anti-Gravity & 3D Pop Effects */
  .anti-gravity {
    animation: float-rig 5s ease-in-out infinite;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-style: preserve-3d;
  }
  .anti-gravity:hover {
    transform: translateZ(50px) scale(1.06) !important;
    filter: drop-shadow(0 0 25px rgba(34, 211, 238, 0.6));
    z-index: 50;
  }
  @keyframes float-rig {
    0%, 100% { transform: translateY(0px) translateZ(0px); }
    50% { transform: translateY(-8px) translateZ(12px); }
  }

  /* 🖱️ Custom Magnetic Cursor Styling */
  #custom-cursor {
    transition: transform 0.15s ease-out, border-color 0.2s ease;
    pointer-events: none;
  }
  #cursor-dot {
    transition: transform 0.05s linear;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    #rig-viewport-box, #rig-viewport-box * {
      cursor: none; /* Holographic laboratory feel */
    }
  }

  /* 🌀 High-Performance Fan Spin */
  .rig-fan {
    animation: spin-fan 2.5s linear infinite;
  }
  @keyframes spin-fan {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<Layout
  title="PC Builder Simulator India (2026) — 3D Interactive Rig Builder & Live INR Amazon Prices | UniqueDigit"
  description="Interactive 3D PC Builder Simulator for Indian gamers. Custom build your gaming rig with live ARGB lighting, mechanical audio feedback, component compatibility validation, live Amazon India prices, FPS benchmarks, and laptop alternatives."
>
  <!-- 🖱️ Custom Magnetic Cursor Elements -->
  <div id="custom-cursor" class="fixed w-10 h-10 rounded-full border-2 border-cyan-400 z-[9999] hidden md:block mix-blend-difference pointer-events-none"></div>
  <div id="cursor-dot" class="fixed w-2 h-2 rounded-full bg-cyan-400 z-[9999] hidden md:block pointer-events-none"></div>

  <!-- Top Banner & Breadcrumb -->
  <div class="mb-6">
    <nav class="flex items-center gap-2 text-xs text-muted mb-3">
      <a href="/" class="hover:text-brand transition">Home</a>
      <span>/</span>
      <a href="/builds" class="hover:text-brand transition font-medium">PC Builds</a>
      <span>/</span>
      <span class="text-ink font-bold">3D Rig Simulator</span>
    </nav>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-line">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-brand text-white shadow-xs">
            🎮 3D Real-Time Simulator
          </span>
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 font-mono">
            ⚡ Verified Indian Amazon Prices (2026)
          </span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-500/10 text-purple-600 border border-purple-500/20 hidden sm:inline">
            🔊 Sound FX On
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-ink tracking-tight">
          Indian PC Builder & 3D Interactive Rig Simulator
        </h1>
        <p class="text-sm text-muted mt-1 max-w-3xl">
          Assemble your custom gaming rig in interactive 3D, test AM4/AM5 socket compatibility & PSU headroom, hear mechanical snap feedback, predict 1080p/1440p gaming FPS, and checkout individual parts or full builds on Amazon India.
        </p>

        <!-- Indian Budget Preset Rigs Bar -->
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="text-xs font-mono font-bold text-slate-500 uppercase mr-1">⚡ Quick Preset Rigs:</span>
          <button class="preset-btn px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-bold transition cursor-pointer" data-preset="p35k">
            ₹35K Esports Entry
          </button>
          <button class="preset-btn px-3 py-1.5 rounded-xl bg-brand text-white text-xs font-black shadow-xs cursor-pointer" data-preset="p55k">
            ₹55K 1080p Value King
          </button>
          <button class="preset-btn px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-bold transition cursor-pointer" data-preset="p85k">
            ₹85K 1440p Creator
          </button>
          <button class="preset-btn px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-ink text-xs font-bold transition cursor-pointer" data-preset="p150k">
            ₹1.5L+ 4K Ultra & AI
          </button>
        </div>
      </div>

      <!-- Quick Stats Pill -->
      <div class="flex items-center gap-4 bg-slate-900 text-white p-4 rounded-2xl border border-slate-800 shrink-0 shadow-card">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block font-mono">Estimated Rig Cost</span>
          <span class="text-2xl font-black text-cta font-mono" id="total-price-header">₹54,988</span>
        </div>
        <div class="border-l border-slate-800 pl-4">
          <span class="text-[10px] uppercase font-bold text-slate-400 block font-mono">Total Power Draw</span>
          <span class="text-lg font-black text-white font-mono" id="total-wattage">420W</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Simulator Container: Cockpit Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-6 w-full items-start">
    
    <!-- LEFT COLUMN: 3D Interactive Glass PC Chassis Cockpit (lg:col-span-6 xl:col-span-6) -->
    <div class="w-full min-w-0 lg:col-span-6 xl:col-span-6 flex flex-col gap-6 lg:sticky lg:top-20">
      
      <div class="p-4 sm:p-6 rounded-3xl bg-[#090D16] border border-slate-800 text-white shadow-2xl relative overflow-hidden w-full select-none" id="rig-viewport-box">
        <!-- Dynamic Mouse Spotlight Overlay -->
        <div id="dynamic-spotlight" class="absolute inset-0 pointer-events-none z-10 transition-opacity duration-300"></div>

        <!-- Ambient Dynamic ARGB Glow -->
        <div id="ambient-rgb" class="absolute -top-24 -left-24 w-96 h-96 bg-cyan-500/25 rounded-full blur-3xl pointer-events-none transition-all duration-700"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-purple-500/25 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-20 flex flex-col gap-3.5">
          <!-- Cockpit Top Bar: System Online, 3D Camera Angles & Power Icon -->
          <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-800/80">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shadow-md shadow-emerald-400/80" id="rig-power-led"></span>
              <span class="text-xs font-mono font-black text-emerald-300 tracking-wider" id="rig-status-text">● SYSTEM ONLINE • 60 FPS</span>
            </div>

            <div class="flex items-center gap-2">
              <!-- Camera Angle Tabs -->
              <div class="flex items-center bg-slate-900/90 p-1 rounded-xl border border-slate-800 text-xs font-mono">
                <button class="cam-btn px-2.5 py-1 rounded-lg bg-brand text-white font-bold cursor-pointer transition shadow-xs" data-cam="hero">3D View</button>
                <button class="cam-btn px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer transition" data-cam="flat">Front</button>
                <button class="cam-btn px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer transition" data-cam="side">Side 45°</button>
              </div>

              <!-- Power & Reset Icons -->
              <button id="btn-power-switch" class="w-7 h-7 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-xs cursor-pointer transition" title="Toggle Power / Stress Test">
                ⏻
              </button>
              <button id="btn-reset-rig" class="w-7 h-7 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-xs cursor-pointer transition" title="Reset View">
                ⛶
              </button>
            </div>
          </div>

          <!-- ARGB Mode Indicator Pill -->
          <div class="flex items-center justify-between px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 text-[11px] font-mono">
            <div class="flex items-center gap-2">
              <span class="text-sm">🌈</span>
              <span class="text-slate-300 font-bold uppercase tracking-wider">ARGB SYNC — <span class="text-cyan-400" id="argb-mode-name">RAINBOW MODE • ALL FANS SYNCED</span></span>
            </div>
            <!-- ARGB Color Switcher -->
            <div class="flex items-center gap-1.5">
              <button class="w-3.5 h-3.5 rounded-full bg-cyan-400 border border-white/60 cursor-pointer transition hover:scale-125" data-rgb="cyan" title="Cyber Cyan"></button>
              <button class="w-3.5 h-3.5 rounded-full bg-purple-500 border border-white/60 cursor-pointer transition hover:scale-125" data-rgb="purple" title="Neon Purple"></button>
              <button class="w-3.5 h-3.5 rounded-full bg-emerald-400 border border-white/60 cursor-pointer transition hover:scale-125" data-rgb="emerald" title="Razer Emerald"></button>
              <button class="w-3.5 h-3.5 rounded-full bg-amber-400 border border-white/60 cursor-pointer transition hover:scale-125" data-rgb="amber" title="Blaze Gold"></button>
              <button class="w-3.5 h-3.5 rounded-full bg-rose-500 border border-white/60 cursor-pointer transition hover:scale-125" data-rgb="rose" title="Crimson Red"></button>
            </div>
          </div>

          <!-- 3D Perspective Cabinet Chamber with Three.js WebGL Engine -->
          <div class="perspective-1000 w-full flex items-center justify-center py-2">
            <div
              id="pc-3d-case"
              class="w-full min-h-[480px] rounded-3xl bg-gradient-to-b from-[#0e1424] via-[#080c18] to-[#04060d] border-2 border-slate-700/80 p-5 relative flex flex-col justify-between shadow-2xl transition-transform duration-300 transform-gpu overflow-hidden"
              style="transform: rotateX(5deg) rotateY(-7deg);"
            >
              <!-- Real Three.js WebGL 3D Canvas -->
              <canvas id="three-pc-canvas" class="absolute inset-0 w-full h-full z-10 pointer-events-auto rounded-3xl"></canvas>

              <!-- Tempered Glass Reflection Diagonal Sheen & Screws -->
              <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/5 via-white/5 to-purple-500/10 pointer-events-none rounded-3xl border border-white/15 z-20"></div>
              <div class="absolute top-3 left-3 w-3 h-3 rounded-full bg-slate-600 border border-slate-300 z-30 shadow-sm flex items-center justify-center text-[7px] text-slate-900 font-bold">+</div>
              <div class="absolute top-3 right-3 w-3 h-3 rounded-full bg-slate-600 border border-slate-300 z-30 shadow-sm flex items-center justify-center text-[7px] text-slate-900 font-bold">+</div>
              <div class="absolute bottom-3 left-3 w-3 h-3 rounded-full bg-slate-600 border border-slate-300 z-30 shadow-sm flex items-center justify-center text-[7px] text-slate-900 font-bold">+</div>
              <div class="absolute bottom-3 right-3 w-3 h-3 rounded-full bg-slate-600 border border-slate-300 z-30 shadow-sm flex items-center justify-center text-[7px] text-slate-900 font-bold">+</div>

              <!-- Top Radiator Fans (2x 120mm ARGB Spinning Halos with Anti-Gravity) -->
              <div class="flex items-center justify-center gap-6 pb-2 relative z-20 pointer-events-none">
                <div class="anti-gravity w-24 h-8 rounded-full bg-slate-950/80 border-2 border-cyan-400 flex items-center justify-center shadow-lg shadow-cyan-400/40 p-1 pointer-events-auto">
                  <div class="rig-fan w-full h-full rounded-full bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-500 blur-xs"></div>
                </div>
                <div class="anti-gravity w-24 h-8 rounded-full bg-slate-950/80 border-2 border-cyan-400 flex items-center justify-center shadow-lg shadow-cyan-400/40 p-1 pointer-events-auto">
                  <div class="rig-fan w-full h-full rounded-full bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-500 blur-xs"></div>
                </div>
              </div>

              <!-- Floating Hologram Callout 1: Top CPU Spec Badge (Anti-Gravity) -->
              <div class="anti-gravity relative z-30 self-start p-2.5 px-4 rounded-2xl bg-slate-950/95 border border-cyan-400/80 shadow-2xl shadow-cyan-500/30 backdrop-blur-xl max-w-[290px]">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-sm shadow-cyan-400 animate-ping"></span>
                  <span class="text-xs font-black text-white font-mono tracking-tight truncate uppercase" id="vis-cpu-name">
                    INTEL CORE i5-13400F
                  </span>
                </div>
                <span class="text-[9px] font-mono text-cyan-300 font-bold block" id="vis-cpu-socket-line">
                  LGA1700 • 10C/16T • 4.6GHz • 65W TDP
                </span>
              </div>

              <!-- Center Chamber: Dual Vertical ARGB Front Intake Fans + Motherboard Core -->
              <div class="relative z-20 w-full flex items-center justify-between my-2 gap-4 pointer-events-none">
                
                <!-- Left/Center Motherboard & CPU Cooler Block (Anti-Gravity) -->
                <div class="flex items-center gap-3 pointer-events-auto">
                  <!-- Circular ARGB CPU Liquid Pump / Cooler -->
                  <div class="anti-gravity w-22 h-22 rounded-full bg-slate-950/90 border-2 border-purple-500 shadow-2xl shadow-purple-500/40 flex items-center justify-center relative p-2">
                    <div class="rig-fan w-full h-full rounded-full border-2 border-dashed border-cyan-400 flex items-center justify-center" style="animation-duration: 2.2s;">
                      <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-cyan-400 via-purple-500 to-pink-500 shadow-lg shadow-cyan-400 blur-xs"></div>
                    </div>
                  </div>

                  <!-- Dual Glowing RAM Sticks with Illuminated Tops -->
                  <div class="anti-gravity flex gap-2 p-2 rounded-xl bg-slate-950/90 border border-slate-700 shadow-inner">
                    <div class="w-2.5 h-16 rounded-sm bg-gradient-to-t from-cyan-400 via-purple-400 to-pink-400 shadow-md shadow-purple-400 animate-pulse"></div>
                    <div class="w-2.5 h-16 rounded-sm bg-gradient-to-t from-cyan-400 via-purple-400 to-pink-400 shadow-md shadow-purple-400 animate-pulse"></div>
                  </div>
                </div>

                <!-- Right Side: Dual Front 140mm ARGB Intake Fans (Rainbow Spinning Halos) -->
                <div class="flex flex-col gap-3 shrink-0 pointer-events-auto">
                  <div class="anti-gravity w-20 h-20 rounded-full bg-slate-950/90 border-2 border-cyan-400 shadow-2xl shadow-cyan-400/50 flex items-center justify-center relative p-1.5">
                    <div class="rig-fan w-full h-full rounded-full border-2 border-dashed border-purple-400 flex items-center justify-center" style="animation-duration: 1.8s;">
                      <div class="w-7 h-7 rounded-full bg-gradient-to-r from-cyan-400 to-pink-500 blur-xs"></div>
                    </div>
                  </div>
                  <div class="anti-gravity w-20 h-20 rounded-full bg-slate-950/90 border-2 border-cyan-400 shadow-2xl shadow-cyan-400/50 flex items-center justify-center relative p-1.5">
                    <div class="rig-fan w-full h-full rounded-full border-2 border-dashed border-purple-400 flex items-center justify-center" style="animation-duration: 1.8s;">
                      <div class="w-7 h-7 rounded-full bg-gradient-to-r from-cyan-400 to-pink-500 blur-xs"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Floating Hologram Callout 2: Graphics Card (GPU) Beast Block (Anti-Gravity) -->
              <div class="anti-gravity relative z-30 p-3.5 rounded-2xl bg-slate-950/95 border-2 border-purple-500/90 shadow-2xl shadow-purple-500/40 backdrop-blur-xl my-1">
                <div class="flex items-center justify-between gap-2 mb-1">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-400 shadow-sm shadow-purple-400 animate-pulse"></span>
                    <span class="text-xs font-black text-white font-mono uppercase tracking-tight" id="vis-gpu-name">
                      NVIDIA GEFORCE RTX 4060 • 8GB GDDR6
                    </span>
                  </div>
                  <span class="px-2 py-0.5 rounded text-[8px] font-mono font-black bg-purple-500/30 text-purple-200 border border-purple-500/50">PCIe 4.0 x16</span>
                </div>
                <span class="text-[9px] font-mono text-purple-300 font-bold block" id="vis-gpu-spec">
                  DLSS 3 • 115W TDP • Ray Tracing Core Active
                </span>
              </div>

              <!-- Bottom Floating Hologram Badges: RAM & NVMe SSD (Anti-Gravity) -->
              <div class="relative z-30 flex items-center justify-between gap-2 pt-1">
                <!-- Left: RAM Pill -->
                <div class="anti-gravity p-2 px-3.5 rounded-xl bg-slate-950/95 border border-cyan-400/60 shadow-lg shadow-cyan-500/10 text-[10px] font-mono">
                  <span class="font-bold text-white block" id="vis-ram-spec">DDR5</span>
                  <span class="text-cyan-400 font-bold text-[9px]" id="vis-ram-type">16GB • 5600MHz</span>
                </div>

                <!-- Right: NVMe SSD Pill -->
                <div class="anti-gravity p-2 px-3.5 rounded-xl bg-slate-950/95 border border-emerald-400/60 shadow-lg shadow-emerald-500/10 text-right text-[10px] font-mono flex items-center gap-2">
                  <span class="text-emerald-400 font-bold text-xs">✓</span>
                  <div>
                    <span class="font-bold text-white block truncate max-w-[150px]" id="vis-ssd-name">WD BLUE SN580 1TB NVMe</span>
                    <span class="text-emerald-300 font-bold text-[9px]" id="vis-ssd-speed">PCIe 4.0 • 4150 MB/s Read</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Bottom Real-Time Telemetry Bar (ECG / Temp Wave Monitor) -->
          <div class="p-3.5 rounded-2xl bg-slate-900/90 border border-slate-800 flex flex-col gap-2.5">
            <div class="flex items-center justify-between gap-3">
              <!-- Stress Test Trigger Button -->
              <button id="btn-power-switch-bottom" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 text-xs font-black font-mono flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95 transition shrink-0">
                <span>⚡ POWER / STRESS TEST</span>
              </button>

              <!-- Live Sine Wave SVG Graphic -->
              <div class="flex-1 h-6 flex items-center justify-center overflow-hidden px-2">
                <svg class="w-full h-5 text-cyan-400 animate-pulse" viewBox="0 0 100 20" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M0,10 L20,10 L25,2 L30,18 L35,10 L50,10 L55,4 L60,16 L65,10 L100,10" />
                </svg>
              </div>

              <!-- Live Load & Temp Telemetry -->
              <div class="text-right shrink-0">
                <div class="text-[10px] font-mono font-black text-slate-300">
                  Load <span class="text-cyan-400" id="telemetry-load">58%</span>
                </div>
                <div class="text-[10px] font-mono font-bold text-amber-300">
                  <span id="telemetry-cpu-temp">CPU 52°C</span> • <span id="telemetry-gpu-temp">GPU 61°C</span>
                </div>
              </div>
            </div>

            <!-- PSU Headroom Banner -->
            <div class="pt-2 border-t border-slate-800 flex items-center justify-between text-[11px] font-mono">
              <span class="text-slate-300 font-bold" id="vis-psu-headroom-banner">PSU 550W 80+ GOLD • HEADROOM: +29% SAFE</span>
              <span class="w-4 h-4 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center text-[10px] font-black">✓</span>
            </div>
          </div>

          <!-- Compatibility Banner -->
          <div class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-xs shrink-0" id="compat-icon">✓</span>
              <div>
                <span class="block text-xs font-bold text-white" id="compat-status">100% Component Compatibility Verified</span>
                <span class="text-[10px] text-slate-400" id="compat-desc">AM4 Socket & 550W PSU match RTX 4060 perfectly.</span>
              </div>
            </div>
          </div>

          <!-- 1-Click Multi-Item Amazon Cart Link & Share Buttons -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
            <div class="flex items-center gap-2">
              <button id="btn-share-whatsapp" class="p-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs transition flex items-center gap-1.5 cursor-pointer shadow-sm" title="Share Build on WhatsApp">
                <span>💬 WhatsApp</span>
              </button>
              <button id="btn-copy-link" class="p-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition cursor-pointer" title="Copy Direct Build Link">
                <span>🔗 Share Link</span>
              </button>
            </div>

            <a
              id="btn-buy-full-build"
              href="https://www.amazon.in/s?k=ryzen+5+5600+rtx+4060+pc+build&tag=uniquedigi0c6-21"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-xs transition transform hover:-translate-y-0.5 active:translate-y-0 shadow-lg shadow-amber-500/25 cursor-pointer shrink-0"
            >
              <span>🛒 1-Click Amazon Cart (All Parts)</span>
              <Icon name="external-link" class="w-3.5 h-3.5" />
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Interactive Component Selector (lg:col-span-6 xl:col-span-6) -->
    <div class="w-full min-w-0 lg:col-span-6 xl:col-span-6 flex flex-col gap-6">
      
      <!-- Category Selection Tabs -->
      <div class="p-5 sm:p-6 rounded-3xl bg-white border border-line shadow-card">
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-line">
          <div>
            <h3 class="text-base font-black text-ink tracking-tight uppercase">Component Catalog</h3>
            <span class="text-xs text-muted font-medium">Select parts to install</span>
          </div>
          <span class="text-xs font-mono font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            ● Real Indian INR Prices
          </span>
        </div>

        <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar" id="part-category-tabs">
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-black bg-brand text-white shadow-xs shrink-0 cursor-pointer" data-cat="cpu">
            1. Processor (CPU)
          </button>
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-ink shrink-0 cursor-pointer transition" data-cat="gpu">
            2. Graphics Card (GPU)
          </button>
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-ink shrink-0 cursor-pointer transition" data-cat="mobo">
