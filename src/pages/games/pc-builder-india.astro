      });
      btn.className = 'cam-btn px-2.5 py-1 rounded-lg bg-brand text-white font-bold cursor-pointer transition';
      const cam = btn.getAttribute('data-cam');
      playSound('click');

      if (caseBox) {
        if (cam === 'hero') caseBox.style.transform = 'rotateX(5deg) rotateY(-7deg)';
        if (cam === 'flat') caseBox.style.transform = 'rotateX(0deg) rotateY(0deg)';
