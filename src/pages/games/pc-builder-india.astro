  }

  // Setup ARGB Color Changer
  document.querySelectorAll('[data-rgb]').forEach(btn => {
    btn.addEventListener('click', () => {
      const color = btn.getAttribute('data-rgb');
      const rgbAmbient = document.getElementById('ambient-rgb');
      const rgbModeName = document.getElementById('argb-mode-name');
      playSound('rgb');
      if (rgbAmbient) {
        if (color === 'cyan') {
          rgbAmbient.className = 'absolute -top-24 -left-24 w-96 h-96 bg-cyan-500/25 rounded-full blur-3xl pointer-events-none transition-all duration-700';
          if (rgbModeName) rgbModeName.textContent = 'CYBER CYAN • AURA SYNC';
        }
        if (color === 'purple') {
          rgbAmbient.className = 'absolute -top-24 -left-24 w-96 h-96 bg-purple-500/25 rounded-full blur-3xl pointer-events-none transition-all duration-700';
          if (rgbModeName) rgbModeName.textContent = 'NEON PURPLE • SYNTHWAVE';
        }
        if (color === 'emerald') {
          rgbAmbient.className = 'absolute -top-24 -left-24 w-96 h-96 bg-emerald-500/25 rounded-full blur-3xl pointer-events-none transition-all duration-700';
          if (rgbModeName) rgbModeName.textContent = 'RAZER EMERALD • CHROMA';
        }
        if (color === 'amber') {
          rgbAmbient.className = 'absolute -top-24 -left-24 w-96 h-96 bg-amber-500/25 rounded-full blur-3xl pointer-events-none transition-all duration-700';
          if (rgbModeName) rgbModeName.textContent = 'BLAZE GOLD • WARP SPEED';
        }
        if (color === 'rose') {
          rgbAmbient.className = 'absolute -top-24 -left-24 w-96 h-96 bg-rose-500/25 rounded-full blur-3xl pointer-events-none transition-all duration-700';
          if (rgbModeName) rgbModeName.textContent = 'CRIMSON RED • OVERCLOCK';
        }
      }
    });
  });

  // Power Switch & Stress Test Simulation (Both Buttons)
  const powerBtn = document.getElementById('btn-power-switch');
  const powerBtnBottom = document.getElementById('btn-power-switch-bottom');
  const powerLed = document.getElementById('rig-power-led');
  const statusText = document.getElementById('rig-status-text');

  function triggerStressTest() {
    playSound('power');
    if (statusText) statusText.textContent = '● STRESS TESTING 100% LOAD...';
    if (powerLed) powerLed.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping';
    
    // Temporarily ramp telemetry
    const teleLoad = document.getElementById('telemetry-load');
    const teleCpu = document.getElementById('telemetry-cpu-temp');
    const teleGpu = document.getElementById('telemetry-gpu-temp');
    if (teleLoad) teleLoad.textContent = '99%';
    if (teleCpu) teleCpu.textContent = 'CPU 76°C';
    if (teleGpu) teleGpu.textContent = 'GPU 79°C';

    // Speed up fans temporarily
    document.querySelectorAll('.rig-fan').forEach(fan => {
      (fan as HTMLElement).style.animationDuration = '0.35s';
    });

    setTimeout(() => {
      if (statusText) statusText.textContent = '● SYSTEM ONLINE • 60 FPS';
      if (powerLed) powerLed.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';
      updateVisualizerAndStats();
      document.querySelectorAll('.rig-fan').forEach(fan => {
        (fan as HTMLElement).style.animationDuration = '2.0s';
      });
    }, 1800);
  }

  if (powerBtn) powerBtn.addEventListener('click', triggerStressTest);
  if (powerBtnBottom) powerBtnBottom.addEventListener('click', triggerStressTest);

  // Sound Toggle
  const soundBtn = document.getElementById('btn-sound-toggle');
  if (soundBtn) {
    soundBtn.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      soundBtn.textContent = soundEnabled ? '🔊' : '🔇';
      if (soundEnabled) playSound('click');
    });
  }

  // Social Share & WhatsApp Handler
  const waBtn = document.getElementById('btn-share-whatsapp');
  const copyBtn = document.getElementById('btn-copy-link');
  if (waBtn) {
    waBtn.addEventListener('click', () => {
      const text = encodeURIComponent(`Check out my custom gaming PC build on UniqueDigit: ₹${document.getElementById('total-price-header')?.textContent || ''} - ${currentSelection.cpu.name} + ${currentSelection.gpu.name}! View 3D simulator: ${window.location.href}`);
      window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    });
  }
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard?.writeText(window.location.href);
      const orig = copyBtn.textContent;
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => { copyBtn.textContent = orig; }, 2000);
    });
  }

  // 🖱️ Custom Magnetic Cursor & Dynamic Glass Spotlight Logic
  const cursor = document.getElementById('custom-cursor');
  const cursorDot = document.getElementById('cursor-dot');
  const spotlight = document.getElementById('dynamic-spotlight');

  document.addEventListener('mousemove', (e) => {
    if (cursor && cursorDot) {
      cursor.style.transform = `translate3d(${e.clientX - 20}px, ${e.clientY - 20}px, 0)`;
      cursorDot.style.transform = `translate3d(${e.clientX - 4}px, ${e.clientY - 4}px, 0)`;
    }
    if (viewportBox && spotlight) {
      const rect = viewportBox.getBoundingClientRect();
      if (e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom) {
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        spotlight.style.background = `radial-gradient(450px circle at ${x}px ${y}px, rgba(34, 211, 238, 0.18), transparent 60%)`;
      }
    }
  });

  document.querySelectorAll('button, a, .anti-gravity, input[type="range"]').forEach(el => {
    el.addEventListener('mouseenter', () => {
      if (cursor) {
        cursor.style.transform += ' scale(1.6)';
        cursor.style.borderColor = '#fbbf24';
      }
    });
    el.addEventListener('mouseleave', () => {
      if (cursor) {
        cursor.style.borderColor = '#22d3ee';
      }
    });
  });

  // ==========================================
  // 🎮 THREE.JS HIGH-PERFORMANCE 3D WEBGL ENGINE
  // ==========================================
  let threeScene, threeCamera, threeRenderer, pcModelGroup;
  let fanMeshes = [];
  let gpuMesh, cpuCoolerMesh, ramMeshGroup;
  let argbPointLight1, argbPointLight2;
  let isDragging = false;
  let previousMouseX = 0;
  let previousMouseY = 0;
  let targetRotationX = 0.1;
  let targetRotationY = -0.15;
  let fanRotationSpeed = 0.05;

  function initThreeEngine() {
    const canvas = document.getElementById('three-pc-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const width = canvas.clientWidth || 500;
    const height = canvas.clientHeight || 480;

    // 1. Scene & Camera
    threeScene = new THREE.Scene();
    threeCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    threeCamera.position.set(0, 0, 7.2);

    // 2. WebGL Renderer with Alpha & Tone Mapping
    try {
      threeRenderer = new THREE.WebGLRenderer({
        canvas: canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance'
      });
      threeRenderer.setSize(width, height);
      threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      threeRenderer.toneMapping = THREE.ACESFilmicToneMapping;
      threeRenderer.toneMappingExposure = 1.2;
    } catch (e) {
      console.warn('WebGL init fallback:', e);
      return;
    }

    // 3. Studio Lighting & ARGB Accent Point Lights
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
    threeScene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
    dirLight.position.set(5, 8, 6);
    threeScene.add(dirLight);

    argbPointLight1 = new THREE.PointLight(0x00f2ff, 3.5, 10);
    argbPointLight1.position.set(-2, 1.5, 1.5);
    threeScene.add(argbPointLight1);

    argbPointLight2 = new THREE.PointLight(0xbf00ff, 3.5, 10);
    argbPointLight2.position.set(2, -1, 1.5);
    threeScene.add(argbPointLight2);

    // 4. PC Chassis & Components 3D Mesh Construction
    pcModelGroup = new THREE.Group();

    // Outer Mid-Tower PC Case (Metallic Dark Box)
    const caseGeo = new THREE.BoxGeometry(3.2, 4.4, 2.0);
    const caseMat = new THREE.MeshStandardMaterial({
      color: 0x0a0e1a,
      roughness: 0.3,
      metalness: 0.85
    });
    const caseMesh = new THREE.Mesh(caseGeo, caseMat);
    pcModelGroup.add(caseMesh);

    // Tempered Glass Front/Side View Window (Physics Glass Effect)
    const glassGeo = new THREE.BoxGeometry(3.05, 4.25, 0.05);
    const glassMat = new THREE.MeshPhysicalMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.15,
      roughness: 0.05,
      metalness: 0.1,
      transmission: 0.9,
      ior: 1.5
    });
    const glassMesh = new THREE.Mesh(glassGeo, glassMat);
    glassMesh.position.set(0, 0, 0.98);
    pcModelGroup.add(glassMesh);

    // Motherboard PCB Plate
    const moboGeo = new THREE.BoxGeometry(2.6, 3.4, 0.1);
    const moboMat = new THREE.MeshStandardMaterial({
      color: 0x111827,
      roughness: 0.6,
      metalness: 0.4
    });
    const moboMesh = new THREE.Mesh(moboGeo, moboMat);
    moboMesh.position.set(0, 0, -0.4);
    pcModelGroup.add(moboMesh);

    // CPU Cooler Liquid AIO Pump (Cylinder with Glowing ARGB Ring)
    const coolerGeo = new THREE.CylinderGeometry(0.48, 0.48, 0.25, 32);
    const coolerMat = new THREE.MeshStandardMaterial({
      color: 0x1e1b4b,
      emissive: 0x6366f1,
      emissiveIntensity: 0.6,
      roughness: 0.2,
      metalness: 0.8
    });
    cpuCoolerMesh = new THREE.Mesh(coolerGeo, coolerMat);
    cpuCoolerMesh.rotation.x = Math.PI / 2;
    cpuCoolerMesh.position.set(-0.35, 0.6, -0.2);
    pcModelGroup.add(cpuCoolerMesh);

    // Dual Glowing ARGB DDR5 RAM Sticks
    ramMeshGroup = new THREE.Group();
    const ramGeo = new THREE.BoxGeometry(0.08, 0.9, 0.15);
    const ramMat = new THREE.MeshStandardMaterial({
      color: 0x00f2ff,
      emissive: 0x00f2ff,
      emissiveIntensity: 0.8,
      roughness: 0.1
    });
    const ram1 = new THREE.Mesh(ramGeo, ramMat);
    ram1.position.set(0.35, 0.6, -0.2);
    const ram2 = new THREE.Mesh(ramGeo, ramMat);
    ram2.position.set(0.5, 0.6, -0.2);
    ramMeshGroup.add(ram1);
    ramMeshGroup.add(ram2);
    pcModelGroup.add(ramMeshGroup);

    // NVIDIA GeForce RTX Graphics Card (GPU) with LED Backplate
    const gpuGeo = new THREE.BoxGeometry(2.3, 0.45, 0.9);
    const gpuMat = new THREE.MeshStandardMaterial({
      color: 0x0f172a,
      emissive: 0x8b5cf6,
      emissiveIntensity: 0.5,
      roughness: 0.3,
      metalness: 0.9
    });
    gpuMesh = new THREE.Mesh(gpuGeo, gpuMat);
    gpuMesh.position.set(-0.15, -0.45, 0.1);
    pcModelGroup.add(gpuMesh);

    // 4x Animated Rotating ARGB Cooling Fans
    const createFan = (x, y, z, rotX = 0) => {
      const fanGroup = new THREE.Group();
      const ringGeo = new THREE.TorusGeometry(0.38, 0.04, 16, 32);
      const ringMat = new THREE.MeshStandardMaterial({
        color: 0x00f2ff,
        emissive: 0x00f2ff,
        emissiveIntensity: 0.9
      });
      const ring = new THREE.Mesh(ringGeo, ringMat);
      fanGroup.add(ring);

      const bladeGeo = new THREE.BoxGeometry(0.68, 0.08, 0.02);
      const bladeMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.5 });
      const blade1 = new THREE.Mesh(bladeGeo, bladeMat);
      const blade2 = new THREE.Mesh(bladeGeo, bladeMat);
      blade2.rotation.z = Math.PI / 2;
      fanGroup.add(blade1);
      fanGroup.add(blade2);

      fanGroup.position.set(x, y, z);
      fanGroup.rotation.x = rotX;
      pcModelGroup.add(fanGroup);
      fanMeshes.push({ group: fanGroup, blade1, blade2, ringMat });
    };

    // Top Radiator Fans
    createFan(-0.6, 1.85, 0, Math.PI / 2);
    createFan(0.6, 1.85, 0, Math.PI / 2);

    // Front Intake Fans
    createFan(1.35, 0.8, 0.2);
    createFan(1.35, -0.5, 0.2);

    threeScene.add(pcModelGroup);

    // 5. Mouse Drag 360° Orbit Interaction
    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      previousMouseX = e.clientX;
      previousMouseY = e.clientY;
    });

    window.addEventListener('mouseup', () => { isDragging = false; });

    canvas.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - previousMouseX;
      const deltaY = e.clientY - previousMouseY;

      targetRotationY += deltaX * 0.01;
      targetRotationX += deltaY * 0.01;

      // Restrict pitch
      targetRotationX = Math.max(-0.6, Math.min(0.6, targetRotationX));

      previousMouseX = e.clientX;
      previousMouseY = e.clientY;
    });

    // Touch support for mobile 3D interaction
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        previousMouseX = e.touches[0].clientX;
        previousMouseY = e.touches[0].clientY;
      }
    });

    canvas.addEventListener('touchmove', (e) => {
      if (!isDragging || e.touches.length !== 1) return;
      const deltaX = e.touches[0].clientX - previousMouseX;
      const deltaY = e.touches[0].clientY - previousMouseY;

      targetRotationY += deltaX * 0.012;
      targetRotationX += deltaY * 0.012;
      targetRotationX = Math.max(-0.6, Math.min(0.6, targetRotationX));

      previousMouseX = e.touches[0].clientX;
      previousMouseY = e.touches[0].clientY;
    });

    window.addEventListener('touchend', () => { isDragging = false; });

    // 6. Responsive Resize Handling
    window.addEventListener('resize', () => {
      if (!canvas || !threeCamera || !threeRenderer) return;
      const newW = canvas.clientWidth;
      const newH = canvas.clientHeight;
      threeCamera.aspect = newW / newH;
      threeCamera.updateProjectionMatrix();
      threeRenderer.setSize(newW, newH);
    });

    // 7. Render Animation Loop (60 FPS)
    function animateThree() {
      requestAnimationFrame(animateThree);

      if (pcModelGroup) {
        // Smooth Lerp Rotation
        pcModelGroup.rotation.y += (targetRotationY - pcModelGroup.rotation.y) * 0.08;
        pcModelGroup.rotation.x += (targetRotationX - pcModelGroup.rotation.x) * 0.08;

        // Subtle Anti-Gravity idle bob
        pcModelGroup.position.y = Math.sin(Date.now() * 0.002) * 0.08;
      }

      // Spin Fans
      fanMeshes.forEach(f => {
        f.blade1.rotation.z += fanRotationSpeed;
        f.blade2.rotation.z += fanRotationSpeed;
      });

      if (threeRenderer && threeScene && threeCamera) {
        threeRenderer.render(threeScene, threeCamera);
      }
    }

    animateThree();
  }

  // Update Three.js ARGB Colors
  function updateThreeARGB(colorHex) {
    if (!argbPointLight1 || !argbPointLight2) return;
    const color = new THREE.Color(colorHex);
    argbPointLight1.color = color;
    argbPointLight2.color = color;

    fanMeshes.forEach(f => {
      if (f.ringMat) {
        f.ringMat.color = color;
        f.ringMat.emissive = color;
      }
    });

    if (ramMeshGroup) {
      ramMeshGroup.children.forEach((child: any) => {
        if (child.material) {
          child.material.color = color;
          child.material.emissive = color;
        }
      });
    }
  }

  // Camera presets helper for Three.js
  function setThreeCameraAngle(angle) {
    if (angle === 'hero') { targetRotationX = 0.1; targetRotationY = -0.15; }
    if (angle === 'flat') { targetRotationX = 0.0; targetRotationY = 0.0; }
    if (angle === 'side') { targetRotationX = 0.08; targetRotationY = -0.55; }
  }

  // Connect Camera Angle Buttons to Three.js
  document.querySelectorAll('.cam-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const cam = btn.getAttribute('data-cam');
      setThreeCameraAngle(cam);
    });
  });

  // Connect Color Buttons to Three.js
  document.querySelectorAll('[data-rgb]').forEach(btn => {
    btn.addEventListener('click', () => {
      const color = btn.getAttribute('data-rgb');
      if (color === 'cyan') updateThreeARGB(0x00f2ff);
      if (color === 'purple') updateThreeARGB(0xbf00ff);
      if (color === 'emerald') updateThreeARGB(0x10b981);
      if (color === 'amber') updateThreeARGB(0xf59e0b);
      if (color === 'rose') updateThreeARGB(0xf43f5e);
    });
  });

  // Connect Reset Button to Three.js
  const resetThreeBtn = document.getElementById('btn-reset-rig');
  if (resetThreeBtn) {
    resetThreeBtn.addEventListener('click', () => {
      targetRotationX = 0.1;
      targetRotationY = -0.15;
    });
  }

  // Initial load
  initThreeEngine();
  renderPartCards('cpu');
  updateVisualizerAndStats();
</script>
