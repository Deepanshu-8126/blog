    const visPsuHeadroomBanner = document.getElementById('vis-psu-headroom-banner');

    if (visCpu) visCpu.textContent = cpu.name.toUpperCase();
    if (visCpuSocketLine) visCpuSocketLine.textContent = `${cpu.socket} • ${cpu.brand} • ${cpu.wattage}W TDP • ${cpu.badge}`;
    if (visGpu) visGpu.textContent = `${gpu.name.toUpperCase()}`;
    if (visGpuSpec) visGpuSpec.textContent = `${gpu.wattage}W TDP • ${gpu.badge} • PCIe 4.0 Core`;
    if (visRam) visRam.textContent = ram.ramType;
    if (visRamType) visRamType.textContent = ram.name.includes('32GB') ? '32GB (16GBx2) High-Speed' : '16GB (8GBx2) Dual-Channel';
    if (visSsd) visSsd.textContent = ssd.name.split('(')[0].toUpperCase();
    if (visSsdSpeed) visSsdSpeed.textContent = ssd.speed ? `${ssd.speed} Read Speed • Gen4` : 'PCIe 4.0 NVMe';
    if (visPsuHeadroomBanner) {
      visPsuHeadroomBanner.textContent = `PSU ${psuWattage}W 80+ • HEADROOM: +${headroomPct}% (${headroom >= 80 ? 'SAFE' : 'TIGHT'})`;
    }

    // Dynamic Live Telemetry Temp Updates based on wattage
    const teleLoad = document.getElementById('telemetry-load');
    const teleCpu = document.getElementById('telemetry-cpu-temp');
    const teleGpu = document.getElementById('telemetry-gpu-temp');
    const cpuTemp = Math.round(42 + (cpu.wattage * 0.16));
    const gpuTemp = Math.round(48 + (gpu.wattage * 0.09));
    const loadPct = Math.round((totalWattage / psuWattage) * 75);

    if (teleLoad) teleLoad.textContent = `${loadPct}%`;
    if (teleCpu) teleCpu.textContent = `CPU ${cpuTemp}°C`;
    if (teleGpu) teleGpu.textContent = `GPU ${gpuTemp}°C`;

    // Electricity & UPS Calculations
    const monthlyUnits = (totalWattage * 4 * 30) / 1000;
    const monthlyCost = Math.round(monthlyUnits * 7.5);
    const billEstimate = document.getElementById('bill-estimate');
    const upsRecommend = document.getElementById('ups-recommend');
    if (billEstimate) billEstimate.textContent = `~₹${monthlyCost}/month`;
    if (upsRecommend) upsRecommend.textContent = totalWattage > 450 ? '1100VA / 660W' : '600VA / 360W';

    // Dynamic FPS Calculations
    const multiplier = gpu.fpsMultiplier || 1.0;
    const fpsGta = document.getElementById('fps-gta');
    const fpsVal = document.getElementById('fps-val');
    const fpsCp = document.getElementById('fps-cp');
    const fpsBgmi = document.getElementById('fps-bgmi');
    if (fpsGta) fpsGta.textContent = `${Math.round(cpu.gtaFps * multiplier)} FPS`;
    if (fpsVal) fpsVal.textContent = `${Math.round(cpu.valFps * multiplier)} FPS`;
    if (fpsCp) fpsCp.textContent = `${Math.round(cpu.cpFps * multiplier)} FPS`;
    if (fpsBgmi) fpsBgmi.textContent = `${Math.round(cpu.bgmiFps * multiplier)} FPS`;

    // Compatibility validation
    const compatIcon = document.getElementById('compat-icon');
    const compatStatus = document.getElementById('compat-status');
    const compatDesc = document.getElementById('compat-desc');
    let isSocketMatch = (cpu.socket === mobo.socket);
    let isRamMatch = (mobo.ramType.includes(ram.ramType));
    let isPsuSafe = (headroom >= 80);

    if (!isSocketMatch) {
      if (compatIcon) { compatIcon.textContent = '✕'; compatIcon.className = 'w-6 h-6 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center font-black text-xs shrink-0'; }
      if (compatStatus) { compatStatus.textContent = `⚠️ Socket Mismatch: ${cpu.socket} vs ${mobo.socket}`; compatStatus.className = 'block text-xs font-bold text-rose-400'; }
      if (compatDesc) compatDesc.textContent = `Please switch motherboard to match ${cpu.socket} processor socket.`;
    } else if (!isRamMatch) {
      if (compatIcon) { compatIcon.textContent = '⚠️'; compatIcon.className = 'w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-black text-xs shrink-0'; }
      if (compatStatus) { compatStatus.textContent = `⚠️ RAM Type Mismatch: ${ram.ramType} on ${mobo.ramType}`; compatStatus.className = 'block text-xs font-bold text-amber-400'; }
      if (compatDesc) compatDesc.textContent = `Please select matching ${mobo.ramType} memory modules.`;
    } else if (!isPsuSafe) {
      if (compatIcon) { compatIcon.textContent = '⚠️'; compatIcon.className = 'w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-black text-xs shrink-0'; }
      if (compatStatus) { compatStatus.textContent = `⚠️ PSU Headroom Warning (${totalWattage}W / ${psuWattage}W)`; compatStatus.className = 'block text-xs font-bold text-amber-400'; }
      if (compatDesc) compatDesc.textContent = `Consider upgrading to a 650W or 750W PSU for peak stability.`;
    } else {
      if (compatIcon) { compatIcon.textContent = '✓'; compatIcon.className = 'w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-xs shrink-0'; }
      if (compatStatus) { compatStatus.textContent = `100% Component Compatibility Verified`; compatStatus.className = 'block text-xs font-bold text-white'; }
      if (compatDesc) compatDesc.textContent = `${cpu.socket} Socket & ${psuWattage}W PSU match perfectly with ${gpu.name}.`;
    }

    // Update 1-Click Multi-ASIN Amazon Cart Link
    const buyBtn = document.getElementById('btn-buy-full-build');
    if (buyBtn) {
      const asins = [cpu.amazonAsin, gpu.amazonAsin, mobo.amazonAsin, ram.amazonAsin, ssd.amazonAsin, cabinet.amazonAsin].filter(Boolean);
      const cartParams = asins.map((asin, idx) => `ASIN.${idx+1}=${asin}&Quantity.${idx+1}=1`).join('&');
      const directCartUrl = `https://www.amazon.in/gp/aws/cart/add.html?AssociateTag=${AMAZON_TAG}&${cartParams}`;
      buyBtn.setAttribute('href', directCartUrl);
    }

    // Update summary table
    const summaryContainer = document.getElementById('selected-parts-summary');
    if (summaryContainer) {
      summaryContainer.innerHTML = Object.entries(currentSelection).map(([k, item]) => `
        <div class="py-2.5 flex items-center justify-between gap-2">
          <span class="text-slate-400 font-mono uppercase text-[10px] w-14 shrink-0">${k}</span>
          <span class="font-bold text-ink truncate flex-1">${item.name}</span>
          <span class="font-mono font-bold text-slate-800 shrink-0">₹${item.price.toLocaleString('en-IN')}</span>
        </div>
      `).join('');
    }

    // Re-render current catalog tab
    renderPartCards(activeTab);
  }

  // Window helper for onclick handler
  window.selectPart = function(category, id) {
    const item = PARTS_DATA[category]?.find(x => x.id === id);
    if (item) {
      currentSelection[category] = item;
