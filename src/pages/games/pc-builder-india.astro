---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<Layout
  title="PC Builder Simulator India (2026) — 3D Interactive Rig Builder & Live INR Amazon Prices | UniqueDigit"
  description="Interactive 3D PC Builder Simulator for Indian gamers. Custom build your gaming rig with live ARGB lighting, mechanical audio feedback, component compatibility validation, live Amazon India prices, FPS benchmarks, and laptop alternatives."
>
  <!-- Top Banner & Breadcrumb -->
  <div class="mb-6">
    <nav class="flex items-center gap-2 text-xs text-muted mb-3">
      <a href="/" class="hover:text-brand transition">Home</a>
      <span>/</span>
      <a href="/pc-builds" class="hover:text-brand transition font-medium">PC Builds</a>
      <span>/</span>
      <span class="text-ink font-bold">3D Rig Simulator</span>
    </nav>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-line">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-brand text-white shadow-xs">
            🎮 3D Real-Time Simulator
          </span>
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 font-mono">
            ⚡ Verified Indian Amazon Prices (2026)
          </span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-500/10 text-purple-600 border border-purple-500/20 hidden sm:inline">
            🔊 Sound FX On
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-ink tracking-tight">
          Indian PC Builder & 3D Interactive Rig Simulator
        </h1>
        <p class="text-sm text-muted mt-1 max-w-3xl">
          Assemble your custom gaming rig in interactive 3D, test AM4/AM5 socket compatibility & PSU headroom, hear mechanical snap feedback, predict 1080p/1440p gaming FPS, and checkout individual parts or full builds on Amazon India.
        </p>
      </div>

      <!-- Quick Stats Pill -->
      <div class="flex items-center gap-4 bg-slate-900 text-white p-4 rounded-2xl border border-slate-800 shrink-0 shadow-card">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block font-mono">Estimated Rig Cost</span>
          <span class="text-2xl font-black text-cta font-mono" id="total-price-header">₹54,988</span>
        </div>
        <div class="border-l border-slate-800 pl-4">
          <span class="text-[10px] uppercase font-bold text-slate-400 block font-mono">Total Power Draw</span>
          <span class="text-lg font-black text-white font-mono" id="total-wattage">420W</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Simulator Container -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 my-6 w-full items-start">
    
    <!-- LEFT COLUMN: 3D Interactive PC Cabinet Visualizer -->
    <div class="w-full min-w-0 flex flex-col gap-6 sticky lg:top-20">
      
      <div class="p-5 sm:p-7 rounded-3xl bg-slate-950 border border-slate-800 text-white shadow-2xl relative overflow-hidden w-full select-none" id="rig-viewport-box">
        <!-- Ambient ARGB Background Lighting -->
        <div id="ambient-rgb" class="absolute -top-20 -left-20 w-96 h-96 bg-cyan-500/25 rounded-full blur-3xl pointer-events-none transition-all duration-700"></div>
        <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-brand/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <!-- Top Header inside Visualizer -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800/80 mb-5">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse" id="rig-power-led"></span>
              <span class="text-xs font-mono font-bold text-slate-300" id="rig-status-text">SYSTEM ONLINE (60 FPS)</span>
            </div>

            <!-- Interactive Controls: Camera Angles + ARGB + Sound Toggle -->
            <div class="flex items-center gap-2">
              <!-- Camera Angle Selector -->
              <div class="flex items-center bg-slate-900 p-1 rounded-xl border border-slate-800 text-[11px] font-mono">
                <button class="cam-btn px-2.5 py-1 rounded-lg bg-brand text-white font-bold cursor-pointer transition" data-cam="hero">3D Hero</button>
                <button class="cam-btn px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer transition" data-cam="flat">Front</button>
                <button class="cam-btn px-2.5 py-1 rounded-lg text-slate-400 hover:text-white cursor-pointer transition" data-cam="side">Side 45°</button>
              </div>

              <!-- ARGB Color Switcher -->
              <div class="flex items-center gap-1 bg-slate-900 p-1.5 rounded-xl border border-slate-800">
                <button class="w-4 h-4 rounded-full bg-cyan-400 border border-white/40 cursor-pointer transition hover:scale-125" data-rgb="cyan" title="Cyber Cyan"></button>
                <button class="w-4 h-4 rounded-full bg-purple-500 border border-white/40 cursor-pointer transition hover:scale-125" data-rgb="purple" title="Neon Purple"></button>
                <button class="w-4 h-4 rounded-full bg-emerald-400 border border-white/40 cursor-pointer transition hover:scale-125" data-rgb="emerald" title="Razer Emerald"></button>
                <button class="w-4 h-4 rounded-full bg-amber-400 border border-white/40 cursor-pointer transition hover:scale-125" data-rgb="amber" title="Blaze Gold"></button>
                <button class="w-4 h-4 rounded-full bg-rose-500 border border-white/40 cursor-pointer transition hover:scale-125" data-rgb="rose" title="Crimson Red"></button>
              </div>

              <!-- Sound Toggle -->
              <button id="btn-sound-toggle" class="p-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300 hover:text-white cursor-pointer" title="Toggle Mechanical Audio FX">
                🔊
              </button>
            </div>
          </div>

          <!-- 3D Parallax Cabinet Frame -->
          <div class="perspective-1000 w-full flex items-center justify-center py-2">
            <div
              id="pc-3d-case"
              class="w-full min-h-[420px] rounded-3xl bg-gradient-to-b from-slate-900 via-slate-950 to-black border-2 border-slate-700/80 p-6 relative flex flex-col justify-between shadow-2xl transition-transform duration-300 transform-gpu overflow-hidden"
              style="transform: rotateX(6deg) rotateY(-8deg);"
            >
              
              <!-- Realistic Tempered Glass Bevel Reflection Layer -->
              <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-cyan-400/10 pointer-events-none rounded-3xl border border-white/10 z-20"></div>
              
              <!-- Front I/O Panel Header with clickable Power Button -->
              <div class="relative z-30 flex items-center justify-between pb-3 border-b border-slate-800/80 mb-2">
                <div class="flex items-center gap-2">
                  <button id="btn-power-switch" class="px-3 py-1 rounded-xl bg-rose-500/20 hover:bg-rose-500/40 text-rose-300 border border-rose-500/40 text-[11px] font-mono font-black flex items-center gap-1.5 cursor-pointer active:scale-95 transition shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-rose-400 animate-ping"></span>
                    <span>⚡ POWER ON / TEST</span>
                  </button>
                  <span class="text-[10px] font-mono text-slate-400 hidden sm:inline" id="post-status-badge">POST: OK</span>
                </div>

                <div class="flex items-center gap-3 text-[10px] font-mono text-slate-400">
                  <span>USB 3.2 Gen2</span>
                  <span>Type-C</span>
                  <span class="text-cyan-400 font-bold">ARGB SYNC</span>
                </div>
              </div>

              <!-- Motherboard & Internal Hardware Layout -->
              <div class="relative z-10 w-full h-full flex flex-col justify-between gap-4 my-auto">
                
                <!-- TOP ZONE: Exhaust Fan + CPU Socket Cooler + Dual RGB RAM Sticks -->
                <div class="flex items-start justify-between gap-3">
                  
                  <!-- Rear 120mm Exhaust ARGB Fan (Spinning) -->
                  <div class="w-20 h-20 rounded-2xl bg-slate-900/90 border border-slate-700/90 flex items-center justify-center relative shadow-inner group">
                    <div class="w-16 h-16 rounded-full border-2 border-dashed border-cyan-400 animate-spin flex items-center justify-center rig-fan" style="animation-duration: 2.2s;">
                      <div class="w-5 h-5 rounded-full bg-cyan-400/90 blur-xs shadow-lg shadow-cyan-400"></div>
                    </div>
                    <span class="absolute -bottom-4 text-[9px] font-mono text-slate-400">Exhaust (1400 RPM)</span>
                  </div>

                  <!-- CPU Socket & Liquid/Air Cooler Block -->
                  <div class="flex-1 max-w-[210px] p-3.5 rounded-2xl bg-slate-900/90 border border-cyan-400/50 shadow-xl shadow-cyan-500/10 flex flex-col items-center justify-center text-center relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-b from-cyan-500/10 to-transparent pointer-events-none"></div>
                    <span class="text-[10px] font-black uppercase text-cyan-300 font-mono tracking-wider mb-1" id="vis-cpu-name">AMD Ryzen 5 5600</span>
                    <div class="w-12 h-12 rounded-xl bg-slate-950 border border-cyan-400/60 flex flex-col items-center justify-center shadow-inner">
                      <span class="text-xs font-mono font-black text-cyan-400" id="vis-cpu-socket">AM4</span>
                      <span class="text-[8px] font-mono text-slate-400">65W TDP</span>
                    </div>
                    <span class="text-[9px] text-slate-300 mt-1 font-medium" id="vis-cpu-cooler">Wraith Stealth ARGB</span>
                  </div>

                  <!-- Dual Channel RGB Heatspreader RAM Sticks -->
                  <div class="flex gap-2 p-2.5 rounded-2xl bg-slate-900/80 border border-slate-700 shadow-inner">
                    <div class="w-3 h-20 rounded-sm bg-gradient-to-t from-cyan-500 via-purple-500 to-pink-500 shadow-md shadow-purple-500/50 animate-pulse"></div>
                    <div class="w-3 h-20 rounded-sm bg-gradient-to-t from-cyan-500 via-purple-500 to-pink-500 shadow-md shadow-purple-500/50 animate-pulse"></div>
                    <div class="flex flex-col justify-center text-[9px] font-mono text-slate-300 pl-1">
                      <span id="vis-ram-spec" class="font-bold text-white">16GB</span>
                      <span id="vis-ram-type" class="text-cyan-400">DDR4-3200</span>
                      <span class="text-[8px] text-slate-400">Dual Ch.</span>
                    </div>
                  </div>
                </div>

                <!-- MIDDLE ZONE: Heavy Dedicated Graphics Card (GPU) with Dual Axial Fans & Backplate -->
                <div class="p-4 rounded-2xl bg-slate-900/95 border-2 border-purple-500/60 shadow-2xl shadow-purple-500/20 flex items-center justify-between relative overflow-hidden group">
                  <!-- GPU PCB Glow -->
                  <div class="absolute top-0 right-0 w-32 h-32 bg-purple-500/10 rounded-full blur-2xl pointer-events-none"></div>

                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full border-2 border-dashed border-purple-400 animate-spin flex items-center justify-center rig-fan" style="animation-duration: 1.8s;">
                      <div class="w-3 h-3 rounded-full bg-purple-400 shadow-md shadow-purple-400"></div>
                    </div>
                    <div class="w-12 h-12 rounded-full border-2 border-dashed border-purple-400 animate-spin flex items-center justify-center rig-fan" style="animation-duration: 1.8s;">
                      <div class="w-3 h-3 rounded-full bg-purple-400 shadow-md shadow-purple-400"></div>
                    </div>
                  </div>

                  <div class="text-right">
                    <div class="flex items-center justify-end gap-1.5 mb-0.5">
                      <span class="px-2 py-0.5 rounded text-[9px] font-mono font-black bg-purple-500/30 text-purple-300 border border-purple-500/40">PCIe 4.0 x16</span>
                      <span class="text-xs font-black text-purple-200 font-mono tracking-tight" id="vis-gpu-name">
                        NVIDIA GeForce RTX 4060 8GB
                      </span>
                    </div>
                    <span class="text-[10px] text-slate-400 font-mono block" id="vis-gpu-spec">
                      115W TDP • DLSS 3 & Ray Tracing Enabled
                    </span>
                  </div>
                </div>

                <!-- BOTTOM ZONE: M.2 NVMe SSD Heatsink & PSU Shroud with Braided Cables -->
                <div class="flex items-center justify-between pt-3 border-t border-slate-800/80">
                  <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-700 flex items-center gap-2">
                    <Icon name="cpu" class="w-4 h-4 text-cyan-400" />
                    <div>
                      <span class="text-[10px] font-mono font-bold text-white block" id="vis-ssd-name">1TB Gen4 NVMe</span>
                      <span class="text-[9px] font-mono text-slate-400" id="vis-ssd-speed">3,500 MB/s Read Speed</span>
                    </div>
                  </div>

                  <div class="p-2.5 px-4 rounded-xl bg-slate-900 border border-slate-700 text-right">
                    <span class="text-[10px] font-mono font-bold text-amber-300 block" id="vis-psu-name">550W Bronze PSU</span>
                    <span class="text-[9px] font-mono text-slate-400" id="vis-psu-headroom">Headroom: +130W (Safe)</span>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <!-- Compatibility & Bottleneck Alert Banner -->
          <div class="mt-5 p-4 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black text-sm shrink-0" id="compat-icon">
                ✓
              </span>
              <div>
                <span class="block text-xs font-bold text-white" id="compat-status">100% Component Compatibility Verified</span>
                <span class="text-[11px] text-slate-400" id="compat-desc">AM4 Socket & 550W PSU are fully compatible with RTX 4060.</span>
              </div>
            </div>

            <div class="text-right shrink-0">
              <span class="text-[10px] font-mono uppercase text-slate-400 block">Bottleneck</span>
              <span class="text-xs font-black text-emerald-400 font-mono" id="bottleneck-score">0.8% (Ideal)</span>
            </div>
          </div>

          <!-- Live Gaming FPS Benchmarks Meter -->
          <div class="mt-5 pt-5 border-t border-slate-800">
            <div class="flex items-center justify-between mb-3">
              <h4 class="text-xs font-mono font-black uppercase text-slate-400 tracking-wider">
                🎮 Real-Time Gaming FPS Benchmarks (1080p Ultra)
              </h4>
              <span class="text-[10px] font-mono text-emerald-400">Direct Hardware Simulation</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 text-center">
                <span class="text-[10px] text-slate-400 font-bold block">GTA 5 / 6</span>
                <span class="text-base font-black text-cyan-300 font-mono" id="fps-gta">95 FPS</span>
              </div>
              <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 text-center">
                <span class="text-[10px] text-slate-400 font-bold block">Valorant / CS2</span>
                <span class="text-base font-black text-emerald-300 font-mono" id="fps-val">280 FPS</span>
              </div>
              <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 text-center">
                <span class="text-[10px] text-slate-400 font-bold block">Cyberpunk 2077</span>
                <span class="text-base font-black text-purple-300 font-mono" id="fps-cp">72 FPS</span>
              </div>
              <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 text-center">
                <span class="text-[10px] text-slate-400 font-bold block">BGMI / PUBG</span>
                <span class="text-base font-black text-amber-300 font-mono" id="fps-bgmi">140 FPS</span>
              </div>
            </div>
          </div>

          <!-- 1-Click Amazon India Complete Build Checkout Button -->
          <div class="mt-6 pt-5 border-t border-slate-800 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            <div>
              <span class="text-xs text-slate-300 font-bold block">Amazon India Prime Certified Cart</span>
              <span class="text-[11px] text-slate-500">Official brand warranties, GST invoices & fast Prime delivery.</span>
            </div>

            <a
              id="btn-buy-full-build"
              href="https://www.amazon.in/s?k=ryzen+5+5600+rtx+4060+pc+build&tag=uniquedigi0c6-21"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-sm transition transform hover:-translate-y-0.5 active:translate-y-0 shadow-lg shadow-amber-500/25 cursor-pointer shrink-0"
            >
              <span>🛒 Buy Complete Build on Amazon</span>
              <Icon name="external-link" class="w-4 h-4" />
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Interactive Component Selector -->
    <div class="w-full min-w-0 flex flex-col gap-6">
      
      <!-- Category Selection Tabs -->
      <div class="p-5 sm:p-6 rounded-3xl bg-white border border-line shadow-card">
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-line">
          <span class="text-xs font-mono font-bold uppercase text-muted">Component Catalog</span>
          <span class="text-xs font-mono font-bold text-brand">Select parts to install</span>
        </div>

        <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar" id="part-category-tabs">
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-black bg-brand text-white shadow-xs shrink-0 cursor-pointer" data-cat="cpu">
            1. Processor (CPU)
          </button>
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-ink shrink-0 cursor-pointer transition" data-cat="gpu">
            2. Graphics Card (GPU)
          </button>
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-ink shrink-0 cursor-pointer transition" data-cat="mobo">
            3. Motherboard
          </button>
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-ink shrink-0 cursor-pointer transition" data-cat="ram">
            4. RAM (Memory)
          </button>
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-ink shrink-0 cursor-pointer transition" data-cat="ssd">
            5. Storage (SSD)
          </button>
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-ink shrink-0 cursor-pointer transition" data-cat="cabinet">
            6. Case & PSU
          </button>
        </div>

        <!-- Dynamic Part Cards List Container -->
        <div class="mt-4 flex flex-col gap-3 max-h-[540px] overflow-y-auto pr-1" id="part-cards-list">
          <!-- Populated dynamically by JavaScript below -->
        </div>
      </div>

      <!-- Current Selected Components Breakdown Table -->
      <div class="p-6 rounded-3xl bg-white border border-line shadow-card">
        <h3 class="text-base font-black text-ink mb-4 flex items-center justify-between">
          <span>Installed Parts Summary</span>
          <span class="text-xs font-mono font-bold text-brand" id="summary-part-count">6 of 6 Parts Installed</span>
        </h3>

        <div class="flex flex-col divide-y divide-slate-100 text-xs" id="selected-parts-summary">
          <!-- Populated by JS -->
        </div>
      </div>

    </div>

  </div>

  <AdSlot position="mid" />

  <!-- DYNAMIC BUDGET SLIDER & GAMING LAPTOP ALTERNATIVES SECTION -->
  <div class="my-12 p-6 sm:p-10 rounded-3xl bg-slate-900 border border-slate-800 text-white shadow-2xl">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-slate-800 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          <span class="text-xs font-mono font-bold uppercase text-amber-300">Portability vs Power</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Prefer a Gaming Laptop Instead? Top Alternatives for Your Budget
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Compare your custom desktop build against pre-assembled RTX gaming laptops available at the exact same price point.
        </p>
      </div>

      <!-- Budget Selector Range Slider -->
      <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 min-w-[260px]">
        <div class="flex items-center justify-between text-xs mb-2">
          <span class="text-slate-400 font-medium">Target Budget:</span>
          <span class="font-black text-cta font-mono text-base" id="slider-val-display">₹55,000</span>
        </div>
        <input
          type="range"
          id="budget-slider"
          min="40000"
          max="140000"
          step="5000"
          value="55000"
          class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-400"
        />
        <div class="flex justify-between text-[10px] text-slate-500 font-mono mt-1">
          <span>₹40k</span>
          <span>₹80k</span>
          <span>₹1.4L+</span>
        </div>
      </div>
    </div>

    <!-- Dynamic Laptop Cards List -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="laptop-cards-container">
      <!-- Injected by JavaScript based on budget slider value -->
    </div>
  </div>

  <AdSlot position="bottom" />
</Layout>

<!-- Client-Side Simulator Logic & 3D Web Audio Engine -->
<script>
  // Web Audio Synthesizer (Realistic Mechanical Clicks, Power-On Hum, RGB Whir)
  let audioCtx = null;
  let soundEnabled = true;

  function getAudioCtx() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (AudioContextClass) audioCtx = new AudioContextClass();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playSound(type) {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      const now = ctx.currentTime;
      if (type === 'click') {
        // Mechanical part snap
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(600, now);
        osc.frequency.exponentialRampToValueAtTime(120, now + 0.08);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        osc.start(now);
        osc.stop(now + 0.08);
      } else if (type === 'rgb') {
        // Sci-Fi energy chirp
        osc.type = 'sine';
        osc.frequency.setValueAtTime(320, now);
        osc.frequency.exponentialRampToValueAtTime(880, now + 0.12);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
        osc.start(now);
        osc.stop(now + 0.12);
      } else if (type === 'power') {
        // Deep power-on surge & fan ramp
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(80, now);
        osc.frequency.exponentialRampToValueAtTime(240, now + 0.4);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
        osc.start(now);
        osc.stop(now + 0.4);
      }
    } catch (e) {
      // Audio fallback
    }
  }

