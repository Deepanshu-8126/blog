    const psuWattage = cabinet?.wattage || 550;
    const headroom = psuWattage - totalWattage;

    // Update Header and Summary
    const priceHdr = document.getElementById('total-price-header');
    const wattEl = document.getElementById('total-wattage');
    if (priceHdr) priceHdr.textContent = `₹${totalPrice.toLocaleString('en-IN')}`;
