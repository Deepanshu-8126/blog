  // Reset Rig View Button
  const resetBtn = document.getElementById('btn-reset-rig');
  if (resetBtn && caseBox) {
    resetBtn.addEventListener('click', () => {
      playSound('click');
      caseBox.style.transform = 'rotateX(5deg) rotateY(-7deg)';
    });
  }

  // Interactive 3D Parallax Tilt with Mouse Cursor Movement
  const viewportBox = document.getElementById('rig-viewport-box');
  if (viewportBox && caseBox) {
    viewportBox.addEventListener('mousemove', (e) => {
      const rect = viewportBox.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      caseBox.style.transform = `rotateX(${-y * 14 + 4}deg) rotateY(${x * 18 - 6}deg)`;
    });

    viewportBox.addEventListener('mouseleave', () => {
      caseBox.style.transform = 'rotateX(5deg) rotateY(-7deg)';
