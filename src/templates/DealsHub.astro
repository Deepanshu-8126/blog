<!-- Client-side Filtering Script -->
<script>
  (function() {
    const searchInput = document.getElementById('deal-search-input') as HTMLInputElement | null;
    const storeBtns = document.querySelectorAll('.store-filter-btn');
    const categoryChips = document.querySelectorAll('.category-filter-chip');
    const cards = document.querySelectorAll('.deal-card');
    const noResults = document.getElementById('no-deals-found');
    const countLabel = document.getElementById('deals-count-label');

    let currentStore = 'all';
    let currentCategory = 'all';
    let currentQuery = '';

    function filterDeals() {
      let visibleCount = 0;

      cards.forEach(card => {
        const cardEl = card as HTMLElement;
        const store = cardEl.getAttribute('data-store') || '';
        const cat = cardEl.getAttribute('data-cat') || '';
        const name = cardEl.getAttribute('data-name') || '';

        const matchStore = currentStore === 'all' || store.includes(currentStore);
        const matchCategory = currentCategory === 'all' || cat.includes(currentCategory);
        const matchSearch = !currentQuery || name.includes(currentQuery) || store.includes(currentQuery) || cat.includes(currentQuery);

        if (matchStore && matchCategory && matchSearch) {
          cardEl.style.display = 'flex';
          visibleCount++;
        } else {
          cardEl.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (countLabel) {
        countLabel.textContent = `${visibleCount} Deals Active`;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterDeals();
      });
    }

    storeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        storeBtns.forEach(b => {
          b.className = 'store-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold shrink-0 cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700';
        });
        btn.className = 'store-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold shrink-0 cursor-pointer bg-brand text-white shadow-xs';
        currentStore = (btn as HTMLElement).getAttribute('data-merchant') || 'all';
        filterDeals();
      });
    });

    categoryChips.forEach(chip => {
      chip.addEventListener('click', () => {
        categoryChips.forEach(c => {
          c.className = 'category-filter-chip px-3 py-1 rounded-lg text-xs font-semibold shrink-0 cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-600';
        });
        chip.className = 'category-filter-chip px-3 py-1 rounded-lg text-xs font-semibold shrink-0 cursor-pointer bg-slate-900 text-white';
        currentCategory = (chip as HTMLElement).getAttribute('data-category') || 'all';
        filterDeals();
      });
    });
  })();
</script>