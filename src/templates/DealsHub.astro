<script>
  (function() {
    const searchInput = document.getElementById('deal-search-input') as HTMLInputElement | null;
    const catSearchInput = document.getElementById('cat-deal-search') as HTMLInputElement | null;
    const merchantBtns = document.querySelectorAll('.merchant-filter-btn');
    const categoryBtns = document.querySelectorAll('.category-filter-btn');
    const cards = document.querySelectorAll('.deal-card');
    const noResults = document.getElementById('no-deals-found');

    let currentMerchant = 'all';
    let currentCategory = 'all';
    let currentQuery = '';

    function filterDeals() {
      let visibleCount = 0;

      cards.forEach(card => {
        const cardEl = card as HTMLElement;
        const store = cardEl.getAttribute('data-store') || '';
        const cat = cardEl.getAttribute('data-cat') || '';
        const name = cardEl.getAttribute('data-name') || '';

        const matchMerchant = currentMerchant === 'all' || store.includes(currentMerchant);
        const matchCategory = currentCategory === 'all' || cat.includes(currentCategory);
        const matchSearch = !currentQuery || name.includes(currentQuery) || store.includes(currentQuery);

        if (matchMerchant && matchCategory && matchSearch) {
          cardEl.style.display = 'flex';
          visibleCount++;
        } else {
          cardEl.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterDeals();
      });
    }

    if (catSearchInput) {
      catSearchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterDeals();
      });
    }

    merchantBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        merchantBtns.forEach(b => {
          b.className = 'merchant-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 cursor-pointer active:scale-95 bg-slate-100 hover:bg-slate-200 text-slate-700';
        });
        btn.className = 'merchant-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 cursor-pointer active:scale-95 bg-brand text-white shadow-xs';
        currentMerchant = (btn as HTMLElement).getAttribute('data-merchant') || 'all';
        filterDeals();
      });
    });

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => {
          b.className = 'category-filter-btn px-3 py-1 rounded-lg text-xs font-semibold transition shrink-0 cursor-pointer active:scale-95 bg-slate-100 hover:bg-slate-200 text-slate-600';
        });
        btn.className = 'category-filter-btn px-3 py-1 rounded-lg text-xs font-semibold transition shrink-0 cursor-pointer active:scale-95 bg-slate-900 text-white';
        currentCategory = (btn as HTMLElement).getAttribute('data-category') || 'all';
        filterDeals();
      });
    });
  })();
</script>