---
import NicheCard from '../components/NicheCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import { resolveProductImage } from '../lib/images';
import type { Niche, Product, Post } from '../lib/db';

interface Props {
  niche: Niche;
  products: Product[];
  posts: Post[];
  activeTab?: string;
  currentPage?: number;
  totalPages?: number;
  totalDeals?: number;
}

const {
  niche,
  products,
  posts,
  activeTab = 'live',
  currentPage = 1,
  totalPages = 1,
  totalDeals = products.length
} = Astro.props;

const merchants = ['All', 'Amazon', 'Flipkart', 'Myntra', 'Ajio', 'Meesho'];
const categories = ['All', 'Laptops', 'Smartphones', 'Audio', 'Fashion', 'Under ₹499'];

const STORES = [
  { name: 'Amazon', icon: 'shopping-bag', desc: 'Lightning deals, Prime member exclusives & festival drops', color: 'bg-amber-50 text-amber-900 border-amber-200', tag: 'Amazon India' },
  { name: 'Flipkart', icon: 'shopping-cart', desc: 'Big Billion Days, SuperCoin cashback & electronics drops', color: 'bg-blue-50 text-blue-900 border-blue-200', tag: 'Flipkart' },
  { name: 'Myntra', icon: 'shirt', desc: 'End of Reason Sale, top apparel brands & fashion loot', color: 'bg-rose-50 text-rose-900 border-rose-200', tag: 'Myntra' },
  { name: 'Ajio', icon: 'tag', desc: 'All Stars Sale, sneaker glitches & Reliance trends offers', color: 'bg-cyan-50 text-cyan-900 border-cyan-200', tag: 'Ajio' },
  { name: 'Meesho', icon: 'package', desc: 'Budget loots under ₹499, direct manufacturer prices', color: 'bg-fuchsia-50 text-fuchsia-900 border-fuchsia-200', tag: 'Meesho' },
];
---

<style>
  .deal-card {
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .deal-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.04);
  }

  .deal-img-wrapper {
    background: radial-gradient(circle at center, #ffffff 0%, #f8fafc 100%);
  }

  /* Micro-interactions */
  .store-filter-btn {
    transition: all 0.2s ease;
  }
  .store-filter-btn:active {
    transform: scale(0.96);
  }

  .category-filter-chip {
    transition: all 0.2s ease;
  }
  .category-filter-chip:active {
    transform: scale(0.96);
  }

  .aff-deal-btn {
    transition: all 0.2s ease;
  }
  .aff-deal-btn:hover {
    filter: brightness(1.05);
    box-shadow: 0 6px 16px -2px rgba(91, 47, 208, 0.25);
  }
  .aff-deal-btn:active {
    transform: scale(0.98);
  }

  /* Subtle pulse ticker */
  @keyframes softPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .live-dot {
    animation: softPulse 2s ease-in-out infinite;
  }
</style>

<!-- TAB: LIVE DEALS -->
{activeTab === 'live' && (
  <>
    <!-- Premium Deal Radar Hero -->
    <div class="mb-8 rounded-3xl bg-gradient-to-br from-slate-900 via-purple-950 to-slate-950 text-white p-6 sm:p-8 border border-purple-500/20 shadow-xl relative overflow-hidden">
      <!-- Glow ambient lights -->
      <div class="absolute -right-16 -top-16 w-72 h-72 rounded-full bg-brand/25 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-72 h-72 rounded-full bg-amber-500/15 blur-3xl pointer-events-none"></div>

      <div class="relative z-10">
        <!-- Live Ticker Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-5 mb-5 border-b border-white/10">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-rose-600 text-white flex items-center gap-1.5 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-white live-dot"></span>
              Live Price Radar
            </span>
            <span class="text-xs text-purple-200/90 font-medium hidden sm:inline">
              Instant alerts on verified drops across India
            </span>
          </div>

          <div class="flex items-center gap-3 text-xs text-amber-300 font-semibold">
            <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1 rounded-full border border-white/10 backdrop-blur-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-400 live-dot"></span>
              <span>Verified Price Drops</span>
            </span>
          </div>
        </div>

        <div class="max-w-3xl">
          <h1 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight mb-3">
            Verified Loot Deals & <span class="bg-gradient-to-r from-amber-300 via-rose-300 to-purple-200 bg-clip-text text-transparent">Price Drop Glitches</span>
          </h1>
          <p class="text-sm sm:text-base text-purple-100/90 leading-relaxed font-normal mb-6">
            Handpicked loots, price-error glitches, and bank discount stacking across <strong>Amazon India, Flipkart, Myntra, Ajio, and Meesho</strong>. All offers link directly to official verified checkout pages.
          </p>
        </div>

        <!-- Quick Store Radar Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5 pt-2 text-xs">
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2">
            <span class="text-base">📦</span>
            <div>
              <strong class="text-amber-300 block text-[11px]">Amazon India</strong>
              <span class="text-slate-300 text-[10px]">GIF & Prime Deals</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2">
            <span class="text-base">⚡</span>
            <div>
              <strong class="text-blue-300 block text-[11px]">Flipkart</strong>
              <span class="text-slate-300 text-[10px]">BBD & SuperCoins</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2">
            <span class="text-base">👗</span>
            <div>
              <strong class="text-rose-300 block text-[11px]">Myntra</strong>
              <span class="text-slate-300 text-[10px]">EORS Apparel Drops</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2">
            <span class="text-base">🏷️</span>
            <div>
              <strong class="text-cyan-300 block text-[11px]">Ajio</strong>
              <span class="text-slate-300 text-[10px]">All Stars & Sneakers</span>
            </div>
          </div>
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 col-span-2 sm:col-span-1 flex items-center gap-2">
            <span class="text-base">💰</span>
            <div>
              <strong class="text-fuchsia-300 block text-[11px]">Meesho</strong>
              <span class="text-slate-300 text-[10px]">Under ₹499 Loots</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter & Search Controls -->
    <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-lg">
          <input
            type="text"
            id="deal-search-input"
            placeholder="Search deals by product, model, or store (e.g. iPhone, Victus, Puma, boAt)..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand font-medium transition"
          />
          <div class="absolute left-3.5 top-3 text-slate-400 pointer-events-none">
            <Icon name="search" class="w-4 h-4" />
          </div>
        </div>

        <!-- Store Pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider shrink-0 mr-1 hidden sm:inline">Store:</span>
          {merchants.map(m => (
            <button
              type="button"
              data-merchant={m.toLowerCase()}
              class={`store-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold shrink-0 cursor-pointer ${
                m === 'All'
                  ? 'bg-brand text-white shadow-xs'
                  : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
              }`}
            >
              {m === 'All' ? '🔥 All Stores' : m}
            </button>
          ))}
        </div>
      </div>

      <!-- Category Filter Chips & Counter -->
      <div class="flex items-center justify-between gap-3 pt-3 border-t border-slate-100 overflow-x-auto no-scrollbar">
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider shrink-0 mr-1">Category:</span>
          {categories.map(c => (
            <button
              type="button"
              data-category={c.toLowerCase()}
              class={`category-filter-chip px-3 py-1 rounded-lg text-xs font-semibold shrink-0 cursor-pointer ${
                c === 'All'
                  ? 'bg-slate-900 text-white'
                  : 'bg-slate-100 hover:bg-slate-200 text-slate-600'
              }`}
            >
              {c === 'All' ? 'All Verticals' : c}
            </button>
          ))}
        </div>

        <div class="text-[11px] font-mono text-slate-400 shrink-0 hidden md:inline">
          <span id="deals-count-label">{products.length} Deals Active</span>
        </div>
      </div>
    </div>

    <!-- Deals Grid -->
    <div id="deals-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {products.map(pr => {
        const merchantName = pr.merchant || 'Amazon India';
        const merchantLower = merchantName.toLowerCase();
        const isFlipkart = merchantLower.includes('flipkart');
        const isMyntra = merchantLower.includes('myntra');
        const isMeesho = merchantLower.includes('meesho');
        const isAjio = merchantLower.includes('ajio');

        let storeBadgeStyle = 'bg-amber-50 text-amber-900 border-amber-200';
        let storeButtonBg = 'bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-950';

        if (isFlipkart) {
          storeBadgeStyle = 'bg-blue-50 text-blue-900 border-blue-200';
          storeButtonBg = 'bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white';
        } else if (isMyntra) {
          storeBadgeStyle = 'bg-rose-50 text-rose-900 border-rose-200';
          storeButtonBg = 'bg-gradient-to-r from-rose-500 to-rose-600 hover:from-rose-600 hover:to-rose-700 text-white';
        } else if (isMeesho) {
          storeBadgeStyle = 'bg-fuchsia-50 text-fuchsia-900 border-fuchsia-200';
          storeButtonBg = 'bg-gradient-to-r from-fuchsia-600 to-fuchsia-700 hover:from-fuchsia-700 hover:to-fuchsia-800 text-white';
        } else if (isAjio) {
          storeBadgeStyle = 'bg-cyan-50 text-cyan-900 border-cyan-200';
          storeButtonBg = 'bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 text-white';
        }

        const resolvedImg = resolveProductImage(pr.image_url, pr.name, pr.category);
        const hasDiscount = pr.discount_pct && pr.discount_pct > 0;
        const discountText = hasDiscount ? `-${pr.discount_pct}% OFF` : (pr.badge || '🔥 LOOT DEAL');
        const savingsAmount = pr.mrp && pr.price && pr.mrp > pr.price ? pr.mrp - pr.price : 0;

        return (
          <div
            class="deal-card bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:border-slate-300 flex flex-col justify-between overflow-hidden group"
            data-store={merchantLower}
            data-cat={(pr.category || 'all').toLowerCase()}
            data-name={pr.name.toLowerCase()}
          >
            <!-- Card Header & Media -->
            <div>
              <!-- Image Section -->
              <div class="deal-img-wrapper relative aspect-[16/10] w-full p-4 flex items-center justify-center border-b border-slate-100 overflow-hidden">
                <!-- Badges -->
                <div class="absolute top-3 left-3 z-10 flex items-center gap-1.5">
                  <span class="px-2.5 py-1 rounded-xl text-[11px] font-black uppercase tracking-wider bg-rose-600 text-white shadow-xs">
                    {discountText}
                  </span>
                </div>

                <div class="absolute top-3 right-3 z-10">
                  <span class={`px-2.5 py-1 rounded-xl text-[11px] font-bold uppercase tracking-wider border shadow-2xs ${storeBadgeStyle}`}>
                    {merchantName}
                  </span>
                </div>

                <!-- Product Image -->
                {resolvedImg ? (
                  <>
                    <img
                      src={resolvedImg}
                      alt={pr.name}
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="relative z-0 max-h-36 max-w-[85%] object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm"
                      onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');"
                    />
                    <div class="hidden w-20 h-20 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                      <Icon name="tag" class="w-8 h-8" />
                    </div>
                  </>
                ) : (
                  <div class="w-20 h-20 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                    <Icon name="tag" class="w-8 h-8" />
                  </div>
                )}

                <!-- Rating -->
                <div class="absolute bottom-2.5 left-3 z-10 px-2 py-0.5 rounded-lg bg-white/90 backdrop-blur-xs text-[11px] font-bold text-slate-800 border border-slate-200/80 shadow-2xs flex items-center gap-1">
                  <span class="text-amber-500">★</span>
                  <span>{pr.rating || 4.5}</span>
                </div>

                <!-- Live Tag -->
                <div class="absolute bottom-2.5 right-3 z-10 px-2 py-0.5 rounded-lg bg-emerald-50 text-emerald-700 text-[11px] font-bold border border-emerald-200 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 live-dot"></span>
                  <span>Active Drop</span>
                </div>
              </div>

              <!-- Product Details -->
              <div class="p-5 pb-3">
                <!-- Category Pill -->
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
                  {pr.category || 'Curated Deal'}
                </span>

                <!-- Title -->
                <h3 class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-brand transition leading-snug line-clamp-2 mb-2.5">
                  {pr.name}
                </h3>

                <!-- Offer Tagline -->
                {pr.tagline && (
                  <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-600 mb-3.5 flex items-center gap-2">
                    <span class="text-brand shrink-0">💳</span>
                    <span class="truncate font-medium text-xs">{pr.tagline}</span>
                  </div>
                )}

                <!-- Pricing Block (Clear Visual Hierarchy) -->
                <div class="pt-2 border-t border-slate-100 flex items-baseline justify-between gap-2 mb-2">
                  <div class="flex items-baseline gap-2">
                    <span class="text-2xl font-black text-slate-900 font-mono tracking-tight">
                      ₹{pr.price ? pr.price.toLocaleString('en-IN') : 'Check Deal'}
                    </span>
                    {pr.mrp && pr.mrp > (pr.price || 0) && (
                      <span class="text-xs text-slate-400 line-through font-mono">
                        ₹{pr.mrp.toLocaleString('en-IN')}
                      </span>
                    )}
                  </div>

                  {savingsAmount > 0 && (
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-emerald-50 text-emerald-700 font-mono">
                      Save ₹{savingsAmount.toLocaleString('en-IN')}
                    </span>
                  )}
                </div>

                <!-- Live Engagement Counter -->
                <div class="flex items-center justify-between text-[11px] text-slate-400 font-medium">
                  <span>Verified 100% Genuine</span>
                  <span class="font-mono">⚡ {pr.clicks || 240}+ clicks</span>
                </div>
              </div>
            </div>

            <!-- Card Footer: Direct Affiliate Link CTA -->
            <div class="p-4 pt-3 border-t border-slate-100 bg-slate-50/50">
              <a
                href={`/go/${pr.id}`}
                target="_blank"
                rel="nofollow sponsored noopener"
                class={`aff-deal-btn w-full py-2.5 px-4 rounded-xl font-bold text-xs uppercase tracking-wider transition shadow-xs flex items-center justify-center gap-2 ${storeButtonBg}`}
              >
                <span>Grab Loot on {merchantName}</span>
                <span class="text-sm">&rarr;</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Dynamic Pagination Controls -->
    {totalPages > 1 && (
      <nav aria-label="Deals Pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 sm:p-5 mb-8 bg-white rounded-2xl border border-slate-200/90 shadow-2xs">
        <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-start">
          {currentPage > 1 ? (
            <a
              href={`/${niche.slug}?page=${currentPage - 1}&tab=${activeTab}`}
              class="px-4 py-2 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700 transition flex items-center gap-1.5 active:scale-95 shadow-2xs"
            >
              <span>&larr;</span>
              <span>Previous</span>
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-bold text-slate-300 cursor-not-allowed flex items-center gap-1.5">
              <span>&larr;</span>
              <span>Previous</span>
            </span>
          )}

          {currentPage < totalPages ? (
            <a
              href={`/${niche.slug}?page=${currentPage + 1}&tab=${activeTab}`}
              class="px-4 py-2 rounded-xl bg-brand hover:bg-brand-dark text-white text-xs font-bold transition shadow-xs flex items-center gap-1.5 active:scale-95"
            >
              <span>Next</span>
              <span>&rarr;</span>
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-bold text-slate-300 cursor-not-allowed flex items-center gap-1.5">
              <span>Next</span>
              <span>&rarr;</span>
            </span>
          )}
        </div>

        <!-- Dynamic Page Numbers List -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => {
            const isCurrent = p === currentPage;
            return (
              <a
                href={`/${niche.slug}?page=${p}&tab=${activeTab}`}
                class={`w-8 h-8 rounded-xl text-xs font-bold flex items-center justify-center transition shrink-0 ${
                  isCurrent
                    ? 'bg-brand text-white shadow-xs'
                    : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200'
                }`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {p}
              </a>
            );
          })}
        </div>

        <!-- Deals Stats Counter Summary -->
        <div class="text-xs text-slate-500 font-mono text-center sm:text-right w-full sm:w-auto">
          Page <strong class="text-slate-900 font-bold">{currentPage}</strong> of <strong class="text-slate-900 font-bold">{totalPages}</strong> ({totalDeals} Deals Active)
        </div>
      </nav>
    )}

    <!-- Empty State -->
    <div id="no-deals-found" class="hidden p-12 text-center bg-white rounded-3xl border border-slate-200 my-8">
      <div class="w-12 h-12 rounded-2xl bg-brand-soft text-brand flex items-center justify-center mx-auto mb-3">
        <Icon name="search" class="w-6 h-6" />
      </div>
      <h3 class="text-base font-bold text-slate-900">No matching deals found</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Try clearing your search query or switch back to "All Stores".</p>
    </div>

    <!-- VIP Telegram Alert Banner -->
    <div class="my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-brand via-purple-700 to-indigo-800 text-white shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-xl">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-amber-400 text-slate-950 inline-block mb-2 shadow-xs">
          ⚡ Instant Deal Alerts
        </span>
        <h3 class="text-xl sm:text-2xl font-black mb-2">
          Get Top Loot Deals Before Stock Runs Out
        </h3>
        <p class="text-xs sm:text-sm text-purple-100 leading-relaxed font-normal">
          The biggest discounts and flash offers sell out fast. Join our community to get instant alerts directly on your phone.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto shrink-0">
        <a
          href="https://whatsapp.com/channel/0029Vb90gso4dTnKKpcf7M1E"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto text-center px-5 py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-white font-black text-xs uppercase tracking-wider transition shadow-md active:scale-95 flex items-center justify-center gap-2"
        >
          <span>🟢 Join WhatsApp Channel</span>
        </a>
        <a
          href="https://t.me/uniquedigit_deals"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto text-center px-5 py-3 rounded-2xl bg-white text-brand hover:bg-slate-50 font-black text-xs uppercase tracking-wider transition shadow-md active:scale-95 flex items-center justify-center gap-2"
        >
          <span>✈️ VIP Telegram</span>
        </a>
      </div>
    </div>

    <!-- Shopping Guides & Posts (if any) -->
    {posts.length > 0 && (
      <div class="my-12 pt-8 border-t border-slate-200">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Buying Guides & Festival Analysis
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Independent breakdown of warranties, bank discounts, and the best time to purchase.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.slice(0, 3).map(post => (
            <NicheCard post={post} niche={niche} />
          ))}
        </div>
      </div>
    )}

    <AdSlot position="footer" />
  </>
)}

<!-- TAB: CATEGORIES -->
{activeTab === 'categories' && (
  <div class="space-y-8">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Deal Verticals & Categories
      </h2>
      <p class="mt-2 text-sm text-slate-600">
        Browse curated loot drops by vertical. Each category features dedicated merchant coverage and price alerts.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {categories.slice(1).map(cat => (
        <a
          href={`/deals?tab=live`}
