---
import NicheCard from '../components/NicheCard.astro';
import BreakingTicker from '../components/BreakingTicker.astro';
import TrendingList from '../components/TrendingList.astro';
import AmazonDealBox from '../components/AmazonDealBox.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import Icon from '../components/Icon.astro';
import type { Niche, Post } from '../lib/db';
import { proxyImageUrl } from '../lib/images';

interface Props {
  niche: Niche;
  posts: Post[];
  trendingPosts?: Post[];
  currentPage?: number;
  totalPages?: number;
  activeTab?: string;
}

const { niche, posts, trendingPosts = [], currentPage = 1, totalPages = 1, activeTab = 'latest' } = Astro.props;
const heroPost = posts[0];
const heroImage = heroPost ? proxyImageUrl(heroPost.image_url, niche.slug, heroPost.slug) : '';
const subFeatured = posts.slice(1, 4);
const streamPosts = posts.slice(4);

const tickerItems = posts.slice(0, 6).map(p => ({
  title: p.title,
  url: `/${niche.slug}/${p.slug}`
}));

const NEWS_CATEGORIES = [
  { name: 'Breaking', icon: 'alert-triangle', desc: 'Live national alerts & urgent dispatches' },
  { name: 'Politics', icon: 'landmark', desc: 'Parliament, policy & governance updates' },
  { name: 'Business', icon: 'briefcase', desc: 'Markets, corporate & economic signals' },
  { name: 'Technology', icon: 'cpu', desc: 'AI, space, digital infra & startups' },
  { name: 'Sports', icon: 'trophy', desc: 'Cricket, Olympics & major tournaments' },
  { name: 'Entertainment', icon: 'film', desc: 'Bollywood, OTT & cultural moments' },
];
---

<style>
  /* Mobile-first responsive improvements for NewsHub */
  @media (max-width: 640px) {
    .news-hero {
      border-radius: 0 0 1.5rem 1.5rem;
      margin: 0 -1rem 1.5rem;
    }

    .news-hero .absolute {
      display: none;
    }

    .news-hero h1 {
      font-size: 1.75rem;
    }

    .news-hero .grid {
      grid-template-columns: 1fr !important;
    }

    .hero-lead-story {
      min-height: 220px !important;
    }

    .breaking-card {
      margin: 0 -0.5rem;
      border-radius: 0;
    }
  }

  @media (max-width: 480px) {
    .news-category-card {
      padding: 1rem;
    }

    .hero-stats-grid {
      grid-template-columns: 1fr !important;
    }
  }

  /* Touch feedback */
  .news-category-card:active,
  .breaking-card:active,
  .trending-card:active {
    transform: scale(0.98);
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .animate-ping,
    .animate-pulse,
    .animate-spin {
      animation: none !important;
    }
  }

  /* Focus visible for accessibility */
  .news-category-card:focus-visible,
  .breaking-card:focus-visible,
  .trending-card:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
</style>

  <!-- TAB: LATEST -->
  {activeTab === 'latest' && (
    <>
      <div class="mb-6">
        <BreakingTicker items={tickerItems} />
      </div>

      <div class="news-hero mb-8 rounded-3xl bg-gradient-to-br from-slate-950 via-red-950/40 to-slate-900 text-white p-6 sm:p-8 border border-red-500/20 shadow-xl relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-72 h-72 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <div class="flex items-center gap-2 mb-3">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-600 text-white shadow-xs">
                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                Live News Desk
              </span>
              <span class="text-xs text-red-200">
                Updated Daily
              </span>
            </div>

            <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
              {niche.name} Pulse
            </h2>
            <p class="text-sm sm:text-base text-slate-300 mt-2 leading-relaxed">
              Real-time reporting from verified press conferences, official bulletins, and top national developments.
            </p>
          </div>

          <div class="flex md:flex-col items-center md:items-end gap-2 shrink-0">
            <div class="px-3.5 py-2 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs text-right">
              <span class="text-xs text-slate-400 font-medium block uppercase">Coverage</span>
              <span class="text-sm font-bold text-emerald-400">24/7 Live Desk</span>
            </div>
            <div class="px-3.5 py-2 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs text-right">
              <span class="text-xs text-slate-400 font-medium block uppercase">Verification</span>
              <span class="text-sm font-bold text-white">Fact-Checked Sources</span>
            </div>
          </div>
        </div>
      </div>

      {heroPost && (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-12">
          <div class="lg:col-span-8 rounded-3xl bg-white border border-slate-200/90 shadow-md overflow-hidden flex flex-col justify-between group hover:shadow-xl transition">
            <div>
              <div class="relative h-64 sm:h-96 bg-slate-900 overflow-hidden hero-lead-story">
                <img
                  src={heroImage}
                  alt={heroPost.title}
                  class="w-full h-full object-cover group-hover:scale-102 transition duration-500"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent"></div>
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 rounded-full bg-red-600 text-white font-black text-xs uppercase shadow-sm flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    Lead Story
                  </span>
                </div>
                <div class="absolute bottom-4 left-4 right-4">
                  <span class="text-xs text-red-200 font-mono uppercase tracking-wider block mb-1">
                    {niche.name} &bull; Breaking Dispatch
                  </span>
                  <h2 class="text-xl sm:text-3xl font-black text-white leading-tight">
                    <a href={`/${niche.slug}/${heroPost.slug}`} class="hover:underline">
                      {heroPost.title}
                    </a>
                  </h2>
                </div>
              </div>

              <div class="p-6">
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  {heroPost.summary}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span>Published: {new Date(heroPost.published_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}</span>
              <a href={`/${niche.slug}/${heroPost.slug}`} class="font-bold text-red-600 hover:text-red-700 flex items-center gap-1">
                <span>Read Full Dispatch</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-4 flex flex-col gap-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-1.5">
                <Icon name="sparkles" class="w-3.5 h-3.5 text-red-600" />
                Top Developing Stories
              </h3>
              <span class="text-xs text-slate-500 font-mono">Live</span>
            </div>

            {subFeatured.map(post => (
              <a
                href={`/${niche.slug}/${post.slug}`}
                class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-red-400 hover:shadow-md transition flex flex-col justify-between group"
              >
                <div>
                  <div class="flex items-center gap-2 mb-2 text-xs text-slate-500 font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                    <span>{new Date(post.published_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}</span>
                  </div>
                  <h4 class="font-black text-slate-900 text-sm leading-snug group-hover:text-red-600 transition mb-2">
                    {post.title}
                  </h4>
                  <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                    {post.summary}
                  </p>
                </div>
                <span class="text-xs font-bold text-red-600 mt-3 block group-hover:translate-x-1 transition">
                  Quick Read &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="my-10">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>
            Latest News Stream
          </h2>
          <span class="text-xs text-slate-500 font-mono">{posts.length} stories</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {streamPosts.map(p => (
            <NicheCard post={p} nicheSlug={niche.slug} />
          ))}
        </div>
      </div>

      <AmazonDealBox keyword={heroPost ? heroPost.title : "trending india"} nicheSlug={niche.slug} nicheName={niche.name} />
      <NewsletterStrip />
    </>
  )}

  <!-- TAB: TRENDING -->
  {activeTab === 'trending' && (
    <div class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Trending Now
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Top stories and viral discussions gaining massive attention across India today.
        </p>
      </div>

      <div class="mb-6">
        <BreakingTicker items={tickerItems} />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {trendingPosts.map((p, i) => (
          <NicheCard post={p} nicheSlug={niche.slug} rank={i + 1} />
        ))}
      </div>

      <TrendingList posts={trendingPosts} nicheSlug={niche.slug} limit={10} />
    </div>
  )}

  <!-- TAB: CATEGORIES -->
  {activeTab === 'categories' && (
    <div class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          News Categories
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Browse latest dispatches by category. Curated from verified independent news sources.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {NEWS_CATEGORIES.map(cat => (
          <a href={`/${niche.slug}?category=${cat.name.toLowerCase()}`} class="news-category-card group p-6 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:border-red-400 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 flex items-center justify-center mb-4 group-hover:bg-red-100 transition">
              <Icon name={cat.icon as any} class="w-6 h-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2 group-hover:text-red-700 transition">{cat.name}</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{cat.desc}</p>
            <div class="mt-4 flex items-center gap-1.5 text-xs font-bold text-red-600 group-hover:gap-2 transition">
              <span>Browse</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- TAB: BREAKING -->
  {activeTab === 'breaking' && (
    <div class="space-y-8">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-50 text-red-700 dark:bg-red-900/30 dark:text-red-300 mb-4">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <span class="font-black text-sm uppercase tracking-wider">Live Breaking Feed</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Breaking News &amp; Updates
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Real-time updates and breaking headlines curated across national, business, and entertainment beats.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-red-50 border border-red-200 dark:bg-red-900/20 dark:border-red-800 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-red-600 flex items-center justify-center">
            <Icon name="zap" class="w-6 h-6 text-white" />
          </div>
          <div>
            <p class="font-bold text-red-800 dark:text-red-200">Status: <span class="text-emerald-600 dark:text-emerald-400 font-medium">LIVE</span></p>
          </div>
        </div>
        <button class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm flex items-center gap-2 transition" onclick="window.location.reload()">
          <Icon name="refresh-cw" class="w-4 h-4" />
          Refresh Now
        </button>
      </div>

      <BreakingTicker items={tickerItems} className="mb-8" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.slice(0, 9).map(p => (
          <NicheCard post={p} nicheSlug={niche.slug} class="breaking-card" />
        ))}
      </div>

      <script>
        // Countdown timer for next sync
        let seconds = 30;
        const el = document.getElementById('next-sync');
        const timer = setInterval(() => {
          seconds--;
          if (el) el.textContent = seconds + 's';
          if (seconds <= 0) {
            seconds = 30;
            if (el) el.textContent = '30s';
          }
        }, 1000);
      </script>
    </div>
  )}