---
import Layout from '../layouts/Layout.astro';
import NicheCard from '../components/NicheCard.astro';
import TrendingList from '../components/TrendingList.astro';
import AdSlot from '../components/AdSlot.astro';
import DisclaimerBar from '../components/DisclaimerBar.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import Icon from '../components/Icon.astro';
import type { Niche, Post } from '../lib/db';

interface Props {
  niche: Niche;
  posts: Post[];
  trendingPosts: Post[];
  currentPage?: number;
  totalPages?: number;
}

const { niche, posts, trendingPosts, currentPage = 1, totalPages = 1 } = Astro.props;
const heroPost = posts[0];
const remainingPosts = posts.slice(1);
---

<Layout
  title={`${niche.name} — ${niche.tagline || 'Daily Updates'} | UniqueDigit`}
  description={niche.tagline || `Latest ${niche.name} insights, real-time guides, and viral updates in India.`}
  niche={niche}
>
  <!-- Niche Header Banner -->
  <div class="mb-8 pb-6 border-b border-line flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <div class="w-10 h-10 rounded-xl bg-brand text-white flex items-center justify-center shadow-xs">
          <Icon name={niche.icon} class="w-5 h-5" />
        </div>
        <span class="text-xs font-bold uppercase tracking-wider text-muted font-mono">{niche.grp} Hub</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-ink tracking-tight">{niche.name}</h1>
      <p class="text-sm text-muted mt-1">{niche.tagline}</p>
    </div>

    {niche.config?.review && (
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-bold shrink-0 shadow-2xs">
        <Icon name="shield-check" class="w-4 h-4 text-amber-600" />
        <span>Editorial Fact-Checked & Peer Reviewed</span>
      </span>
    )}
  </div>

  {niche.config?.disclaimer && (
    <DisclaimerBar text={niche.config.disclaimer} type={niche.slug === 'health' ? 'health' : 'general'} />
  )}

  <!-- Quick Topic & Filter Pills (Dynamic Sub-category Filter) -->
  <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 no-scrollbar">
    <span class="px-3.5 py-1.5 rounded-full text-xs font-black bg-brand text-white shadow-xs shrink-0 cursor-pointer">
      All {niche.name}
    </span>
    {niche.slug === 'health' && (
      <>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          💪 Protein & Nutrition
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🥗 Diet & Weight Loss
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🏋️ Gym Workouts
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🌿 Ayurvedic Wellness
        </span>
      </>
    )}
    {niche.slug === 'food' && (
      <>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🍳 High-Protein Meals
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🍟 Air Fryer Recipes
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🍱 Meal Prep & Macros
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          ☕ Healthy Snacks
        </span>
      </>
    )}
    {niche.slug === 'fashion' && (
      <>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          👟 Sneakers Under ₹5,000
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          👔 Capsule Wardrobe
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          👕 Everyday Essentials
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🕶️ Accessories & Style
        </span>
      </>
    )}
    {niche.slug === 'side-hustles' && (
      <>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🤖 AI Freelancing & Tools
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          📦 Digital Products & Templates
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          💼 Remote Jobs in India
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          📈 Passive Income Ideas
        </span>
      </>
    )}
    {niche.slug === 'gta-6' && (
      <>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🖥️ PC Specs & Requirements
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🎮 Vice City Maps & Leaks
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          📅 India Release Date & Pre-Orders
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          ⚡ Ray Tracing & GPU Tests
        </span>
      </>
    )}
    {niche.slug === 'viral' && (
      <>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🔥 Google Search Spikes
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          ⚡ Tech & Gadget Drops
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🎬 OTT & Entertainment Buzz
        </span>
        <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🏷️ Loot Deals & Price Drops
        </span>
      </>
    )}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Main Feed Column -->
    <div class="lg:col-span-8">
      {heroPost ? (
        <div class="mb-8">
          <NicheCard post={heroPost} niche={niche} />
        </div>
      ) : null}

      <AdSlot position="top" />

      {remainingPosts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {remainingPosts.map(p => (
            <NicheCard post={p} niche={niche} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center bg-white rounded-3xl border border-line my-6">
          <Icon name="sparkles" class="w-8 h-8 text-brand mx-auto mb-3" />
          <h3 class="text-base font-bold text-ink">New articles are currently being generated</h3>
          <p class="text-xs text-muted mt-1">Our daily pipeline fetches fresh trends for {niche.name} every morning.</p>
        </div>
      )}

      {totalPages > 1 && (
        <nav aria-label="Pagination Navigation" class="flex items-center justify-between border-t border-line mt-8 pt-6">
          {currentPage > 1 ? (
            <a 
              href={`/${niche.slug}${currentPage - 1 === 1 ? '' : `?page=${currentPage - 1}`}`}
              class="px-4 py-2 rounded-xl bg-white border border-line hover:border-brand text-xs font-bold text-ink transition shadow-2xs"
            >
              ← Previous Page
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-bold text-muted cursor-not-allowed">
              ← Previous Page
            </span>
          )}

          <span class="text-xs font-mono text-muted">
            Page <strong class="text-ink">{currentPage}</strong> of <strong class="text-ink">{totalPages}</strong>
          </span>

          {currentPage < totalPages ? (
            <a 
              href={`/${niche.slug}?page=${currentPage + 1}`}
              class="px-4 py-2 rounded-xl bg-white border border-line hover:border-brand text-xs font-bold text-ink transition shadow-2xs"
            >
              Next Page →
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-bold text-muted cursor-not-allowed">
              Next Page →
            </span>
          )}
        </nav>
      )}

      <AdSlot position="mid" />
    </div>

    <!-- Sidebar Column -->
    <div class="lg:col-span-4 flex flex-col gap-6">
      <TrendingList posts={trendingPosts} title="Trending Right Now" />
      <AdSlot position="sidebar" />
    </div>

  </div>

  <NewsletterStrip />
</Layout>
