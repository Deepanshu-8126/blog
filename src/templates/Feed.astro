---
import Layout from '../layouts/Layout.astro';
import NicheCard from '../components/NicheCard.astro';
import TrendingList from '../components/TrendingList.astro';
import AdSlot from '../components/AdSlot.astro';
import DisclaimerBar from '../components/DisclaimerBar.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import Icon from '../components/Icon.astro';
import type { Niche, Post } from '../lib/db';

interface Props {
  niche: Niche;
  posts: Post[];
  trendingPosts: Post[];
  currentPage?: number;
  totalPages?: number;
}

const { niche, posts, trendingPosts, currentPage = 1, totalPages = 1 } = Astro.props;
const heroPost = posts[0];
const remainingPosts = posts.slice(1);
---

<Layout
  title={`${niche.name} — ${niche.tagline || 'Daily Updates'} | UniqueDigit`}
  description={niche.tagline || `Latest ${niche.name} insights, real-time guides, and viral updates in India.`}
  niche={niche}
>
  <!-- Niche Header Banner -->
  {niche.slug === 'gta-6' ? (
    <div class="mb-8 rounded-3xl bg-gradient-to-br from-slate-950 via-purple-950 to-slate-900 text-white p-6 sm:p-8 border border-purple-500/30 shadow-2xl relative overflow-hidden">
      <!-- Neon Ambient Blur Glows -->
      <div class="absolute -top-20 -right-20 w-80 h-80 bg-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-pink-600 text-white shadow-xs">
              🎮 Vice City Intelligence
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-white/10 text-cyan-300 border border-cyan-400/30">
              ⚡ 4K 60FPS Target
            </span>
            <span class="text-xs text-purple-200 font-mono hidden sm:inline">· Rockstar Wire Corroborated</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            Grand Theft Auto VI
          </h1>
          <p class="text-sm sm:text-base text-purple-200/90 mt-2 leading-relaxed">
            Unfiltered PC hardware requirements, realistic Indian pricing, ray-traced global illumination benchmarks, and Leonida state leaks.
          </p>

          <!-- 4 Telemetry Spec Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-6">
            <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-purple-300 font-mono block">Engine Target</span>
              <span class="text-xs font-black text-white">RAGE 9 Next-Gen</span>
            </div>
            <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-purple-300 font-mono block">Rec. Memory</span>
              <span class="text-xs font-black text-cyan-300 font-mono">32GB DDR5</span>
            </div>
            <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-purple-300 font-mono block">Optimal GPU</span>
              <span class="text-xs font-black text-pink-300">RTX 4070 Super</span>
            </div>
            <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-purple-300 font-mono block">Expected Price</span>
              <span class="text-xs font-black text-amber-300 font-mono">₹4,999 (India)</span>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2 shrink-0">
          <a
            href="/builds"
            class="px-5 py-3 rounded-2xl bg-gradient-to-r from-pink-500 to-purple-600 hover:brightness-110 text-white text-xs font-black transition flex items-center justify-center gap-2 shadow-lg"
          >
            <span>🖥️ Test Your PC Rig</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="/pc-builds"
            class="px-5 py-2.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition text-center"
          >
            <span>Explore 5 Gaming Builds</span>
          </a>
        </div>
      </div>
    </div>
  ) : (
    <div class="mb-8 pb-6 border-b border-line flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <div class="w-10 h-10 rounded-xl bg-brand text-white flex items-center justify-center shadow-xs">
            <Icon name={niche.icon} class="w-5 h-5" />
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-muted font-mono">{niche.grp} Hub</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-ink tracking-tight">{niche.name}</h1>
        <p class="text-sm text-muted mt-1">{niche.tagline}</p>
      </div>

      {niche.config?.review && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-bold shrink-0 shadow-2xs">
          <Icon name="shield-check" class="w-4 h-4 text-amber-600" />
          <span>Editorial Fact-Checked & Peer Reviewed</span>
        </span>
      )}
    </div>
  )}

  {niche.config?.disclaimer && (
    <DisclaimerBar text={niche.config.disclaimer} type={niche.slug === 'health' ? 'health' : 'general'} />
  )}

  <!-- Quick Topic & Filter Pills (Dynamic Sub-category Filter) -->
  <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 no-scrollbar">
    <a href={`/${niche.slug}`} class="px-3.5 py-1.5 rounded-full text-xs font-black bg-brand text-white shadow-xs shrink-0 cursor-pointer">
      All {niche.name}
    </a>
    {niche.slug === 'health' && (
      <>
        <a href="/search?q=protein" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          💪 Protein & Nutrition
        </a>
        <a href="/search?q=diet" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🥗 Diet & Weight Loss
        </a>
        <a href="/search?q=workout" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🏋️ Gym Workouts
        </a>
        <a href="/search?q=ayurveda" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🌿 Ayurvedic Wellness
        </a>
      </>
    )}
    {niche.slug === 'food' && (
      <>
        <a href="/search?q=protein" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🍳 High-Protein Meals
        </a>
        <a href="/search?q=air+fryer" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🍟 Air Fryer Recipes
        </a>
        <a href="/search?q=meal+prep" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🍱 Meal Prep & Macros
        </a>
        <a href="/search?q=snacks" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          ☕ Healthy Snacks
        </a>
      </>
    )}
    {niche.slug === 'fashion' && (
      <>
        <a href="/search?q=sneakers" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          👟 Sneakers Under ₹5,000
        </a>
        <a href="/search?q=wardrobe" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          👔 Capsule Wardrobe
        </a>
        <a href="/search?q=fashion" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          👕 Everyday Essentials
        </a>
        <a href="/search?q=accessories" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🕶️ Accessories & Style
        </a>
      </>
    )}
    {niche.slug === 'side-hustles' && (
      <>
        <a href="/search?q=ai+tools" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🤖 AI Freelancing & Tools
        </a>
        <a href="/search?q=digital+products" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          📦 Digital Products & Templates
        </a>
        <a href="/search?q=remote" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          💼 Remote Jobs in India
        </a>
        <a href="/search?q=income" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          📈 Passive Income Ideas
        </a>
      </>
    )}
    {niche.slug === 'gta-6' && (
      <>
        <a href="/builds" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🖥️ PC Specs & Requirements
        </a>
        <a href="/search?q=gta+6" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🎮 Vice City Maps & Leaks
        </a>
        <a href="/search?q=gta+6+release" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          📅 India Release Date & Pre-Orders
        </a>
        <a href="/search?q=ray+tracing" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          ⚡ Ray Tracing & GPU Tests
        </a>
      </>
    )}
    {niche.slug === 'viral' && (
      <>
        <a href="/trending" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🔥 Google Search Spikes
        </a>
        <a href="/search?q=tech" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          ⚡ Tech & Gadget Drops
        </a>
        <a href="/movies" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🎬 OTT & Entertainment Buzz
        </a>
        <a href="/deals" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-slate-100 text-ink border border-line shrink-0 cursor-pointer transition">
          🏷️ Loot Deals & Price Drops
        </a>
      </>
    )}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Main Feed Column -->
    <div class="lg:col-span-8">
      {heroPost ? (
        <div class="mb-8">
          <NicheCard post={heroPost} niche={niche} />
        </div>
      ) : null}

      <AdSlot position="top" />

      {remainingPosts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {remainingPosts.map(p => (
            <NicheCard post={p} niche={niche} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center bg-white rounded-3xl border border-line my-6">
          <Icon name="sparkles" class="w-8 h-8 text-brand mx-auto mb-3" />
          <h3 class="text-base font-bold text-ink">New articles are currently being generated</h3>
          <p class="text-xs text-muted mt-1">Our daily pipeline fetches fresh trends for {niche.name} every morning.</p>
        </div>
      )}

      {totalPages > 1 && (
        <nav aria-label="Pagination Navigation" class="flex items-center justify-between border-t border-line mt-8 pt-6">
          {currentPage > 1 ? (
            <a 
              href={`/${niche.slug}${currentPage - 1 === 1 ? '' : `?page=${currentPage - 1}`}`}
              class="px-4 py-2 rounded-xl bg-white border border-line hover:border-brand text-xs font-bold text-ink transition shadow-2xs"
            >
              ← Previous Page
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-bold text-muted cursor-not-allowed">
              ← Previous Page
            </span>
          )}

          <span class="text-xs font-mono text-muted">
            Page <strong class="text-ink">{currentPage}</strong> of <strong class="text-ink">{totalPages}</strong>
          </span>

          {currentPage < totalPages ? (
            <a 
              href={`/${niche.slug}?page=${currentPage + 1}`}
              class="px-4 py-2 rounded-xl bg-white border border-line hover:border-brand text-xs font-bold text-ink transition shadow-2xs"
            >
              Next Page →
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-50 border border-slate-100 text-xs font-bold text-muted cursor-not-allowed">
              Next Page →
            </span>
          )}
        </nav>
      )}

      <AdSlot position="mid" />
    </div>

    <!-- Sidebar Column -->
    <div class="lg:col-span-4 flex flex-col gap-6">
      <TrendingList posts={trendingPosts} title="Trending Right Now" />
      <AdSlot position="sidebar" />
    </div>

  </div>

  <NewsletterStrip />
</Layout>
