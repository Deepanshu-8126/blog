---
import NicheCard from '../components/NicheCard.astro';
import HealthDisclaimer from '../components/HealthDisclaimer.astro';
import ToolCard from '../components/ToolCard.astro';
import AmazonDealBox from '../components/AmazonDealBox.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import Icon from '../components/Icon.astro';
import type { Niche, Post, Product } from '../lib/db';

interface Props {
  niche: Niche;
  posts: Post[];
  trendingPosts?: Post[];
  products?: Product[];
  activeTab?: string;
}

const { niche, posts, trendingPosts = [], products = [], activeTab = 'latest' } = Astro.props;
const heroPost = posts[0];
const remainingPosts = posts.slice(1);

const HEALTH_CATEGORIES = [
  { name: 'Ayurveda & AYUSH', icon: 'sparkles', desc: 'Ancient herbal science & modern clinical research' },
  { name: 'Nutrition & Diet', icon: 'utensils', desc: 'Caloric balances, protein staples & clean eating' },
  { name: 'Fitness & Recovery', icon: 'heart', desc: 'Mobility, strength routines & injury prevention' },
  { name: 'Mental Health & Sleep', icon: 'moon', desc: 'Circadian rhythms, stress reduction & mindfulness' },
];

const EMERGENCY_CONTACTS = [
  { name: 'National Emergency', number: '112', desc: 'All emergencies — police, fire, medical' },
  { name: 'Ambulance', number: '108', desc: 'Free emergency ambulance service' },
  { name: 'Women Helpline', number: '1091', desc: 'Domestic violence & harassment' },
  { name: 'Child Helpline', number: '1098', desc: 'Child protection & abuse reporting' },
  { name: 'Mental Health', number: '080-4611-0007', desc: 'NIMHANS tele-counselling (24/7)' },
  { name: 'Poison Control', number: '1800-11-6161', desc: 'National Poisons Information Centre' },
];
---

<style>
  /* Mobile-first responsive improvements */
  .deal-card {
    min-height: 0;
  }

  .deal-card img {
    max-height: 200px;
    width: auto;
  }

  @media (max-width: 640px) {
    .deal-card {
      margin: 0 -0.5rem;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }

    .deal-card:first-child {
      border-top: none;
    }

    .deal-card:last-child {
      border-bottom: none;
    }

    .deal-card img {
      max-height: 160px;
    }

    /* Stack filter buttons vertically on very small screens */
    .merchant-filter-btn {
      flex: 1 0 auto;
      min-width: 0;
    }

    /* Better tap targets for mobile */
    .subnav-tab {
      min-height: 44px;
      padding: 0.75rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .live-radar-bar {
      font-size: 0.65rem;
    }

    .hero-stats-grid {
      grid-template-columns: 1fr !important;
    }
  }

  /* Touch feedback */
  .deal-card:active,
  .merchant-filter-btn:active,
  .category-card:active {
    transform: scale(0.98);
  }

  .grab-loot-btn:active {
    transform: scale(0.97);
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .live-radar-bar .animate-ping,
    .animate-pulse,
    .animate-spin {
      animation: none !important;
    }
    .deal-card img {
      transition: none !important;
    }
  }

  /* Focus visible for accessibility */
  .merchant-filter-btn:focus-visible,
  .subnav-tab:focus-visible,
  .category-card:focus-visible,
  .grab-loot-btn:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  /* Health-specific mobile improvements */
  @media (max-width: 640px) {
    .health-hero {
      border-radius: 0 0 1.5rem 1.5rem;
      margin: 0 -1rem 1.5rem;
    }

    .health-hero .absolute {
      display: none;
    }

    .health-category-card {
      padding: 1rem;
    }

    .emergency-card {
      margin: 0 -0.5rem;
      border-radius: 0;
    }
  }

  @media (max-width: 480px) {
    .health-hero h1 {
      font-size: 1.75rem;
    }

    .emergency-card {
      padding: 1rem;
    }

    .emergency-card .flex {
      flex-direction: column;
      align-items: flex-start;
    }

    .emergency-card a {
      width: 100%;
      justify-content: center;
    }
  }
</style>

  <!-- TAB: LATEST -->
  {activeTab === 'latest' && (
    <>
      <!-- Medical Portal Header -->
      <div class="health-hero mb-10 rounded-3xl bg-gradient-to-br from-emerald-950 via-teal-900 to-slate-900 text-white p-6 sm:p-10 border border-emerald-500/30 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl">
          <div class="flex items-center gap-2 mb-4 flex-wrap">
            <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-500 text-slate-950 shadow-sm flex items-center gap-1.5">
              <Icon name="heart" class="w-3.5 h-3.5" />
              Clinical & AYUSH Protocol Validated
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-white/10 text-emerald-200 border border-emerald-400/30">
              Peer-Reviewed Research Grounded
            </span>
          </div>

          <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            Healthcare & Wellness Hub
          </h2>
          <p class="text-sm sm:text-base text-emerald-100/90 mt-3 leading-relaxed">
            Curated medical journalism synthesizing peer-reviewed clinical studies, National AYUSH protocols, and evidence-based nutrition science for everyday vitality.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
            <div class="p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-emerald-300 font-mono block">Fact-Checking</span>
              <span class="text-xs font-black text-white">Double-Checked</span>
            </div>
            <div class="p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-emerald-300 font-mono block">AYUSH Standards</span>
              <span class="text-xs font-black text-white">Full Compliance</span>
            </div>
            <div class="p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-emerald-300 font-mono block">Supplements</span>
              <span class="text-xs font-black text-white">Lab-Tested Only</span>
            </div>
            <div class="p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs">
              <span class="text-xs text-emerald-300 font-mono block">Emergency Info</span>
              <span class="text-xs font-black text-white">Helpline Integrated</span>
            </div>
          </div>
        </div>
      </div>

      <HealthDisclaimer />

      <div class="my-10">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <h2 class="text-xl font-black text-slate-900 tracking-tight">Core Wellness Pillars</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {HEALTH_CATEGORIES.map(cat => (
            <div class="health-category-card p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:border-emerald-400 hover:shadow-md transition">
              <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-3">
                <Icon name={cat.icon as any} class="w-5 h-5" />
              </div>
              <h3 class="font-black text-slate-900 text-sm mb-1">{cat.name}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{cat.desc}</p>
            </div>
          ))}
        </div>
      </div>

      {heroPost && (
        <div class="my-10">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Featured Medical Analysis
            </h2>
            <span class="text-xs font-mono text-emerald-700 font-bold bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
              Primary Spotlight
            </span>
          </div>

          <div class="rounded-3xl bg-white border border-emerald-200 shadow-md overflow-hidden hover:shadow-xl transition">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
              <div class="lg:col-span-7 relative min-h-[260px] sm:min-h-[340px] bg-slate-900 overflow-hidden">
                <img
                  src={`/img?url=${encodeURIComponent(heroPost.image_url || 'https://upload.wikimedia.org/wikipedia/commons/b/b0/Beach_asana_class%2C_Plage_Pereire%2C_Arcachon%2C_2015.jpg')}`}
                  alt={heroPost.title}
                  class="w-full h-full object-cover"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4">
                  <span class="px-2.5 py-1 rounded-lg bg-emerald-500 text-slate-950 font-black text-xs uppercase">
                    Featured Guide
                  </span>
                </div>
              </div>

              <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 text-xs text-slate-600 font-medium mb-2">
                    <span>Curated Wellness Desk</span>
                    <span>&bull;</span>
                    <span>{new Date(heroPost.published_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  </div>

                  <h3 class="text-xl sm:text-2xl font-black text-slate-900 leading-snug mb-3 hover:text-emerald-700 transition">
                    <a href={`/health/${heroPost.slug}`}>{heroPost.title}</a>
                  </h3>

                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
                    {heroPost.summary}
                  </p>
                </div>

                <div>
                  <a
                    href={`/health/${heroPost.slug}`}
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs transition"
                  >
                    <span>Read Expert Guide</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      <div class="my-10">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-900"></span>
            Recent Health & Wellness Articles
          </h2>
          <span class="text-xs text-slate-500 font-mono">{posts.length} articles indexed</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {remainingPosts.map(p => (
            <NicheCard post={p} nicheSlug={niche.slug} />
          ))}
        </div>
      </div>

      {products.length > 0 && (
        <div class="my-12 p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-xl font-black text-slate-900">Lab-Tested Fitness & Wellness Equipment</h2>
              <p class="text-xs text-slate-600 mt-1">Lab-tested equipment, smart trackers, and clean supplements.</p>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">Amazon Fulfilled</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {products.map(pr => (
              <ToolCard product={pr} />
            ))}
          </div>
        </div>
      )}

      <AmazonDealBox keyword="fitness tracker smart watch yoga mat" nicheSlug="health" nicheName="Health & Fitness" />
      <NewsletterStrip />
    </>
  )}

  <!-- TAB: CATEGORIES -->
  {activeTab === 'categories' && (
    <div class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Health Categories
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Browse evidence-based wellness guides across Ayurveda, nutrition, fitness, and mental health.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {HEALTH_CATEGORIES.map((cat, i) => (
          <a href={`/health?category=${cat.name.toLowerCase().replace(/ & /g, '-').replace(/\s+/g, '-')}`} class="group p-6 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:border-emerald-400 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-4 group-hover:bg-emerald-100 transition">
              <Icon name={cat.icon as any} class="w-6 h-6" />
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2 group-hover:text-emerald-700 transition">{cat.name}</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{cat.desc}</p>
            <div class="mt-4 flex items-center gap-1.5 text-xs font-bold text-emerald-700 group-hover:gap-2 transition">
              <span>Explore</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>

      {products.length > 0 && (
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-xl font-black text-slate-900">Equipment by Category</h2>
              <p class="text-xs text-slate-600 mt-1">Shop curated wellness gear organized by use case.</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {products.map(pr => (
              <ToolCard product={pr} />
            ))}
          </div>
        </div>
      )}
    </div>
  )}

  <!-- TAB: EQUIPMENT (Tools) -->
  {activeTab === 'tools' && (
    <div class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Wellness Equipment & Tools
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Lab-tested fitness trackers, recovery tools, smart scales, and clean supplements — curated by our wellness desk.
        </p>
      </div>

      {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {products.map(pr => (
            <ToolCard product={pr} />
          ))}
        </div>
      ) : (
        <div class="py-16 text-center">
          <Icon name="dumbbell" class="w-16 h-16 mx-auto text-slate-300 dark:text-slate-600 mb-4" />
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">No Equipment Listed Yet</h3>
          <p class="text-slate-600 dark:text-slate-400">Curated fitness & wellness gear coming soon.</p>
        </div>
      )}

      <AmazonDealBox keyword="fitness tracker smart watch yoga mat resistance bands" nicheSlug="health" nicheName="Health & Fitness" />
    </div>
  )}

  <!-- TAB: EMERGENCY -->
  {activeTab === 'emergency' && (
    <div class="space-y-8">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-50 text-red-700 dark:bg-red-900/30 dark:text-red-300 mb-4">
          <Icon name="alert-triangle" class="w-5 h-5" />
          <span class="font-black text-sm uppercase tracking-wider">Emergency Helplines</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          India Emergency Contacts
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
          Save these numbers. In a crisis, every second counts. All numbers are toll-free and available 24/7.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {EMERGENCY_CONTACTS.map(contact => (
          <div class="emergency-card p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:border-red-400 hover:shadow-md transition relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-red-500"></div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center shrink-0">
                <Icon name="phone" class="w-6 h-6" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1">{contact.name}</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 mb-2">{contact.desc}</p>
                <a
                  href={`tel:${contact.number}`}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm transition"
                >
                  <Icon name="phone" class="w-4 h-4" />
                  <span>{contact.number}</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="p-6 rounded-2xl bg-gradient-to-r from-red-50 to-amber-50 border border-red-200">
        <h3 class="font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
          <Icon name="shield" class="w-5 h-5 text-red-600" />
          Medical Disclaimer
        </h3>
        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          <strong>This information is for educational purposes only and is not medical advice.</strong> In a genuine medical emergency, call <strong>112</strong> or <strong>108</strong> immediately. Always consult a qualified healthcare physician for diagnosis and treatment.
        </p>
      </div>
    </div>
  )}