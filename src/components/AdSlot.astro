---
interface Props {
  position?: 'top' | 'mid' | 'sidebar' | 'footer';
  class?: string;
  adClient?: string;
  adSlot?: string;
}

const { 
  position = 'mid', 
  class: className = '',
  adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || '',
  adSlot = ''
} = Astro.props;

const hasAdSense = Boolean(adClient && adSlot);
---

{hasAdSense ? (
  <div class:list={["w-full my-6 flex justify-center items-center overflow-hidden min-h-[90px] bg-slate-50/50 rounded-2xl", className]} data-ad-position={position}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={adClient}
      data-ad-slot={adSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
) : position === 'sidebar' ? (
  <div class:list={["w-full my-4 rounded-3xl bg-gradient-to-br from-indigo-900 via-slate-900 to-purple-950 text-white p-5 border border-indigo-700/50 shadow-md relative overflow-hidden", className]} data-ad-position={position}>
    <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-brand/30 rounded-full blur-2xl pointer-events-none"></div>
    <div class="relative z-10">
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-[10px] font-black uppercase tracking-wider text-amber-300 bg-amber-400/20 px-2.5 py-1 rounded-full font-mono border border-amber-400/30">
          💎 Zero Annual Fee
        </span>
        <span class="text-[10px] text-slate-400 font-mono">RBI Regulated</span>
      </div>
      <h4 class="text-sm font-black text-white leading-snug mb-2">
        Lifetime FREE 5% Cashback Credit Cards
      </h4>
      <p class="text-xs text-slate-300 leading-relaxed mb-4">
        Unlimited 5% cashback on Amazon &amp; online orders with ₹1,500 welcome reward balance.
      </p>
      <a
        href="https://www.amazon.in/s?k=amazon+pay+icici+credit+card&tag=uniquedigi0c6-21"
        target="_blank"
        rel="sponsored nofollow noopener"
        class="block text-center py-2.5 px-4 rounded-xl bg-cta hover:bg-amber-400 text-cta-ink font-black text-xs transition shadow-xs cursor-pointer"
      >
        Check Free Eligibility &rarr;
      </a>
    </div>
  </div>
) : (
  <div class:list={["w-full my-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-brand-soft/40 to-amber-500/10 border border-amber-200/60 p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xs", className]} data-ad-position={position}>
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-400 text-slate-950 font-black flex items-center justify-center text-lg shrink-0 shadow-xs">
        ⚡
      </div>
      <div>
        <div class="flex items-center gap-2 mb-0.5">
          <span class="text-[10px] font-black uppercase tracking-wider text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full font-mono">
            {position === 'top' ? 'Trending Flash Loot' : "Today's Top Loot"}
          </span>
          <span class="text-xs text-muted hidden sm:inline">&bull; Verified Deals</span>
        </div>
        <h4 class="text-sm font-extrabold text-ink leading-tight">
          {position === 'top' 
            ? 'Amazon Lightning Deals: Electronics, Laptops & Smart Gadgets Under ₹9,999'
            : 'Up to 60% Off on Top PC Hardware, Laptops & Audio Deals'}
        </h4>
      </div>
    </div>
    <a
      href="https://www.amazon.in/s?k=today+deals+electronics&tag=uniquedigi0c6-21"
      target="_blank"
      rel="sponsored nofollow noopener"
      class="px-4 py-2 rounded-xl bg-cta hover:bg-amber-400 text-cta-ink font-black text-xs transition shadow-xs flex items-center gap-1.5 shrink-0 whitespace-nowrap cursor-pointer"
    >
      <span>Claim Offer</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
)}
