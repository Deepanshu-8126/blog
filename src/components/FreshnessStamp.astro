---
interface Props {
  updatedAt?: string | Date;
}

const { updatedAt } = Astro.props;

let timeLabel = 'Just now';
let isDelayed = false;

if (updatedAt) {
  const ts = new Date(updatedAt).getTime();
  const diffMinutes = Math.floor((Date.now() - ts) / (1000 * 60));

  if (diffMinutes < 1) {
    timeLabel = 'Just now';
  } else if (diffMinutes < 60) {
    timeLabel = `${diffMinutes}m ago`;
    if (diffMinutes > 30) isDelayed = true;
  } else {
    const diffHours = Math.floor(diffMinutes / 60);
    timeLabel = `${diffHours}h ago`;
    isDelayed = true;
  }
}
---

<span
  class={`inline-flex items-center gap-1 font-mono text-[11px] ${isDelayed ? 'text-amber-400 font-semibold' : 'text-muted'}`}
  title={updatedAt ? new Date(updatedAt).toLocaleString('en-IN') : 'Recently updated'}
>
  <svg class="w-3 h-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="10" />
    <polyline points="12 6 12 12 16 14" />
  </svg>
  <span>Updated {timeLabel}</span>
  {isDelayed && <span class="px-1 py-0.2 rounded text-[9px] bg-amber-500/20 text-amber-300 uppercase">Delayed</span>}
</span>
