---
interface Props {
  updatedAt?: string | Date;
}

const { updatedAt } = Astro.props;

let timeLabel = 'Live';
let isFresh = true;

if (updatedAt) {
  const ts = new Date(updatedAt).getTime();
  const diffMinutes = Math.floor((Date.now() - ts) / (1000 * 60));

  if (diffMinutes < 5) {
    timeLabel = 'Just now';
  } else if (diffMinutes < 60) {
    timeLabel = `${diffMinutes}m ago`;
  } else if (diffMinutes < 1440) {
    const diffHours = Math.floor(diffMinutes / 60);
    timeLabel = `${diffHours}h ago`;
    isFresh = false;
  } else {
    timeLabel = 'Today';
    isFresh = false;
  }
}
---

<span
  class="inline-flex items-center gap-1.5 font-mono text-xs text-slate-500"
  title={updatedAt ? new Date(updatedAt).toLocaleString('en-IN') : 'Live Telemetry'}
>
  <span class={`w-1.5 h-1.5 rounded-full ${isFresh ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400'}`}></span>
  <span>Updated {timeLabel}</span>
</span>
