---
import Icon from './Icon.astro';

interface Props {
  topicTitle?: string;
  nicheSlug?: string;
}

const { topicTitle = 'this deal', nicheSlug = 'deals' } = Astro.props;
---

<div class="my-10 p-6 sm:p-8 rounded-3xl bg-slate-900 border border-slate-800 text-white shadow-card relative overflow-hidden">
  <!-- Subtle accent glow -->
  <div class="absolute right-0 top-0 w-48 h-48 bg-brand/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="max-w-md">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-[11px] font-black uppercase tracking-wider text-emerald-400 font-mono">Community Verdict</span>
      </div>
      <h4 class="text-base sm:text-lg font-black text-white leading-snug">
        Is this information / deal worth it for Indian buyers?
      </h4>
      <p class="text-xs text-slate-400 mt-1">
        Your instant feedback helps our automated radar rank verified deals and filter price drops.
      </p>
    </div>

    <!-- Poll Buttons -->
    <div class="flex items-center gap-3 w-full md:w-auto" id="deal-poll-container">
      <button
        type="button"
        id="poll-yes"
        class="flex-1 md:flex-initial px-5 py-3 rounded-2xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition active:scale-95 cursor-pointer"
      >
        <span>👍 Worth It</span>
        <span class="text-[11px] font-mono bg-emerald-500/30 px-2 py-0.5 rounded-full text-white" id="yes-count">88%</span>
      </button>

      <button
        type="button"
        id="poll-no"
        class="flex-1 md:flex-initial px-5 py-3 rounded-2xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border border-rose-500/20 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition active:scale-95 cursor-pointer"
      >
        <span>👎 Skip / Wait</span>
        <span class="text-[11px] font-mono bg-rose-500/20 px-2 py-0.5 rounded-full text-slate-300" id="no-count">12%</span>
      </button>
    </div>
  </div>

  <div id="poll-thanks" class="hidden mt-4 pt-4 border-t border-slate-800 text-xs text-emerald-400 font-bold flex items-center gap-2">
    <span>✓ Thank you for voting! Live community sentiment updated.</span>
  </div>
</div>

<script>
  const btnYes = document.getElementById('poll-yes');
  const btnNo = document.getElementById('poll-no');
  const thanksMsg = document.getElementById('poll-thanks');

  if (btnYes && btnNo && thanksMsg) {
    const handleVote = () => {
      btnYes.classList.add('opacity-70', 'pointer-events-none');
      btnNo.classList.add('opacity-70', 'pointer-events-none');
      thanksMsg.classList.remove('hidden');
    };

    btnYes.addEventListener('click', handleVote);
    btnNo.addEventListener('click', handleVote);
  }
</script>
