---
import type { Post } from '../lib/db';
import Icon from './Icon.astro';
import { proxyImageUrl } from '../lib/images';

interface Props {
  post: Post;
  class?: string;
}

const { post, class: className = '' } = Astro.props;
if (!post) return null;

const nicheSlug = post.niches?.slug || 'viral';
const nicheName = post.niches?.name || 'Trending';
const grp = post.niches?.grp || 'Tech';
const safeImage = proxyImageUrl(post.image_url, nicheSlug);
const hasRealImage = Boolean(safeImage);

const nicheGradients: Record<string, string> = {
  tech: 'from-blue-600 via-indigo-700 to-slate-900',
  money: 'from-amber-600 via-orange-700 to-slate-900',
  lifestyle: 'from-emerald-600 via-teal-700 to-slate-900',
  entertainment: 'from-pink-600 via-purple-700 to-slate-900',
  education: 'from-indigo-600 via-purple-700 to-slate-900'
};
const cardGrad = nicheGradients[grp.toLowerCase()] || 'from-purple-700 via-indigo-800 to-slate-950';
---

<div class:list={["relative w-full rounded-3xl bg-white border border-slate-200/90 shadow-card overflow-hidden transition-all duration-300 hover:shadow-soft", className]}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
    
    <!-- Image Box: Real News Photo OR Clean CSS Gradient -->
    <div class="lg:col-span-7 relative min-h-[260px] sm:min-h-[340px] bg-slate-950 overflow-hidden flex items-center justify-center">
      {hasRealImage ? (
        <>
          <img
            src={safeImage!}
            alt=""
            aria-hidden="true"
            loading="eager"
            class="absolute inset-0 w-full h-full object-cover filter blur-xl opacity-40 scale-110 pointer-events-none"
          />
          <img
            src={safeImage!}
            alt={post.title}
            loading="eager"
            class="relative z-10 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </>
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${cardGrad} p-8 flex flex-col justify-between relative overflow-hidden`}>
          <div class="absolute -right-10 -bottom-10 w-48 h-48 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
          <div class="flex items-center justify-between z-10">
            <span class="text-xs font-mono font-bold text-white/70 tracking-wider uppercase">Lead Editorial Wire</span>
            <span class="text-2xl opacity-80">⚡</span>
          </div>
          <div class="z-10">
            <h2 class="text-white font-black text-xl sm:text-2xl drop-shadow-md leading-tight">{post.title}</h2>
          </div>
        </div>
      )}
      <div class="absolute inset-0 z-20 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="absolute top-4 left-4 flex items-center gap-2 z-30">
        <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-brand text-white shadow-md">
          {nicheName}
        </span>
        {post.trend_score > 0 && (
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-cta text-cta-ink shadow-md flex items-center gap-1 font-mono">
            🔥 +{post.trend_score}k Trend
          </span>
        )}
      </div>

      {post.image_credit && (
        <span class="absolute bottom-3 right-4 text-[10px] text-white/70 bg-black/40 px-2 py-0.5 rounded backdrop-blur-xs z-30">
          Source: {post.image_credit}
        </span>
      )}
    </div>

    <!-- Content Box -->
    <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between bg-white">
      <div>
        <!-- Editorial Metadata Strip -->
        <div class="flex items-center gap-2 mb-3 text-xs text-muted font-mono">
          <span class="font-bold text-brand uppercase tracking-wider">Top Story</span>
          <span>•</span>
          <span>{new Date(post.published_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          <span>•</span>
          <span class="flex items-center gap-1">
            <Icon name="clock" class="w-3 h-3 text-muted" />
            3 min read
          </span>
        </div>

        <!-- Headline -->
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-black text-ink tracking-tight leading-snug group-hover:text-brand transition mb-4">
          <a href={`/${nicheSlug}/${post.slug}`} class="hover:underline">
            {post.title}
          </a>
        </h2>

        <!-- Summary -->
        <p class="text-xs sm:text-sm text-muted leading-relaxed line-clamp-3 mb-6">
          {post.summary}
        </p>
      </div>

      <!-- Action Button & Tag Pill -->
      <div class="pt-4 border-t border-line flex items-center justify-between">
        <div class="flex items-center gap-2">
          {post.tags && post.tags.slice(0, 2).map((tag: string) => (
            <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-100 text-slate-700">
              #{tag}
            </span>
          ))}
        </div>

        <a
          href={`/${nicheSlug}/${post.slug}`}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand text-white text-xs font-bold shadow-xs hover:bg-brand-dark transition group/btn"
        >
          <span>Read Full Analysis</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" />
        </a>
      </div>

    </div>

  </div>
</div>
