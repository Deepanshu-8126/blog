---
import HypeMeter from './HypeMeter.astro';
import StageBadge from './StageBadge.astro';
import SourceDots from './SourceDots.astro';
import Sparkline from './Sparkline.astro';
import Icon from './Icon.astro';
import type { TrendItem } from '../lib/kv';

interface Props {
  item: TrendItem;
  rank: number;
}

const { item, rank } = Astro.props;
const rankStr = rank < 10 ? `0${rank}` : `${rank}`;
const postSlug = item.post_slug || item.slug;
const postLink = postSlug && item.niche_slug ? `/${item.niche_slug}/${postSlug}` : null;
const dealsLink = item.deal_product?.aff_url || (item.niche_slug ? `/${item.niche_slug}` : '/deals');
---

<div
  class="group relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl border border-line bg-card hover:bg-brand-soft/30 hover:border-brand/40 transition-all duration-200 shadow-xs"
  data-trend-id={item.id}
  data-niche={item.niche_slug || ''}
>
  <!-- Left Side: Rank, Title, Meta -->
  <div class="flex items-start sm:items-center gap-3.5 flex-1 min-w-0">
    <!-- Rank Number -->
    <span class="font-mono font-black text-lg sm:text-xl text-slate-400 group-hover:text-brand transition flex-shrink-0 w-8">
      {rankStr}
    </span>

    <!-- Content Block -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap mb-1">
        <StageBadge stage={item.stage} size="sm" />
        {item.niche && (
          <span class="text-[11px] font-mono font-semibold text-slate-500 uppercase tracking-wider">
            {item.niche}
          </span>
        )}
        {item.approx_traffic && (
          <span class="text-[10px] font-mono text-muted">
            {item.approx_traffic} searches
          </span>
        )}
      </div>

      <!-- Title / Link -->
      <h3 class="font-bold text-ink text-sm sm:text-base leading-snug line-clamp-2 sm:line-clamp-1">
        {postLink ? (
          <a href={postLink} class="hover:text-brand transition">
            {item.title}
          </a>
        ) : (
          <span>{item.title}</span>
        )}
      </h3>

      <!-- Source Verification Chips -->
      <div class="mt-2 sm:mt-1 flex items-center gap-2">
        <SourceDots sources={item.sources} maxVisible={3} />
      </div>
    </div>
  </div>

  <!-- Right Side: Metrics, Sparkline, CTAs -->
  <div class="flex items-center justify-between sm:justify-end gap-3 sm:gap-4 flex-shrink-0 pt-3 sm:pt-0 border-t sm:border-t-0 border-slate-100">
    <!-- Hype Score -->
    <HypeMeter score={item.hype} size="sm" showLabel={false} />

    <!-- 24h Trend Sparkline (Hidden on tiny screens) -->
    <div class="hidden md:block">
      <Sparkline points={item.spark} width={64} height={22} />
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2">
      {postLink ? (
        <a
          href={postLink}
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-brand hover:bg-brand-dark text-white text-xs font-bold transition shadow-xs"
        >
          <span>Read</span>
          <Icon name="arrow-right" class="w-3 h-3" />
        </a>
      ) : item.deal_product ? (
        <a
          href={dealsLink}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-cta hover:brightness-105 text-cta-ink text-xs font-extrabold transition shadow-xs"
        >
          <span>Deals</span>
          <Icon name="external-link" class="w-3 h-3" />
        </a>
      ) : (
        <a
          href={item.niche_slug ? `/${item.niche_slug}` : '/trending'}
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"
        >
          <span>Explore</span>
        </a>
      )}
    </div>
  </div>
</div>
