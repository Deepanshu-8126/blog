---
export interface ComicPanel {
  panelNumber: number;
  character: string;
  dialogue: string;
  bubbleType?: 'speech' | 'thought' | 'shout';
  image: string;
  caption?: string;
  soundEffect?: string;
}

interface Props {
  stripTitle: string;
  panels: ComicPanel[];
}

const { stripTitle, panels } = Astro.props;
---

<div class="comic-strip-container my-10 p-5 sm:p-7 rounded-3xl bg-slate-950 border-2 border-purple-500/30 shadow-2xl">
  <!-- Header Bar -->
  <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-800 text-white">
    <div class="flex items-center gap-3">
      <span class="w-8 h-8 rounded-xl bg-purple-600 text-white flex items-center justify-center font-black text-sm shadow-md animate-pulse">
        🎨
      </span>
      <div>
        <span class="text-[11px] font-black uppercase tracking-wider text-purple-400 font-mono">
          Original Webcomic Strip • 100% Verified Zero-Copyright
        </span>
        <h3 class="text-base sm:text-lg font-black text-white">{stripTitle}</h3>
      </div>
    </div>
    <span class="hidden sm:inline-flex px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-800 text-slate-300 border border-slate-700">
      {panels.length} Panels Story
    </span>
  </div>

  <!-- Vertical Webtoon Panels Flow -->
  <div class="flex flex-col gap-8 max-w-2xl mx-auto">
    {panels.map((panel) => (
      <div class="comic-panel-card bg-slate-900 rounded-2xl border-2 border-slate-700/80 overflow-hidden shadow-xl relative group">
        <!-- Panel Badge -->
        <div class="absolute top-3 left-3 z-20 flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-lg bg-slate-950/90 text-amber-400 font-mono font-black text-[11px] border border-amber-400/40 shadow-sm backdrop-blur-md">
            PANEL #{panel.panelNumber}
          </span>
          {panel.soundEffect && (
            <span class="px-2 py-0.5 rounded-lg bg-red-600 text-white font-black text-xs uppercase tracking-wider transform -rotate-6 shadow-md animate-bounce">
              💥 {panel.soundEffect}!
            </span>
          )}
        </div>

        <!-- Panel Visual (Verified High-Res Background) -->
        <div class="relative h-64 sm:h-80 w-full overflow-hidden bg-slate-950">
          <img
            src={panel.image}
            alt={`${stripTitle} - Panel ${panel.panelNumber}`}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
        </div>

        <!-- Dialogue Cloud Area -->
        <div class="p-4 sm:p-5 relative -mt-12 z-10">
          <!-- Character Tag -->
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-400 text-slate-950 font-black text-xs mb-2 shadow-md">
            <span>👤</span>
            <span>{panel.character}</span>
          </div>

          <!-- Speech Bubble / Dialogue Cloud Box -->
          {panel.bubbleType === 'thought' ? (
            /* Thought Cloud (Wavy circular aesthetics) */
            <div class="relative p-4 rounded-3xl bg-slate-100 text-slate-950 font-bold text-sm sm:text-base leading-snug border-2 border-dashed border-indigo-400 shadow-lg">
              <span class="text-xs text-indigo-600 font-mono uppercase block mb-1">💭 (Thinking...)</span>
              "{panel.dialogue}"
              <!-- Cloud bubbles trailing -->
              <div class="absolute -top-3 left-8 w-3 h-3 rounded-full bg-slate-100 border border-indigo-300"></div>
              <div class="absolute -top-5 left-10 w-2 h-2 rounded-full bg-slate-100 border border-indigo-300"></div>
            </div>
          ) : panel.bubbleType === 'shout' ? (
            /* Action Shout Balloon (Spiky energetic styling) */
            <div class="relative p-4 rounded-2xl bg-amber-300 text-slate-950 font-black text-sm sm:text-base leading-snug border-2 border-amber-500 shadow-xl">
              <span class="text-xs text-red-700 font-mono uppercase block mb-1">📢 (Shouting!)</span>
              "{panel.dialogue}"
            </div>
          ) : (
            /* Classic Speech Bubble with pointer tail */
            <div class="relative p-4 rounded-2xl bg-white text-slate-950 font-bold text-sm sm:text-base leading-snug border-2 border-slate-900 shadow-lg">
              <span class="text-xs text-slate-500 font-mono uppercase block mb-1">💬 Says:</span>
              "{panel.dialogue}"
              <!-- Speech pointer tail -->
              <div class="absolute -bottom-2 left-6 w-4 h-4 bg-white border-b-2 border-r-2 border-slate-900 transform rotate-45"></div>
            </div>
          )}

          {panel.caption && (
            <p class="text-xs text-slate-400 mt-3 italic font-medium">
              📍 Scene: {panel.caption}
            </p>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Strip Navigation & Legal Notice -->
  <div class="mt-6 pt-4 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-400">
    <span>💡 <em>Tip: Scroll vertically to read the full webcomic strip.</em></span>
    <span class="font-mono text-purple-400">UniqueDigit Original Creative IP</span>
  </div>
</div>
