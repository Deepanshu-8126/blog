---
import type { Product } from '../lib/db';
import Icon from './Icon.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const buyUrl = product.aff_url || product.url;
---

<div class="group flex flex-col justify-between rounded-2xl bg-white border border-line p-5 shadow-card hover:shadow-soft hover:border-brand/40 transition-all duration-300">
  <div>
    <!-- Top Bar with Image & Badge -->
    <div class="flex items-start justify-between gap-3 mb-4">
      <div class="w-14 h-14 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center p-2 shrink-0 overflow-hidden">
        {product.image_url ? (
          <img src={product.image_url} alt={product.name} class="max-h-full max-w-full object-contain" loading="lazy" />
        ) : (
          <Icon name="sparkles" class="w-6 h-6 text-brand" />
        )}
      </div>

      <div class="flex flex-col items-end gap-1">
        {product.badge && (
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-cta text-cta-ink shadow-xs">
            {product.badge}
          </span>
        )}
        {product.rating && (
          <div class="flex items-center gap-1 text-xs font-bold text-amber-500 font-mono">
            <span>★</span>
            <span class="text-ink">{product.rating}</span>
          </div>
        )}
      </div>
    </div>

    <!-- Title & Tagline -->
    <h3 class="font-extrabold text-base text-ink leading-snug group-hover:text-brand transition mb-1">
      {product.name}
    </h3>

    {product.tagline && (
      <p class="text-xs text-muted leading-relaxed line-clamp-2 mb-3">
        {product.tagline}
      </p>
    )}

    {product.category && (
      <span class="inline-block text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md mb-4">
        {product.category}
      </span>
    )}
  </div>

  <!-- Bottom Pricing & CTA -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
    <div>
      {product.price ? (
        <div>
          <span class="text-[10px] text-muted block uppercase font-bold">Best Price</span>
          <span class="text-sm font-black text-ink font-mono">₹{product.price.toLocaleString('en-IN')}</span>
        </div>
      ) : (
        <span class="text-xs font-bold text-life font-mono">Freemium / Deal</span>
      )}
    </div>

    <a
      href={buyUrl}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 text-xs font-black transition flex items-center gap-1.5 shadow-xs cursor-pointer"
    >
      <span>View Deal</span>
      <Icon name="external-link" class="w-3.5 h-3.5" />
    </a>
  </div>
</div>
