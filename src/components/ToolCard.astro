---
import type { Product } from '../lib/db';
import Icon from './Icon.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const buyUrl = product.aff_url || product.url;
---

<div
  class="tool-item-card card-lift group flex flex-col justify-between rounded-3xl bg-white border border-slate-200/90 p-5 shadow-xs hover:border-brand/40 transition-all duration-300 relative"
  data-name={product.name.toLowerCase()}
  data-category={(product.category || '').toLowerCase()}
  data-keywords={(product.keywords || product.tagline || '').toLowerCase()}
>
  <div>
    <!-- Full-Width Prominent Product Showcase Image Box -->
    <a href={buyUrl} target="_blank" rel="sponsored nofollow noopener" class="block relative aspect-[16/10] sm:aspect-[4/3] w-full rounded-2xl overflow-hidden mb-4 bg-slate-100 border border-slate-200/70">
      {product.image_url ? (
        <img
          src={product.image_url}
          alt={product.name}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-slate-100">
          <Icon name="sparkles" class="w-12 h-12 text-brand/40" />
        </div>
      )}

      <!-- Top Badges Overlay -->
      <div class="absolute top-3 left-3 flex items-center gap-1.5 z-10">
        {product.category && (
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-white/95 backdrop-blur-xs text-slate-700 shadow-xs border border-slate-200/60">
            {product.category}
          </span>
        )}
      </div>

      <div class="absolute top-3 right-3 flex items-center gap-1.5 z-10">
        {product.badge && (
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-cta text-cta-ink shadow-xs">
            {product.badge}
          </span>
        )}
        {product.rating && (
          <div class="flex items-center gap-0.5 text-xs font-bold bg-white/95 backdrop-blur-xs text-amber-500 font-mono px-2 py-0.5 rounded-full shadow-xs border border-slate-200/60">
            <span>★</span>
            <span class="text-slate-900">{product.rating}</span>
          </div>
        )}
      </div>
    </a>

    <!-- Title & Tagline -->
    <h3 class="font-black text-base sm:text-lg text-slate-900 leading-snug group-hover:text-brand transition-colors mb-1.5 line-clamp-2">
      <a href={buyUrl} target="_blank" rel="sponsored nofollow noopener">
        {product.name}
      </a>
    </h3>

    {product.tagline && (
      <p class="text-xs text-slate-500 leading-relaxed line-clamp-2 mb-4">
        {product.tagline}
      </p>
    )}
  </div>

  <!-- Bottom Pricing & Action CTA -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
    <div>
      {product.price ? (
        <div>
          <span class="text-[10px] text-slate-400 block uppercase font-bold font-mono">Best Price</span>
          <span class="text-base sm:text-lg font-black text-slate-900 font-mono">₹{product.price.toLocaleString('en-IN')}</span>
        </div>
      ) : (
        <div>
          <span class="text-[10px] text-slate-400 block uppercase font-bold font-mono">Pricing</span>
          <span class="text-xs font-bold text-emerald-600 font-mono">Freemium / Special Offer</span>
        </div>
      )}
    </div>

    <a
      href={buyUrl}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 text-xs font-black transition flex items-center gap-1.5 shadow-sm active:scale-95 cursor-pointer shrink-0"
    >
      <span>View Deal</span>
      <Icon name="external-link" class="w-3.5 h-3.5" />
    </a>
  </div>
</div>
