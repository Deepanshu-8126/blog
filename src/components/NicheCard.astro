---
import type { Post, Niche } from '../lib/db';
import Icon from './Icon.astro';
import { proxyImageUrl, get4KCuratedImage } from '../lib/images';

interface Props {
  post: Post;
  niche?: Niche;
  class?: string;
  rank?: number;
}

const { post, niche } = Astro.props;
const currentNiche = niche || post.niches;
const grp = currentNiche?.grp || 'Tech';
const slug = currentNiche?.slug || 'viral';

const groupThemes: Record<string, { chip: string; border: string }> = {
  Tech: { chip: 'bg-blue-600 text-white', border: 'hover:border-blue-400' },
  Money: { chip: 'bg-amber-600 text-white', border: 'hover:border-amber-400' },
  Lifestyle: { chip: 'bg-emerald-600 text-white', border: 'hover:border-emerald-400' },
  Entertainment: { chip: 'bg-pink-600 text-white', border: 'hover:border-pink-400' }
};

const theme = groupThemes[grp] || groupThemes.Tech;

// Calculate estimated read time based on body length
const wordCount = (post.body_md || post.summary || '').split(/\s+/).length;
const readTimeMin = Math.max(2, Math.ceil(wordCount / 180));

// Always resolve an authentic, crisp 4K image
const safeImage = proxyImageUrl(post.image_url, slug, post.slug || post.title);
const fallbackImage = get4KCuratedImage(post.slug || post.title, slug);
---

<div class={`card-lift group flex flex-col justify-between rounded-3xl bg-white border border-slate-200/90 ${theme.border} p-4 sm:p-5 shadow-xs transition-all duration-300 relative ${Astro.props.class || ''}`}>
  <div>
    <!-- Standardized 16:9 Image Box (Zero Aspect Ratio Distortion, Guaranteed 4K Visual) -->
    <a href={`/${slug}/${post.slug}`} class="block relative aspect-video w-full rounded-2xl overflow-hidden mb-4 bg-slate-900 flex items-center justify-center">
      <img
        src={safeImage}
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover filter blur-xl opacity-40 scale-110 pointer-events-none"
      />
      <img
        src={safeImage}
        alt={post.title}
        loading="lazy"
        class="relative z-10 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        onerror={`this.onerror=null; this.src='${fallbackImage}';`}
      />
      
      <!-- Top Pills -->
      <div class="absolute top-3 left-3 flex items-center gap-1.5 z-20">
        <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider ${theme.chip} shadow-sm`}>
          {currentNiche?.name || grp}
        </span>
      </div>

      {post.is_breaking && (
        <span class="absolute top-3 right-3 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-red-600 text-white shadow-xs z-20 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
          <span>Hot Story</span>
        </span>
      )}
    </a>

    <!-- Title & Summary -->
    <h3 class="font-black text-base sm:text-lg text-slate-900 leading-snug group-hover:text-brand transition-colors line-clamp-2 mb-2">
      <a href={`/${slug}/${post.slug}`}>
        {post.title}
      </a>
    </h3>

    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-4">
      {post.summary}
    </p>
  </div>

  <!-- Bottom Metadata Strip -->
  <div class="flex items-center justify-between pt-3.5 border-t border-slate-100 text-xs text-slate-500 font-mono">
    <div class="flex items-center gap-2">
      <span>{new Date(post.published_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' })}</span>
      <span>·</span>
      <span>{readTimeMin}m read</span>
    </div>

    <a href={`/${slug}/${post.slug}`} class="font-bold text-brand group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
      <span>Read</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>
</div>
