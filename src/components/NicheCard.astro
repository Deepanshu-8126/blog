---
import type { Post, Niche } from '../lib/db';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  niche?: Niche;
}

const { post, niche } = Astro.props;
const currentNiche = niche || post.niches;
const grp = currentNiche?.grp || 'Tech';
const slug = currentNiche?.slug || 'viral';

const groupThemes: Record<string, { cardBg: string; chip: string; border: string }> = {
  Tech: { cardBg: 'bg-tech-bg/40', chip: 'bg-tech text-white', border: 'hover:border-blue-300' },
  Money: { cardBg: 'bg-money-bg/50', chip: 'bg-money text-white', border: 'hover:border-amber-300' },
  Lifestyle: { cardBg: 'bg-life-bg/50', chip: 'bg-life text-white', border: 'hover:border-emerald-300' },
  Entertainment: { cardBg: 'bg-ent-bg/40', chip: 'bg-ent text-white', border: 'hover:border-pink-300' }
};

const theme = groupThemes[grp] || groupThemes.Tech;
---

<div class="group flex flex-col justify-between rounded-2xl bg-white border border-slate-200 hover:border-brand/50 p-4 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
  <div>
    <!-- Image Box -->
    <div class="relative aspect-video w-full rounded-xl overflow-hidden mb-3.5 bg-slate-200">
      <img
        src={post.image_url || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80'}
        alt={post.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
      
      <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
        <span class={`px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider ${theme.chip} shadow-xs`}>
          {currentNiche?.name || grp}
        </span>
        {post.trend_score > 0 && (
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/95 backdrop-blur-xs text-ink shadow-xs font-mono">
            +{post.trend_score}k
          </span>
        )}
      </div>
    </div>

    <!-- Title & Summary -->
    <h3 class="font-extrabold text-base text-ink leading-snug group-hover:text-brand transition line-clamp-2 mb-2">
      <a href={`/${slug}/${post.slug}`}>
        {post.title}
      </a>
    </h3>

    <p class="text-xs text-muted line-clamp-2 leading-relaxed mb-4">
      {post.summary}
    </p>
  </div>

  <div class="flex items-center justify-between pt-3 border-t border-black/5 text-xs text-muted">
    <span>{new Date(post.published_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' })}</span>
    <a href={`/${slug}/${post.slug}`} class="font-bold text-brand hover:underline flex items-center gap-1">
      Read <Icon name="arrow-right" class="w-3 h-3 group-hover:translate-x-0.5 transition" />
    </a>
  </div>
</div>
