---
import type { Post, Niche } from '../lib/db';
import Icon from './Icon.astro';
import { proxyImageUrl } from '../lib/images';

interface Props {
  post: Post;
  niche?: Niche;
  class?: string;
  rank?: number;
}

const { post, niche } = Astro.props;
const currentNiche = niche || post.niches;
const grp = currentNiche?.grp || 'Tech';
const slug = currentNiche?.slug || 'viral';

const groupThemes: Record<string, { chip: string; border: string }> = {
  Tech: { chip: 'bg-blue-600 text-white', border: 'hover:border-blue-400' },
  Money: { chip: 'bg-amber-600 text-white', border: 'hover:border-amber-400' },
  Lifestyle: { chip: 'bg-emerald-600 text-white', border: 'hover:border-emerald-400' },
  Entertainment: { chip: 'bg-pink-600 text-white', border: 'hover:border-pink-400' },
  Education: { chip: 'bg-indigo-600 text-white', border: 'hover:border-indigo-400' }
};

const theme = groupThemes[grp] || groupThemes.Tech;

// Calculate estimated read time based on body length
const wordCount = (post.body_md || post.summary || '').split(/\s+/).length;
const readTimeMin = Math.max(2, Math.ceil(wordCount / 180));

// Resolve real web news photo, or curated high-res editorial photo for the niche
const safeImage = proxyImageUrl(post.image_url, slug, post.slug);
const hasRealImage = Boolean(safeImage);

const nicheGradients: Record<string, string> = {
  tech: 'from-blue-600 via-indigo-700 to-slate-900',
  money: 'from-amber-600 via-orange-700 to-slate-900',
  lifestyle: 'from-emerald-600 via-teal-700 to-slate-900',
  entertainment: 'from-pink-600 via-purple-700 to-slate-900',
  education: 'from-indigo-600 via-purple-700 to-slate-900'
};
const cardGrad = nicheGradients[grp.toLowerCase()] || 'from-purple-700 via-indigo-800 to-slate-950';
---

<div class={`card-lift group flex flex-col justify-between rounded-3xl bg-white border border-slate-200/90 ${theme.border} p-4 sm:p-5 shadow-xs transition-all duration-300 relative ${Astro.props.class || ''}`}>
  <div>
    <!-- Standardized 16:9 Image Box: Real News Photo OR Clean CSS Gradient -->
    <a href={`/${slug}/${post.slug}`} class="block relative aspect-video w-full rounded-2xl overflow-hidden mb-4 bg-slate-100 flex items-center justify-center">
      {hasRealImage ? (
        <>
          <img
            src={safeImage!}
            alt={post.title}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror="this.style.display='none'; this.parentElement.querySelector('.image-fallback')?.classList.remove('hidden');"
          />
          <div class={`image-fallback hidden absolute inset-0 w-full h-full bg-gradient-to-br ${cardGrad} p-5 flex flex-col justify-between z-10`}>
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold text-white/70 tracking-wider uppercase">{currentNiche?.name || grp}</span>
              <span class="text-lg opacity-80">⚡</span>
            </div>
            <div>
              <p class="text-white font-extrabold text-sm sm:text-base line-clamp-2 leading-snug drop-shadow-xs">{post.title}</p>
            </div>
          </div>
        </>
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${cardGrad} p-5 flex flex-col justify-between relative overflow-hidden group-hover:scale-102 transition-transform duration-500`}>
          <div class="absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-white/10 blur-xl pointer-events-none"></div>
          <div class="flex items-center justify-between z-10">
            <span class="text-[11px] font-mono font-bold text-white/70 tracking-wider uppercase">{currentNiche?.name || grp}</span>
            <span class="text-lg opacity-80">⚡</span>
          </div>
          <div class="z-10">
            <p class="text-white font-extrabold text-sm sm:text-base line-clamp-2 leading-snug drop-shadow-xs">{post.title}</p>
          </div>
        </div>
      )}
      
      <!-- Top Pills -->
      <div class="absolute top-3 left-3 flex items-center gap-1.5 z-20">
        <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider ${theme.chip} shadow-sm`}>
          {currentNiche?.name || grp}
        </span>
      </div>

      {post.is_breaking && (
        <span class="absolute top-3 right-3 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-red-600 text-white shadow-xs z-20 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
          <span>Hot Story</span>
        </span>
      )}
    </a>

    <!-- Title & Summary -->
    <h3 class="font-black text-base sm:text-lg text-slate-900 leading-snug group-hover:text-brand transition-colors line-clamp-2 mb-2">
      <a href={`/${slug}/${post.slug}`}>
        {post.title}
      </a>
    </h3>

    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-4">
      {post.summary}
    </p>
  </div>

  <!-- Bottom Metadata Strip -->
  <div class="flex items-center justify-between pt-3.5 border-t border-slate-100 text-xs text-slate-500 font-mono">
    <div class="flex items-center gap-2">
      <span>{new Date(post.published_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' })}</span>
      <span>·</span>
      <span>{readTimeMin}m read</span>
    </div>

    <a href={`/${slug}/${post.slug}`} class="font-bold text-brand group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
      <span>Read</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>
</div>
