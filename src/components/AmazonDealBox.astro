---
import Icon from './Icon.astro';
import { getContextualDeals } from '../lib/recommendations';

interface Props {
  keyword: string;
  summary?: string;
  nicheSlug?: string;
  nicheName?: string;
  customTitle?: string;
}

const { keyword, summary = '', nicheSlug = 'deals', nicheName = 'Curated Finds', customTitle } = Astro.props;
const amazonTag = 'uniquedigi0c6-21';

// Function to extract 2-4 clean, high-intent product keywords instead of raw long article titles
function extractProductQuery(title: string, summaryText: string, slug: string): string {
  const combined = `${title} ${summaryText}`.toLowerCase();

  if (/cooling|air purifier|purifier|hepa|ac\b|conditioner|heatwave|weather|smog|pollution|aqi/i.test(combined)) {
    return 'inverter ac air purifier';
  }
  if (/cricket|ipl|t20|world cup|match|stadium/i.test(combined)) {
    return 'cricket kit 4k smart tv';
  }
  if (/gta 6|playstation|ps5|xbox|gaming/i.test(combined)) {
    return 'gaming mouse headphones rgb';
  }
  if (/pc build|rtx|gpu|graphic card|nvidia|processor|ssd|ram\b/i.test(combined)) {
    return 'rtx graphic card ssd gen4';
  }
  if (/phone|smartphone|5g|iphone|oneplus|samsung galaxy/i.test(combined)) {
    return '5g smartphone fast charger';
  }
  if (/laptop|macbook|thinkpad|notebook/i.test(combined)) {
    return 'laptop thin and light';
  }
  if (/gold|silver|bullion|coin/i.test(combined)) {
    return '24k gold coin certified';
  }
  if (/exam|results|sarkari|admit card/i.test(combined)) {
    return 'study tablet exam notes';
  }

  // Generic fallback: strip noise words and take up to 3 meaningful words
  const words = title
    .replace(/[^\w\s]/gi, ' ')
    .split(/\s+/)
    .filter(w => {
      const low = w.toLowerCase();
      return (
        w.length > 2 &&
        !['guide', 'best', 'survival', 'top', 'today', 'live', 'how', 'what', 'why', 'swing', 'latest', 'review', 'update', 'india', '2025', '2026', 'versus', 'with', 'from', 'this', 'that', 'near'].includes(low)
      );
    });

  if (words.length > 0) {
    return words.slice(0, 3).join(' ');
  }

  return 'trending deals electronics';
}

const cleanQuery = extractProductQuery(keyword, summary, nicheSlug);
const searchUrl = `https://www.amazon.in/s?k=${encodeURIComponent(cleanQuery)}&tag=${amazonTag}`;
const contextualDeals = getContextualDeals(nicheSlug, keyword, summary);

const displayHeading = customTitle || (nicheName && nicheName !== 'Curated Finds'
  ? `Handpicked Deals & Verified Offers in ${nicheName}`
  : `Today's Curated Deals & Verified Offers`);
---

<div class="my-10 rounded-3xl bg-white p-6 sm:p-8 border border-purple-200/80 shadow-card relative overflow-hidden">
  <!-- Soft Purple Accent Glow -->
  <div class="absolute -right-20 -bottom-20 w-72 h-72 bg-brand/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10">
    <!-- Top Header Badge -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-soft text-brand font-black text-xs uppercase tracking-wider">
          <Icon name="sparkles" class="w-3.5 h-3.5" />
          Curated Deals & Offers
        </span>
        <span class="text-xs text-slate-500 font-medium hidden sm:inline">Handpicked for {nicheName}</span>
      </div>

      <div class="flex items-center gap-1.5 text-xs text-slate-700 font-mono font-bold bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Verified Active Offers</span>
      </div>
    </div>

    <!-- Title & Value Pitch -->
    <h3 class="text-xl sm:text-2xl font-black text-slate-900 leading-snug mb-2">
      {displayHeading}
    </h3>

    <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
      We checked top trusted retailers and Amazon India for today's best verified discounts. Here are top recommended picks matching this story:
    </p>

    <!-- Contextual Dynamic Deals List -->
    {contextualDeals.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        {contextualDeals.map(deal => (
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand/50 hover:bg-purple-50/30 transition flex flex-col justify-between group shadow-2xs">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2 py-0.5 rounded-md bg-amber-100 text-amber-900 text-[11px] font-black uppercase">
                  {deal.badge}
                </span>
                <span class="text-[10px] text-slate-600 font-mono bg-white px-2 py-0.5 rounded-full border border-slate-200">
                  {deal.merchant}
                </span>
              </div>
              <h4 class="font-bold text-sm text-slate-900 group-hover:text-brand transition mb-1 leading-snug">
                {deal.title}
              </h4>
              <p class="text-xs text-slate-600 font-medium">
                {deal.discount} • <span class="text-slate-500">{deal.priceNote}</span>
              </p>
            </div>

            <div class="pt-3 mt-3 border-t border-slate-200/80 flex items-center justify-between">
              <span class="text-[11px] text-emerald-600 flex items-center gap-1 font-medium">
                ✓ {deal.trustTag}
              </span>
              <a
                href={deal.affUrl}
                target="_blank"
                rel="sponsored nofollow noopener"
                class="px-3.5 py-1.5 rounded-xl bg-cta hover:bg-amber-400 text-cta-ink font-black text-xs transition flex items-center gap-1 shadow-xs cursor-pointer"
              >
                <span>View Deal</span>
                <Icon name="external-link" class="w-3 h-3" />
              </a>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Universal CTA Row -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-4 border-t border-slate-100">
      <div class="text-xs text-slate-500">
        <span class="text-slate-800 font-semibold block">Amazon India & Trusted Merchant Deals</span>
        <span>Lightning deals and coupon codes refresh continuously throughout the day.</span>
      </div>

      <a
        href={searchUrl}
        target="_blank"
        rel="sponsored nofollow noopener"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-brand hover:bg-brand-dark text-white font-black text-sm transition transform hover:-translate-y-0.5 active:translate-y-0 shadow-md shadow-brand/20 cursor-pointer shrink-0"
      >
        <span>Explore Live Offers on Amazon India</span>
        <Icon name="external-link" class="w-4 h-4" />
      </a>
    </div>
  </div>
</div>
