---
import { getNiches } from '../lib/db';
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';

const niches = await getNiches();
---

<footer class="w-full bg-white border-t border-line mt-16 pt-12 pb-8 text-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 pb-12 border-b border-slate-100">
      
      <!-- Brand & Mission -->
      <div class="lg:col-span-2">
        <div class="mb-3">
          <BrandLogo size="md" theme="dark" />
        </div>
        <p class="text-xs text-muted leading-relaxed max-w-sm mb-4">
          India’s next-generation viral intelligence portal. Grounded hardware reviews, live bullion trends, generative AI directory, and verified loot deals updated daily.
        </p>
        <div class="flex items-center gap-2 text-xs text-muted">
          <span class="w-2 h-2 rounded-full bg-life"></span>
          <span>Zero fake metrics. 100% data-grounded insights.</span>
        </div>
      </div>

      <!-- Quick Niche Links -->
      <div>
        <h4 class="font-bold text-xs uppercase tracking-wider text-muted mb-3">Tech & AI Hubs</h4>
        <ul class="flex flex-col gap-2 text-xs">
          <li><a href="/builds" class="text-slate-700 hover:text-brand transition">PC Builds India</a></li>
          <li><a href="/ai-tools" class="text-slate-700 hover:text-brand transition">AI Tools Directory</a></li>
          <li><a href="/gold-rate" class="text-slate-700 hover:text-brand transition">Gold Rate Today</a></li>
          <li><a href="/gta-6" class="text-slate-700 hover:text-brand transition">GTA 6 Specs & Intel</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-xs uppercase tracking-wider text-muted mb-3">Deals & Lifestyle</h4>
        <ul class="flex flex-col gap-2 text-xs">
          <li><a href="/deals" class="text-slate-700 hover:text-brand transition">Today's Deals</a></li>
          <li><a href="/cashback" class="text-slate-700 hover:text-brand transition">Cashback Offers</a></li>
          <li><a href="/side-hustles" class="text-slate-700 hover:text-brand transition">Side Hustles 2026</a></li>
          <li><a href="/movies" class="text-slate-700 hover:text-brand transition">Movies & OTT Guide</a></li>
        </ul>
      </div>

      <!-- Legal & Disclosures -->
      <div>
        <h4 class="font-bold text-xs uppercase tracking-wider text-muted mb-3">Legal & Company</h4>
        <ul class="flex flex-col gap-2 text-xs">
          <li><a href="/about" class="text-slate-700 hover:text-brand transition">About UniqueDigit</a></li>
          <li><a href="/contact" class="text-slate-700 hover:text-brand transition">Contact Us</a></li>
          <li><a href="/privacy" class="text-slate-700 hover:text-brand transition">Privacy Policy</a></li>
          <li><a href="/terms" class="text-slate-700 hover:text-brand transition">Terms of Service</a></li>
          <li><a href="/disclosure" class="text-slate-700 hover:text-brand transition">Affiliate Disclosure</a></li>
          <li><a href="/disclaimer" class="text-slate-700 hover:text-brand transition">General Disclaimer</a></li>
        </ul>
      </div>

    </div>

    <!-- Affiliate Disclosure Banner -->
    <div class="py-6 border-b border-slate-100 text-[11px] text-muted leading-relaxed">
      <p>
        <strong>Affiliate Transparency:</strong> UniqueDigit participates in affiliate marketing programs, including EarnKaro and Amazon Associates. We may earn a commission when you make qualifying purchases through outbound links on our site at no additional cost to you.
      </p>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted">
      <span>&copy; {new Date().getFullYear()} UniqueDigit Media Inc. All rights reserved.</span>
      <div class="flex items-center gap-4">
        <a href="/sitemap.xml" class="hover:text-ink transition">Sitemap</a>
        <a href="/rss.xml" class="hover:text-ink transition">RSS Feed</a>
        <span>Built for Indian Geeks</span>
      </div>
    </div>
  </div>
</footer>
