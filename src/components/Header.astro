---
import { getNiches } from '../lib/db';
import MegaMenu from './MegaMenu.astro';
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';

interface Props {
  activeNiche?: string;
  activeGroup?: string;
}

const { activeNiche } = Astro.props;
const niches = await getNiches();
const pinnedNiches = niches.filter(n => n.pin).slice(0, 5);

// Group niches for mobile drawer
const groups = ['Tech', 'Money', 'Lifestyle', 'Entertainment'];
const nichesByGroup: Record<string, typeof niches> = {};
groups.forEach(g => {
  nichesByGroup[g] = niches.filter(n => n.grp.toLowerCase() === g.toLowerCase());
});

const groupBadges: Record<string, string> = {
  Tech: 'bg-tech-bg text-tech',
  Money: 'bg-money-bg text-money',
  Lifestyle: 'bg-life-bg text-life',
  Entertainment: 'bg-ent-bg text-ent'
};

// Dynamic path detection
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isTrending = pathname.startsWith('/trending');
const isBuilds = pathname.startsWith('/builds');
const isDeals = pathname.startsWith('/deals');
const isSearch = pathname.startsWith('/search');

const isNicheActive = (slug: string) => {
  return activeNiche === slug || pathname === `/${slug}` || pathname.startsWith(`/${slug}/`);
};

const todayFormatted = new Intl.DateTimeFormat('en-IN', {
  weekday: 'short',
  month: 'short',
  day: 'numeric'
}).format(new Date());
---

<header class="sticky top-0 z-50 w-full glass-nav-brand text-white shadow-xl transition-all duration-300">
  <!-- Top Telemetry & Live Desk Bar -->
  <div class="hidden sm:block border-b border-white/5 bg-slate-950/80 text-[11px] py-1 px-4 text-slate-400 font-mono">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 font-bold text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          LIVE INTEL DESK
        </span>
        <span class="text-slate-700">|</span>
        <span class="text-slate-300 font-sans font-medium">
          India Edition &bull; {todayFormatted}
        </span>
        <span class="hidden lg:inline text-slate-700">|</span>
        <span class="hidden lg:inline text-amber-300 font-mono font-medium">
          ⚡ Bullion 24K: ₹1,18,500/10g
        </span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/trending" class="hover:text-white transition flex items-center gap-1 text-slate-300">
          <span class="text-xs">🔥</span>
          <span class="font-sans font-medium">Trends Radar Active</span>
        </a>
        <span class="text-slate-700">|</span>
        <span class="px-1.5 py-0.5 rounded bg-white/10 text-slate-300 text-[10px] uppercase font-bold tracking-wider">
          Grounded Media
        </span>
      </div>
    </div>
  </div>

  <!-- Main Newsroom Masthead Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3 sm:gap-4">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-4 lg:gap-6 shrink-0">
        <a href="/" class="block">
          <BrandLogo size="md" />
        </a>

        <!-- Desktop Navigation: Sleek Editorial Links -->
        <nav class="hidden lg:flex items-center gap-1">
          <a
            href="/"
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 ${isHome ? 'bg-white/15 text-white shadow-xs border border-white/10' : 'text-slate-300 hover:text-white hover:bg-white/10'}`}
          >
            <Icon name="home" class="w-3.5 h-3.5 text-slate-400" />
            <span>Home</span>
          </a>
          <a
            href="/trending"
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 ${isTrending ? 'bg-white/15 text-white shadow-xs border border-white/10' : 'text-slate-300 hover:text-white hover:bg-white/10'}`}
          >
            <span class="text-xs">🔥</span>
            <span>Live Wire</span>
          </a>
          <a
            href="/cricket"
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 ${pathname.startsWith('/cricket') ? 'bg-white/15 text-white shadow-xs border border-white/10' : 'text-slate-300 hover:text-white hover:bg-white/10'}`}
          >
            <Icon name="trophy" class="w-3.5 h-3.5 text-emerald-400" />
            <span>Cricket</span>
          </a>
          <a
            href="/ai-tools"
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 ${pathname.startsWith('/ai-tools') ? 'bg-white/15 text-white shadow-xs border border-white/10' : 'text-slate-300 hover:text-white hover:bg-white/10'}`}
          >
            <Icon name="sparkles" class="w-3.5 h-3.5 text-blue-400" />
            <span>AI Tools</span>
          </a>
          <a
            href="/gold-rate"
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 ${pathname.startsWith('/gold-rate') ? 'bg-white/15 text-white shadow-xs border border-white/10' : 'text-slate-300 hover:text-white hover:bg-white/10'}`}
          >
            <Icon name="coins" class="w-3.5 h-3.5 text-amber-400" />
            <span>Gold Rate</span>
          </a>
          <a
            href="/builds"
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 ${pathname.startsWith('/builds') || pathname.startsWith('/pc-builds') ? 'bg-white/15 text-white shadow-xs border border-white/10' : 'text-slate-300 hover:text-white hover:bg-white/10'}`}
          >
            <Icon name="cpu" class="w-3.5 h-3.5 text-purple-400" />
            <span>PC Rig</span>
          </a>
          <a
            href="/deals"
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition shrink-0 ${isDeals ? 'bg-white/15 text-white shadow-xs border border-white/10' : 'text-slate-300 hover:text-white hover:bg-white/10'}`}
          >
            <Icon name="tag" class="w-3.5 h-3.5 text-emerald-300" />
            <span>Deals</span>
          </a>

          <!-- More Dropdown Button -->
          <button
            id="megamenu-toggle-btn"
            type="button"
            class="flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-white/10 transition cursor-pointer select-none shrink-0"
            aria-expanded="false"
          >
            <span>All Hubs</span>
            <Icon name="chevron-down" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 pointer-events-none" id="megamenu-arrow" />
          </button>
        </nav>
      </div>

      <!-- Right Action Tools -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Global Search Pill with Keyboard Shortcut -->
        <a
          href="/search"
          class={`flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/15 text-slate-300 hover:text-white transition text-xs font-medium border border-white/10 shadow-xs ${isSearch ? 'bg-white/20 text-white' : ''}`}
          title="Search all topics (Ctrl + K)"
        >
          <Icon name="search" class="w-3.5 h-3.5 text-slate-400" />
          <span class="hidden sm:inline">Search...</span>
          <kbd class="hidden md:inline-block text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-900/60 border border-white/10 text-slate-400 font-semibold">
            ⌘K
          </kbd>
        </a>

        <!-- Trending Board Button -->
        <a
          href="/trending"
          class={`hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-bold transition ${isTrending ? 'bg-white text-slate-900 border-white shadow-xs' : 'bg-red-500/15 border-red-500/30 text-red-200 hover:bg-red-500/25'}`}
          title="Live Indian Hype & Trends Board"
        >
          <span class="text-xs">🔥</span>
          <span>Trending Board</span>
        </a>

        <!-- Loot Deals Button -->
        <a
          href="/deals"
          class={`hidden sm:flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-black shadow-sm transition ${isDeals ? 'bg-white text-slate-900' : 'bg-cta text-cta-ink hover:brightness-105'}`}
        >
          <Icon name="tag" class="w-3.5 h-3.5" />
          <span>Loot Deals</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition cursor-pointer"
          aria-label="Open Mobile Menu"
        >
          <svg class="w-6 h-6" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Newsroom Category Strip (Horizontal Quick-Rail) -->
  <div class="border-t border-white/5 bg-slate-950/70 backdrop-blur-md px-4 py-1.5 overflow-x-auto no-scrollbar">
    <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs font-semibold whitespace-nowrap">
      <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 mr-1 shrink-0">Topics:</span>
      <a
        href="/"
        class={`px-2.5 py-1 rounded-lg transition shrink-0 ${isHome ? 'bg-brand text-white font-bold' : 'text-slate-300 hover:text-white hover:bg-slate-800'}`}
      >
        All News
      </a>
      {niches.map(n => (
        <a
          href={`/${n.slug}`}
          class={`px-2.5 py-1 rounded-lg transition shrink-0 flex items-center gap-1.5 ${isNicheActive(n.slug) ? 'bg-white/20 text-white font-bold border border-white/20' : 'text-slate-300 hover:text-white hover:bg-slate-800/80'}`}
        >
          <span>{n.name}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Mega Menu Dropdown -->
  <MegaMenu />

  <!-- Mobile Drawer / Slide-Over Sheet -->
  <div id="mobile-sheet" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
    <div id="mobile-sheet-panel" class="fixed inset-y-0 right-0 max-w-sm w-full bg-white text-ink shadow-2xl overflow-y-auto flex flex-col justify-between translate-x-full transition-transform duration-300 ease-out">
      
      <!-- Drawer Header -->
      <div class="p-5 border-b border-slate-100">
        <div class="flex items-center justify-between pb-3">
          <div class="flex items-center gap-2">
            <BrandLogo size="sm" theme="dark" showTagline={false} />
          </div>
          <button id="close-mobile-sheet" class="p-1.5 rounded-lg text-slate-400 hover:text-ink hover:bg-slate-100 transition cursor-pointer" aria-label="Close menu">
            <svg class="w-5 h-5" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Quick Search inside Mobile Drawer -->
        <form action="/search" method="get" class="mt-2 relative">
          <input
            type="search"
            name="q"
            placeholder="Search trends, PC builds, AI tools..."
            class="w-full pl-9 pr-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs text-ink placeholder:text-slate-400 focus:outline-none focus:border-brand"
          />
          <span class="absolute left-3 top-2.5 text-slate-400 pointer-events-none">
            <Icon name="search" class="w-3.5 h-3.5" />
          </span>
        </form>
      </div>

      <!-- Quick Nav Buttons -->
      <div class="px-5 py-3 border-b border-slate-100 grid grid-cols-2 gap-2 bg-slate-50/60">
        <a
          href="/"
          class={`p-2.5 rounded-xl text-xs font-bold flex items-center gap-2 transition ${isHome ? 'bg-brand text-white shadow-xs' : 'bg-white text-slate-800 border border-slate-200 hover:bg-slate-100'}`}
        >
          <span>🏠</span>
          <span>Home</span>
        </a>
        <a
          href="/trending"
          class={`p-2.5 rounded-xl text-xs font-bold flex items-center gap-2 transition ${isTrending ? 'bg-brand text-white shadow-xs' : 'bg-white text-slate-800 border border-slate-200 hover:bg-slate-100'}`}
        >
          <span>🔥</span>
          <span>Trending Board</span>
        </a>
        <a
          href="/builds"
          class={`p-2.5 rounded-xl text-xs font-bold flex items-center gap-2 transition ${isBuilds ? 'bg-brand text-white shadow-xs' : 'bg-white text-slate-800 border border-slate-200 hover:bg-slate-100'}`}
        >
          <Icon name="cpu" class="w-3.5 h-3.5 text-brand" />
          <span>PC Builds</span>
        </a>
        <a
          href="/deals"
          class={`p-2.5 rounded-xl text-xs font-bold flex items-center gap-2 transition ${isDeals ? 'bg-brand text-white shadow-xs' : 'bg-cta text-cta-ink shadow-xs hover:brightness-105'}`}
        >
          <Icon name="tag" class="w-3.5 h-3.5" />
          <span>Loot Deals</span>
        </a>
      </div>

      <!-- Categorized Hubs List -->
      <div class="p-5 flex-1 overflow-y-auto space-y-5">
        {groups.map(grp => {
          const items = nichesByGroup[grp] || [];
          const badgeClass = groupBadges[grp] || 'bg-slate-100 text-slate-700';
          return (
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class={`px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider ${badgeClass}`}>
                  {grp}
                </span>
                <span class="text-[10px] font-mono text-muted">{items.length} Hubs</span>
              </div>
              <div class="grid grid-cols-1 gap-1">
                {items.map(n => (
                  <a
                    href={`/${n.slug}`}
                    class={`p-2 rounded-xl flex items-center justify-between text-xs transition ${isNicheActive(n.slug) ? 'bg-brand-soft text-brand font-bold' : 'hover:bg-slate-50 text-slate-800'}`}
                  >
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600 shrink-0">
                        <Icon name={n.icon} class="w-3.5 h-3.5" />
                      </div>
                      <div class="truncate">
                        <span class="font-bold block truncate">{n.name}</span>
                        <span class="text-[10px] text-muted block truncate">{n.tagline}</span>
                      </div>
                    </div>
                    {n.is_new && (
                      <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-breaking text-white shrink-0 ml-2">
                        NEW
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Drawer Footer -->
      <div class="p-4 border-t border-slate-100 bg-slate-50">
        <a
          href="/deals"
          class="w-full py-2.5 rounded-xl bg-cta text-cta-ink font-black text-xs flex items-center justify-center gap-2 shadow-sm hover:brightness-105 transition"
        >
          <Icon name="tag" class="w-4 h-4" />
          <span>Browse All Live Loot Deals</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Bottom Navigation Bar (High-Touch UX for Thumbs) -->
  <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-line shadow-lg px-2 py-1.5 flex items-center justify-around">
    <a
      href="/"
      class={`flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition ${isHome ? 'text-brand font-bold' : 'text-slate-500 hover:text-slate-800'}`}
    >
      <span class="text-base leading-none">🏠</span>
      <span class="text-[10px]">Home</span>
    </a>

    <a
      href="/trending"
      class={`flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition ${isTrending ? 'text-brand font-bold' : 'text-slate-500 hover:text-slate-800'}`}
    >
      <span class="text-base leading-none">🔥</span>
      <span class="text-[10px]">Trending</span>
    </a>

    <a
      href="/builds"
      class={`flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition ${isBuilds ? 'text-brand font-bold' : 'text-slate-500 hover:text-slate-800'}`}
    >
      <Icon name="cpu" class="w-4 h-4" />
      <span class="text-[10px]">Builds</span>
    </a>

    <a
      href="/deals"
      class={`flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl transition ${isDeals ? 'text-brand font-bold' : 'text-slate-500 hover:text-slate-800'}`}
    >
      <Icon name="tag" class="w-4 h-4" />
      <span class="text-[10px]">Deals</span>
    </a>

    <button
      type="button"
      id="bottom-bar-menu-btn"
      class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl text-slate-500 hover:text-slate-800 cursor-pointer"
      aria-label="Open Hubs Menu"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <span class="text-[10px]">Hubs ({niches.length})</span>
    </button>
  </nav>
</header>

<script is:inline>
  (function() {
    function setupHeaderNavigation() {
      const toggleBtn = document.getElementById('megamenu-toggle-btn');
      const panel = document.getElementById('megamenu-panel');
      const arrow = document.getElementById('megamenu-arrow');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const bottomMenuBtn = document.getElementById('bottom-bar-menu-btn');
      const mobileSheet = document.getElementById('mobile-sheet');
      const mobilePanel = document.getElementById('mobile-sheet-panel');
      const closeMobileSheet = document.getElementById('close-mobile-sheet');

      // Desktop MegaMenu Toggle
      if (toggleBtn && panel) {
        toggleBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          const isHidden = panel.classList.toggle('hidden');
          if (arrow) {
            if (isHidden) {
              arrow.classList.remove('rotate-180');
            } else {
              arrow.classList.add('rotate-180');
            }
          }
          toggleBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        };

        document.addEventListener('click', function(e) {
          if (!panel.contains(e.target) && !toggleBtn.contains(e.target)) {
            panel.classList.add('hidden');
            if (arrow) arrow.classList.remove('rotate-180');
            toggleBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Mobile Drawer Open / Close Helpers
      function openDrawer() {
        if (!mobileSheet || !mobilePanel) return;
        mobileSheet.classList.remove('pointer-events-none', 'opacity-0');
        mobileSheet.classList.add('opacity-100');
        mobilePanel.classList.remove('translate-x-full');
        mobilePanel.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (!mobileSheet || !mobilePanel) return;
        mobileSheet.classList.add('opacity-0', 'pointer-events-none');
        mobileSheet.classList.remove('opacity-100');
        mobilePanel.classList.add('translate-x-full');
        mobilePanel.classList.remove('translate-x-0');
        document.body.style.overflow = '';
      }

      if (mobileBtn) mobileBtn.onclick = openDrawer;
      if (bottomMenuBtn) bottomMenuBtn.onclick = openDrawer;
      if (closeMobileSheet) closeMobileSheet.onclick = closeDrawer;

      if (mobileSheet) {
        mobileSheet.onclick = function(e) {
          if (e.target === mobileSheet) closeDrawer();
        };
      }

      // Escape key to close
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeDrawer();
          if (panel) {
            panel.classList.add('hidden');
            if (arrow) arrow.classList.remove('rotate-180');
          }
        }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.location.href = '/search';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeaderNavigation);
    } else {
      setupHeaderNavigation();
    }
    document.addEventListener('astro:page-load', setupHeaderNavigation);
  })();
</script>
