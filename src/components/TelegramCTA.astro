---
interface Props {
  isSticky?: boolean;
}

const { isSticky = true } = Astro.props;
---

<div
  id="telegram-cta-banner"
  class={`bg-gradient-to-r from-sky-600 via-blue-600 to-indigo-700 text-white shadow-xl transition-transform duration-300 ${isSticky ? 'fixed bottom-0 left-0 right-0 z-40 p-3 sm:p-4 border-t border-sky-400/30' : 'rounded-3xl p-6 border border-sky-500/30 my-8'}`}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <!-- Content Info -->
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center flex-shrink-0 text-xl shadow-inner">
        ✈️
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm sm:text-base leading-tight">Instant Hype & Loot Alerts</span>
          <span class="hidden sm:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-white/20 uppercase">
            Hype ≥ 75
          </span>
        </div>
        <p class="text-xs text-sky-100 hidden sm:block mt-0.5">
          Har breaking tech drop, loot discount aur viral news sabse pehle pao direct Telegram par.
        </p>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <a
        href="https://t.me/uniquedigit"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-xl bg-white text-sky-700 hover:bg-sky-50 font-bold text-xs sm:text-sm transition shadow-md flex items-center gap-1.5"
      >
        <span>Join Telegram</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>

      {isSticky && (
        <button
          type="button"
          id="close-telegram-banner"
          class="p-1.5 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition"
          aria-label="Dismiss banner"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      )}
    </div>
  </div>
</div>

<script>
  const closeBtn = document.getElementById('close-telegram-banner');
  const banner = document.getElementById('telegram-cta-banner');
  if (closeBtn && banner) {
    closeBtn.addEventListener('click', () => {
      banner.style.display = 'none';
    });
  }
</script>
