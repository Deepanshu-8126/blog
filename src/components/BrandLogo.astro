---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  theme?: 'light' | 'dark' | 'brand';
  showTagline?: boolean;
}

const { size = 'md', theme = 'brand', showTagline = true } = Astro.props;

const sizes = {
  sm: { icon: 'w-7 h-7', text: 'text-base', sub: 'text-[9px]' },
  md: { icon: 'w-9 h-9', text: 'text-lg', sub: 'text-[10px]' },
  lg: { icon: 'w-11 h-11', text: 'text-2xl', sub: 'text-xs' }
};

const currentSize = sizes[size];
---

<div class="flex items-center gap-2.5 group select-none">
  <!-- Precision Vector Radar Monogram -->
  <div class={`relative ${currentSize.icon} rounded-xl bg-gradient-to-br from-brand via-purple-600 to-indigo-700 flex items-center justify-center p-0.5 shadow-md group-hover:shadow-purple-500/30 group-hover:scale-105 transition-all duration-300 shrink-0`}>
    <!-- Inner High-Contrast Shield -->
    <div class="w-full h-full rounded-[10px] bg-slate-950/40 backdrop-blur-xs flex items-center justify-center relative overflow-hidden">
      <!-- Radar Pulse Ring -->
      <span class="absolute inset-0 rounded-full border border-cta/30 animate-ping opacity-40"></span>
      
      <!-- Vector UD Monogram -->
      <svg class="w-5 h-5 text-cta drop-shadow-xs" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2005/Atom">
        <!-- Letter U -->
        <path d="M4 5V13C4 16.3137 6.68629 19 10 19C13.3137 19 16 16.3137 16 13V5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <!-- Letter D overlay with pulse dot -->
        <path d="M12 5H17C19.2091 5 21 6.79086 21 9C21 11.2091 19.2091 13 17 13H12" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
        <!-- Radar Center Node -->
        <circle cx="16.5" cy="9" r="1.5" fill="#FFD21F" />
      </svg>
    </div>
  </div>

  <!-- Wordmark & Subtitle -->
  <div class="flex flex-col leading-none">
    <div class="flex items-center gap-1">
      <span class={`font-black ${currentSize.text} tracking-tight ${theme === 'dark' ? 'text-slate-900' : 'text-white'} group-hover:text-amber-300 transition-colors`}>
        Unique<span class="text-cta">Digit</span>
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
    </div>
    {showTagline && (
      <span class={`${currentSize.sub} font-bold uppercase tracking-wider text-purple-200/90 mt-0.5 font-mono`}>
        Live Radar & Intel
      </span>
    )}
  </div>
</div>
