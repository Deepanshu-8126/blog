---
interface Props {
  sources: string[];
  maxVisible?: number;
}

const { sources = [], maxVisible = 4 } = Astro.props;

interface SourceMeta {
  label: string;
  short: string;
  color: string;
}

const SOURCE_MAP: Record<string, SourceMeta> = {
  gtrends: { label: 'Search Trend Intelligence', short: 'Search Signal', color: 'bg-blue-500/10 text-blue-700 border-blue-200' },
  gnews: { label: 'Verified Press Wire', short: 'Press Wire', color: 'bg-indigo-500/10 text-indigo-700 border-indigo-200' },
  wiki: { label: 'Verified Reference Data', short: 'Reference Data', color: 'bg-slate-200 text-slate-700 border-slate-300' },
  youtube: { label: 'Video Streaming Pulse', short: 'Video Wire', color: 'bg-red-500/10 text-red-700 border-red-200' },
  hn: { label: 'Tech Industry Forum', short: 'Tech Forum', color: 'bg-amber-500/10 text-amber-800 border-amber-200' },
  tmdb: { label: 'Entertainment Database', short: 'Box Office DB', color: 'bg-emerald-500/10 text-emerald-800 border-emerald-200' },
  social: { label: 'Audience Interest Pulse', short: 'Social Signal', color: 'bg-purple-500/10 text-purple-700 border-purple-200' }
};

// Clean and filter out raw crawler scrapers or reddit references
const cleanSources = sources
  .map(s => (s || '').toLowerCase().trim())
  .filter(s => s && !s.includes('reddit') && !s.includes('radar') && !s.includes('fetcher') && !s.includes('crawler') && !s.includes('bot'));

const visibleSources = cleanSources.slice(0, maxVisible);
const extraCount = Math.max(0, cleanSources.length - maxVisible);
---

<div class="inline-flex items-center gap-1.5 flex-wrap">
  {visibleSources.map(key => {
    const meta = SOURCE_MAP[key] || { label: 'Editorial Coverage', short: 'Editorial Wire', color: 'bg-slate-100 text-slate-700 border-slate-200' };
    return (
      <span
        class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold border ${meta.color} cursor-default`}
        title={`Source: ${meta.label}`}
      >
        {meta.short}
      </span>
    );
  })}
  {extraCount > 0 && (
    <span class="text-[10px] text-muted font-mono" title={`${extraCount} more signals`}>
      +{extraCount} verified
    </span>
  )}
</div>
