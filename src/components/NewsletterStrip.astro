---
import Icon from './Icon.astro';
---

<div class="w-full my-12 rounded-3xl bg-gradient-to-br from-brand to-brand-dark p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
  <!-- Subtle background glow -->
  <div class="absolute -right-20 -top-20 w-80 h-80 bg-cta/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md text-cta text-xs font-bold uppercase tracking-wider mb-4">
      <Icon name="sparkles" class="w-3.5 h-3.5" />
      Daily Intelligence Drops
    </span>

    <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-3">
      Get Top Loot Deals & Tech Trends Before Everyone Else
    </h2>

    <p class="text-sm text-purple-100 leading-relaxed mb-6">
      Join 10,000+ Indian tech enthusiasts. 0 spam, strictly curated daily price drops, PC hardware insights, and AI tool breakthroughs.
    </p>

    <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); alert('Subscribed successfully to UniqueDigit daily updates!');">
      <input
        type="email"
        required
        placeholder="Enter your email address..."
        class="flex-1 px-4 py-3 rounded-xl bg-white text-ink text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cta shadow-inner"
      />
      <button
        type="submit"
        class="px-6 py-3 rounded-xl bg-cta hover:bg-amber-400 text-cta-ink font-black text-sm transition shadow-md shrink-0 cursor-pointer"
      >
        Subscribe Free
      </button>
    </form>
    
    <span class="text-[11px] text-purple-200 block mt-3">
      🔒 Unsubscribe anytime. We respect your privacy.
    </span>
  </div>
</div>
