---
interface Props {
  nicheSlug?: string;
}

const { nicheSlug } = Astro.props;
---

<div class="my-8 sm:my-10 rounded-2xl sm:rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white p-6 sm:p-8 shadow-xl border border-indigo-700/50 relative overflow-hidden">
  <!-- Glowing accent circle -->
  <div class="absolute -right-12 -bottom-12 w-56 h-56 rounded-full bg-amber-400/15 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-tr from-amber-400 to-amber-500 text-slate-950 flex items-center justify-center font-black text-2xl shrink-0 shadow-md">
        ⚡
      </div>
      <div>
        <div class="flex items-center gap-2 mb-1.5 flex-wrap">
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30">
            Daily Live Test Active
          </span>
          <span class="text-xs text-slate-400 font-medium">Free GK Practice</span>
        </div>
        <h4 class="font-black text-white text-base sm:text-xl leading-snug mb-1">
          Daily Current Affairs & GK Mock Test 2026
        </h4>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl leading-relaxed">
          UPSC, SSC CGL, Railway, Banking & State Exams ke liye daily 10 high-probability MCQs solve karein. Instant scorecard, accuracy aur explanation dekhein.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-3 shrink-0 w-full md:w-auto">
      <a
        href="/exams-results"
        class="w-full md:w-auto text-center px-6 py-3.5 rounded-xl sm:rounded-2xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs sm:text-sm tracking-wide uppercase transition duration-150 shadow-lg shadow-amber-400/20 active:scale-95 whitespace-nowrap cursor-pointer"
      >
        Attempt Free Test ➔
      </a>
    </div>
  </div>
</div>
