---
import Icon from './Icon.astro';

interface Props {
  productTitle?: string;
  mrp?: number;
  salePrice?: number;
  bankDiscount?: number;
  bankName?: string;
  dealUrl?: string;
  retailer?: string;
  savingsPercent?: number;
  isLowestPrice?: boolean;
}

const {
  productTitle = 'Featured Verified Deal',
  mrp = 24999,
  salePrice = 17999,
  bankDiscount = 1500,
  bankName = 'HDFC / ICICI Credit Cards',
  dealUrl = 'https://www.amazon.in/?tag=uniquedigi0c6-21',
  retailer = 'Amazon India',
  savingsPercent = Math.round(((mrp - salePrice) / mrp) * 100),
  isLowestPrice = true
} = Astro.props;

const effectivePrice = Math.max(0, salePrice - bankDiscount);
const totalSaved = mrp - effectivePrice;
const totalSavingsPct = Math.round((totalSaved / mrp) * 100);

const formatInr = (val: number) => {
  return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(val);
};
---

<div class="my-8 rounded-3xl bg-white border border-emerald-200/90 shadow-md p-6 sm:p-7 relative overflow-hidden">
  <!-- Subtle Emerald Glow -->
  <div class="absolute -right-16 -top-16 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10">
    <!-- Header Badge -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 font-black text-xs uppercase tracking-wider border border-emerald-200">
          <Icon name="tag" class="w-3.5 h-3.5" />
          Triple Discount Stack
        </span>
        {isLowestPrice && (
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 text-xs font-bold">
            🔥 30-Day Lowest Price
          </span>
        )}
      </div>

      <span class="text-xs text-slate-500 font-mono">
        Seller: <strong class="text-slate-800">{retailer}</strong>
      </span>
    </div>

    <!-- Product Title -->
    <h3 class="text-lg sm:text-xl font-black text-slate-900 leading-snug mb-4">
      {productTitle}
    </h3>

    <!-- Price Calculation Breakdown Table -->
    <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4 sm:p-5 mb-5 space-y-3">
      <!-- Step 1: MRP -->
      <div class="flex items-center justify-between text-xs sm:text-sm text-slate-600">
        <span>Original MRP:</span>
        <span class="line-through font-mono text-slate-500">{formatInr(mrp)}</span>
      </div>

      <!-- Step 2: Instant Deal Cut -->
      <div class="flex items-center justify-between text-xs sm:text-sm text-slate-700 font-medium">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          Store Instant Discount ({savingsPercent}% Off):
        </span>
        <span class="font-mono text-slate-900 font-bold">{formatInr(salePrice)}</span>
      </div>

      <!-- Step 3: Bank / Card Offer -->
      {bankDiscount > 0 && (
        <div class="flex items-center justify-between text-xs sm:text-sm text-emerald-700 font-medium pt-2 border-t border-slate-200/80">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Bank Offer ({bankName}):
          </span>
          <span class="font-mono font-bold">- {formatInr(bankDiscount)}</span>
        </div>
      )}

      <!-- Effective Bottomline Price -->
      <div class="pt-3 border-t-2 border-emerald-300 flex items-center justify-between">
        <div>
          <span class="text-[11px] font-black uppercase tracking-wider text-emerald-800 block">
            Net Effective Steal Price
          </span>
          <span class="text-xs text-emerald-600 font-bold">
            Total Saved: {formatInr(totalSaved)} ({totalSavingsPct}% total cut)
          </span>
        </div>
        <div class="text-right">
          <span class="text-2xl sm:text-3xl font-black text-emerald-700 font-mono tracking-tight">
            {formatInr(effectivePrice)}
          </span>
        </div>
      </div>
    </div>

    <!-- Call to Action Button & Guarantee -->
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <a
        href={dealUrl}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-black text-sm transition shadow-md hover:shadow-lg text-center"
      >
        <span>Claim Offer at {retailer}</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <div class="text-center sm:text-left text-[11px] text-slate-600 leading-tight">
        <span>⚡ Price verified within last hour. Stock may run out quickly.</span>
      </div>
    </div>
  </div>
</div>
